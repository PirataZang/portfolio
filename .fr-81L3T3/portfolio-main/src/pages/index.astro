    <nav class="menu" id="menu-celular" data-menu-painel aria-label="Seções">
      <a href="#processo">Como funciona</a>
      <a href="#projetos">Projetos no GitHub</a>
      <a href="#demos">Demos completas</a>
      <a href="#stack">Ferramental</a>
      <a href="#servicos">Serviços e preços</a>
      <a href="#duvidas">Dúvidas</a>
      <a href="#contato">Falar comigo</a>
