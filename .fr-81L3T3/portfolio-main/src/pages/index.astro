    </svg>

    <a class="pular" href="#conteudo">Pular para o conteúdo</a>

    <header class="topo">
      <div class="topo-barra" data-progresso aria-hidden="true"></div>
      <a class="marca" href="#">
        <span class="marca-sig">IF</span>
        <span class="marca-txt">{EU.nome}<small>{EU.papel}</small></span>
      </a>
      <nav class="topo-nav" aria-label="Seções">
        <a href="#processo">Como funciona</a>
        <a href="#projetos">Projetos</a>
        <a href="#demos">Demos</a>
