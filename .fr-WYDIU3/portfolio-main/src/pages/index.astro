  { f: 'qua', x: 1120, y: 420, s: 44, r: 18 },
  { f: 'cir', x: 520, y: 620, s: 40 },
  { f: 'chev', x: 220, y: 560, s: 32, r: 8 },
  { f: 'x', x: 720, y: 130, s: 22, r: 22 },
  { f: 'cota', x: 600, y: 330, s: 84 },
  { f: 'canto', x: 300, y: 110, s: 40 },
  { f: 'arc', x: 1040, y: 600, s: 76, r: 120 },
];

const CAMPO_CONTATO: Forma[] = [
  { f: 'cir', x: 70, y: 80, s: 120 },
  { f: 'tri', x: 1060, y: 96, s: 62, r: 28 },
  { f: 'malha', x: 140, y: 540, s: 70 },
  { f: 'los', x: 1120, y: 500, s: 50 },
  { f: 'lin', x: 420, y: 660, s: 160 },
  { f: 'ast', x: 660, y: 100, s: 34 },
  { f: 'mira', x: 420, y: 300, s: 44 },
  { f: 'canto', x: 876, y: 556, s: 72 },
];

const titulo = `${EU.nome} — Criação de sites, sistemas e consultoria em ${EU.local}`;
const descricao =
  'Desenvolvedor fullstack. Sites sob medida a partir de R$ 800, sistemas por módulo e consultoria técnica por hora. Vue, Go, Astro e Docker. Projetos abertos no GitHub.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${EU.site}/#servico`,
      name: `${EU.nome} · Desenvolvimento`,
      description: descricao,
      url: EU.site,
      email: EU.email,
      areaServed: 'BR',
      address: {
        '@type': 'PostalAddress',
        addressLocality: EU.cidade,
        addressRegion: EU.uf,
        addressCountry: 'BR',
      },
      founder: {
        '@type': 'Person',
        name: EU.nome,
        jobTitle: EU.papel,
        sameAs: `https://github.com/${EU.gh}`,
      },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Serviços',
        itemListElement: SERVICOS.map((s) => ({
          '@type': 'Offer',
          name: s.t,
          description: s.d,
          priceCurrency: 'BRL',
          price: s.de.replace(/[^\d]/g, ''),
          priceSpecification: {
            '@type': 'PriceSpecification',
            minPrice: s.de.replace(/[^\d]/g, ''),
            priceCurrency: 'BRL',
          },
        })),
      },
    },
  ],
};
---

<Base title={titulo} description={descricao}>
  <Fragment slot="head">
    <link rel="canonical" href={EU.site} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#07080f" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.documentElement.classList.add('anima-on');
    </script>
  </Fragment>

  <div class="pf">
    {/* ---------- biblioteca de formas: definida uma vez, usada em todo lugar ---------- */}
    <svg class="formas-defs" aria-hidden="true" focusable="false">
      <defs>
        {/*
          Traço de 1 px que não engrossa quando o <use> escala. O atributo vai
          na forma, não no <g>: vector-effect não é herdado, então num grupo
          ele não desceria para o path. fill/stroke, esses sim são herdados —
          vêm do CSS do .campo e atravessam o clone do <use>.
        */}
        <g id="s-x"><path vector-effect="non-scaling-stroke" d="M3 3 21 21M21 3 3 21" /></g>
        <g id="s-cir"><circle vector-effect="non-scaling-stroke" cx="12" cy="12" r="10.5" /></g>
        <g id="s-tri"><path vector-effect="non-scaling-stroke" d="M12 2 22.5 21H1.5Z" /></g>
        <g id="s-qua"><rect vector-effect="non-scaling-stroke" x="2.5" y="2.5" width="19" height="19" rx="2.5" /></g>
        <g id="s-lin"><path vector-effect="non-scaling-stroke" d="M0 12h24" /></g>
        <g id="s-los"><path vector-effect="non-scaling-stroke" d="M12 1 23 12 12 23 1 12Z" /></g>
        <g id="s-hex"><path vector-effect="non-scaling-stroke" d="M12 1.5 21.5 7v10L12 22.5 2.5 17V7Z" /></g>
        <g id="s-chev"><path vector-effect="non-scaling-stroke" d="M7 2.5 18 12 7 21.5" /></g>
        <g id="s-arc"><path vector-effect="non-scaling-stroke" d="M2 21A19 19 0 0 1 21 2" /></g>
        <g id="s-zig"><path vector-effect="non-scaling-stroke" d="M1 17 6.75 7l5.75 10 5.75-10L23 17" /></g>
        <g id="s-ast"><path vector-effect="non-scaling-stroke" d="M12 1v22M2.5 6.5 21.5 17.5M21.5 6.5 2.5 17.5" /></g>
        {/*
          Marcas de desenho técnico. Entraram no lugar de uma forma orgânica
          que era a única coisa sem régua no conjunto — e por isso destoava de
          todo o resto. Mira de centro, cota e marca de canto dão a variedade
          sem sair da prancheta.
        */}
        <g id="s-mira">
          <circle vector-effect="non-scaling-stroke" cx="12" cy="12" r="7" />
          <path vector-effect="non-scaling-stroke" d="M12 1v6M12 17v6M1 12h6M17 12h6" />
        </g>
        <g id="s-cota">
          <path vector-effect="non-scaling-stroke" d="M2 4v16M22 4v16M2 12h20" />
          <path vector-effect="non-scaling-stroke" d="M6.5 8.5 2 12l4.5 3.5M17.5 8.5 22 12l-4.5 3.5" />
        </g>
        <g id="s-canto">
          <path vector-effect="non-scaling-stroke" d="M2 9.5V2h7.5M22 14.5V22h-7.5" />
        </g>
        {/* nove aros de 1 px viram sujeira: esta é a única forma preenchida */}
        <g id="s-malha">
          <circle cx="3" cy="3" r="1.5" /><circle cx="12" cy="3" r="1.5" /><circle cx="21" cy="3" r="1.5" />
          <circle cx="3" cy="12" r="1.5" /><circle cx="12" cy="12" r="1.5" /><circle cx="21" cy="12" r="1.5" />
          <circle cx="3" cy="21" r="1.5" /><circle cx="12" cy="21" r="1.5" /><circle cx="21" cy="21" r="1.5" />
        </g>
      </defs>
    </svg>

    <a class="pular" href="#conteudo">Pular para o conteúdo</a>

    <header class="topo">
      <div class="topo-barra" data-progresso aria-hidden="true"></div>
      <a class="marca" href="#">
        <span class="marca-sig">IF</span>
        <span class="marca-txt">{EU.nome}<small>{EU.papel}</small></span>
      </a>
      <nav class="topo-nav" aria-label="Seções">
        <a href="#servicos">Serviços</a>
        <a href="#projetos">Projetos</a>
        <a href="#demos">Demos</a>
        <a href="#processo">Como funciona</a>
      </nav>
      <a class="btn btn-p btn-min topo-cta" href="#contato">
        <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
        <span>Pedir orçamento</span>
      </a>
      {/*
        Abaixo de 920px a navegação some e, até aqui, não havia nada no lugar:
        no celular dava para chegar às seções só rolando a página inteira.
      */}
      <button type="button" class="topo-botao" data-menu aria-expanded="false" aria-controls="menu-celular">
        <span class="topo-risco" aria-hidden="true"></span>
        <span class="visualmente-oculto">Abrir menu</span>
      </button>
    </header>

    <nav class="menu" id="menu-celular" data-menu-painel aria-label="Seções">
      <a href="#servicos">Serviços e preços</a>
      <a href="#projetos">Projetos no GitHub</a>
      <a href="#demos">Demos completas</a>
      <a href="#processo">Como funciona</a>
      <a href="#contato">Falar comigo</a>
      <a class="menu-zap" href={`https://wa.me/${EU.zap}`} rel="noopener">
        <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> WhatsApp
      </a>
    </nav>
    <div class="menu-fundo" data-menu-fundo hidden></div>

    <main id="conteudo">
      {/* ================= HERÓI ================= */}
      <section class="heroi blueprint">
        <div class="halo halo-anil" aria-hidden="true"></div>
        <div class="halo halo-roxo" aria-hidden="true"></div>
        <svg class="campo" viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice" data-campo="0.16" aria-hidden="true" focusable="false">
          {
            CAMPO_HEROI.map((f, i) => (
              <g transform={`translate(${f.x} ${f.y}) scale(${f.s / 24})`}>
                <use
                  href={`#s-${f.f}`}
                  opacity={f.o ?? 1}
                  class={`fm fm-${modo(f.f)}`}
                  style={`--r:${f.r ?? 0}deg; --d:${ritmo(i).dur}s; --a:${ritmo(i).atraso}s; --sentido:${ritmo(i).sentido}`}
                />
              </g>
            ))
          }
        </svg>

        <div class="heroi-txt">
          <p class="fita" data-anima>
            <span class="pisca" aria-hidden="true"></span>
            Disponível para projeto · {EU.local}
          </p>
          <h1>
            <span class="linha" data-linha>Sites e sistemas</span>
            <span class="linha" data-linha>feitos <em>sob medida</em>,</span>
            <span class="linha" data-linha>não sobre molde.</span>
          </h1>
          <p class="lead" data-anima>
            {perfil?.bio ?? '💻 Fullstack Developer | Criador de Soluções Inteligentes'} —
            escrevo Vue, Go e TypeScript, entrego em container e deixo o
            código aberto para você conferir.
          </p>
          <div class="acoes" data-anima>
            <a class="btn btn-p btn-g" href="#servicos">
              <i class="fa-solid fa-tags" aria-hidden="true"></i> Ver serviços e preços
            </a>
            <a class="btn btn-fant btn-g" href={`https://github.com/${EU.gh}`} rel="noopener">
              <i class="fa-brands fa-github" aria-hidden="true"></i> Ver o código
            </a>
          </div>

          <dl class="nums" data-anima>
            {
              numeros.map((n) => (
                <div>
                  <dt data-conta-ate={n.v} data-ano={n.ano ? '1' : null}>{n.v}</dt>
                  <dd>{n.l}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <p class="rola" aria-hidden="true">scroll</p>
      </section>

      {/* ================= O CAMINHO — mapa astral preso ao topo ================= */}
      {/*
        A seção é alta, o miolo fica `sticky` e o scroll vira o traçado de uma
        constelação: o fio corre de uma estrela à outra e, quando chega, a
        carta daquela etapa nasce ali. Cada carta entra com uma transição
        diferente do Motion — mola, corte de máscara, giro em 3D, sequência
        encadeada — de propósito, para a seção mostrar repertório.

        A classe `.presa` só entra pelo JS, e só em tela larga. Sem ela — sem
        JS, com movimento reduzido, ou no celular — as cinco cartas são uma
        lista empilhada comum, que é um estado legível e completo.
      */}
      <section class="caminho blueprint" id="processo" data-caminho>
        <div class="caminho-miolo">
          <div class="caixa caminho-caixa">
            <header class="cab" data-anima>
              <p class="olho olho-escuro">Como a coisa anda</p>
              <h2>Da primeira conversa ao container rodando</h2>
            </header>

            <p class="cam-conta" aria-live="polite">
              <b data-cam-atual>01</b><span>/ {String(CAMINHO.length).padStart(2, '0')}</span>
              <em data-cam-nome>{CAMINHO[0].t}</em>
            </p>
          </div>

          {/* o céu sai da caixa: quanto mais largo, mais a constelação respira */}
          <div class="ceu" data-ceu>
            <div class="ceu-camera" data-camera>
                {/* poeira em divs, não em círculos SVG: assim continua redonda */}
                <div class="ceu-poeira" aria-hidden="true">
                  {POEIRA.map((d) => (
                    <span style={`left:${d.x}%; top:${d.y}%; --o:${d.o}; --d:${d.d}s`}></span>
                  ))}
                </div>

                <svg class="ceu-svg" data-svg aria-hidden="true" focusable="false">
                  <defs>
                    <linearGradient id="g-fio" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0%" stop-color="#2743b8" />
                      <stop offset="100%" stop-color="#6b21d6" />
                    </linearGradient>
                  </defs>
                  <g class="ceu-trilhos">
                    {CAMINHO.slice(1).map(() => <path data-trilho />)}
                  </g>
                  <g class="ceu-galhos">
                    {CAMINHO.map((c, i) => c.mi.map(() => <path data-galho data-no={i} pathLength="1" />))}
                  </g>
                  <g class="ceu-fios">
                    {CAMINHO.slice(1).map(() => <path data-fio pathLength="1" style="stroke-dashoffset:1" />)}
                  </g>
                </svg>

                {CAMINHO.map((c, i) => (
                  <button
                    type="button"
                    class="astro"
                    data-astro
                    data-x={c.x}
                    data-y={c.y}
                    style={`--x:${c.x}%; --y:${c.y}%`}
                    aria-label={`Etapa ${c.n}: ${c.t}`}
                  >
                    <span class="astro-fagulha" aria-hidden="true"></span>
                    <span class="astro-onda" aria-hidden="true"></span>
                    <span class="astro-orbita" aria-hidden="true"></span>
                    <span class="astro-halo" aria-hidden="true"></span>
                    <span class="astro-disco" aria-hidden="true">{c.n}</span>
                  </button>
                ))}

                {/*
                  As satélites. Constelação não é uma fileira de pontos: são as
                  estrelas menores penduradas em cada nó que dão o desenho.
                */}
                {CAMINHO.map((c, i) =>
                  c.mi.map((m, k) => (
                    <span
                      class="mini"
                      data-mini
                      data-no={i}
                      style={`--x:${c.x + m.x}%; --y:${c.y + m.y}%; --i:${k}`}
                      aria-hidden="true"
                    ></span>
                  )),
                )}

                {CAMINHO.map((c, i) => (
                  <article
                    class="carta"
                    data-carta
                    data-lado={c.lado}
                    style={`--x:${c.x}%; --y:${c.y}%`}
                    aria-hidden={i === 0 ? null : 'true'}
                  >
                    <div class="carta-cab" data-cx>
                      <span class="cam-n">{c.n}</span>
                      <i class={`carta-i ${c.i}`} aria-hidden="true"></i>
                      <span class="cam-marco">{c.marco}</span>
                    </div>
                    <h3 data-cx>{c.t}</h3>
                    <p data-cx>{c.d}</p>
                  </article>
                ))}
            </div>
          </div>
        </div>
      </section>

      {/* ================= SERVIÇOS ================= */}
      <section class="secao servicos blueprint" id="servicos">
        <svg class="campo" viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice" data-campo="-0.1" aria-hidden="true" focusable="false">
          {
            CAMPO_SERVICOS.map((f, i) => (
              <g transform={`translate(${f.x} ${f.y}) scale(${f.s / 24})`}>
                <use
                  href={`#s-${f.f}`}
                  class={`fm fm-${modo(f.f)}`}
                  style={`--r:${f.r ?? 0}deg; --d:${ritmo(i).dur}s; --a:${ritmo(i).atraso}s; --sentido:${ritmo(i).sentido}`}
                />
              </g>
            ))
          }
        </svg>

        <div class="caixa caixa-larga">
          <header class="cab" data-anima>
            <p class="olho">Serviços</p>
            <h2>Três formas de trabalhar junto</h2>
            <p class="lead">
              Preço de referência para você calibrar orçamento agora. O valor
              fecha depois da conversa, por escrito, e não muda no meio.
            </p>
          </header>

          <ul class="grade-serv">
            {
              SERVICOS.map((s) => (
                <li class={`serv${s.destaque ? ' serv-d' : ''}`} data-serv data-brilho>
                  <div class="serv-luz" aria-hidden="true"></div>
                  {/*
                    Formas do fundo do card. Cada uma é um <svg> próprio de
                    tamanho fixo: assim continua na proporção certa em card
                    estreito ou largo, e a animação é só `transform` com
                    valores literais — nada de var() no keyframe.
                  */}
                  <div class="serv-formas" aria-hidden="true">
                    {s.formas.map((f) => (
                      <svg
                        class={`sf sf-m${f.m}`}
                        viewBox="0 0 24 24"
                        style={`left:${f.x}%; top:${f.y}%; width:${f.s}px; height:${f.s}px; animation-duration:${f.d}s; animation-delay:${f.a}s`}
                      >
                        <use href={`#s-${f.f}`} />
                      </svg>
                    ))}
                  </div>
                  {s.destaque && <span class="serv-selo">mais pedido</span>}
                  <i class={`serv-i ${s.icone}`} aria-hidden="true"></i>
                  <h3>{s.t}</h3>
                  <p class="serv-sub">{s.sub}</p>
                  <p class="serv-preco">
                    <small>a partir de</small>
                    <b data-preco={s.de.replace(/\D/g, '')}>{s.de}</b>
                    <span>{s.unidade}</span>
                  </p>
                  <p class="serv-extra">{s.extra}</p>
                  <p class="serv-txt">{s.d}</p>
                  <ul class="serv-itens">
                    {s.itens.map((i) => (
                      <li>
                        <i class="fa-solid fa-check" aria-hidden="true"></i>
                        {i}
                      </li>
                    ))}
                  </ul>
                  {s.naoEntra && (
                    <p class="serv-fora" role="note">
                      <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                      <b>Fora daqui</b>
                      <span>{s.naoEntra}</span>
                    </p>
                  )}
                  <p class="serv-prazo">
                    <i class="fa-solid fa-stopwatch" aria-hidden="true"></i> {s.prazo}
                  </p>
                  <a class={`btn ${s.destaque ? 'btn-p' : 'btn-fant'} btn-cheio`} href={`#contato`} data-servico={s.t}>
                    Quero um orçamento
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="nota-preco" data-anima>
            Parcelo em até 6× sem juros no cartão, ou 10% de desconto no Pix à
            vista. Manutenção mensal é opcional e cotada separada.
          </p>
        </div>
      </section>

      {/* ================= PROJETOS DO GITHUB ================= */}
      <section class="secao projetos" id="projetos">
        <svg class="campo" viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice" data-campo="0.13" aria-hidden="true" focusable="false">
          {
            CAMPO_PROJETOS.map((f, i) => (
              <g transform={`translate(${f.x} ${f.y}) scale(${f.s / 24})`}>
                <use
                  href={`#s-${f.f}`}
                  class={`fm fm-${modo(f.f)}`}
                  style={`--r:${f.r ?? 0}deg; --d:${ritmo(i).dur}s; --a:${ritmo(i).atraso}s; --sentido:${ritmo(i).sentido}`}
                />
              </g>
            ))
          }
        </svg>

        <div class="caixa">
          <header class="cab" data-anima>
            <p class="olho">Código aberto</p>
            <h2>Projetos no GitHub</h2>
            <p class="lead">
              Puxado da API pública do GitHub na hora do build. Nada de
              mockup: é o repositório, com a linguagem e a data reais. Arraste
              de lado, ou use as setas.
            </p>
          </header>

          {/*
            Galeria com scroll-snap nativo: quem manda no avanço é o dedo, a
            roda ou as setas — nada anda sozinho. O encaixe, a rolagem suave e
            o arrasto por toque saem todos do CSS; ao JS sobram só as setas e
            os pontos, que precisam saber onde a fila parou.
          */}
          <div class="galeria" data-galeria data-anima>
            <ul class="galeria-fila no-bar" data-fila>
              {
                    projetos.map((p) => (
                <li class="proj" data-brilho>
                  <div class="serv-luz" aria-hidden="true"></div>
                  <div class="proj-cab">
                    <span class="proj-tipo">{p.tipo}</span>
                    {p.estrelas > 0 && (
                      <span class="proj-estrela">
                        <i class="fa-solid fa-star" aria-hidden="true"></i> {p.estrelas}
                      </span>
                    )}
                  </div>
                  <h3><span class="cerquilha">/</span>{p.nome}</h3>
                  <p class="proj-d">{p.resumo}</p>
                  <p class="proj-pe">
                    {p.lang && (
                      <span class="proj-lang">
                        <i style={`--cor:${CORES[p.lang] ?? '#8b93b5'}`} aria-hidden="true"></i>
                        {p.lang}
                      </span>
                    )}
                    {p.empurrado && (
                      <span class="proj-data">
                        {new Date(p.empurrado).toLocaleDateString('pt-BR', { month: 'short', year: 'numeric' })}
                      </span>
                    )}
                  </p>
                  <div class="proj-links">
                    <a href={p.url} rel="noopener">
                      <i class="fa-brands fa-github" aria-hidden="true"></i> Código
                    </a>
                    {p.aoVivo && (
                      <a href={p.aoVivo} rel="noopener" class="proj-vivo">
                        <i class="fa-solid fa-up-right-from-square" aria-hidden="true"></i> Ver no ar
                      </a>
                    )}
                  </div>
                </li>
                    ))
              }
            </ul>

            <div class="galeria-leme">
              <button type="button" class="gal-seta" data-gal="-1" aria-label="Projeto anterior">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
              </button>
              <span class="gal-trilho" aria-hidden="true">
                <span class="gal-polegar" data-polegar></span>
              </span>
              <p class="gal-conta" aria-live="polite">
                <b data-gal-atual>01</b>
                <span>/ {String(projetos.length).padStart(2, '0')}</span>
              </p>
              <button type="button" class="gal-seta" data-gal="1" aria-label="Próximo projeto">
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
              </button>
            </div>

            <p class="trilha-pe">
              <a class="btn btn-fant" href={`https://github.com/${EU.gh}?tab=repositories`} rel="noopener">
                <i class="fa-brands fa-github" aria-hidden="true"></i>
                Ver todos os projetos
              </a>
            </p>
          </div>
        </div>
      </section>

      {/* ================= DEMOS ================= */}
      <section class="secao demos" id="demos">
        <div class="caixa">
          <header class="cab" data-anima>
            <p class="olho">Demonstrações</p>
            <h2>Sites completos, para você abrir e clicar</h2>
            <p class="lead">
              Cada demo é um site de verdade, com conteúdo escrito e fluxo que
              funciona. É o que eu entrego, não um print.
            </p>
          </header>

          <ul class="grade-demos">
            {
              DEMOS.map((d) => (
                <li class="demo" data-anima>
                  <a href={`/sites/${d.slug}`} class={d.pronto ? '' : 'demo-wip'}>
                    <span class="demo-tag">{d.tag}</span>
                    <span class="demo-nome">{d.nome}</span>
                    <span class="demo-nota">{d.nota}</span>
                    <span class="demo-seta" aria-hidden="true">
                      <i class="fa-solid fa-arrow-right"></i>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      {/* ================= STACK ================= */}
      <section class="secao stack blueprint" id="stack">
        <div class="caixa">
          <header class="cab" data-anima>
            <p class="olho">Ferramental</p>
            <h2>Com o que eu construo</h2>
            <p class="lead">
              Escolha de stack é decisão de manutenção, não de moda. Estas são
              as que eu sustento em produção.
            </p>
          </header>

          <div class="grade-stack">
            {
              STACK.map((g) => (
                <section class="stack-g" data-anima>
                  <h3>{g.g}</h3>
                  <ul>
                    {g.itens.map((i) => <li>{i}</li>)}
                  </ul>
                </section>
              ))
            }
          </div>

          {linguagens.length > 0 && (
            <p class="stack-nota" data-anima>
              Nos repositórios públicos hoje:{' '}
              {linguagens.map((l, i) => (
                <>
                  <span class="stack-lang">
                    <i style={`--cor:${CORES[l] ?? '#8b93b5'}`} aria-hidden="true"></i>{l}
                  </span>
                  {i < linguagens.length - 1 ? ' · ' : ''}
                </>
              ))}
            </p>
          )}
        </div>
      </section>

      {/* ================= CONTATO ================= */}
      <section class="secao contato" id="contato">
        <svg class="campo" viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice" data-campo="-0.14" aria-hidden="true" focusable="false">
          {
            CAMPO_CONTATO.map((f, i) => (
              <g transform={`translate(${f.x} ${f.y}) scale(${f.s / 24})`}>
                <use
                  href={`#s-${f.f}`}
                  class={`fm fm-${modo(f.f)}`}
                  style={`--r:${f.r ?? 0}deg; --d:${ritmo(i).dur}s; --a:${ritmo(i).atraso}s; --sentido:${ritmo(i).sentido}`}
                />
              </g>
            ))
          }
        </svg>
        <div class="halo halo-roxo halo-baixo" aria-hidden="true"></div>

        <div class="caixa">
          <div class="contato-grade">
            <div data-anima>
              <p class="olho">Contato</p>
              <h2>Me conte o que precisa resolver</h2>
              <p class="lead">
                Responda em três campos e eu volto com uma faixa de preço e um
                prazo no mesmo dia. Se não for meu tipo de projeto, eu digo — e
                indico quem faz.
              </p>
              <ul class="contato-links">
                <li>
                  <a href={`https://wa.me/${EU.zap}`} rel="noopener">
                    <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> WhatsApp {EU.zapFmt}
                  </a>
                </li>
                <li>
                  <a href={`mailto:${EU.email}`}>
                    <i class="fa-solid fa-envelope" aria-hidden="true"></i> {EU.email}
                  </a>
                </li>
                <li>
                  <a href={`https://github.com/${EU.gh}`} rel="noopener">
                    <i class="fa-brands fa-github" aria-hidden="true"></i> github.com/{EU.gh}
                  </a>
                </li>
              </ul>
            </div>

            <form class="form" data-form data-zap={EU.zap} data-anima>
              <div class="form-2">
                <label>
                  Nome
                  <input name="nome" type="text" required autocomplete="name" placeholder="Como te chamo" />
                </label>
                <label>
                  WhatsApp ou e-mail
                  <input name="contato" type="text" required placeholder="(47) 90000-0000" />
                </label>
              </div>

              <label>
                O que você precisa
                <select name="servico" data-alvo>
                  {SERVICOS.map((s) => <option>{s.t}</option>)}
                  <option>Ainda não sei</option>
                </select>
              </label>

              <div class="form-2">
                <label>
                  Orçamento previsto
                  <select name="verba">
                    <option>Até R$ 1.500</option>
                    <option selected>R$ 1.500 a R$ 3.000</option>
                    <option>R$ 3.000 a R$ 8.000</option>
                    <option>Acima de R$ 8.000</option>
                    <option>Prefiro que você me diga</option>
                  </select>
                </label>
                <label>
                  Prazo
                  <select name="prazo">
                    <option>Sem pressa</option>
                    <option selected>Nas próximas semanas</option>
                    <option>É urgente</option>
                  </select>
                </label>
              </div>

              <label>
                O problema, em duas linhas
                <textarea
                  name="obs"
                  rows="3"
                  required
                  placeholder="Hoje eu perco pedido porque… / minha planilha não dá mais conta de…"></textarea>
              </label>

              <button class="btn btn-p btn-cheio btn-g" type="submit">
                <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Enviar pelo WhatsApp
              </button>
              <p class="form-nota">
                Abre a conversa com tudo preenchido. Nada fica gravado neste site.
              </p>
            </form>
          </div>
        </div>
      </section>
    </main>

    <footer class="rodape">
      <div class="caixa rodape-grade">
        <div>
          <p class="rodape-marca">{EU.nome}<small>{EU.papel} · {EU.local}</small></p>
          <p class="rodape-d">
            Sites, sistemas e consultoria. Código aberto no GitHub, entrega em
            container, conversa em português.
          </p>
        </div>
        <nav aria-label="Rodapé">
          <p class="rodape-t">Navegar</p>
          <ul>
            <li><a href="#servicos">Serviços e preços</a></li>
            <li><a href="#projetos">Projetos no GitHub</a></li>
            <li><a href="#demos">Demos completas</a></li>
            <li><a href="#processo">Como funciona</a></li>
          </ul>
        </nav>
        <div>
          <p class="rodape-t">Falar comigo</p>
          <ul>
            <li><a href={`https://wa.me/${EU.zap}`} rel="noopener">WhatsApp</a></li>
            <li><a href={`mailto:${EU.email}`}>{EU.email}</a></li>
            <li><a href={`https://github.com/${EU.gh}`} rel="noopener">GitHub</a></li>
          </ul>
        </div>
      </div>
      <p class="caixa rodape-fim">
        <span>© 2026 {EU.nome}</span>
      </p>
    </footer>
  </div>
</Base>

<style>
  .pf {
    /* noite azulada: preto que puxa para anil, nunca cinza */
    --noite: #07080f;
    --noite-2: #0a0c17;
    --noite-3: #0f1224;
    --carta: #121629;

    /* o azul quase preto das formas do fundo */
    --tracado: #1b2650;

    --anil: #1e2b6b;
    --anil-luz: #4472f7;
    --roxo: #5b2ec4;
    --roxo-luz: #a259f7;
    --ciano: #35d6f0;

    --gelo: #eaeefc;
    --gelo-60: #98a1c4;
    --gelo-40: #666f93;
    --borda: #1c2140;
    --borda-viva: #2b3468;

    --clara: #eef1f9;
    --clara-2: #e2e7f4;
    --escuro: #0b0e1c;
    --escuro-60: #4a5273;

    --raio: 14px;
    --raio-g: 22px;
    --topo-h: 4rem;
    --t: 0.4s;
    --e: cubic-bezier(0.22, 0.61, 0.36, 1);
    --brilho: 0 0 0 1px var(--borda-viva), 0 20px 50px -24px rgba(91, 46, 196, 0.55);

    position: relative;
    background: var(--noite);
    color: var(--gelo);
    font-family: 'Sora', ui-sans-serif, system-ui, sans-serif;
    font-size: 1rem;
    line-height: 1.62;
  }

  :global(body) { background: #07080f; color: #eaeefc; }
  :global(::selection) { background: #5b2ec4; color: #fff; }

  .formas-defs { position: absolute; width: 0; height: 0; overflow: hidden; }

  .pular {
    position: absolute; left: -9999px; top: 0; z-index: 100;
    background: var(--roxo); color: #fff; padding: 0.7rem 1.1rem;
    text-decoration: none; border-radius: 0 0 var(--raio) 0;
  }
  .pular:focus { left: 0; }

  /* ---------- tipografia ---------- */
  h1, h2, h3 {
    font-weight: 700; letter-spacing: -0.032em; line-height: 1.1;
    margin: 0; text-wrap: balance;
  }
  h1 { font-size: clamp(2.4rem, 6.2vw, 4.6rem); font-weight: 800; line-height: 1.04; }
  h2 { font-size: clamp(1.8rem, 3.6vw, 2.9rem); }
  h3 { font-size: 1.18rem; letter-spacing: -0.02em; }
  p { margin: 0; text-wrap: pretty; }
  .lead { font-size: 1.04rem; color: var(--gelo-60); max-width: 56ch; }

  .olho {
    display: inline-flex; align-items: center; gap: 0.55rem;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.7rem; font-weight: 500; letter-spacing: 0.2em;
    text-transform: uppercase; margin: 0 0 0.9rem;
    color: var(--anil-luz);
  }
  .olho::before {
    content: ''; width: 22px; height: 1px; flex: none;
    background: linear-gradient(90deg, transparent, var(--roxo-luz));
  }
  .olho-escuro { color: #2743b8; }
  .olho-escuro::before { background: linear-gradient(90deg, transparent, #6b21d6); }

  /*
    Texto em gradiente. Cor sólida é o estado base, e o gradiente só entra
    onde background-clip: text existe — senão `color: transparent` deixaria
    título e rótulo invisíveis.
  */
  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    h1 em {
      color: transparent;
      -webkit-background-clip: text; background-clip: text;
      background-image: linear-gradient(100deg, var(--anil-luz) 8%, var(--roxo-luz) 62%, var(--ciano));
    }
  }

  .caixa { max-width: 1200px; margin: 0 auto; padding-inline: clamp(1rem, 4vw, 2.6rem); }
  /* quatro cartões de preço lado a lado não cabem em 1200: esta seção usa
     mais tela que o resto da página, de propósito */
  .caixa-larga { max-width: 1560px; }
  /* o campo de formas transborda de propósito; o corte é aqui e não no .pf,
     que é ancestral do topo fixo */
  .secao { position: relative; overflow: hidden; padding-block: clamp(3.8rem, 8vw, 7rem); }
  .cab { margin-bottom: clamp(2.2rem, 4vw, 3.2rem); max-width: 60ch; }
  .cab .lead { margin-top: 0.9rem; }
  .cab-larga {
    max-width: none; display: flex; flex-wrap: wrap; gap: 1.5rem;
    align-items: flex-end; justify-content: space-between;
  }
  .cab-larga > div:first-child { max-width: 60ch; }

  /* ---------- botões ---------- */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.55rem;
    padding: 0.78rem 1.4rem; border-radius: 999px;
    font-family: inherit; font-size: 0.93rem; font-weight: 600; text-decoration: none;
    border: 1px solid transparent; white-space: nowrap; cursor: pointer;
    transition: background var(--t) var(--e), border-color var(--t) var(--e),
      color var(--t) var(--e), box-shadow var(--t) var(--e);
  }
  .btn-g { padding: 0.95rem 1.7rem; font-size: 1rem; }
  .btn-min { padding: 0.55rem 1.05rem; font-size: 0.85rem; }
  .btn-cheio { width: 100%; }
  .btn-p {
    background: var(--roxo);
    color: #fff;
    box-shadow: 0 12px 30px -16px rgba(91, 46, 196, 0.95);
  }
  .btn-p:hover {
    background: #6c3ade;
    box-shadow: 0 0 0 1px rgba(162, 89, 247, 0.5), 0 16px 40px -16px rgba(91, 46, 196, 1);
  }
  .btn-fant { background: rgba(234, 238, 252, 0.04); color: var(--gelo); border-color: var(--borda-viva); }
  .btn-fant:hover { border-color: var(--roxo-luz); background: rgba(162, 89, 247, 0.1); }

  /* ---------- formas de fundo ---------- */
  .campo {
    position: absolute; inset: -6% -2%; width: 104%; height: 112%;
    /* fill/stroke são herdados e atravessam o <use>; vector-effect não é,
       e por isso mora como atributo nos <g> do <defs> */
    fill: none; stroke: var(--tracado); stroke-width: 1;
    pointer-events: none; z-index: 0;
  }
  /* a malha de pontos é sólida, senão nove aros minúsculos viram sujeira */
  .campo use[href='#s-malha'] { fill: var(--tracado); stroke: none; }

  /*
    O movimento de cada forma. A posição vive no <g> de fora e a animação no
    <use> de dentro, e essa separação é obrigatória: `transform` em CSS
    SUBSTITUI o atributo transform do SVG — no mesmo elemento, a forma perderia
    o lugar e voaria para o canto da tela.

    `transform-box: fill-box` faz o eixo ser o centro da própria forma e não a
    origem do SVG. Sem isso, girar 20° manda a peça para o outro lado.
  */
  /*
    A rotação base mora em `rotate:`, não dentro do `transform`. Parece
    detalhe, mas é o que tira `var()` de dentro dos keyframes: com custom
    property lá o Chrome precisa resolver estilo dos 40 <use> a cada quadro
    e a animação nunca sobe para o compositor. `rotate` é propriedade
    independente e compõe antes do `transform`, então o desenho é o mesmo.
  */
  .fm {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    rotate: var(--r, 0deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .fm-gira {
      animation: fm-gira var(--d, 30s) linear var(--a, 0s) infinite;
      animation-direction: var(--sentido, normal);
    }
    .fm-flutua {
      animation: fm-flutua var(--d, 30s) ease-in-out var(--a, 0s) infinite;
      animation-direction: var(--sentido, normal);
    }
  }
  @keyframes fm-gira {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  /* deriva curta com uma inclinada de ida e volta. O valor é pré-escala,
     então forma grande deriva mais — profundidade de graça. */
  @keyframes fm-flutua {
    0%, 100% { transform: rotate(0deg) translate(0, 0); }
    33% { transform: rotate(5deg) translate(1.5px, -3.5px); }
    66% { transform: rotate(-4deg) translate(-1.5px, 2.5px); }
  }
  .secao > .caixa, .heroi-txt { position: relative; z-index: 2; }

  /* halo: a luz que faz o preto não ser preto */
  .halo {
    position: absolute; border-radius: 50%; pointer-events: none; z-index: 1;
    filter: blur(90px); opacity: 0.5;
  }
  .halo-anil {
    width: 46rem; height: 32rem; top: -14rem; right: -12rem;
    background: radial-gradient(circle, var(--anil) 0%, transparent 68%);
  }
  .halo-roxo {
    width: 38rem; height: 30rem; bottom: -14rem; left: -10rem;
    background: radial-gradient(circle, var(--roxo) 0%, transparent 66%);
    opacity: 0.38;
  }
  .halo-baixo { top: auto; bottom: -16rem; left: 50%; translate: -50% 0; }

  /* malha de engenharia, esmaecida no meio */
  /*
    A grade de prancheta. Dois níveis é o que separa papel de engenharia de uma
    grade qualquer: fio fino a cada 34 px e fio forte a cada 170 px, um a cada
    cinco. Esmaece no topo e no pé para não cortar seco na emenda das seções.

    Uma regra só, e cada seção escolhe a cor pelas duas variáveis — a clara
    precisa de azul escuro, as escuras de azul luminoso.
  */
  .blueprint {
    --g-fina: rgba(68, 114, 247, 0.045);
    --g-forte: rgba(68, 114, 247, 0.09);
  }
  .blueprint::before {
    content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background-image:
      linear-gradient(to right, var(--g-fina) 1px, transparent 1px),
      linear-gradient(to bottom, var(--g-fina) 1px, transparent 1px),
      linear-gradient(to right, var(--g-forte) 1px, transparent 1px),
      linear-gradient(to bottom, var(--g-forte) 1px, transparent 1px);
    background-size: 34px 34px, 34px 34px, 170px 170px, 170px 170px;
    mask-image: linear-gradient(180deg, transparent, #000 16%, #000 84%, transparent);
  }

  /* ---------- herói ---------- */
  .heroi {
    position: relative; overflow: hidden;
    min-height: min(94svh, 52rem);
    display: grid; align-items: center;
    padding: calc(var(--topo-h) + clamp(2.5rem, 6vh, 4.5rem)) clamp(1rem, 4vw, 2.6rem)
      clamp(4.5rem, 10vh, 7rem);
    border-bottom: 1px solid var(--borda);
  }
  .heroi-txt { max-width: 1200px; margin: 0 auto; width: 100%; }

  .fita {
    display: inline-flex; align-items: center; gap: 0.6rem;
    padding: 0.42rem 0.95rem 0.42rem 0.75rem; margin-bottom: 1.7rem;
    border-radius: 999px; border: 1px solid var(--borda-viva);
    background: rgba(68, 114, 247, 0.08);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.74rem; color: var(--gelo-60);
  }
  .pisca {
    width: 7px; height: 7px; border-radius: 50%; flex: none;
    background: #37e08a; box-shadow: 0 0 10px 1px #37e08a;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pisca { animation: respira 2.4s ease-in-out infinite; }
  }
  @keyframes respira { 50% { opacity: 0.35; box-shadow: 0 0 4px 0 #37e08a; } }

  h1 .linha { display: block; }
  h1 em { font-style: normal; color: var(--roxo-luz); }
  .heroi .lead { margin-top: 1.6rem; font-size: 1.1rem; max-width: 48ch; }
  .acoes { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.2rem; }

  .nums {
    margin: 3.2rem 0 0; padding-top: 1.8rem;
    border-top: 1px solid var(--borda);
    display: grid; gap: 1.4rem 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr));
  }
  .nums dt {
    font-size: clamp(1.9rem, 3.4vw, 2.5rem); font-weight: 800; letter-spacing: -0.04em;
    line-height: 1; font-variant-numeric: tabular-nums;
    color: var(--gelo);
  }
  .nums dd {
    margin: 0.5rem 0 0; font-size: 0.82rem; color: var(--gelo-40);
    max-width: 20ch; line-height: 1.5;
  }

  .rola {
    position: absolute; z-index: 2; left: 50%; bottom: 1.2rem; translate: -50% 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--gelo-40);
  }
  .rola::after {
    content: ''; display: block; width: 1px; height: 2rem; margin: 0.55rem auto 0;
    background: linear-gradient(var(--roxo-luz), transparent);
  }

  /* ---------- serviços ---------- */
  .servicos { background: var(--noite-2); border-bottom: 1px solid var(--borda); }
  /*
    Quatro colunas fixas a partir de 1180 px. `auto-fit` resolvia pela largura
    e não pela contagem: com quatro cartões dava 3+1, e o último ficava órfão
    na fileira de baixo. Abaixo disso vai para 2+2, e no celular empilha.

    Sem `align-items: start`: os quatro esticam até a mesma altura e o
    `flex: 1` da lista empurra prazo e botão para a mesma linha de base.
  */
  .grade-serv {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: clamp(0.9rem, 1.6vw, 1.3rem);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .grade-serv { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1180px) { .grade-serv { grid-template-columns: repeat(4, 1fr); } }
  .serv, .proj {
    position: relative; overflow: hidden;
    display: flex; flex-direction: column;
    background: var(--carta); border: 1px solid var(--borda);
    border-radius: var(--raio-g); padding: clamp(1.2rem, 1.9vw, 1.6rem);
    transition: border-color var(--t) var(--e), box-shadow var(--t) var(--e),
      background var(--t) var(--e);
  }
  .serv:hover, .proj:hover { border-color: var(--borda-viva); box-shadow: var(--brilho); }
  /* fio luminoso no topo do card, mais forte no destaque */
  .serv::before, .proj::before {
    content: ''; position: absolute; inset: 0 0 auto; height: 1px;
    background: linear-gradient(90deg, transparent, var(--anil-luz), var(--roxo-luz), transparent);
    opacity: 0.35; transition: opacity var(--t) var(--e);
  }
  .serv:hover::before, .proj:hover::before { opacity: 1; }
  .serv-d { border-color: var(--borda-viva); background: #171b33; }
  .serv-d::before { opacity: 1; }

  /*
    O brilho que segue o ponteiro. Era um radial-gradient reposicionado por
    `--mx/--my` no card — e custom property herdada invalida o estilo da
    subárvore inteira a cada movimento do mouse, com ~40 nós por card. Agora
    é um disco de tamanho fixo que só anda de `transform`: o compositor
    resolve sozinho e o recálculo de estilo some.
  */
  .serv-luz {
    position: absolute; left: 0; top: 0;
    width: 32rem; height: 32rem; margin: -16rem 0 0 -16rem;
    border-radius: 50%; pointer-events: none; opacity: 0;
    background: radial-gradient(closest-side, rgba(162, 89, 247, 0.18), transparent);
    transition: opacity 0.45s var(--e);
  }
  .serv:hover .serv-luz, .proj:hover .serv-luz { will-change: transform; }

  /* ---------- formas dentro do card ---------- */
  .serv-formas { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  /*
    O conteúdo em fluxo passa a ser posicionado para pintar por cima das
    formas. Lista explícita de propósito: um `:not()` genérico ganharia do
    `position: absolute` do selo por especificidade e o esparramaria.
  */
  .serv > h3, .serv > p, .serv > ul, .serv > i, .serv > a { position: relative; }
  .sf {
    position: absolute; overflow: visible;
    fill: none; stroke: var(--borda-viva); stroke-width: 1;
    opacity: 0.42;
  }
  .sf use[href='#s-malha'] { fill: var(--borda-viva); stroke: none; }
  .serv-d .sf { stroke: rgba(162, 89, 247, 0.42); opacity: 0.75; }
  .serv-d .sf use[href='#s-malha'] { fill: rgba(162, 89, 247, 0.42); }

  @media (prefers-reduced-motion: no-preference) {
    .sf-m0 { animation: sf-sobe var(--d, 8s) ease-in-out infinite; }
    .sf-m1 { animation: sf-desce var(--d, 9s) ease-in-out infinite; }
    .sf-m2 { animation: sf-deriva var(--d, 12s) ease-in-out infinite; }
  }
  /* sobe e desce de verdade no card em destaque; deriva de leve nos outros */
  @keyframes sf-sobe {
    0%, 100% { transform: translateY(14px); }
    50%      { transform: translateY(-16px); }
  }
  @keyframes sf-desce {
    0%, 100% { transform: translateY(-13px); }
    50%      { transform: translateY(15px); }
  }
  @keyframes sf-deriva {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    33%      { transform: translate(4px, -7px) rotate(7deg); }
    66%      { transform: translate(-4px, 6px) rotate(-6deg); }
  }
  .serv:hover .serv-luz, .proj:hover .serv-luz { opacity: 1; }

  .serv-selo {
    position: absolute; right: 1rem; top: 1rem;
    padding: 0.22rem 0.6rem; border-radius: 999px;
    background: var(--roxo);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
  }
  .serv-i {
    width: 2.5rem; height: 2.5rem; display: grid; place-items: center;
    border-radius: 11px; margin-bottom: 1rem; font-size: 1rem;
    color: var(--anil-luz);
    background: rgba(68, 114, 247, 0.1);
    border: 1px solid var(--borda-viva);
  }
  .serv-d .serv-i { color: var(--roxo-luz); background: rgba(162, 89, 247, 0.12); }
  .serv-sub { margin-top: 0.3rem; font-size: 0.85rem; color: var(--gelo-40); }
  .serv-preco {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem;
    margin: 1.3rem 0 0; padding: 1rem 0; border-block: 1px solid var(--borda);
  }
  .serv-preco small {
    width: 100%; font-family: 'JetBrains Mono', monospace;
    font-size: 0.64rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gelo-40);
  }
  .serv-preco b { font-size: clamp(1.6rem, 2.4vw, 1.95rem); font-weight: 800; letter-spacing: -0.04em; }
  .serv-d .serv-preco b { color: var(--roxo-luz); }
  /*
    A unidade ocupa a linha inteira de propósito. Deixando-a fluir, "por hora ·
    pacotes de 10 h" cabia ao lado do valor e "escopo fechado, por módulo" não
    — e o bloco de preço saía com duas ou três linhas conforme o card.
  */
  .serv-preco span { width: 100%; font-size: 0.76rem; color: var(--gelo-40); }
  /*
    A linha do adicional existe em todo card, com texto ou vazia: é o que faz
    o parágrafo seguinte começar na mesma altura nos quatro.
  */
  .serv-extra {
    min-height: 1lh; margin-top: 0.9rem;
    font-size: 0.87rem; font-weight: 600; color: var(--gelo);
  }

  .serv-txt { margin-top: 1rem; font-size: 0.87rem; color: var(--gelo-60); }
  .serv-itens { list-style: none; margin: 1.2rem 0 0; padding: 0; display: grid; gap: 0.55rem; flex: 1; }
  .serv-itens li {
    display: grid; grid-template-columns: 0.95rem 1fr; gap: 0.5rem;
    font-size: 0.83rem; color: var(--gelo-60); line-height: 1.42;
  }
  .serv-itens i { color: var(--ciano); font-size: 0.68rem; margin-top: 0.35rem; }
  /*
    O "fora daqui" é um aviso, não mais um parágrafo: caixa própria em vermelho
    apagado, tipografia menor que a da lista e rótulo em mono. Vermelho porque
    é a única coisa do card que diz "não" — some no meio do roxo se não destoar.
  */
  .serv-fora {
    --aviso: #ff7a8a;
    margin-top: 1rem; padding: 0.7rem 0.85rem;
    display: grid; grid-template-columns: 0.95rem 1fr; gap: 0.2rem 0.55rem;
    border: 1px solid rgba(255, 122, 138, 0.26); border-radius: 13px;
    background: rgba(255, 122, 138, 0.07);
  }
  .serv-fora i { grid-area: 1 / 1; margin-top: 0.15rem; font-size: 0.78rem; color: var(--aviso); }
  .serv-fora b {
    grid-area: 1 / 2;
    font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--aviso);
  }
  .serv-fora span {
    grid-area: 2 / 2;
    font-size: 0.74rem; line-height: 1.5; color: var(--gelo-60);
  }

  .serv-prazo {
    display: flex; align-items: center; gap: 0.45rem;
    margin: 1.3rem 0 1.1rem;
    font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; color: var(--gelo-40);
  }
  .nota-preco {
    margin-top: 1.6rem; font-size: 0.82rem; color: var(--gelo-40); text-align: center;
  }

  /* ---------- projetos ---------- */
  .projetos { background: var(--noite); }

  /*
    Galeria de projetos. Encaixe, rolagem suave e arrasto por toque são do
    CSS — `scroll-snap-type` faz o trabalho que antes era uma esteira animada
    à mão. Sem JS ela continua sendo uma fila que rola de lado, que é o
    comportamento certo.

    O cartão mede menos que a fila de propósito: a beirada do próximo
    aparecendo é o que avisa, principalmente no celular, que há mais de lado.
  */
  .galeria { --vao: clamp(0.9rem, 2.4vw, 1.5rem); position: relative; z-index: 2; }
  .galeria-fila {
    list-style: none; margin: 0; padding: 0.5rem 0 0.9rem;
    display: flex; gap: var(--vao);
    overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory; scroll-behavior: smooth;
  }
  .proj { flex: 0 0 min(76vw, 21rem); scroll-snap-align: start; }
  @media (min-width: 700px) { .proj { flex-basis: clamp(17rem, 26vw, 21rem); } }

  /* leme: setas e pontos */
  .galeria-leme {
    display: flex; align-items: center; justify-content: center; gap: 1rem;
    margin-top: 1.4rem;
  }
  .gal-seta {
    display: none; place-items: center; flex: none;
    width: 2.75rem; height: 2.75rem; border-radius: 50%;
    background: rgba(234, 238, 252, 0.04); border: 1px solid var(--borda-viva);
    color: var(--gelo-60); font-size: 0.85rem; cursor: pointer;
    transition: color var(--t) var(--e), border-color var(--t) var(--e),
      background var(--t) var(--e), opacity var(--t) var(--e);
  }
  @media (min-width: 700px) { .gal-seta { display: grid; } }
  .gal-seta:hover:not(:disabled) { color: var(--gelo); border-color: var(--roxo-luz); background: rgba(162, 89, 247, 0.1); }
  .gal-seta:disabled { opacity: 0.3; cursor: default; }

  /*
    Um ponto por projeto não escala: com catorze eles não cabem na largura do
    celular e nenhum vira alvo de dedo. O polegar é a barra de rolagem da fila
    — largura proporcional ao que cabe na tela, posição proporcional ao que já
    passou — e serve para qualquer quantidade de cartões.
  */
  .gal-trilho {
    flex: 1; max-width: 20rem; height: 3px; border-radius: 999px;
    background: var(--borda-viva); overflow: hidden;
  }
  .gal-polegar {
    display: block; width: 100%; height: 100%; border-radius: 999px;
    background: var(--roxo-luz); transform-origin: 0 50%;
  }
  .gal-conta {
    display: flex; align-items: baseline; gap: 0.35rem; flex: none;
    font-family: 'JetBrains Mono', monospace; font-size: 0.7rem;
    letter-spacing: 0.08em; color: var(--gelo-40);
  }
  .gal-conta b { font-size: 0.95rem; color: var(--gelo); }

  .trilha-pe { margin-top: 1.6rem; text-align: center; }

  .proj-cab { display: flex; align-items: center; justify-content: space-between; gap: 0.8rem; margin-bottom: 1.1rem; }
  .proj-tipo {
    padding: 0.24rem 0.65rem; border-radius: 999px;
    border: 1px solid var(--borda-viva); background: rgba(68, 114, 247, 0.09);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gelo-60);
  }
  .proj-estrela {
    display: inline-flex; align-items: center; gap: 0.3rem;
    font-family: 'JetBrains Mono', monospace; font-size: 0.74rem; color: #f5c451;
  }
  .proj h3 { font-size: 1.1rem; word-break: break-word; }
  .cerquilha { color: var(--roxo-luz); font-weight: 800; }
  .proj-d { margin-top: 0.7rem; font-size: 0.87rem; color: var(--gelo-60); flex: 1; }
  .proj-pe {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 1rem;
    margin-top: 1.2rem; padding-top: 1rem; border-top: 1px solid var(--borda);
    font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; color: var(--gelo-40);
  }
  .proj-lang { display: inline-flex; align-items: center; gap: 0.4rem; }
  .proj-lang i, .stack-lang i {
    width: 8px; height: 8px; border-radius: 50%; flex: none;
    background: var(--cor, #8b93b5); box-shadow: 0 0 8px -1px var(--cor, #8b93b5);
  }
  .proj-links { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.1rem; }
  .proj-links a {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.5rem 0.85rem; border-radius: 999px;
    font-size: 0.79rem; font-weight: 600; text-decoration: none;
    color: var(--gelo-60); border: 1px solid var(--borda);
    transition: color var(--t) var(--e), border-color var(--t) var(--e), background var(--t) var(--e);
  }
  .proj-links a:hover {
    color: #fff; border-color: var(--roxo-luz);
    background: rgba(162, 89, 247, 0.16);
    box-shadow: 0 0 0 1px rgba(162, 89, 247, 0.45), 0 0 18px -2px rgba(162, 89, 247, 0.55);
  }
  /* "Ver no ar" é a ação principal do card: nasce preenchido, não vazado */
  .proj-vivo {
    color: var(--noite) !important; font-weight: 700;
    background: var(--ciano) !important;
    border-color: transparent !important;
    box-shadow: 0 6px 18px -10px rgba(53, 214, 240, 0.9);
  }
  .proj-vivo:hover {
    color: var(--noite) !important;
    background: #63e0f5 !important;
    box-shadow: 0 0 0 1px rgba(53, 214, 240, 0.7), 0 0 24px -2px rgba(53, 214, 240, 0.8) !important;
  }
  .proj-vivo i { color: var(--noite); }

  /* ---------- demos ---------- */
  .demos { background: var(--noite-3); border-block: 1px solid var(--borda); }
  .grade-demos {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: clamp(0.8rem, 1.6vw, 1.1rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  }
  .demo a {
    position: relative; overflow: hidden;
    display: grid; gap: 0.35rem; height: 100%;
    padding: 1.5rem 3.2rem 1.5rem 1.5rem;
    border-radius: var(--raio-g); text-decoration: none;
    background: var(--carta); border: 1px solid var(--borda);
    transition: border-color var(--t) var(--e), background var(--t) var(--e), box-shadow var(--t) var(--e);
  }
  .demo a:hover { border-color: var(--borda-viva); box-shadow: var(--brilho); }
  .demo-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.64rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--anil-luz);
  }
  .demo-nome { font-size: 1.22rem; font-weight: 700; letter-spacing: -0.02em; color: var(--gelo); }
  .demo-nota { font-size: 0.84rem; color: var(--gelo-40); }
  .demo-seta {
    position: absolute; right: 1.3rem; top: 50%; translate: 0 -50%;
    color: var(--gelo-40); transition: color var(--t) var(--e), translate var(--t) var(--e);
  }
  .demo a:hover .demo-seta { color: var(--roxo-luz); translate: 4px -50%; }
  .demo-wip { opacity: 0.55; }
  .demo-wip .demo-nota { color: #c78a3f; }

  /* ---------- processo: a seção que inverte o contraste ---------- */
  .caminho {
    position: relative; z-index: 2;
    background: var(--clara); color: var(--escuro);
  }
  /* fundo claro: a grade tem que ser azul escuro para aparecer */
  .caminho { --g-fina: rgba(30, 43, 107, 0.05); --g-forte: rgba(30, 43, 107, 0.095); }
  .caminho .caixa { position: relative; z-index: 2; }
  .caminho h2, .caminho h3 { color: var(--escuro); }
  .caminho .lead { color: var(--escuro-60); }
  /* ---------- o caminho: mapa astral preso ao topo ---------- */

  /*
    Estado base — e o que vê quem está sem JS, com movimento reduzido ou no
    celular: cinco cartas empilhadas. O céu, os fios e as estrelas só existem
    no modo `.presa`.
  */
  .caminho-caixa { padding-top: clamp(3.6rem, 7.5vw, 6rem); }
  .caminho-miolo { padding-bottom: clamp(3.6rem, 7.5vw, 6rem); }
  .ceu { max-width: 1200px; margin: 1.4rem auto 0; padding-inline: clamp(1rem, 4vw, 2.6rem); }
  .ceu-svg, .ceu-poeira, .astro { display: none; }
  .ceu-camera { display: grid; gap: 1rem; }
  .carta {
    background: #fff; border: 1px solid #d5dcee; border-radius: var(--raio-g);
    padding: clamp(1.4rem, 3vw, 2.1rem);
    box-shadow: 0 1px 2px rgba(11, 14, 28, 0.04), 0 18px 40px -26px rgba(30, 43, 107, 0.35);
  }
  .carta-cab { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 0.9rem; }
  .cam-n {
    font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; font-weight: 700;
    letter-spacing: 0.1em; color: #6b21d6;
  }
  .carta-i { font-size: 1.05rem; color: #2743b8; }
  .cam-marco {
    margin-left: auto; padding: 0.24rem 0.7rem; border-radius: 999px;
    background: #eef1f9; border: 1px solid #d5dcee;
    font-family: 'JetBrains Mono', monospace; font-size: 0.64rem;
    letter-spacing: 0.08em; color: #4a5273; white-space: nowrap;
  }
  .carta h3 { font-size: clamp(1.2rem, 2.2vw, 1.6rem); color: var(--escuro); margin-bottom: 0.6rem; }
  .carta p { font-size: clamp(0.9rem, 1.4vw, 1rem); color: var(--escuro-60); max-width: 52ch; }

  /* contador da etapa */
  .cam-conta {
    display: flex; align-items: baseline; gap: 0.5rem; margin-bottom: 1.2rem;
    font-family: 'JetBrains Mono', monospace; font-size: 0.72rem;
    letter-spacing: 0.1em; color: #9aa2bd;
  }
  .cam-conta b { color: #6b21d6; font-size: 1.35rem; line-height: 1; }
  .cam-conta em {
    font-style: normal; margin-left: 0.4rem; padding-left: 0.9rem;
    border-left: 1px solid #d5dcee; color: #4a5273; letter-spacing: 0.06em;
  }

  /*
    O modo preso. A seção fica alta, o miolo gruda no topo e o scroll dela
    vira o traçado da constelação: uma tela de rolagem por etapa.
  */
  .caminho.presa { height: calc(var(--etapas, 5) * 82vh + 100svh); }
  .caminho.presa .caminho-miolo {
    position: sticky; top: 0; min-height: 100svh;
    display: grid; align-content: center;
  }
  .caminho.presa .cam-conta { margin-bottom: 0; }

  .caminho.presa .ceu {
    position: relative;
    max-width: none; width: 100%;
    height: clamp(21rem, 54vh, 32rem);
    margin: 1.2rem 0 0;
    padding-inline: clamp(1.4rem, 3vw, 3rem);
    perspective: 1400px;
  }
  .caminho.presa .ceu-camera { inset: 0 clamp(1.4rem, 3vw, 3rem); }
  .caminho.presa .ceu-camera {
    display: block; position: absolute; inset: 0;
    transform-style: preserve-3d;
  }

  .caminho.presa .ceu-svg,
  .caminho.presa .ceu-poeira { display: block; position: absolute; inset: 0; }
  .caminho.presa .ceu-svg { width: 100%; height: 100%; overflow: visible; }

  /*
    A intensidade de cada grão mora na transparência da cor, não no keyframe.
    Com `var()` dentro do @keyframes o Chrome não compõe a animação e recalcula
    estilo dos 26 grãos a cada quadro; com valores fixos o `opacity` vai para
    o compositor. O resultado na tela é o mesmo: alfa da cor × 0,25 a 1.
  */
  .ceu-poeira span {
    position: absolute; width: 3px; height: 3px; border-radius: 50%;
    background: rgb(107 33 214 / var(--o));
    animation: cintila var(--d) ease-in-out infinite alternate;
  }
  @keyframes cintila { from { opacity: 0.25; } to { opacity: 1; } }

  .ceu-trilhos path {
    fill: none; stroke: #b9c2dd; stroke-width: 1.1;
    stroke-dasharray: 2 7; stroke-linecap: round; opacity: 0.7;
  }
  .ceu-fios path {
    fill: none; stroke: url(#g-fio); stroke-width: 1.7;
    stroke-linecap: round; stroke-dasharray: 1;
    filter: drop-shadow(0 0 7px rgba(107, 33, 214, 0.4));
  }
  /*
    Os galhos até as satélites. `stroke-dashoffset` sai de 1 e vai a 0 numa
    transição de CSS, com atraso por índice: o desenho brota do nó para fora
    quando a etapa acende, e some sozinho na volta do scroll.
  */
  .ceu-galhos path {
    fill: none; stroke: #c2cade; stroke-width: 1; stroke-linecap: round;
    stroke-dasharray: 1; stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.55s var(--e) 0.1s, stroke 0.4s var(--e);
  }
  .ceu-galhos path.aceso { stroke-dashoffset: 0; stroke: rgba(107, 33, 214, 0.5); }

  .caminho.presa .mini {
    position: absolute; left: var(--x); top: var(--y);
    width: 5px; height: 5px; border-radius: 50%;
    background: #6b21d6; box-shadow: 0 0 8px rgba(107, 33, 214, 0.55);
    translate: -50% -50%; scale: 0.2; opacity: 0; z-index: 2;
    transition: scale 0.5s var(--e), opacity 0.35s linear;
    transition-delay: calc(var(--i) * 0.1s + 0.18s);
  }
  .caminho.presa .mini.aceso { scale: 1; opacity: 0.9; }
  .mini { display: none; }
  .caminho.presa .mini { display: block; }

  /*
    As estrelas. Cada uma é uma estação do mapa, com o número dentro do disco
    em vez de pendurado embaixo — e três estados que se leem de longe: a que
    falta (tracejada e apagada), a que já passou (cheia) e a da vez (cheia,
    maior, com halo pulsando e órbita girando).

    O anel de `box-shadow` da cor do fundo recorta o fio por baixo, então a
    estrela fica sobre a linha em vez de a linha atravessar a estrela.
  */
  .caminho.presa .astro {
    --r: 1.15rem;
    display: grid; place-items: center;
    position: absolute; left: var(--x); top: var(--y);
    translate: -50% -50%;
    width: calc(var(--r) * 2); height: calc(var(--r) * 2); padding: 0;
    background: none; border: 0; cursor: pointer; z-index: 3;
  }
  .astro-disco {
    grid-area: 1 / 1; display: grid; place-items: center;
    width: 100%; height: 100%; border-radius: 50%;
    background: var(--clara); border: 1px dashed #b3bdd8;
    box-shadow: 0 0 0 4px var(--clara);
    font-family: 'JetBrains Mono', monospace; font-size: 0.62rem;
    font-weight: 700; letter-spacing: 0.02em; color: #9aa2bd;
    transition: background var(--t) var(--e), border-color var(--t) var(--e),
                color var(--t) var(--e), scale var(--t) var(--e),
                box-shadow var(--t) var(--e);
  }
  .astro:hover .astro-disco { scale: 1.14; border-color: #6b21d6; color: #6b21d6; }

  .astro.aceso .astro-disco {
    background: #6b21d6;
    border-style: solid; border-color: transparent; color: #fff;
    box-shadow: 0 0 0 4px var(--clara), 0 8px 18px -8px rgba(39, 67, 184, 0.75);
  }
  .astro.ativo .astro-disco { scale: 1.16; }
  .astro.ativo:hover .astro-disco { scale: 1.24; }

  .astro-halo {
    grid-area: 1 / 1; width: 100%; height: 100%; border-radius: 50%;
    border: 1px solid rgba(107, 33, 214, 0.45); opacity: 0;
  }
  .astro.ativo .astro-halo { animation: pulsar 2.4s ease-out infinite; }
  @keyframes pulsar {
    0%   { scale: 1;   opacity: 0.7; }
    70%  { scale: 2.5; opacity: 0; }
    100% { scale: 2.5; opacity: 0; }
  }

  /*
    A chegada. A fagulha é uma estrela de quatro pontas em `clip-path`, a onda
    é um anel — os dois nascem apagados e só existem no instante em que o fio
    encosta na estrela; quem toca os dois é o Motion, uma vez por chegada.
  */
  .astro-fagulha {
    grid-area: 1 / 1; width: 420%; height: 420%; opacity: 0;
    background: radial-gradient(circle, rgba(162, 89, 247, 0.95), rgba(162, 89, 247, 0) 70%);
    clip-path: polygon(
      50% 0%, 57% 43%, 100% 50%, 57% 57%,
      50% 100%, 43% 57%, 0% 50%, 43% 43%
    );
    pointer-events: none;
  }
  .astro-onda {
    grid-area: 1 / 1; width: 100%; height: 100%; border-radius: 50%;
    border: 1.5px solid rgba(107, 33, 214, 0.7); opacity: 0; pointer-events: none;
  }

  .astro-orbita {
    grid-area: 1 / 1; width: 250%; height: 250%; border-radius: 50%;
    border: 1px dashed rgba(107, 33, 214, 0.4);
    opacity: 0; scale: 0.55;
    transition: opacity var(--t) var(--e), scale var(--t) var(--e);
  }
  .astro.ativo .astro-orbita {
    opacity: 1; scale: 1; animation: girar 18s linear infinite;
  }
  @keyframes girar { to { rotate: 360deg; } }

  /*
    A carta ancora na estrela e abre para o lado que sobra: `d` abre à direita,
    `e` à esquerda. O `translate` do CSS compõe antes do `transform` que o
    Motion escreve, então os dois convivem sem se atropelar.
  */
  .caminho.presa .carta {
    position: absolute; left: var(--x); top: var(--y);
    width: min(23rem, 29vw); opacity: 0; pointer-events: none; z-index: 4;
    will-change: transform, opacity, filter;
  }
  .caminho.presa .carta[data-lado='d'] {
    translate: var(--fol) -50%; transform-origin: left center;
  }
  .caminho.presa .carta[data-lado='e'] {
    translate: calc(-100% - var(--fol)) -50%; transform-origin: right center;
  }
  .caminho.presa .carta.ativa { pointer-events: auto; z-index: 5; }
  /*
    O fiozinho que liga a carta de volta à estrela. Ele para na borda do disco,
    e não no centro: `--fol` é a folga do centro da estrela até a carta, menos
    o raio do disco sobra exatamente o vão entre os dois.
  */
  .caminho.presa .carta {
    --fol: 3.3rem; --r: 1.15rem;
  }
  .caminho.presa .carta::before {
    content: ''; position: absolute; top: 50%; height: 1px;
    width: calc(var(--fol) - var(--r));
    background: linear-gradient(90deg, #6b21d6, rgba(107, 33, 214, 0.15));
  }
  .caminho.presa .carta[data-lado='d']::before { right: 100%; }
  .caminho.presa .carta[data-lado='e']::before {
    left: 100%; background: linear-gradient(270deg, #6b21d6, rgba(107, 33, 214, 0.15));
  }

  .passos {
    list-style: none; margin: 0; padding: 0; counter-reset: p;
    display: grid; gap: clamp(1rem, 2vw, 1.4rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }
  .passos li {
    position: relative;
    background: #fff; border: 1px solid #d5dcee;
    border-radius: var(--raio-g); padding: 1.6rem 1.4rem;
    box-shadow: 0 1px 2px rgba(11, 14, 28, 0.04), 0 14px 32px -22px rgba(30, 43, 107, 0.3);
  }
  .passos li::before {
    content: ''; position: absolute; inset: 0 0 auto; height: 3px;
    border-radius: var(--raio-g) var(--raio-g) 0 0;
    background: linear-gradient(90deg, #2743b8, #6b21d6);
  }
  .passo-n {
    display: block; margin-bottom: 0.8rem;
    font-family: 'JetBrains Mono', monospace; font-size: 0.82rem; font-weight: 700;
    letter-spacing: 0.1em; color: #6b21d6;
  }
  .passos h3 { font-size: 1.1rem; margin-bottom: 0.45rem; }
  .passos p { font-size: 0.88rem; color: var(--escuro-60); }

  /* ---------- stack ---------- */
  .stack { background: var(--noite-2); border-bottom: 1px solid var(--borda); }
  .grade-stack {
    display: grid; gap: clamp(1rem, 2vw, 1.5rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
  }
  .stack-g {
    background: var(--carta); border: 1px solid var(--borda);
    border-radius: var(--raio-g); padding: 1.5rem 1.4rem;
  }
  .stack-g h3 {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--anil-luz); margin-bottom: 1.1rem;
  }
  .stack-g ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .stack-g li {
    padding: 0.4rem 0.8rem; border-radius: 8px;
    background: rgba(234, 238, 252, 0.045); border: 1px solid var(--borda);
    font-size: 0.84rem; color: var(--gelo-60);
    transition: border-color var(--t) var(--e), color var(--t) var(--e);
  }
  .stack-g li:hover { border-color: var(--borda-viva); color: var(--gelo); }
  .stack-nota {
    margin-top: 1.6rem; font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem; color: var(--gelo-40);
  }
  .stack-lang { display: inline-flex; align-items: center; gap: 0.35rem; }

  /* ---------- contato ---------- */
  .contato { position: relative; overflow: hidden; background: var(--noite); }
  .contato-grade { display: grid; gap: clamp(2rem, 4vw, 3.5rem); align-items: start; }
  .contato-links { list-style: none; margin: 1.8rem 0 0; padding: 0; display: grid; gap: 0.7rem; }
  .contato-links a {
    display: inline-flex; align-items: center; gap: 0.6rem;
    color: var(--gelo); text-decoration: none; font-size: 0.93rem; font-weight: 500;
    transition: color var(--t) var(--e);
  }
  .contato-links i { color: var(--roxo-luz); width: 1.1rem; }
  .contato-links a:hover { color: var(--roxo-luz); }

  .form {
    display: grid; gap: 0.9rem;
    background: var(--carta); border: 1px solid var(--borda);
    border-radius: var(--raio-g); padding: clamp(1.2rem, 2.8vw, 1.9rem);
  }
  .form label {
    display: grid; gap: 0.35rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem; font-weight: 500; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--gelo-40);
  }
  .form-2 { display: grid; gap: 0.9rem; grid-template-columns: 1fr; }
  .form :is(input, select, textarea) {
    font-family: 'Sora', sans-serif; font-size: 0.93rem; font-weight: 400;
    letter-spacing: 0; text-transform: none; color: var(--gelo);
    background: var(--noite); border: 1px solid var(--borda); border-radius: 10px;
    padding: 0.68rem 0.8rem; width: 100%;
    transition: border-color var(--t) var(--e), box-shadow var(--t) var(--e);
  }
  .form :is(input, select, textarea):focus {
    outline: none; border-color: var(--roxo-luz);
    box-shadow: 0 0 0 3px rgba(162, 89, 247, 0.16);
  }
  .form textarea { resize: vertical; }
  .form option { background: var(--noite-3); color: var(--gelo); }
  .form-nota { font-family: 'JetBrains Mono', monospace; font-size: 0.68rem; color: var(--gelo-40); text-align: center; }

  /* ---------- topo ---------- */
  .topo {
    position: fixed; inset: 0 0 auto; z-index: 60;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 0.7rem clamp(1rem, 4vw, 2.6rem);
    background: rgba(7, 8, 15, 0.72);
    backdrop-filter: blur(16px) saturate(1.4);
    border-bottom: 1px solid var(--borda);
  }
  .topo-barra {
    position: absolute; inset: auto 0 -1px; height: 2px;
    background: var(--roxo-luz);
    transform: scaleX(0); transform-origin: 0 50%;
  }
  .marca { display: flex; align-items: center; gap: 0.7rem; text-decoration: none; color: var(--gelo); }
  .marca-sig {
    width: 2.4rem; height: 2.4rem; display: grid; place-items: center; flex: none;
    border-radius: 9px; font-family: 'JetBrains Mono', monospace;
    font-size: 0.92rem; font-weight: 700; color: #fff;
    background: var(--roxo);
    box-shadow: 0 6px 18px -8px rgba(91, 46, 196, 0.9);
  }
  .marca-txt { font-size: 1.12rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; }
  .marca-txt small {
    display: block; font-family: 'JetBrains Mono', monospace; font-weight: 400;
    font-size: 0.68rem; letter-spacing: 0.13em; text-transform: uppercase;
    color: var(--gelo-60); margin-top: 0.3rem;
  }
  .topo-nav { display: none; gap: 1.5rem; }
  .topo-nav a {
    position: relative; font-size: 0.89rem; font-weight: 500;
    color: var(--gelo-60); text-decoration: none;
    transition: color var(--t) var(--e);
  }
  .topo-nav a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -5px; height: 1px;
    background: var(--roxo-luz);
    transform: scaleX(0); transform-origin: 0 50%;
    transition: transform var(--t) var(--e);
  }
  .topo-nav a:hover { color: var(--gelo); }
  .topo-nav a:hover::after { transform: scaleX(1); }

  /* ---------- menu do celular ---------- */
  .topo-botao {
    display: grid; place-items: center; flex: none;
    width: 2.75rem; height: 2.75rem; padding: 0;
    border-radius: 12px; border: 1px solid var(--borda-viva);
    background: rgba(234, 238, 252, 0.04); cursor: pointer;
  }
  @media (min-width: 920px) { .topo-botao { display: none; } }
  /*
    Três riscos empilhados na mesma célula do grid: os de fora são pseudos do
    botão, o do meio é o span. Ficam no botão, e não todos no span, porque
    `opacity` desce para os pseudo-elementos do próprio elemento — apagar o
    risco do meio apagaria os outros dois junto.
  */
  .topo-botao::before, .topo-botao::after, .topo-risco {
    grid-area: 1 / 1;
    width: 1.05rem; height: 1.5px; border-radius: 2px; background: var(--gelo);
    transition: transform var(--t) var(--e), opacity 0.2s linear;
  }
  .topo-botao::before { content: ''; transform: translateY(-6px); }
  .topo-botao::after { content: ''; transform: translateY(6px); }
  .topo-botao[aria-expanded='true']::before { transform: rotate(45deg); }
  .topo-botao[aria-expanded='true']::after { transform: rotate(-45deg); }
  .topo-botao[aria-expanded='true'] .topo-risco { opacity: 0; }

  .menu {
    position: fixed; inset: var(--topo-h) 0 auto; z-index: 59;
    display: grid; padding: 0.5rem clamp(1rem, 4vw, 2.6rem) 1.1rem;
    background: rgba(10, 12, 23, 0.97);
    backdrop-filter: blur(18px) saturate(1.4);
    border-bottom: 1px solid var(--borda);
    transform: translateY(-104%);
    transition: transform 0.42s var(--e), visibility 0.42s;
    visibility: hidden;
  }
  .menu.aberto { transform: translateY(0); visibility: visible; }
  @media (min-width: 920px) { .menu, .menu-fundo, .topo-botao { display: none; } }
  .menu a {
    display: flex; align-items: center; gap: 0.6rem;
    padding: 0.95rem 0.2rem; min-height: 3rem;
    font-size: 1rem; font-weight: 600; color: var(--gelo); text-decoration: none;
    border-bottom: 1px solid var(--borda);
  }
  .menu a:last-child { border-bottom: 0; }
  .menu-zap { color: var(--ciano) !important; }
  .menu-fundo { position: fixed; inset: 0; z-index: 58; background: rgba(7, 8, 15, 0.6); }

  /*
    Alvo de dedo. Medido no celular, os links do rodapé tinham 18px de altura e
    os dos cartões 38px — abaixo dos 44 que se acerta sem mirar. O espaço extra
    é padding, então o texto continua onde estava.
  */
  @media (max-width: 919px) {
    /* inline-block porque padding em elemento inline pinta mas não reserva
       espaço — os alvos ficariam sobrepostos em vez de maiores */
    .rodape-grade li a, .contato-links li a { display: inline-flex; padding-block: 0.6rem; }
    .rodape-grade ul, .contato-links { margin-block: -0.6rem; }
    .proj-links a { padding-block: 0.72rem; }
    /* o CTA do topo perdeu o rótulo aqui e encolheu junto: volta a ser alvo */
    .topo-cta { min-height: 2.75rem; min-width: 2.75rem; }
    .marca { padding-block: 0.3rem; }
  }

  .visualmente-oculto {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip-path: inset(50%); white-space: nowrap;
  }

  /* no celular o rótulo do CTA sai e sobra o ícone: dois botões e a marca não
     cabem lado a lado em 390px sem espremer o nome */
  @media (max-width: 479px) {
    .topo-cta span { display: none; }
    .topo-cta { padding-inline: 0.85rem; }
    .marca-txt small { display: none; }
  }

  .pf section[id] { scroll-margin-top: calc(var(--topo-h) + 0.8rem); }

  /* ---------- rodapé ---------- */
  .rodape { background: var(--noite-2); border-top: 1px solid var(--borda); color: var(--gelo-60); }
  .rodape-grade {
    display: grid; gap: 2.4rem;
    padding-block: clamp(2.6rem, 6vw, 4rem) 1.6rem;
  }
  .rodape-marca { font-size: 1.15rem; font-weight: 700; letter-spacing: -0.02em; color: var(--gelo); }
  .rodape-marca small {
    display: block; font-family: 'JetBrains Mono', monospace; font-weight: 400;
    font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--gelo-40); margin-top: 0.45rem;
  }
  .rodape-d { margin-top: 1rem; font-size: 0.86rem; color: var(--gelo-40); max-width: 40ch; }
  .rodape-t {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.66rem; font-weight: 500; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--gelo); margin-bottom: 1rem;
  }
  .rodape ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  .rodape a { color: var(--gelo-60); text-decoration: none; font-size: 0.88rem; transition: color var(--t) var(--e); }
  .rodape a:hover { color: var(--roxo-luz); }
  .rodape-fim {
    display: flex; flex-wrap: wrap; gap: 0.8rem; justify-content: space-between;
    padding-block: 1.2rem 1.7rem; border-top: 1px solid var(--borda);
    font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; color: var(--gelo-40);
  }

  .pf :focus-visible { outline: 2px solid var(--roxo-luz); outline-offset: 3px; border-radius: 8px; }
  .caminho :focus-visible { outline-color: #6b21d6; }

  /* o que o Motion revela nasce escondido — só com JS e com vontade de movimento */
  :global(.anima-on) .pf [data-anima],
  :global(.anima-on) .pf [data-serv],
  :global(.anima-on) .pf [data-linha] { opacity: 0; }

  /* ---------- do tablet para cima ---------- */
  @media (min-width: 700px) {
    .form-2 { grid-template-columns: 1fr 1fr; }
    .rodape-grade { grid-template-columns: 1.4fr 1fr 1fr; }
  }
  @media (min-width: 920px) {
    .pf { --topo-h: 4.4rem; }
    .topo-nav { display: flex; }
    .contato-grade { grid-template-columns: 1fr 1.05fr; }
  }

  /* ---------- movimento reduzido ---------- */
  @media (prefers-reduced-motion: reduce) {
    .pf * {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
    .galeria-fila { scroll-behavior: auto; }
  }
</style>

<script>
  /*
    Movimento pelo Motion One. Regra de sempre: conteúdo antes de efeito — se
    o import falhar, o `catch` devolve tudo visível.
  */
  const reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const SAIDA = [0.22, 0.61, 0.36, 1] as const;
  const raiz = document.documentElement;

  /* ---------------- formulário ---------------- */

  /* clicar em "quero um orçamento" num card já escolhe o serviço no form */
  const alvo = document.querySelector<HTMLSelectElement>('[data-alvo]');
  document.querySelectorAll<HTMLAnchorElement>('[data-servico]').forEach((a) => {
    a.addEventListener('click', () => {
      if (alvo) alvo.value = a.dataset.servico!;
    });
  });

  /* site estático não tem para onde postar; o pedido vai pelo zap */
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  form?.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const d = new FormData(form);
    const v = (k: string) => String(d.get(k) ?? '').trim();
    const linhas = [
      'Olá, Igor! Vim pelo site.',
      '',
      `Preciso de: ${v('servico')}`,
      `Orçamento previsto: ${v('verba')}`,
      `Prazo: ${v('prazo')}`,
      '',
      `O problema: ${v('obs')}`,
      '',
      `Nome: ${v('nome')}`,
      `Contato: ${v('contato')}`,
    ];
    window.open(
      `https://wa.me/${form.dataset.zap}?text=${encodeURIComponent(linhas.join('\n'))}`,
      '_blank',
      'noopener',
    );
  });

  /* ---------------- luz que segue o ponteiro ---------------- */

  /* ponteiro fino só: no toque não existe hover, e o listener seria desperdício */
  if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('[data-brilho]').forEach((el) => {
      const luz = el.querySelector<HTMLElement>('.serv-luz');
      if (!luz) return;
      let px = 0;
      let py = 0;
      let agendado = false;
      /*
        A medida do card fica dentro do rAF, não no listener: assim é no
        máximo uma leitura de layout por quadro em vez de uma por evento de
        ponteiro — e continua correta com a página rolando sob o cursor.
      */
      const pintar = () => {
        agendado = false;
        const r = el.getBoundingClientRect();
        luz.style.transform = `translate3d(${px - r.left}px, ${py - r.top}px, 0)`;
      };
      el.addEventListener(
        'pointermove',
        (e) => {
          px = e.clientX;
          py = e.clientY;
          if (!agendado) {
            agendado = true;
            requestAnimationFrame(pintar);
          }
        },
        { passive: true },
      );
    });
  }

  /* ---------------- menu do celular ---------------- */

  const botaoMenu = document.querySelector<HTMLButtonElement>('[data-menu]');
  const painelMenu = document.querySelector<HTMLElement>('[data-menu-painel]');
  const fundoMenu = document.querySelector<HTMLElement>('[data-menu-fundo]');
  if (botaoMenu && painelMenu && fundoMenu) {
    const trocar = (abrir: boolean) => {
      botaoMenu.setAttribute('aria-expanded', String(abrir));
      botaoMenu.querySelector('.visualmente-oculto')!.textContent = abrir ? 'Fechar menu' : 'Abrir menu';
      painelMenu.classList.toggle('aberto', abrir);
      fundoMenu.hidden = !abrir;
      /* trava a rolagem atrás do painel, senão o dedo rola a página por baixo */
      document.body.style.overflow = abrir ? 'hidden' : '';
    };
    botaoMenu.addEventListener('click', () =>
      trocar(botaoMenu.getAttribute('aria-expanded') !== 'true'),
    );
    fundoMenu.addEventListener('click', () => trocar(false));
    painelMenu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) trocar(false);
    });
    addEventListener('keydown', (e) => e.key === 'Escape' && trocar(false));
  }

  /* ---------------- galeria de projetos ---------------- */

  /*
    Só as setas e os pontos moram aqui: o encaixe e o arrasto são do CSS. Isto
    fica fora do `ligarMovimento` de propósito — precisa funcionar com
    movimento reduzido e mesmo se o Motion não carregar.

    O índice sai de `scrollLeft` dividido pelo passo, e o passo é medido dos
    dois primeiros cartões: assim ele acompanha o `clamp()` da largura e o
    `gap`, sem repetir a conta no JS.
  */
  const galeria = document.querySelector<HTMLElement>('[data-galeria]');
  const fila = galeria?.querySelector<HTMLElement>('[data-fila]');
  if (galeria && fila) {
    const cartoes = [...fila.querySelectorAll<HTMLElement>('.proj')];
    const polegar = galeria.querySelector<HTMLElement>('[data-polegar]')!;
    const conta = galeria.querySelector<HTMLElement>('[data-gal-atual]')!;
    const setas = [...galeria.querySelectorAll<HTMLButtonElement>('[data-gal]')];
    const passo = () =>
      cartoes.length > 1 ? cartoes[1].offsetLeft - cartoes[0].offsetLeft : fila.clientWidth;

    let atual = -1;
    let agendado = false;
    const conferir = () => {
      agendado = false;
      const fim = fila.scrollWidth - fila.clientWidth;
      const i = Math.min(cartoes.length - 1, Math.round(fila.scrollLeft / passo()));
      setas[0].disabled = fila.scrollLeft < 4;
      setas[1].disabled = fila.scrollLeft > fim - 4;
      /* polegar de barra de rolagem: translate primeiro, escala depois — com a
         origem em 0 a escala não desloca o que o translate já posicionou */
      polegar.style.transform =
        `translateX(${(fila.scrollLeft / fila.scrollWidth) * 100}%)` +
        ` scaleX(${fila.clientWidth / fila.scrollWidth})`;
      if (i === atual) return;
      atual = i;
      conta.textContent = String(i + 1).padStart(2, '0');
    };
    conferir();
    fila.addEventListener(
      'scroll',
      () => {
        if (agendado) return;
        agendado = true;
        requestAnimationFrame(conferir);
      },
      { passive: true },
    );
    addEventListener('resize', conferir, { passive: true });

    setas.forEach((b) =>
      b.addEventListener('click', () => fila.scrollBy({ left: passo() * Number(b.dataset.gal) })),
    );
  }

  /* ---------------- movimento ---------------- */

  async function ligarMovimento() {
    if (reduz) return;
    const { animate, inView, scroll, stagger, press } = await import('motion');

    /* inView do Motion re-dispara a cada reentrada; revelação é estreia */
    const umaVez = (
      el: Element,
      efeito: () => void,
      opcoes?: Parameters<typeof inView>[2],
    ) => {
      let parar = () => {};
      parar = inView(el, () => { efeito(); parar(); }, opcoes);
    };

    /* 1. barra de progresso do topo */
    const barra = document.querySelector<HTMLElement>('[data-progresso]');
    if (barra) scroll(animate(barra, { scaleX: [0, 1] }, { ease: 'linear' }));

    /* 2. herói: as linhas do título sobem por baixo de uma máscara */
    animate(
      document.querySelectorAll('[data-linha]'),
      { opacity: [0, 1], y: [26, 0], filter: ['blur(8px)', 'blur(0px)'] },
      { duration: 0.8, delay: stagger(0.09), ease: SAIDA },
    );
    animate(
      document.querySelectorAll('.heroi [data-anima]'),
      { opacity: [0, 1], y: [16, 0] },
      { duration: 0.7, delay: stagger(0.09, { startDelay: 0.3 }), ease: SAIDA },
    );

    /* 3. revelação em cascata, agrupada por pai para o stagger correr entre irmãos */
    const grupos = new Map<Element, HTMLElement[]>();
    for (const el of document.querySelectorAll<HTMLElement>('[data-anima]')) {
      if (el.closest('.heroi')) continue;
      const pai = el.parentElement!;
      grupos.set(pai, [...(grupos.get(pai) ?? []), el]);
    }
    for (const irmaos of grupos.values()) {
      umaVez(
        irmaos[0],
        () =>
          animate(
            irmaos,
            { opacity: [0, 1], y: [22, 0] },
            { duration: 0.65, delay: stagger(0.075), ease: SAIDA },
          ),
        { amount: 0.12, margin: '0px 0px -8% 0px' },
      );
    }

    /*
      3b. OS CARDS DE PREÇO. Um sobe de cada vez: a mesma entrada curta em
      todos, e o `delay` por índice — 0,18 s, folgado o bastante para a
      sequência se ler — é o que faz um chegar depois do outro em vez de os
      quatro piscarem juntos. O preço conta a partir da subida do próprio
      card, e não do `inView`, senão o número chegaria no fim antes de o card
      aparecer.

      Cada card dispara sozinho: em quatro colunas o `delay` vira o
      escalonamento; numa coluna só, cada um espera a própria vez na tela.
    */
    document.querySelectorAll<HTMLElement>('[data-serv]').forEach((card, i) => {
      const atraso = i * 0.18;
      const preco = card.querySelector<HTMLElement>('[data-preco]');

      umaVez(
        card,
        () => {
          animate(
            card,
            { opacity: [0, 1], y: [30, 0] },
            { duration: 0.6, delay: atraso, ease: SAIDA },
          );
          if (preco) {
            const fim = Number(preco.dataset.preco);
            animate(0, fim, {
              duration: 0.9,
              delay: atraso + 0.15,
              ease: SAIDA,
              onUpdate: (n) =>
                (preco.textContent = `R$ ${Math.round(n).toLocaleString('pt-BR')}`),
            });
          }
        },
        { amount: 0.15, margin: '0px 0px -6% 0px' },
      );
    });

    /* 4. os números contam ao entrar na tela */
    document.querySelectorAll<HTMLElement>('[data-conta-ate]').forEach((el) => {
      const fim = Number(el.dataset.contaAte);
      const ano = el.dataset.ano === '1';
      /* ano não é contagem: 1.400 anos passando na tela não quer dizer nada */
      if (ano) return;
      umaVez(
        el,
        () =>
          animate(0, fim, {
            duration: 1.2,
            ease: SAIDA,
            onUpdate: (n) => (el.textContent = String(Math.round(n))),
          }),
        { amount: 0.8 },
      );
    });

    /* 5. as camadas de formas andam em velocidades diferentes: profundidade sem 3D */
    document.querySelectorAll<HTMLElement>('[data-campo]').forEach((el) => {
      const v = Number(el.dataset.campo) * 220;
      scroll(animate(el, { y: [-v, v] }, { ease: 'linear' }), {
        target: el.parentElement!,
        offset: ['start end', 'end start'],
      });
    });

    /*
      6a. O CAMINHO — o mapa astral. A seção prende no topo e o scroll dela
      vira o traçado da constelação. `scroll()` com offset start/start a
      end/end cobre exatamente o trecho em que o sticky está grudado, então
      p vai de 0 a 1 ao longo das cinco etapas.

      Cada etapa ocupa uma fatia igual de p. Dentro da fatia i: a carta i
      aparece e fica, e só nos últimos 55% da fatia o fio corre até a estrela
      seguinte. Assim o movimento tem cadência — lê, viaja, lê — em vez de
      trocar tudo de uma vez.

      A classe `.presa` só entra aqui, e só em tela larga: sem JS, com
      movimento reduzido ou no celular a seção continua sendo a lista
      empilhada do CSS base, que é legível e não depende de nada.
    */
    const caminho = document.querySelector<HTMLElement>('[data-caminho]');
    const cartas = caminho ? [...caminho.querySelectorAll<HTMLElement>('[data-carta]')] : [];
    if (caminho && cartas.length && matchMedia('(min-width: 900px)').matches) {
      const ceu = caminho.querySelector<HTMLElement>('[data-ceu]')!;
      const camera = caminho.querySelector<HTMLElement>('[data-camera]')!;
      const astros = [...caminho.querySelectorAll<HTMLElement>('[data-astro]')];
      const fios = [...caminho.querySelectorAll<SVGPathElement>('[data-fio]')];
      const conta = caminho.querySelector<HTMLElement>('[data-cam-atual]');
      const nome = caminho.querySelector<HTMLElement>('[data-cam-nome]');

      caminho.style.setProperty('--etapas', String(cartas.length));
      caminho.classList.add('presa');

      /*
        O traçado nasce aqui, em pixels: o viewBox acompanha o tamanho real do
        céu, então a espessura do traço sai uniforme e `pathLength="1"` volta a
        valer. Cada trecho é um arco — o ponto de controle é o meio do segmento
        empurrado na perpendicular — senão o mapa vira um zigue-zague de régua.
      */
      const svg = caminho.querySelector<SVGSVGElement>('[data-svg]')!;
      const trilhos = [...caminho.querySelectorAll<SVGPathElement>('[data-trilho]')];
      const galhos = [...caminho.querySelectorAll<SVGPathElement>('[data-galho]')];
      const minis = [...caminho.querySelectorAll<HTMLElement>('[data-mini]')];
      const poeira = caminho.querySelectorAll<HTMLElement>('.ceu-poeira span');

      /*
        Traços retos, como em carta celeste — arco é coisa de gráfico, não de
        constelação. O centro sai do próprio layout: com `left:X%` mais
        `translate:-50%`, `offsetLeft` já é o centro do ponto, e transform
        nenhum mexe nisso. Nada de recontar percentual à mão.
      */
      const centro = (el: HTMLElement) => ({ x: el.offsetLeft, y: el.offsetTop });
      const desenhar = () => {
        const r = svg.getBoundingClientRect();
        if (r.width < 1) return;
        svg.setAttribute('viewBox', `0 0 ${r.width} ${r.height}`);
        const p = astros.map(centro);
        fios.forEach((f, k) => {
          const d = `M ${p[k].x} ${p[k].y} L ${p[k + 1].x} ${p[k + 1].y}`;
          f.setAttribute('d', d);
          trilhos[k]?.setAttribute('d', d);
        });
        galhos.forEach((g, k) => {
          const a = p[Number(g.dataset.no)];
          const m = centro(minis[k]);
          g.setAttribute('d', `M ${a.x} ${a.y} L ${m.x} ${m.y}`);
        });
      };
      desenhar();
      addEventListener('resize', desenhar, { passive: true });

      /*
        Uma entrada diferente por etapa, de propósito: mola que floresce da
        estrela, corte de máscara, giro em 3D, sequência encadeada e queda
        com desfoque. Cada saída desfaz exatamente as propriedades que a
        entrada mexeu, senão sobra estilo inline velho na volta do scroll.
      */
      const ENTRA: ((c: HTMLElement, dir: number) => void)[] = [
        /* 01 — mola: a carta floresce do ponto da estrela */
        (c) =>
          animate(
            c,
            { opacity: [0, 1], scale: [0.5, 1], filter: ['blur(14px)', 'blur(0px)'] },
            {
              type: 'spring', bounce: 0.42, visualDuration: 0.55,
              opacity: { duration: 0.25, ease: 'easeOut' },
              filter: { duration: 0.5, ease: 'easeOut' },
            },
          ),
        /* 02 — máscara: a proposta é revelada como quem desenrola o papel */
        (c) =>
          animate(
            c,
            {
              opacity: [0, 1],
              clipPath: ['inset(0 100% 0 0 round 22px)', 'inset(0 0% 0 0 round 22px)'],
              x: [26, 0],
            },
            { duration: 0.75, ease: SAIDA, opacity: { duration: 0.15 } },
          ),
        /* 03 — giro em 3D: a carta vira para o leitor */
        (c) =>
          animate(
            c,
            { opacity: [0, 1], rotateY: [-58, 0], rotateX: [10, 0], scale: [0.88, 1] },
            { type: 'spring', bounce: 0.3, visualDuration: 0.7, opacity: { duration: 0.3 } },
          ),
        /* 04 — sequência: a carta sobe e o ícone entra girando logo atrás */
        (c) =>
          animate([
            [c, { opacity: [0, 1], y: [46, 0], skewY: [3.5, 0] },
              { type: 'spring', bounce: 0.34, visualDuration: 0.6, opacity: { duration: 0.25 } }],
            [c.querySelector('.carta-i') as Element, { scale: [0, 1], rotate: [-140, 0] },
              { type: 'spring', bounce: 0.6, visualDuration: 0.5, at: '-0.42' }],
          ]),
        /* 05 — pouso: entra grande e desfocada e assenta no lugar */
        (c) =>
          animate(
            c,
            { opacity: [0, 1], scale: [1.14, 1], y: [-34, 0], filter: ['blur(8px)', 'blur(0px)'] },
            {
              type: 'spring', bounce: 0.38, visualDuration: 0.62,
              opacity: { duration: 0.25 }, filter: { duration: 0.45, ease: 'easeOut' },
            },
          ),
      ];

      const SAI: ((c: HTMLElement, dir: number) => void)[] = [
        (c) => animate(c, { opacity: 0, scale: 0.75, filter: 'blur(12px)' }, { duration: 0.28, ease: 'easeIn' }),
        (c) => animate(c, { opacity: 0, clipPath: 'inset(0 0 0 100% round 22px)', x: -18 }, { duration: 0.34, ease: 'easeIn' }),
        (c) => animate(c, { opacity: 0, rotateY: 46, rotateX: -6, scale: 0.9 }, { duration: 0.3, ease: 'easeIn' }),
        (c, dir) => animate(c, { opacity: 0, y: -38 * dir, skewY: -2.5 }, { duration: 0.28, ease: 'easeIn' }),
        (c) => animate(c, { opacity: 0, scale: 1.1, y: 26, filter: 'blur(8px)' }, { duration: 0.28, ease: 'easeIn' }),
      ];

      /* o miolo da carta entra em cascata, e a origem da cascata muda por etapa */
      const ORIGEM = ['first', 'last', 'center', 'first', 'last'] as const;

      let atual = -1;
      const mostrar = (i: number) => {
        if (i === atual || !cartas[i]) return;
        const dir = i > atual ? 1 : -1;
        const antes = cartas[atual];
        const antesI = atual;
        atual = i;

        if (antes) {
          antes.classList.remove('ativa');
          antes.setAttribute('aria-hidden', 'true');
          SAI[antesI % SAI.length](antes, dir);
        }

        const c = cartas[i];
        c.classList.add('ativa');
        c.removeAttribute('aria-hidden');
        ENTRA[i % ENTRA.length](c, dir);
        animate(
          c.querySelectorAll('[data-cx]'),
          { opacity: [0, 1], y: [16, 0] },
          { duration: 0.5, delay: stagger(0.07, { startDelay: 0.14, from: ORIGEM[i % ORIGEM.length] }), ease: SAIDA },
        );

        /*
          A chegada na estrela. Três coisas ao mesmo tempo, cada uma com um
          tempo próprio: o disco dá um pulo, a fagulha de quatro pontas abre
          girando, e uma onda se expande a partir do ponto. Logo atrás, o céu
          inteiro cintila em cascata a partir do meio — é o instante que marca
          "cheguei numa etapa nova".
        */
        const estrela = astros[i];
        const disco = estrela?.querySelector('.astro-disco');
        if (disco) animate(disco, { scale: [1, 1.55, 1] }, { duration: 0.7, times: [0, 0.32, 1], ease: ['easeOut', 'easeInOut'] });
        if (estrela) {
          animate([
            [estrela.querySelector('.astro-fagulha') as Element,
              { opacity: [0, 1, 0], scale: [0.15, 1, 1.9], rotate: [0, 55, 130] },
              { duration: 1, times: [0, 0.26, 1], ease: 'easeOut' }],
            [estrela.querySelector('.astro-onda') as Element,
              { opacity: [0.85, 0], scale: [0.5, 3.2] },
              { duration: 0.85, ease: 'easeOut', at: '<0.05' }],
          ]);
        }
        /* a poeira só cintila em `scale`: o `opacity` dela já é animação de CSS */
        animate(
          poeira,
          { scale: [1, 2.4, 1] },
          { duration: 0.9, delay: stagger(0.012, { from: 'center' }), ease: 'easeOut' },
        );
        astros.forEach((a, n) => a.classList.toggle('ativo', n === i));

        /*
          Câmera: o céu desliza um sexto do caminho até centralizar a estrela
          da vez. Um sexto, e não tudo, para o mapa inteiro continuar dentro da
          tela — a graça é ver a constelação se montando, não perder o contexto.
        */
        const r = ceu.getBoundingClientRect();
        const ax = Number(astros[i].dataset.x);
        const ay = Number(astros[i].dataset.y);
        animate(
          camera,
          { x: ((50 - ax) / 100) * r.width * 0.16, y: ((50 - ay) / 100) * r.height * 0.16 },
          { type: 'spring', bounce: 0.16, visualDuration: 0.9 },
        );

        if (conta) conta.textContent = String(i + 1).padStart(2, '0');
        if (nome) {
          nome.textContent = c.querySelector('h3')?.textContent ?? '';
          animate(nome, { opacity: [0, 1], y: [8 * dir, 0] }, { duration: 0.35, ease: SAIDA });
        }
      };
      mostrar(0);

      scroll(
        (p: number) => {
          const n = cartas.length;
          const i = Math.min(n - 1, Math.floor(p * n * 0.999));
          const sub = Math.min(1, Math.max(0, p * n - i));
          /* o fio só corre nos últimos 55% da fatia: primeiro se lê, depois se viaja */
          const corre = Math.min(1, Math.max(0, (sub - 0.45) / 0.55));

          fios.forEach((f, k) => {
            const fr = k < i ? 1 : k === i ? corre : 0;
            f.style.strokeDashoffset = String(1 - fr);
          });
          /* a estrela seguinte acende quando o fio encosta nela */
          const alcance = corre > 0.985 ? i + 1 : i;
          astros.forEach((a, k) => a.classList.toggle('aceso', k <= alcance));
          minis.forEach((m) => m.classList.toggle('aceso', Number(m.dataset.no) <= alcance));
          galhos.forEach((g) => g.classList.toggle('aceso', Number(g.dataset.no) <= alcance));

          mostrar(i);
        },
        { target: caminho, offset: ['start start', 'end end'] },
      );

      /*
        Clicar numa estrela pula para a etapa dela. É a mesma conta do
        `scroll()` ao contrário: a fatia i começa em i/n do trecho grudado, e
        eu miro no meio da fatia para a carta já estar montada na chegada.
      */
      astros.forEach((a, i) => {
        press(a, (alvo) => {
          animate(alvo, { scale: 0.86 }, { type: 'spring', bounce: 0.4, visualDuration: 0.2 });
          return () => animate(alvo, { scale: 1 }, { type: 'spring', bounce: 0.5, visualDuration: 0.3 });
        });
        a.addEventListener('click', () => {
          const curso = caminho.offsetHeight - innerHeight;
          scrollTo({ top: caminho.offsetTop + ((i + 0.45) / cartas.length) * curso, behavior: 'smooth' });
        });
      });
    }


    /* 7. tato: tudo que se clica afunda um fio */
    press('.pf :is(.btn, .demo a, .proj-links a)', (el) => {
      animate(el, { scale: 0.97 }, { duration: 0.12 });
      return () => animate(el, { scale: 1 }, { type: 'spring', stiffness: 480, damping: 26 });
    });

    /* 8. o halo do herói respira junto com o scroll */
    document.querySelectorAll<HTMLElement>('.heroi .halo').forEach((h, i) => {
      scroll(animate(h, { opacity: [0.5, 0.14], scale: [1, 1.18 + i * 0.06] }, { ease: 'linear' }), {
        target: document.querySelector<HTMLElement>('.heroi')!,
        offset: ['start start', 'end start'],
      });
    });
  }

  const revelarTudo = () => raiz.classList.remove('anima-on');
  const socorro = setTimeout(revelarTudo, 3000);
  ligarMovimento()
    .catch(revelarTudo)
    .finally(() => clearTimeout(socorro));
  if (reduz) revelarTudo();
</script>
