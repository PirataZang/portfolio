  bottle: `<svg viewBox="0 0 60 140" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round" aria-hidden="true"><path d="M22.5 5.5A2.5 2.5 0 0 1 25 3H35A2.5 2.5 0 0 1 37.5 5.5V18H22.5Z"/><path d="M21.8 18H38.2V21.5H21.8Z"/><path d="M24.5 21.5H35.5C35.5 29 36 35 37 40C38.5 46.5 53 49 53 59V129C53 133 50.5 135.5 46.5 135.5H13.5C9.5 135.5 7 133 7 129V59C7 49 21.5 46.5 23 40C24 35 24.5 29 24.5 21.5Z"/><path d="M12 72C20 68 40 68 48 72V112C40 115.5 20 115.5 12 112Z"/><path transform="translate(23 84) scale(.58)" fill="currentColor" stroke="none" fill-rule="evenodd" d="${SKULL}"/></svg>`,
  glass: `<svg viewBox="0 0 60 70" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" aria-hidden="true"><path d="M15.2 50H44.8L46 58C45.8 61 44 62.5 41 62.5H19C16 62.5 14.2 61 14 58Z" fill="currentColor" fill-opacity=".2" stroke="none"/><path d="M14.3 22C24 24.2 36 24.2 45.7 22L43.4 50H16.6Z" fill="currentColor" fill-opacity=".4" stroke="none"/><path d="M10 8H50L46 58C45.8 61 44 62.5 41 62.5H19C16 62.5 14.2 61 14 58Z"/><path d="M10 8C20 10.6 40 10.6 50 8" stroke-opacity=".7"/><path d="M19 16L20.8 44" stroke-opacity=".7"/></svg>`,
  balance: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5.2V20"/><path d="M7.5 20.5H16.5"/><path d="M4.2 7.3L19.8 3.1"/><circle cx="12" cy="5.2" r="1.2" fill="currentColor"/><path d="M4.2 7.3L1.9 13M4.2 7.3L6.5 13"/><path d="M1.4 13H7A2.8 2.8 0 0 1 1.4 13Z" fill="currentColor"/><path d="M2.9 12.6L3.3 10.2H5.1L5.5 12.6Z" fill="currentColor"/><path d="M19.8 3.1L17.5 8.8M19.8 3.1L22.1 8.8"/><path d="M17 8.8H22.6A2.8 2.8 0 0 1 17 8.8Z"/></svg>`,
  spiral: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M12 12a1 1 0 0 1 2 0a2 2 0 0 1 -4 0a3 3 0 0 1 6 0a4 4 0 0 1 -8 0a5 5 0 0 1 10 0a6 6 0 0 1 -12 0"/></svg>`,
  skullq: `<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M12 1.8C15.9 1.8 18.6 4.4 18.6 7.9C18.6 11.4 15.9 13.4 12 13.4C8.1 13.4 5.4 11.4 5.4 7.9C5.4 4.4 8.1 1.8 12 1.8ZM8.1 8.2a1.7 1.7 0 1 0 3.4 0a1.7 1.7 0 1 0 -3.4 0ZM12.5 8.2a1.7 1.7 0 1 0 3.4 0a1.7 1.7 0 1 0 -3.4 0ZM12 10.4L12.8 11.9H11.2Z"/><path fill="currentColor" d="M7.6 12.2H11.6V14.6H10.7V13.6H9.6V14.6H8.6V13.6H7.6Z"/><path d="M16.2 11.6C15.6 14 12.4 14.3 12.4 16.6V17.4" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/><circle cx="12.4" cy="21" r="1.7" fill="currentColor"/></svg>`,
  fork: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21.5V13.5"/><path d="M12 13.5C12 10.5 9.5 9 6.5 6.5"/><path d="M12 13.5C12 10.5 14.5 9 17.5 6.5"/><path d="M6 10.4L5.8 5.8L10.4 6"/><path d="M18 10.4L18.2 5.8L13.6 6"/></svg>`,
};
const GAMES = [
  { id: 'dare', name: 'Desafio', one: 'Responde ou bebe', c: '#0D0D10', ink: '#F1EFF6', tint: '#F1EFF6', glow: '#5d5873', icon: 'bottle', bgw: '50%',
    how: 'Alguém lê a carta e responde. Quem não quiser, bebe. Depois vem o “Para todos”: a roda inteira responde, e quem fugir bebe 1 (quem leu a carta bebe 2).',
    cards: [['Qual foi a pior cantada que você já levou?', 'Mande agora a sua pior cantada para alguém da roda.'], ['Qual é a fantasia que dá para contar em voz alta?', 'Qual personagem de filme ou série você acha mais sexy?'], ['Já traiu ou foi traído? Conte como foi.', 'Perdoar traição: sim ou não? Justifique.']] },
  { id: 'never', name: 'Eu nunca', one: 'Quem já fez, bebe', c: '#7A1022', ink: '#FFF1F3', tint: '#FF7A93', glow: '#7A1022', icon: 'glass', bgw: '72%',
    how: 'A carta diz algo que alguém pode já ter feito. Quem já fez, assume e bebe. Só uma pessoa bebeu? Ela conta a história ou bebe +1.',
    cards: [['dormi com a roupa da festa.'], ['fui pego no flagra.'], ['fui traído e perdoei.']] },
  { id: 'doit', name: 'Faz ou bebe', one: 'Faz a ação ou bebe', c: '#168048', ink: '#F2FFF7', tint: '#3DDC84', glow: '#168048', icon: 'balance', bgw: '82%',
    how: 'A carta pede uma ação, de imitar alguém a entregar o celular desbloqueado. Ou faz, ou bebe. A roda decide se valeu.',
    cards: [['Faça 10 polichinelos.'], ['Sussurre um elogio no ouvido de alguém da roda.'], ['Mande um “oi, tudo bem?” para o seu ex.']] },
  { id: 'paranoia', name: 'Paranoia', one: 'Pergunta secreta', c: '#2A5BE8', ink: '#F4F6FF', tint: '#8FADFF', glow: '#2A5BE8', icon: 'spiral', bgw: '96%',
    how: 'A pergunta fica escondida: quem está com o celular segura a carta para ler e responde só com um nome. O citado bebe para saber a pergunta. Segure a carta pra testar.',
    cards: [['Quem aqui é o mais atrasado?'], ['Quem aqui é o mais safado?'], ['Quem aqui seria o pior traído?']] },
  { id: 'likely', name: 'Mais provável', one: 'A roda aponta', c: '#F7C531', ink: '#1B1608', tint: '#F7C531', glow: '#F7C531', icon: 'skullq', bgw: '86%',
    how: '“Quem é mais provável de…?” No 3, todo mundo aponta ao mesmo tempo. O mais apontado bebe.',
    cards: [['perder o celular?'], ['ficar com alguém desta roda?'], ['ter um caso com alguém casado?']] },
  { id: 'prefer', name: 'Prefere', one: 'A minoria bebe', c: '#6B3FD9', ink: '#F5F1FF', tint: '#B79BFF', glow: '#6B3FD9', icon: 'fork', bgw: '86%',
    how: 'Duas opções, uma escolha difícil. No 3, todo mundo mostra 1 ou 2 dedos. A minoria bebe. Empate: todo mundo bebe 1.',
    cards: [['perder o celular por um mês', 'perder a carteira por um mês'], ['ficar com a pessoa mais bonita do bar', 'ficar com a pessoa mais engraçada do bar'], ['descobrir que o seu par traiu há anos', 'descobrir que o seu par traiu ontem']] },
];
const LEVELS = [['Mico', 1, 50], ['Picante', 2, 100], ['Pesado', 3, 50]];
const shots = n => n === 1 ? '1 shot' : n + ' shots';

/* ---------- ambient glow ---------- */
const root = document.documentElement;
let current = document.querySelector('.hero');
const amb = document.querySelector('.amb');
const refreshGlow = () => { const c = current.dataset.glow; if (root.style.getPropertyValue('--g') !== c) { root.style.setProperty('--g', c); amb.style.setProperty('--ga', c); } };
if ('IntersectionObserver' in window) {
  const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { current = e.target; refreshGlow(); } }), { rootMargin: '-45% 0px -45% 0px' });
  document.querySelectorAll('[data-glow]').forEach(s => io.observe(s));
}
let mxQueued = false, mx = 50;
addEventListener('pointermove', e => { if (e.pointerType !== 'mouse') return; mx = e.clientX / innerWidth * 100; if (!mxQueued) { mxQueued = true; requestAnimationFrame(() => { amb.style.setProperty('--mx', mx.toFixed(1) + '%'); mxQueued = false; }); } }, { passive: true });
const bar = $('#bar');
const onScroll = () => bar.classList.toggle('on', scrollY > 8);
addEventListener('scroll', onScroll, { passive: true }); onScroll();

/* ---------- conversation card ---------- */
function convCard([key, no, kind, title, prompt]) {
  const d = DECKS[key];
  return `<article class="card" style="--c:${d.c};--ink:${d.ink}" aria-label="${esc(d.label)}: ${esc(title)}. ${esc(prompt)}">
    <div class="frame oval">
      <span class="corner tl">${String(no).padStart(2, '0')}</span><span class="corner br">${String(no).padStart(2, '0')}</span>
      <div class="face"><span class="pill">${kind}</span><h3 class="title${title.length > 14 ? ' long' : ''}">${esc(title)}</h3><p class="prompt">${esc(prompt)}</p></div>
      <span class="deckname">${d.name} · ${d.label}</span>
    </div></article>`;
}

/* ---------- hero deck ---------- */
const deck = $('#deck');
let order = CARDS.map((_, i) => (i + 1) % CARDS.length), top = 0, busy = false, drag = null;
function stack() {
  const have = [...deck.children];
  for (let k = have.length; k < 3; k++) {
    const holder = document.createElement('div');
    holder.innerHTML = convCard(CARDS[order[(top + k) % order.length]]);
    const el = holder.firstElementChild; el.dataset.pos = 3; deck.append(el);
  }
  deck.offsetWidth;
  [...deck.children].forEach((el, k) => { el.dataset.pos = k; el.setAttribute('aria-hidden', k ? 'true' : 'false'); el.style.zIndex = 3 - k; });
  const c = CARDS[order[top % order.length]];
  $('#deckLive').textContent = `${DECKS[c[0]].label}: ${c[3]}. ${c[4]}`;
  const dk = DECKS[c[0]]; document.querySelector('.hero').dataset.glow = dk.glow || dk.c; refreshGlow();
}
function fling(card, dx, dy) {
  if (busy) return; busy = true;
  const len = Math.hypot(dx, dy) || 1, far = Math.max(innerWidth, 800) * 1.2;
  card.style.transition = 'transform .4s cubic-bezier(.4,0,1,1), opacity .4s';
  card.style.transform = `translate(${dx / len * far}px, ${dy / len * far}px) rotate(${dx / len * 30}deg)`;
  card.style.opacity = 0;
  setTimeout(() => { card.remove(); top++; busy = false; stack(); }, reduce ? 0 : 360);
}
const topCard = () => deck.querySelector('.card[data-pos="0"]');
deck.addEventListener('pointerdown', e => {
  const card = e.target.closest('.card');
  if (busy || !card || card !== topCard()) return;
  card.setPointerCapture(e.pointerId);
  drag = { card, x: e.clientX, y: e.clientY, dx: 0, dy: 0 };
  card.classList.add('held');
});
deck.addEventListener('pointermove', e => {
  if (!drag) return;
  drag.dx = e.clientX - drag.x; drag.dy = e.clientY - drag.y;
  if (drag.raf) return;
  drag.raf = requestAnimationFrame(() => { if (!drag) return; drag.raf = 0; drag.card.style.transform = `translate3d(${drag.dx}px, ${drag.dy}px, 0) rotate(${drag.dx * .06}deg)`; });
});
const release = () => {
  if (!drag) return;
  const { card, dx, dy } = drag; drag = null; card.classList.remove('held');
  if (Math.hypot(dx, dy) > 90) fling(card, dx, dy); else card.style.transform = '';
};
deck.addEventListener('pointerup', release); deck.addEventListener('pointercancel', release);
deck.addEventListener('keydown', e => {
  const dir = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] }[e.key];
  if (dir && topCard()) { e.preventDefault(); fling(topCard(), ...dir); }
});
$('#deckNext').addEventListener('click', () => topCard() && fling(topCard(), 1, -.15));
stack();

/* ---------- conversation decks rail ---------- */
const deckKeys = Object.keys(DECKS);
let curDeck = 'green', curIdx = 0;
$('#decks').innerHTML = deckKeys.map(k => { const d = DECKS[k];
  return `<button class="deckbtn" type="button" data-k="${k}" aria-pressed="false"><span class="mini" style="--c:${d.c};--ink:${d.ink}" aria-hidden="true"></span><b>${d.label}</b><span>${d.name}</span></button>`; }).join('');
function showDeck(k, step = 0) {
  curDeck = k;
  const list = CARDS.filter(c => c[0] === k);
  curIdx = (curIdx + step) % list.length;
  const d = DECKS[k];
  $('#deckCard').innerHTML = convCard(list[curIdx]);
  $('#deckName').textContent = 'Baralho ' + d.name;
  $('#deckLabel').textContent = d.label;
  $('#deckBlurb').textContent = d.blurb;
  document.querySelectorAll('.deckbtn').forEach(b => b.setAttribute('aria-pressed', b.dataset.k === k));
  document.getElementById('conversa').dataset.glow = d.glow || d.c; refreshGlow();
}
$('#decks').addEventListener('click', e => { const b = e.target.closest('.deckbtn'); if (b) { curIdx = 0; showDeck(b.dataset.k); } });
showDeck('green');

/* ---------- drink ---------- */
let game = GAMES[0], level = 2, unlocked = false, holding = false;
try { unlocked = sessionStorage.getItem('spill18') === '1'; } catch {}
const skullRow = lv => `<span class="skulls" role="img" aria-label="Nível ${lv}">${[1, 2, 3].map(i => skull(i <= lv ? '' : 'off')).join('')}</span>`;
function drinkCard(g, lv) {
  const data = g.cards[lv - 1];
  let bg = `<span class="dbg" style="width:${g.bgw}">${ICON[g.icon]}</span>`;
  let mid, bot;
  if (g.id === 'dare') {
    mid = `<span class="deye">Responda ou ${shots(lv)}</span><p class="dmain">${esc(data[0])}</p>`;
    bot = `<span class="drule">Para todos</span><span class="dall">${esc(data[1])}</span><span class="ddet">Não respondeu: 1 shot · Quem leu: 2</span>`;
  } else if (g.id === 'never') {
    mid = `<span class="dlead">Eu nunca…</span><p class="dmain big">${esc(data[0])}</p>`;
    bot = `<span class="drule">Quem já fez bebe ${shots(lv)}</span><span class="ddet">Só uma pessoa bebeu? Conta a história ou +1.</span>`;
  } else if (g.id === 'doit') {
    mid = `<span class="deye">Faça ou beba ${shots(lv)}</span><p class="dmain big">${esc(data[0])}</p>`;
    bot = `<span class="drule">Recusou: ${shots(lv)}</span><span class="ddet">A roda decide se valeu.</span>`;
  } else if (g.id === 'paranoia') {
    mid = holding ? `<span class="deye">Pergunta secreta · não leia alto</span><p class="dmain big">${esc(data[0])}</p>`
      : `<span style="width:42%;display:block">${ICON.spiral}</span><span class="dlead">Segure para ler</span><span class="ddet" style="max-width:22ch">Só quem está com o celular pode ver a pergunta.</span>`;
    if (!holding) bg = '';
    bot = `<span class="drule">Responda só com um nome</span><span class="ddet">Quem foi citado bebe ${lv} pra saber a pergunta.</span>`;
  } else if (g.id === 'likely') {
    mid = `<span class="dlead">Quem é mais provável de…</span><p class="dmain big">${esc(data[0])}</p>`;
    bot = `<span class="drule">No 3, todo mundo aponta</span><span class="ddet">Mais apontado bebe ${lv}. Empate: todos bebem.</span>`;
  } else {
    mid = `<span class="dlead">Você prefere…</span><span class="opt"><span class="num">1</span><span>${esc(data[0])}</span></span><span class="drule" style="opacity:.85">ou</span><span class="opt"><span class="num">2</span><span>${esc(data[1])}</span></span>`;
    bot = `<span class="drule">No 3, mostre 1 ou 2 dedos</span><span class="ddet">A minoria bebe ${lv}. Empate: todo mundo bebe 1.</span>`;
  }
  return `<div class="card" style="--c:${g.c};--ink:${g.ink}"><div class="frame">${g.id === 'paranoia' && !holding ? '' : bg}
    <div class="dtop"><span class="pill">${g.name}</span>${skullRow(lv)}</div>
    <div class="dmid">${mid}</div><div class="dbot">${bot}</div><span class="dfoot">Drink · ${g.name}</span></div></div>`;
}
$('#games').innerHTML = GAMES.map(g => `<button class="deckbtn gbtn" type="button" data-g="${g.id}" aria-pressed="false" style="--c:${g.c};--ink:${g.ink}"><span class="gico">${ICON[g.icon]}</span><b>${g.name}</b><span>${g.one}</span></button>`).join('');
$('#levels').innerHTML = LEVELS.map(([n, lv]) => `<button class="lvl" type="button" data-lv="${lv}" aria-pressed="false">${'<span style="display:flex;gap:2px">' + [1, 2, 3].slice(0, lv).map(() => skull()).join('') + '</span>'}${n}</button>`).join('');
$('#shots').innerHTML = LEVELS.map(([n, lv, count]) => `<li><span class="sk" aria-label="${lv} caveira${lv > 1 ? 's' : ''}">${[1, 2, 3].map(i => skull(i <= lv ? '' : 'off')).join('')}</span><div><b>${n}</b><span>${shots(lv)} por carta</span></div><em>${count} cartas</em></li>`).join('');
document.querySelectorAll('#shots .off').forEach(s => s.style.opacity = .22);

function renderGame() {
  const stage = $('#stage');
  stage.classList.toggle('locked', !unlocked);
  const card = drinkCard(game, level);
  $('#gcard').innerHTML = game.id === 'paranoia' && unlocked
    ? `<button class="hold" type="button" id="hold" aria-label="Segure para ler a pergunta secreta">${card}</button>` : card;
  $('#gName').textContent = game.name; $('#gName').style.setProperty('--tint', game.tint);
  $('#gOne').textContent = game.one;
  $('#gHow').textContent = game.how;
  document.querySelectorAll('.gbtn').forEach(b => b.setAttribute('aria-pressed', b.dataset.g === game.id));
  document.querySelectorAll('.lvl').forEach(b => b.setAttribute('aria-pressed', +b.dataset.lv === level));
  document.getElementById('drink').dataset.glow = game.glow; refreshGlow();
  const hold = $('#hold');
  if (hold) {
    const paint = () => { hold.innerHTML = drinkCard(game, level); };
    const on = e => { if (e.type === 'keydown') { if (e.key !== ' ' && e.key !== 'Enter') return; e.preventDefault(); } if (!holding) { holding = true; paint(); } };
    const off = () => { if (holding) { holding = false; paint(); } };
    hold.addEventListener('pointerdown', e => { hold.setPointerCapture?.(e.pointerId); on(e); });
    hold.addEventListener('keydown', on);
    ['pointerup', 'pointercancel', 'keyup', 'blur'].forEach(t => hold.addEventListener(t, off));
    hold.addEventListener('contextmenu', e => e.preventDefault());
  }
}
$('#games').addEventListener('click', e => { const b = e.target.closest('.gbtn'); if (b) { game = GAMES.find(g => g.id === b.dataset.g); holding = false; renderGame(); } });
$('#levels').addEventListener('click', e => { const b = e.target.closest('.lvl'); if (b) { level = +b.dataset.lv; holding = false; renderGame(); } });
$('#gateYes').addEventListener('click', () => { unlocked = true; try { sessionStorage.setItem('spill18', '1'); } catch {} renderGame(); });
renderGame();
})();
</script>
