---
import Base from '../../../layouts/Base.astro';

/*
  SPILL — site do app de cartas (Android, offline, sem cadastro).

  Mesa de jogo à noite: fundo escuro, uma luz ambiente que toma a cor da seção
  em vista e as cartas como objeto principal. Tudo que se vê é demonstração
  funcional: o baralho do topo se arrasta, os sete baralhos de conversa e os
  seis jogos de shot trocam de carta. O Modo Drink fica atrás de uma
  confirmação de +18 (guardada só na sessão do navegador).
*/

const BASE = import.meta.env.BASE_URL;
const titulo = 'Spill — cartas para a roda de amigos';
const descricao =
  'App de cartas para Android, grátis e offline: 140 cartas de conversa em sete baralhos e um Modo Drink +18 com seis jogos de shot.';
---

<Base title={titulo} description={descricao}>
  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta name="theme-color" content="#16151B" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Unbounded:wght@400..900&display=swap"
    />
  </Fragment>

<div class="amb" aria-hidden="true"></div>
<div class="grain" aria-hidden="true"></div>

<header class="bar" id="bar">
  <div class="wrap">
    <a class="brand" href="#topo" aria-label="Spill, voltar ao topo">
      <svg viewBox="-12 44 264 160" aria-hidden="true"><use href="#fan"/></svg>
      <b>spill</b>
    </a>
    <nav class="nav" aria-label="Seções">
      <a href="#conversa">Conversa</a>
      <a href="#como-jogar">Como jogar</a>
      <a href="#drink">Modo Drink</a>
      <a href="#baixar">Baixar</a>
    </nav>
    <a class="btn btn-main" href="https://github.com/PirataZang/Spill/releases/latest/download/Spill.apk" target="_blank" rel="noopener">Baixar APK</a>
  </div>
</header>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <filter id="fs" x="-40%" y="-40%" width="180%" height="180%"><feDropShadow dx="0" dy="4" stdDeviation="5" flood-color="#000" flood-opacity=".32"/></filter>
    <g id="fan">
      <g transform="rotate(-30 120 236)"><rect x="84" y="56" width="72" height="104" rx="11" fill="#168048" filter="url(#fs)"/><rect x="89.5" y="61.5" width="61" height="93" rx="7" fill="none" stroke="#fff" stroke-opacity=".6" stroke-width="2"/><circle cx="97" cy="74" r="3.2" fill="#fff"/></g>
      <g transform="rotate(-15 120 236)"><rect x="84" y="56" width="72" height="104" rx="11" fill="#2A5BE8" filter="url(#fs)"/><rect x="89.5" y="61.5" width="61" height="93" rx="7" fill="none" stroke="#fff" stroke-opacity=".6" stroke-width="2"/><circle cx="97" cy="74" r="3.2" fill="#fff"/></g>
      <g><rect x="84" y="56" width="72" height="104" rx="11" fill="#F7C531" filter="url(#fs)"/><rect x="89.5" y="61.5" width="61" height="93" rx="7" fill="none" stroke="#fff" stroke-opacity=".75" stroke-width="2"/><circle cx="97" cy="74" r="3.2" fill="#fff"/></g>
      <g transform="rotate(15 120 236)"><rect x="84" y="56" width="72" height="104" rx="11" fill="#D7263D" filter="url(#fs)"/><rect x="89.5" y="61.5" width="61" height="93" rx="7" fill="none" stroke="#fff" stroke-opacity=".6" stroke-width="2"/><circle cx="97" cy="74" r="3.2" fill="#fff"/></g>
      <g transform="rotate(30 120 236)"><rect x="84" y="56" width="72" height="104" rx="11" fill="#0D0D10" stroke="#fff" stroke-opacity=".16" stroke-width="1" filter="url(#fs)"/><rect x="89.5" y="61.5" width="61" height="93" rx="7" fill="none" stroke="#fff" stroke-opacity=".6" stroke-width="2"/><circle cx="97" cy="74" r="3.2" fill="#fff"/><path d="M107 97h26a6 6 0 0 1 6 6v11a6 6 0 0 1-6 6h-14l-8 7v-7h-4a6 6 0 0 1-6-6v-11a6 6 0 0 1 6-6z" fill="#fff"/><circle cx="113" cy="108.5" r="2.4" fill="#0D0D10"/><circle cx="120" cy="108.5" r="2.4" fill="#0D0D10"/><circle cx="127" cy="108.5" r="2.4" fill="#0D0D10"/></g>
    </g>
  </defs>
</svg>

<main id="topo">
  <!-- HERO -->
  <section class="hero" data-glow="#2A5BE8" aria-labelledby="h1">
    <div class="wrap">
      <div class="hero-copy">
        <svg class="logo-fan" viewBox="-12 44 264 160" role="img" aria-label="Logo do Spill: cinco cartas em leque">
          <g class="fg" style="--a:-30deg"><use href="#fan"/></g>
        </svg>
        <p class="eyebrow">App Android · grátis · sem internet</p>
        <h1 id="h1">Cartas para a roda de amigos.</h1>
        <p class="lede">Puxe uma carta, puxe assunto. Ou puxe um shot.</p>
        <p class="sub">140 cartas de conversa em sete baralhos e um Modo Drink +18 com seis jogos de shot. Sem cadastro, sem anúncio. Abriu, escolheu, jogou.</p>
        <div class="cta">
          <a class="btn btn-main" href="https://github.com/PirataZang/Spill/releases/latest/download/Spill.apk" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg>
            Baixar o APK
          </a>
          <a class="btn btn-ghost" href="#o-que-e">Como funciona</a>
        </div>
        <p class="fine"><span>Android 8.0 ou mais novo</span><span>Baixa sempre a versão mais recente</span></p>
      </div>

      <div class="deck-zone">
        <div class="deck" id="deck" tabindex="0" role="region" aria-roledescription="baralho" aria-label="Baralho de exemplo. Use as setas ou o botão Próxima carta para puxar a próxima."></div>
        <div class="deck-ctl">
          <span id="deckHint">Arraste a carta pra puxar a próxima</span>
          <button class="btn btn-ghost" type="button" id="deckNext">Próxima carta →</button>
        </div>
        <p class="sr" id="deckLive" aria-live="polite"></p>
      </div>
    </div>
  </section>

  <!-- FACTS -->
  <section class="facts" aria-label="O Spill em números">
    <div class="wrap">
      <ul>
        <li><b>140</b><span>cartas de conversa, em 7 baralhos</span></li>
        <li><b>1.200</b><span>cartas de shot, em 6 jogos</span></li>
        <li><b>PT · EN</b><span>troque o idioma no topo da tela</span></li>
        <li><b>0</b><span>permissões pedidas pelo app</span></li>
        <li><b>Offline</b><span>sem cadastro, sem internet, sem anúncio</span></li>
      </ul>
    </div>
  </section>

  <!-- O QUE É -->
  <section id="o-que-e" data-glow="#D7263D" aria-labelledby="h-what">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">O que é o Spill</p>
        <h2 class="h2" id="h-what">O celular deixa de ser distração e vira pretexto pra conversar.</h2>
        <p class="lede">O Spill é um app de cartas feito para <b>juntar gente</b>: numa mesa, num churrasco, numa viagem ou numa resenha de sexta. A ideia é rir, puxar assunto e se conhecer melhor. Ele tem dois lados.</p>
      </div>
      <div class="sides">
        <a class="side" href="#conversa" style="--c:var(--green)">
          <span class="side-tag">Spill, a conversa</span>
          <dl>
            <div><dt>Pra quê</dt><dd>Quebrar o gelo e puxar assunto de verdade.</dd></div>
            <div><dt>Como</dt><dd>Cartas de filmes, séries, músicas, temas e cantadas, em 7 baralhos coloridos.</dd></div>
            <div><dt>Clima</dt><dd>Leve, pra qualquer idade.</dd></div>
            <div><dt>Cartas</dt><dd>140, em português e inglês.</dd></div>
          </dl>
          <span class="side-go">Ver a conversa →</span>
        </a>
        <a class="side" href="#drink" style="--c:var(--wine)">
          <span class="side-tag">Modo Drink +18</span>
          <dl>
            <div><dt>Pra quê</dt><dd>Animar a noite com jogos de bebida.</dd></div>
            <div><dt>Como</dt><dd>6 jogos com níveis de intensidade e escala de shots.</dd></div>
            <div><dt>Clima</dt><dd>Só para maiores de 18.</dd></div>
            <div><dt>Cartas</dt><dd>1.200, em português.</dd></div>
          </dl>
          <span class="side-go">Ver os jogos de shot →</span>
        </a>
      </div>
      <p class="lede" style="margin-top:28px">Sem cadastro, sem internet, sem anúncio. <b>Abriu, escolheu, jogou.</b></p>
    </div>
  </section>

  <!-- CONVERSA -->
  <section id="conversa" data-glow="#168048" aria-labelledby="h-conv">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Spill, a conversa</p>
        <h2 class="h2" id="h-conv">Uma boa pergunta começa a conversa.</h2>
        <p class="lede">Cada carta traz uma, puxada de um filme, uma série, uma música ou da vida. São <b>sete baralhos</b>, cada um com seu clima, de perguntas para um encontro a cantadas para testar na roda. Toque num deles.</p>
      </div>
      <div class="rail" id="decks" role="group" aria-label="Baralhos"></div>
      <div class="deck-show">
        <div id="deckCard"></div>
        <div class="deck-info" aria-live="polite">
          <p class="eyebrow" id="deckName"></p>
          <h3 id="deckLabel"></h3>
          <p id="deckBlurb"></p>
        </div>
      </div>
    </div>
  </section>

  <!-- COMO JOGAR -->
  <section id="como-jogar" data-glow="#F7C531" aria-labelledby="h-how">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Como se joga</p>
        <h2 class="h2" id="h-how">Cinco passos, nenhuma regra difícil.</h2>
      </div>
      <ol class="steps">
        <li class="step" style="--i:0;--c:var(--green);--ink:#F2FFF7"><div><h3>Escolha um modo</h3><p><b>Aleatório</b> mistura todos os baralhos. <b>Temático</b> fica numa cor só, e a rodada inteira tem o mesmo clima.</p></div></li>
        <li class="step" style="--i:1;--c:var(--blue);--ink:#F4F6FF"><div><h3>Leia a carta em voz alta</h3><p>E fale por mais ou menos um minuto.</p></div></li>
        <li class="step" style="--i:2;--c:var(--yellow);--ink:#1B1608"><div><h3>Continue a conversa</h3><p>Todo mundo pode fazer perguntas ou entrar com a própria história.</p></div></li>
        <li class="step" style="--i:3;--c:var(--red);--ink:#FFF3F4"><div><h3>Próxima carta</h3><p>Arraste a carta para qualquer lado da tela, ou toque em Próxima.</p></div></li>
        <li class="step" style="--i:4;--c:#3A3646;--ink:#F1EFF6"><div><h3>Pontos, se quiserem</h3><p>Depois de cada resposta, o grupo dá um ponto para a mais criativa. Ninguém ganha de verdade.</p></div></li>
      </ol>
    </div>
  </section>

  <!-- DRINK -->
  <section id="drink" class="drink" data-glow="#7A1022" aria-labelledby="h-drink">
    <div class="wrap">
      <div class="sec-head">
        <span class="badge18" aria-hidden="true">+18</span>
        <p class="eyebrow">Modo Drink · só para maiores de 18</p>
        <h2 class="h2" id="h-drink">Seis jogos de shot dentro do mesmo app.</h2>
        <p class="lede">Visual próprio, fundo escuro e <b>uma cor e um ícone para cada jogo</b>. Antes de abrir, o app pede a confirmação de idade. Escolha um jogo e um nível pra ver uma carta.</p>
      </div>
      <div class="rail games" id="games" role="group" aria-label="Jogos de shot"></div>
      <p class="mixnote">E o <b>Misturado</b>, que alterna Desafio e Eu nunca, uma carta de cada.</p>

      <div class="gshow">
        <div class="stage locked" id="stage">
          <div id="gcard"></div>
          <div class="gate" id="gate">
            <span class="badge18" aria-hidden="true">+18</span>
            <p>As cartas deste modo falam de sexo, bebida e vergonha alheia.</p>
            <button class="btn btn-main" type="button" id="gateYes">Tenho 18 anos ou mais</button>
          </div>
        </div>
        <div class="ginfo" aria-live="polite">
          <p class="one" id="gOne"></p>
          <h3 id="gName"></h3>
          <p id="gHow"></p>
          <div class="levels" role="group" aria-label="Nível da carta" id="levels"></div>
        </div>
      </div>

      <div class="shots">
        <h3>Quanto se bebe</h3>
        <p class="lede" style="font-size:17px">Cada carta tem de uma a três caveiras. É o nível, e <b>cada caveira vale 1 shot</b>.</p>
        <ul id="shots"></ul>
        <p class="tot">São <b>200 cartas por jogo</b>, <b>1.200 no total</b>, sem repetir enunciado.</p>
      </div>

      <div class="round">
        <h3>Monte a rodada</h3>
        <ul>
          <li><b>Jogo</b><span>Uma fila deslizante com os 6 jogos e o Misturado.</span></li>
          <li><b>Níveis</b><span>Quais entram na rodada. Pelo menos um fica sempre ligado.</span></li>
          <li><b>Escalada</b><span>A rodada começa no mico e esquenta até o pesado. Desligada, as cartas vêm embaralhadas.</span></li>
          <li><b>Modo leve</b><span>Gole em vez de shot, pra noite durar.</span></li>
        </ul>
      </div>

      <div class="warn"><span class="badge18" aria-hidden="true">+18</span><p>Ninguém é obrigado a responder: é pra isso que existe o shot. Beba com responsabilidade e nunca dirija depois de beber.</p></div>
    </div>
  </section>

  <!-- DOWNLOAD -->
  <section id="baixar" data-glow="#168048" aria-labelledby="h-dl">
    <div class="wrap">
      <div class="dl-card">
        <div class="dl-cta">
          <p class="eyebrow">Baixar e instalar</p>
          <h2 class="h2" id="h-dl">Chama a galera. Baixa o Spill.</h2>
          <p class="lede">O APK sai direto do GitHub, na versão mais recente. O app não pede permissão nenhuma e funciona totalmente offline.</p>
          <a class="btn btn-main" href="https://github.com/PirataZang/Spill/releases/latest/download/Spill.apk" target="_blank" rel="noopener">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg>
            Baixar Spill.apk
          </a>
          <a href="https://github.com/PirataZang/Spill/releases/latest" target="_blank" rel="noopener" style="font-size:15px;color:var(--muted)">Ver notas da versão</a>
        </div>
        <ol class="dl-steps">
          <li><div><b>Baixe o Spill.apk</b><br><span>Pelo botão ao lado ou pela página de Releases do GitHub.</span></div></li>
          <li><div><b>Abra o arquivo no Android</b><br><span>Precisa ser Android 8.0 ou mais novo. Se ele pedir, libere “instalar apps desconhecidos” para o navegador ou o gerenciador de arquivos.</span></div></li>
          <li><div><b>Abra o Spill e escolha como jogar</b><br><span>Conversa ou Modo Drink. Sem cadastro.</span></div></li>
        </ol>
      </div>
    </div>
  </section>

</main>

<footer>
  <div class="wrap">
    <svg viewBox="-12 44 264 160" aria-hidden="true"><use href="#fan"/></svg>
    <p>Feito para juntar gente.</p>
    <nav aria-label="Links">
      <a href={`${BASE}#projetos`}>← Portfólio do Igor</a>
      <a href="https://github.com/PirataZang/Spill" target="_blank" rel="noopener">GitHub</a>
      <a href="https://github.com/PirataZang/Spill/releases/latest" target="_blank" rel="noopener">Releases</a>
      <a href="https://github.com/PirataZang/Spill/blob/main/LICENSE" target="_blank" rel="noopener">Licença MIT</a>
    </nav>
  </div>
</footer>
</Base>

<style is:global>
/* Layout: a game table at night. One dark world (the app's own), an ambient glow behind everything that
   takes the color of whatever is in view, cards as the hero object, rails that scroll sideways on phones. */
@property --ga { syntax: '<color>'; inherits: false; initial-value: #2A5BE8; }
:root {
  color-scheme: dark;
  --bg: #16151B;
  --deep: #0B0A0E;
  --surface: #201E27;
  --raised: #2B2834;
  --line: #38343F;
  --fg: #F2F0F7;
  --muted: #A7A2B5;
  --green: #168048;
  --blue: #2A5BE8;
  --yellow: #F7C531;
  --red: #D7263D;
  --black: #0D0D10;
  --wine: #7A1022;
  --purple: #6B3FD9;
  --display: "Unbounded", "Arial Black", system-ui, sans-serif;
  --body: "Bricolage Grotesque", "Segoe UI", system-ui, sans-serif;
  --gut-l: max(16px, env(safe-area-inset-left, 0px));
  --gut-r: max(16px, env(safe-area-inset-right, 0px));
  --g: #2A5BE8;
}
html { scroll-behavior: smooth; overflow-x: clip; }
body {
  margin: 0; overflow-x: clip;
  background: var(--bg); color: var(--fg);
  font-family: var(--body); font-size: 17px; line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}
body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 30; background: var(--bg); }
* { box-sizing: border-box; }
a { color: inherit; }
button { font: inherit; color: inherit; }
:focus-visible { outline: 2.5px solid var(--fg); outline-offset: 3px; border-radius: 6px; }
h1, h2, h3 { text-wrap: balance; margin: 0; }
p { margin: 0; }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

/* ambient light: follows the section in view */
.amb {
  position: fixed; inset: -10% -10% 0; z-index: 0; pointer-events: none;
  background:
    radial-gradient(55% 38% at var(--mx, 50%) 30%, color-mix(in srgb, var(--ga) 55%, transparent), transparent 70%),
    radial-gradient(40% 30% at 85% 85%, color-mix(in srgb, var(--ga) 22%, transparent), transparent 70%);
  opacity: .55; transition: --ga .9s ease; will-change: transform; contain: strict;
}
.grain { position: fixed; inset: 0; z-index: 0; pointer-events: none; opacity: .05; will-change: transform;
  background-image: radial-gradient(#fff 1px, transparent 1px); background-size: 3px 3px; }
main, header, footer { position: relative; z-index: 1; }

.wrap { width: 100%; max-width: 1120px; margin: 0 auto; padding-left: var(--gut-l); padding-right: var(--gut-r); }
section { padding-block: clamp(72px, 12vw, 128px); }
.eyebrow { font-family: var(--display); font-size: 11px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
.h2 { font-family: var(--display); font-weight: 800; font-size: clamp(30px, 7.4vw, 56px); line-height: 1.02; letter-spacing: -.03em; }
.lede { font-size: clamp(17px, 2.4vw, 20px); color: var(--muted); max-width: 58ch; }
.lede b { color: var(--fg); font-weight: 600; }

/* ---------- buttons ---------- */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 10px;
  min-height: 52px; padding: 0 22px; border-radius: 16px; border: 0;
  font-family: var(--display); font-weight: 700; font-size: 15px; letter-spacing: .01em; text-decoration: none; cursor: pointer;
  transition: transform .15s, box-shadow .2s, background .2s;
}
.btn-main { background: var(--fg); color: var(--bg); box-shadow: 0 0 0 0 var(--g), 0 14px 40px -12px color-mix(in srgb, var(--g) 80%, transparent); }
.btn-main:hover { transform: translateY(-2px); box-shadow: 0 0 0 4px color-mix(in srgb, var(--g) 45%, transparent), 0 18px 50px -12px color-mix(in srgb, var(--g) 90%, transparent); }
.btn-main:active { transform: translateY(1px); }
.btn-ghost { background: transparent; color: var(--fg); border: 1px solid var(--line); font-family: var(--body); font-weight: 600; font-size: 16px; }
.btn-ghost:hover { background: var(--surface); border-color: var(--muted); }
.btn svg { flex: none; }

/* ---------- top bar ---------- */
.bar {
  position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20;
  border-bottom: 1px solid transparent; transition: background .3s, border-color .3s;
}
.bar.on { background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-color: var(--line); }
.bar .wrap { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 64px; }
.brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
.brand svg { width: 46px; height: auto; }
.brand b { font-family: var(--display); font-weight: 900; font-size: 22px; letter-spacing: -.04em; }
.nav { display: none; gap: 22px; font-size: 15px; font-weight: 600; color: var(--muted); }
.nav a { text-decoration: none; }
.nav a:hover { color: var(--fg); }
.bar .btn { min-height: 44px; padding: 0 16px; font-size: 13px; border-radius: 12px; }
@media (min-width: 860px) { .nav { display: flex; } }

/* ---------- hero ---------- */
.hero { padding-block: 28px 64px; }
.hero .wrap { display: grid; gap: 40px; align-items: center; }
.hero-copy { display: grid; gap: 20px; justify-items: start; }
.logo-fan { width: 168px; }
.logo-fan .fg { transform-box: fill-box; transform-origin: 50% 100%; animation: fan 1s cubic-bezier(.2, .8, .2, 1) both; }
@keyframes fan { from { transform: translateY(14px) scale(.86); opacity: 0; } }
.hero h1 { font-family: var(--display); font-weight: 900; font-size: clamp(40px, 11vw, 84px); line-height: .95; letter-spacing: -.045em; }
.hero .lede { font-size: clamp(19px, 4.6vw, 23px); color: var(--fg); font-weight: 600; }
.hero .sub { color: var(--muted); max-width: 46ch; }
.cta { display: flex; flex-wrap: wrap; gap: 10px; }
