  <script is:inline define:vars={{ SIM, RAW }}>
    (function () {
      var doc = document;
      var reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---- instalar: abas + copiar (as duas caixas andam juntas) ---- */
      var os = 'unix';
      var CMD = {
        unix: ['$', 'curl -fsSL ' + RAW + '/install.sh | bash'],
        win: ['PS>', 'irm ' + RAW + '/install.ps1 | iex'],
      };
      function pintaInstala() {
        doc.querySelectorAll('[data-prompt]').forEach(function (el) { el.textContent = CMD[os][0]; });
        doc.querySelectorAll('[data-cmd]').forEach(function (el) { el.textContent = CMD[os][1]; });
        doc.querySelectorAll('[data-os]').forEach(function (b) {
          b.setAttribute('aria-selected', String(b.dataset.os === os));
        });
      }
      doc.querySelectorAll('[data-os]').forEach(function (b) {
        b.addEventListener('click', function () { os = b.dataset.os; pintaInstala(); });
      });
      doc.querySelectorAll('[data-copiar]').forEach(function (b) {
        b.addEventListener('click', function () {
          try { navigator.clipboard.writeText(CMD[os][1]); } catch (e) {}
          b.textContent = '✓ Copiado';
          b.classList.add('ok');
          setTimeout(function () { b.textContent = 'Copiar'; b.classList.remove('ok'); }, 1800);
        });
      });
      pintaInstala();

      /* ---- barra de progresso de leitura ---- */
      var barra = doc.getElementById('progresso');
      function progresso() {
        var h = doc.documentElement;
        var max = h.scrollHeight - h.clientHeight;
        barra.style.transform = 'scaleX(' + (max > 0 ? Math.min(1, h.scrollTop / max) : 0) + ')';
      }
      addEventListener('scroll', progresso, { passive: true });
      progresso();

      /* ---- vídeos: tocam só à vista; com movimento reduzido ficam com controles ---- */
      var videos = doc.querySelectorAll('[data-video]');
      if (reduz || !('IntersectionObserver' in window)) {
        videos.forEach(function (v) { v.controls = true; v.preload = 'metadata'; });
      } else {
        var vo = new IntersectionObserver(function (es) {
          es.forEach(function (e) {
            if (e.isIntersecting) { e.target.play().catch(function () {}); } else { e.target.pause(); }
          });
        }, { threshold: 0.25 });
        videos.forEach(function (v) { vo.observe(v); });
      }

      /* ---- revelação ---- */
      if (!reduz && 'IntersectionObserver' in window) {
        doc.documentElement.classList.add('anim');
        doc.querySelectorAll('[data-stagger]').forEach(function (g) {
          var step = parseInt(g.getAttribute('data-step'), 10) || 90;
          var base = parseInt(g.getAttribute('data-base'), 10) || 0;
          Array.prototype.forEach.call(g.children, function (c, i) { c.style.transitionDelay = (base + i * step) + 'ms'; });
        });
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) {
            if (!e.isIntersecting) return;
            e.target.classList.add('in');
            io.unobserve(e.target);
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
        doc.querySelectorAll('[data-rv], [data-stagger]').forEach(function (el) { io.observe(el); });
      }

      /* ---- simulador ---- */
      var raiz = doc.getElementById('sim');
      var tela = doc.getElementById('sim-tela');
      var titulo = doc.getElementById('sim-titulo');
      var btnX = doc.getElementById('sim-x');
      var st = { v: 'lista', i: 0, j: 0 }; /* v: lista | git | ct | ajuda */
      var esc = function (s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
      var cur = function () { return SIM[st.i]; };
      var rodape = function (txt) { return '<p class="sim-pe">' + txt + '</p>'; };

      function viewLista() {
        titulo.textContent = '~/projetos — devscope';
        return '<p class="sim-h"><b>PROJETOS</b> <i>' + SIM.length + ' encontrados</i></p>' +
          SIM.map(function (p, k) {
            var ligado = p.on || p.ct.some(function (c) { return c[2]; });
            var onda = ligado && p.on ? '<span class="verde">' + p.w + '</span>' : '<span class="perigo">' + p.w + '</span>';
            return '<p class="sim-l' + (k === st.i ? ' sel' : '') + '">' + onda + '<span>' + esc(p.n) + '</span><em class="' + (p.on ? '' : 'perigo') + '">' + esc(p.s) + '</em></p>';
          }).join('') +
          rodape('↑↓ mover · Enter git · c containers · ? ajuda');
      }
      function viewGit() {
        var p = cur(), g = p.git, c = g.c[st.j];
        titulo.textContent = p.n + ' — git';
        return '<p class="sim-h"><b>GIT</b> <i>' + esc(p.n) + ' · ' + esc(g.b) + (g.sujo ? ' · <u>' + g.sujo + ' alterações</u>' : ' · limpo') + '</i></p>' +
          g.c.map(function (x, k) {
            return '<p class="sim-l' + (k === st.j ? ' sel' : '') + '"><span class="acento">' + x[0] + '</span><span>' + esc(x[1]) + '</span></p>';
          }).join('') +
          '<div class="sim-diff">' + c[2].map(function (l) {
            return '<p class="' + (l[0] === '+' ? 'mais' : 'menos') + '">' + esc(l) + '</p>';
          }).join('') + '</div>' +
          rodape('↑↓ commits · Esc voltar');
      }
      function viewCt() {
        var p = cur(), c = p.ct[st.j];
        titulo.textContent = p.n + ' — containers';
        return '<p class="sim-h"><b>CONTAINERS</b> <i>' + esc(p.n) + '</i></p>' +
          p.ct.map(function (x, k) {
            return '<p class="sim-l' + (k === st.j ? ' sel' : '') + '"><span class="' + (x[2] ? 'verde' : 'perigo') + '">' + (x[2] ? '●' : '○') + '</span><span>' + esc(x[0]) + '</span><em>:' + esc(x[1]) + ' · cpu ' + esc(x[3]) + '</em></p>';
          }).join('') +
          '<div class="sim-diff"><p>' + (c[2] ? 'GET :' + esc(c[1]) + ' → <span class="verde">200 OK</span> · 12 ms' : '<span class="perigo">parado</span> · x inicia') + '</p>' +
          '<p>POSTGRES_PASSWORD=<span class="azul">s3••••••••</span></p></div>' +
          rodape('↑↓ mover · x parar/iniciar · Esc voltar');
      }
      function viewAjuda() {
        titulo.textContent = 'ajuda — devscope';
        return '<p class="sim-h"><b>ATALHOS</b></p>' +
          [['↑ ↓', 'mover na lista'], ['Enter', 'abrir o Git do projeto'], ['c', 'abrir os containers'], ['x', 'parar/iniciar container'], ['Esc', 'voltar um nível'], ['?', 'esta ajuda']]
            .map(function (a) { return '<p class="sim-l"><span class="acento">' + a[0] + '</span><span>' + a[1] + '</span></p>'; }).join('') +
          rodape('Esc voltar · no app real: / filtra, Ctrl P busca fuzzy, Tab troca de módulo');
      }
      function pinta() {
        tela.innerHTML = { lista: viewLista, git: viewGit, ct: viewCt, ajuda: viewAjuda }[st.v]();
        btnX.hidden = st.v !== 'ct';
      }
      function tecla(k) {
        var n = st.v === 'lista' ? SIM.length : st.v === 'git' ? cur().git.c.length : st.v === 'ct' ? cur().ct.length : 0;
        var campo = st.v === 'lista' ? 'i' : 'j';
        if (k === 'ArrowDown' && n) st[campo] = (st[campo] + 1) % n;
        else if (k === 'ArrowUp' && n) st[campo] = (st[campo] + n - 1) % n;
        else if (k === 'Enter' && st.v === 'lista') { st.v = 'git'; st.j = 0; }
        else if (k === 'c' && st.v === 'lista') { st.v = 'ct'; st.j = 0; }
        else if (k === 'x' && st.v === 'ct') { var c = cur().ct[st.j]; c[2] = !c[2]; c[3] = c[2] ? '1%' : '—'; }
        else if (k === '?') st.v = 'ajuda';
        else if (k === 'Escape' && st.v !== 'lista') st.v = 'lista';
        else return false;
        pinta();
        return true;
      }
      raiz.addEventListener('keydown', function (e) {
        /* botão focado mantém o clique nativo; sem isto Enter num botão viraria "abrir Git" */
        if (e.ctrlKey || e.metaKey || e.altKey || e.target.closest('button')) return;
        if (tecla(e.key)) e.preventDefault();
      });
      raiz.querySelectorAll('[data-k]').forEach(function (b) {
        b.addEventListener('click', function () { tecla(b.dataset.k); });
      });
      pinta();
    })();
  </script>
</Base>

<style is:global>
  .ds {
    --bg: #0b0e13; --bg-2: #0f131a; --surface: #141920; --surface-2: #1b212b;
    --line: #232a35; --line-2: #333b47;
    --text: #e8ecf1; --text-2: #a9b3bf; --text-3: #808b98;
    --primary: #46d17e; --on-primary: #06130b; --accent: #f2b84b; --danger: #f2665c;
    --c-code: #e3b341; --c-run: #5aa9ff; --c-net: #46d17e; --c-data: #f47ab8; --c-desk: #f39a4c;
    --sans: 'Geist', system-ui, sans-serif; --mono: 'JetBrains Mono', ui-monospace, monospace;
    --bounce: cubic-bezier(.34, 1.56, .64, 1); --ease: cubic-bezier(.2, .7, .2, 1);
    --sec-y: 128px; --gut: 24px;
    background: var(--bg); color: var(--text); font-family: var(--sans);
    font-size: 17px; line-height: 1.6; min-height: 100vh;
  }
  .ds a { color: var(--primary); }
  .ds a:hover { color: #7fe3a6; }
  .ds ::selection { background: #46d17e33; color: inherit; }
  .ds :focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; border-radius: 6px; }
  .ds h1, .ds h2, .ds h3, .ds p, .ds pre, .ds ul, .ds ol, .ds figure { margin: 0; }
  .ds ul, .ds ol { padding: 0; list-style: none; }
  .ds .mono, .ds code, .ds pre { font-family: var(--mono); }
  .ds code { font-size: .9em; color: var(--text); }
  .ds i, .ds em { font-style: normal; }
  .ds .verde { color: var(--primary); }
  .ds .perigo { color: var(--danger); }
  .ds .azul { color: var(--c-run); }
  .ds .acento { color: var(--accent); }
  .ds .mudo { color: var(--text-3); }
  .ds .cinza { color: var(--text-2); }
  .ds .cinza strong, .ds strong { color: var(--text); font-weight: 600; }
  .ds .peq { font-size: 13px; }
  .ds .caixa { max-width: 1200px; margin: 0 auto; padding: var(--sec-y) var(--gut); position: relative; }
  .ds .pular { position: absolute; left: -999px; top: 8px; z-index: 50; background: var(--primary); color: var(--on-primary); padding: 10px 16px; border-radius: 8px; }
  .ds .pular:focus { left: 8px; }

  .ds .kbd { display: inline-flex; align-items: center; justify-content: center; min-width: 26px; height: 26px; padding: 0 8px; box-sizing: border-box; border: 1px solid var(--line-2); border-bottom-width: 2px; border-radius: 6px; background: var(--surface-2); color: var(--text); font-family: var(--mono); font-size: 12px; font-weight: 500; white-space: nowrap; transition: transform .15s var(--ease), border-color .15s, color .15s; }
  .ds button.kbd { cursor: pointer; min-height: 44px; padding: 0 14px; font-size: 13px; }
  .ds .kbd:hover { transform: translateY(1px); border-color: var(--accent); color: var(--accent); }
  .ds .idx { font-family: var(--mono); font-size: 13px; color: var(--text-3); }
  .ds .idx b { color: var(--primary); font-weight: 500; }
  .ds h2 { font-weight: 600; font-size: clamp(34px, 4.6vw, 52px); line-height: 1.04; letter-spacing: -0.035em; color: var(--text); }
  .ds .lead { font-size: 19px; line-height: 1.55; color: var(--text-2); max-width: 31em; }

  /* botões */
  .ds .btn { display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 22px; box-sizing: border-box; border-radius: 10px; font-weight: 600; font-size: 16px; text-decoration: none; transition: transform .35s var(--bounce), background .2s, border-color .2s; }
  .ds .btn:hover { transform: translateY(-2px); }
  .ds .btn:active { transform: scale(.97); }
  .ds .btn-sm { min-height: 44px; padding: 0 16px; font-size: 14px; }
  .ds .btn-primary { background: var(--primary); color: var(--on-primary); }
  .ds .btn-primary:hover { background: #5fdc92; color: var(--on-primary); }
  .ds .btn-ghost { border: 1px solid var(--line-2); color: var(--text); font-weight: 500; }
  .ds .btn-ghost:hover { border-color: var(--text-3); color: var(--text); }
  .ds .cta-row { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }

  /* topo */
  .ds .topo { position: sticky; top: 0; z-index: 20; background: rgba(11, 14, 19, .85); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .ds .nav { max-width: 1200px; margin: 0 auto; padding: 8px var(--gut); display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .ds .marca { display: flex; align-items: center; gap: 10px; color: var(--text); text-decoration: none; font-family: var(--mono); font-weight: 700; font-size: 17px; min-height: 44px; }
  .ds .marca:hover { color: var(--text); }
  .ds .marca span { color: var(--primary); }
  .ds .nav-links { display: flex; align-items: center; gap: 26px; font-size: 15px; }
  .ds .nav-links a { color: var(--text-2); text-decoration: none; transition: color .2s; padding: 10px 0; }
  .ds .nav-links a:hover { color: var(--text); }
  .ds .nav-acoes { display: flex; align-items: center; gap: 10px; }
  .ds .progresso { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--primary); transform-origin: 0 50%; transform: scaleX(0); }

  /* fundos */
  .ds .sec { position: relative; overflow: clip; }
  .ds .sec > .caixa { z-index: 1; }
  .ds .deco { position: absolute; inset: 0; pointer-events: none; z-index: 0; overflow: clip; }
  .ds .deco > * { position: absolute; }
  .ds .fundo2 { background: var(--bg-2); }
  .ds .borda, .ds .sec + .sec { border-top: 1px solid var(--line); }
  .ds .dots { background-image: radial-gradient(#2a323e 1px, transparent 1.3px); background-size: 22px 22px; -webkit-mask-image: radial-gradient(ellipse at center, #000 20%, transparent 70%); mask-image: radial-gradient(ellipse at center, #000 20%, transparent 70%); }
  .ds .gridlines { background-image: linear-gradient(#1a2029 1px, transparent 1px), linear-gradient(90deg, #1a2029 1px, transparent 1px); background-size: 48px 48px; -webkit-mask-image: radial-gradient(ellipse at center, #000 15%, transparent 68%); mask-image: radial-gradient(ellipse at center, #000 15%, transparent 68%); }
  .ds .dia { width: 100%; height: 100%; box-sizing: border-box; border: 1px solid var(--line-2); transform: rotate(45deg); }
  .ds .dia-g { border-color: rgba(70, 209, 126, .22); }
  .ds .dia-fill { background: var(--surface-2); }
  .ds .ring { width: 100%; height: 100%; box-sizing: border-box; border: 1px dashed #2c3440; border-radius: 50%; }
  .ds .glow { border-radius: 50%; background: radial-gradient(circle, rgba(70, 209, 126, .13), transparent 62%); }
  .ds .cross { font-family: var(--mono); font-size: 20px; line-height: 1; color: #3a4350; }
  .ds .spin { animation: ds-spin 80s linear infinite; }
  .ds .spin-r { animation: ds-spin 120s linear infinite reverse; }
  .ds .spin-ring { animation: ds-ring 90s linear infinite; }
  .ds .float { animation: ds-float 6s cubic-bezier(.45, 0, .55, 1) infinite; }
  .ds .float-2 { animation: ds-float 7.5s cubic-bezier(.45, 0, .55, 1) infinite -2s; }
  @keyframes ds-spin { from { transform: rotate(45deg); } to { transform: rotate(405deg); } }
  @keyframes ds-ring { to { transform: rotate(360deg); } }
  @keyframes ds-float { 0%, 100% { translate: 0 0; } 50% { translate: 0 -16px; } }

  /* hero */
  .ds .hero-in { display: flex; flex-wrap: wrap; gap: 64px; align-items: center; padding-top: 96px; padding-bottom: 72px; }
  .ds .hero-txt { flex: 1 1 440px; min-width: 0; display: flex; flex-direction: column; gap: 26px; }
  .ds .selo { display: flex; align-items: center; gap: 12px; font-size: 13px; color: var(--text-2); }
  .ds .dot-live { width: 8px; height: 8px; border-radius: 50%; background: var(--primary); animation: ds-ping 2s ease-out infinite; flex: none; }
  @keyframes ds-ping { 0% { box-shadow: 0 0 0 0 #46d17e88; } 80%, 100% { box-shadow: 0 0 0 10px #46d17e00; } }
  .ds h1 { font-weight: 600; font-size: clamp(46px, 7vw, 80px); line-height: .98; letter-spacing: -0.045em; }
  .ds h1 .mono { font-weight: 700; letter-spacing: -0.06em; }
  .ds .cue { display: inline-block; animation: ds-cue 1.6s var(--ease) infinite; }
  @keyframes ds-cue { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(5px); } }
  .ds .hero-fig { flex: 1 1 560px; min-width: 0; position: relative; }
  .ds .hero-fig figcaption { margin-top: 10px; font-size: 13px; color: var(--text-3); text-align: right; }
  .ds .janela { border: 1px solid var(--line-2); border-radius: 14px; overflow: hidden; background: #05070a; box-shadow: 0 40px 100px rgba(0, 0, 0, .55); }
  .ds .janela video { display: block; width: 100%; height: auto; aspect-ratio: 1200 / 686; background: #05070a; }
  .ds .janela-barra { display: flex; align-items: center; gap: 8px; padding: 11px 14px; border-bottom: 1px solid var(--line); background: var(--surface); }
  .ds .janela-barra i { width: 11px; height: 11px; border-radius: 50%; background: #3a414c; }
  .ds .janela-barra span { margin-left: 10px; font-family: var(--mono); font-size: 12px; color: var(--text-3); }
  .ds .hero-cards { position: relative; z-index: 2; margin: -96px 0 0 -20px; width: min(330px, 92%); display: flex; flex-direction: column; gap: 8px; }
  .ds .hero-cards > div { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border: 1px solid var(--line-2); border-radius: 10px; background: rgba(20, 25, 32, .96); box-shadow: 0 16px 40px rgba(0, 0, 0, .5); font-family: var(--mono); font-size: 13px; transition: transform .45s var(--bounce); }
  .ds .hero-cards > div:hover { transform: translateY(-5px); }
  .ds .hero-cards > div > span:nth-child(2) { flex: 1; color: var(--text); }
  .ds .hero-cards em { color: var(--text-3); }
  .ds .hero-cards em.perigo { color: var(--danger); }
  .ds .wave b { display: inline-block; font-weight: 400; animation: ds-wave 1.8s ease-in-out infinite; animation-delay: calc(var(--i) * 90ms); }
  @keyframes ds-wave { 0%, 100% { opacity: .35; transform: translateY(0); } 50% { opacity: 1; transform: translateY(-2px); } }

  /* instalar */
  .ds .instala { border: 1px solid var(--line-2); border-radius: 12px; background: var(--surface); overflow: hidden; max-width: 560px; }
  .ds .instala.grande { max-width: none; border-radius: 14px; box-shadow: 0 40px 100px rgba(0, 0, 0, .55); }
  .ds .instala-abas { display: flex; border-bottom: 1px solid var(--line); }
  .ds .instala-abas button { flex: 1; min-height: 44px; border: 0; background: var(--surface); color: var(--text-3); font-family: var(--mono); font-size: 13px; cursor: pointer; transition: background .2s, color .2s; }
  .ds .instala-abas button + button { border-left: 1px solid var(--line); }
  .ds .instala-abas button[aria-selected='true'] { background: var(--surface-2); color: var(--text); }
  .ds .instala-cmd { display: flex; align-items: center; gap: 12px; padding: 12px 12px 12px 18px; }
  .ds .instala-cmd code { flex: 1; min-width: 0; font-size: 13px; line-height: 1.55; word-break: break-all; }
  .ds .instala-corpo { padding: 22px; font-size: 13.5px; line-height: 1.7; color: var(--text); word-break: break-all; }
  .ds .instala-pe { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; padding: 0 16px 16px 22px; font-size: 13px; color: var(--text-3); }
  .ds .copiar { flex: none; min-height: 44px; min-width: 96px; border: 1px solid var(--line-2); border-radius: 8px; background: var(--surface-2); color: var(--text); font-family: var(--mono); font-size: 13px; cursor: pointer; transition: background .2s, color .2s; }
  .ds .copiar.ok { background: var(--primary); color: var(--on-primary); }

  /* faixa + números */
  .ds .faixa { border-top: 1px solid var(--line); overflow: hidden; padding: 18px 0; }
  .ds .marquee { display: flex; width: max-content; font-size: 14px; color: var(--text-2); animation: ds-marquee 48s linear infinite; }
  .ds .marquee:hover { animation-play-state: paused; }
  .ds .marquee > div { display: flex; gap: 36px; padding-right: 36px; white-space: nowrap; }
  @keyframes ds-marquee { to { transform: translateX(-50%); } }
  .ds .numeros { border-block: 1px solid var(--line); background: var(--bg-2); }
  .ds .numeros-grade { padding-block: 36px; display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 24px; }
  .ds .numeros-grade b { display: block; font-size: 40px; font-weight: 700; line-height: 1.1; }
  .ds .numeros-grade span { font-size: 14px; color: var(--text-2); }

  /* seções em duas colunas */
  .ds .cab { display: flex; flex-direction: column; gap: 18px; max-width: 720px; margin-bottom: 56px; }
  .ds .cab-linha { max-width: none; flex-direction: row; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; }
  .ds .cab-linha > div { display: flex; flex-direction: column; gap: 18px; max-width: 640px; }
  .ds .cab-linha .lead { max-width: 26em; }
  .ds .duas { display: flex; flex-wrap: wrap; gap: 48px; }
  .ds .col-fixa { flex: 1 1 320px; min-width: 0; }
  .ds .col-larga { flex: 1.5 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .ds .fixa { position: sticky; top: 104px; display: flex; flex-direction: column; gap: 20px; }
  .ds .fixa .lead { font-size: 18px; }
  .ds .cartao { border: 1px solid var(--line); border-radius: 14px; background: var(--surface); overflow: hidden; }
  .ds .cartao.depois { border-color: #2b5a3d; padding: 22px 22px 24px; display: flex; flex-direction: column; gap: 16px; }
  .ds .cartao-cab { display: flex; justify-content: space-between; gap: 12px; padding: 12px 18px; border-bottom: 1px solid var(--line); font-size: 13px; }
  .ds .depois .cartao-cab { padding: 0; border: 0; }
  .ds .antes { display: flex; flex-direction: column; padding: 18px; font-size: 13px; line-height: 1.9; color: var(--text-2); white-space: pre; overflow-x: auto; }
  .ds .antes i, .ds .term i, .ds .cod i { color: var(--text-3); }
  .ds .cartao-pe { padding: 0 18px 18px; font-size: 15px; color: var(--text-2); }
  .ds .cmd-grande { font-size: 22px; color: var(--text); }
  .ds .caret { display: inline-block; width: 9px; height: 1.05em; background: var(--primary); vertical-align: -2px; margin-left: 4px; animation: ds-blink 1.1s steps(1) infinite; }
  @keyframes ds-blink { 50% { opacity: 0; } }
  .ds .tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .ds .tags span { font-size: 12px; padding: 5px 10px; border-radius: 6px; background: var(--surface-2); color: var(--text-2); }
  .ds .pilares-sec { padding-top: 32px; padding-bottom: 128px; }
  .ds .pilares { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); border-top: 1px solid var(--line); }
  .ds .pilares > div { padding: 28px 24px 8px; display: flex; flex-direction: column; gap: 10px; border-right: 1px solid var(--line); }
  .ds .pilares > div:first-child { padding-left: 0; }
  .ds .pilares > div:last-child { border-right: 0; padding-right: 0; }
  .ds .pilares h3 { font-size: 21px; font-weight: 600; letter-spacing: -0.01em; }
  .ds .pilares p:last-child { color: var(--text-2); font-size: 15px; }

  /* simulador */
  .ds .sim-sec .cab { margin-inline: auto; text-align: center; align-items: center; }
  .ds .sim { max-width: 860px; margin: 0 auto; outline-offset: 6px; }
  .ds .sim .janela { box-shadow: 0 40px 100px rgba(0, 0, 0, .6), 0 0 0 1px rgba(70, 209, 126, .12); }
  .ds .sim:focus-within .janela { border-color: #2b5a3d; }
  .ds .sim-tela { padding: 16px 18px; min-height: 330px; font-size: 14px; line-height: 1.5; display: flex; flex-direction: column; gap: 2px; }
  .ds .sim-h { padding-bottom: 10px; margin-bottom: 4px; border-bottom: 1px solid var(--line); color: var(--text-2); }
  .ds .sim-h b { color: var(--primary); letter-spacing: .08em; margin-right: 10px; }
  .ds .sim-h i { color: var(--text-3); }
  .ds .sim-h u { color: var(--accent); text-decoration: none; }
  .ds .sim-l { display: flex; align-items: center; gap: 14px; padding: 6px 10px; border-radius: 6px; color: var(--text-2); }
  .ds .sim-l.sel { background: var(--surface-2); color: var(--text); box-shadow: inset 2px 0 0 var(--primary); }
  .ds .sim-l > span:nth-child(2) { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ds .sim-l em { color: var(--text-3); font-size: 13px; }
  .ds .sim-l em.perigo { color: var(--danger); }
  .ds .sim-l > span:first-child { min-width: 4.2ch; }
  .ds .sim-diff { margin-top: 10px; padding: 12px 14px; border-radius: 8px; background: #05070a; border: 1px solid var(--line); font-size: 13px; color: var(--text-2); overflow-x: auto; }
  .ds .sim-diff p { white-space: pre; }
  .ds .sim-diff .mais { color: var(--primary); }
  .ds .sim-diff .menos { color: var(--danger); }
  .ds .sim-pe { margin-top: auto; padding-top: 14px; font-size: 12px; color: var(--text-3); }
  .ds .sim-teclas { display: flex; flex-wrap: wrap; gap: 8px; padding: 12px 14px; border-top: 1px solid var(--line); background: var(--surface); }
  .ds .sim-teclas [hidden] { display: none; }
  .ds .sim-nota { margin-top: 18px; text-align: center; font-size: 13px; color: var(--text-3); }

  /* lado a lado */
  .ds .lado { display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-start; }
  .ds .lado-inv { flex-wrap: wrap-reverse; }
  .ds .lado-m { flex: 1.3 1 560px; min-width: 0; }
  .ds .lado-t { flex: 1 1 360px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .ds .atalhos-lista { border-top: 1px solid var(--line); }
  .ds .atalhos-lista li { display: flex; gap: 16px; justify-content: space-between; align-items: center; padding: 13px 4px; border-bottom: 1px solid var(--line); transition: background .2s, padding-left .35s var(--bounce); }
  .ds .atalhos-lista li:hover { background: var(--surface); padding-left: 14px; }
  .ds .ks { display: flex; gap: 6px; flex: none; }
  .ds .aviso { display: flex; gap: 14px; align-items: flex-start; padding: 16px 18px; border-radius: 10px; border: 1px solid #4b3d1c; background: #18150d; }
  .ds .aviso p { font-size: 15px; }
  .ds .aviso p span { color: var(--text-2); }
  .ds .aviso .kbd { border-color: var(--accent); color: var(--accent); flex: none; }
  .ds .aviso.azul { flex-direction: column; gap: 8px; border-color: #1f3b5c; background: #0e1724; }
  .ds .aviso.azul code { font-size: 14px; }
  .ds .aviso.azul i { color: var(--c-run); }
  .ds .grade-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
  .ds .card { border: 1px solid var(--line); border-radius: 10px; padding: 18px; background: var(--surface); display: flex; flex-direction: column; gap: 4px; }
  .ds .card span { font-size: 14px; color: var(--text-2); }
  .ds .lift { transition: transform .45s var(--bounce), border-color .25s; }
  .ds .lift:hover { transform: translateY(-5px); border-color: var(--line-2); }

  /* módulos */
  .ds .modulos { border: 1px solid var(--line); border-radius: 14px; background: var(--surface); overflow: hidden; gap: 0; }
  .ds .modulos-cab { display: flex; gap: 16px; padding: 12px 20px; border-bottom: 1px solid var(--line); font-size: 12px; color: var(--text-3); }
  .ds .modulos-cab span:first-child { width: 92px; }
  .ds .modulo { display: flex; flex-wrap: wrap; gap: 8px 16px; padding: 18px 20px; border-bottom: 1px solid var(--line); border-left: 3px solid var(--cor); transition: background .2s, padding-left .35s var(--bounce); }
  .ds .modulo:last-child { border-bottom: 0; }
  .ds .modulo:hover { background: var(--surface-2); padding-left: 28px; }
  .ds .modulo > b { width: 92px; font-size: 12px; font-weight: 700; color: var(--cor); padding-top: 4px; }
  .ds .modulo > div { flex: 1; min-width: 220px; display: flex; flex-direction: column; gap: 6px; }
  .ds .modulo > div > div { display: flex; flex-wrap: wrap; gap: 6px; }
  .ds .modulo > div > div span { font-size: 13px; padding: 3px 9px; border-radius: 6px; background: var(--surface-2); }
  .ds .modulo:hover > div > div span { background: var(--bg); }
  .ds .modulo p { font-size: 14px; color: var(--text-2); }

  /* entrega */
  .ds .duplo { display: flex; flex-wrap: wrap; gap: 20px; align-items: stretch; }
  .ds .painel { flex: 1 1 460px; min-width: 0; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); padding: 30px; display: flex; flex-direction: column; gap: 20px; }
  .ds .painel-cab { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .ds .painel-cab h3 { font-size: 24px; font-weight: 600; letter-spacing: -0.02em; }
  .ds .painel-cab span { font-size: 12px; }
  .ds .passos { display: flex; flex-direction: column; gap: 14px; }
  .ds .passos li { display: flex; gap: 14px; }
  .ds .passos li > span:first-child { color: var(--accent); }
  .ds .painel-pe { margin-top: auto; padding-top: 18px; border-top: 1px solid var(--line); font-size: 15px; color: var(--text-2); }
  .ds .term { border-radius: 10px; background: #05070a; border: 1px solid var(--line); padding: 16px 18px; font-size: 13px; line-height: 1.9; }

  /* atalhos */
  .ds .grade-atalhos { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px; align-content: start; }
  .ds .grade-atalhos > div { display: flex; align-items: center; gap: 14px; padding: 14px 16px; border-radius: 10px; border: 1px solid var(--line); background: var(--surface); font-size: 15px; }

  /* arquitetura */
  .ds .arch { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; padding: 32px; border: 1px solid var(--line); border-radius: 14px; background: var(--bg-2); }
  .ds .arch-col { flex: 1 1 260px; min-width: 0; display: flex; flex-direction: column; gap: 10px; }
  .ds .arch-col > p:first-child { font-size: 12px; }
  .ds .chip { padding: 10px 14px; border-radius: 8px; border: 1px solid var(--line); border-left: 3px solid var(--c, var(--line-2)); background: var(--surface); font-size: 13px; }
  .ds .arch-grade { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .ds .seta { flex: none; color: var(--text-3); }
  .ds .arch-no { flex: 1 1 200px; min-width: 0; padding: 28px; border-radius: 12px; border: 1px solid var(--line-2); background: var(--surface); text-align: center; display: flex; flex-direction: column; gap: 6px; }
  .ds .arch-no.verde-no { border-color: var(--primary); background: #0f1d15; flex-basis: 220px; }
  .ds .arch-no p { font-size: 12px; }
  .ds .arch-no b { font-size: 22px; font-weight: 600; letter-spacing: -0.02em; }
  .ds .arch-no span { font-size: 14px; color: var(--text-2); }
  .ds .arch-pe { margin-top: 24px; display: flex; flex-wrap: wrap; gap: 16px; align-items: center; justify-content: space-between; }
  .ds .arch-pe p { font-size: 13px; }
  .ds .arch-pe a { font-size: 15px; font-weight: 500; }

  /* config */
  .ds .duplo-cod { display: flex; flex-wrap: wrap; gap: 24px; align-items: stretch; }
  .ds .duplo-cod > div { flex: 1 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .ds .duplo-cod h3 { font-size: 30px; font-weight: 600; letter-spacing: -0.03em; line-height: 1.15; }
  .ds .cod { flex: 1; padding: 20px; border-radius: 14px; background: #05070a; border: 1px solid var(--line); font-size: 13px; line-height: 2; color: var(--text); white-space: pre; overflow-x: auto; }
  .ds .cod b { color: var(--accent); font-weight: 400; }

  /* cta */
  .ds .cta-in { display: flex; flex-wrap: wrap; gap: 56px; align-items: center; padding-block: calc(var(--sec-y) + 8px); }
  .ds .cta-txt { flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 22px; }
  .ds .cta-txt .wave { font-size: 26px; letter-spacing: 3px; }
  .ds .cta-txt h2 { font-size: clamp(40px, 6vw, 68px); line-height: 1; letter-spacing: -0.045em; }
  .ds .cta-cmd { flex: 1 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 12px; }

  .ds .rodape { border-top: 1px solid var(--line); }
  .ds .rodape-in { padding-block: 28px; display: flex; flex-wrap: wrap; gap: 20px; justify-content: space-between; align-items: center; font-size: 14px; }
  .ds .rodape-in p { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; color: var(--text); }
  .ds .rodape-in nav { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .ds .rodape-in nav a { color: var(--text-2); text-decoration: none; padding: 10px 0; }
  .ds .rodape-in nav a:hover { color: var(--text); }

  /* revelação: só liga com html.anim */
  .anim .ds [data-rv] { opacity: 0; transform: translateY(28px); transition: opacity .7s var(--ease), transform .8s var(--bounce); }
  .anim .ds [data-rv='left'] { transform: translateX(-36px); }
  .anim .ds [data-rv='right'] { transform: translateX(36px); }
  .anim .ds [data-rv='zoom'] { transform: scale(.94) translateY(16px); }
  .anim .ds [data-rv].in { opacity: 1; transform: none; }
  .anim .ds [data-stagger] > * { opacity: 0; transform: translateY(26px) scale(.97); transition: opacity .6s var(--ease), transform .75s var(--bounce); }
  .anim .ds [data-stagger='left'] > * { transform: translateX(-28px); }
  .anim .ds [data-stagger='right'] > * { transform: translateX(28px); }
  .anim .ds [data-stagger='pop'] > * { transform: scale(.6); }
  .anim .ds [data-stagger].in > * { opacity: 1; transform: none; }

  @media (max-width: 1024px) { .ds { --sec-y: 104px; } }
  @media (max-width: 860px) {
    .ds { --sec-y: 80px; --gut: 20px; }
    .ds .nav-links, .ds .nav-gh { display: none; }
    .ds .hero-in { padding-top: 44px; padding-bottom: 56px; gap: 40px; }
    .ds .hero-cards { margin: -44px 0 0 12px; width: calc(100% - 24px); max-width: 340px; }
    .ds .pilares > div { border-right: 0; border-bottom: 1px solid var(--line); padding: 22px 0; }
