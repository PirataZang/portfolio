---
import Base from '../../../layouts/Base.astro';

/*
  DEVSCOPE — site do projeto (TUI open source em Go).

  Dark técnico, verde-terminal sobre azul-grafite. O produto é um terminal, então
  a prova vem do próprio terminal: um simulador clicável logo abaixo do herói
  (dados fictícios, nada roda de verdade) e as gravações reais do app nas seções
  de Git e Docker. Nada de captura estática onde um vídeo cabe.

  Movimento: revelação por IntersectionObserver e formas em CSS puro. Sem
  `html.anim` (sem JS ou movimento reduzido) tudo aparece parado, e os vídeos
  trocam o autoplay por controles.
*/

const BASE = import.meta.env.BASE_URL;
const MIDIA = `${BASE}projetos/devscope`;
const GH = 'https://github.com/PirataZang/devscope';
const RAW = 'https://raw.githubusercontent.com/PirataZang/devscope/main/scripts';

const titulo = 'DevScope — o htop dos seus projetos, no terminal';
const descricao =
  'TUI open source em Go que junta containers, Git, CI, túneis, banco e saúde de todos os seus projetos numa tela só. Binário único, zero configuração.';

const NAV = [
  ['por-que', 'Por que'],
  ['experimente', 'Experimente'],
  ['git', 'Git'],
  ['docker', 'Docker'],
  ['modulos', 'Módulos'],
  ['arquitetura', 'Arquitetura'],
];

const FAIXA = [
  'Git Graph', 'Preview HTTP', 'Segredos mascarados', 'Worktrees', 'GH Actions', 'Swarm',
  'Kubernetes', 'Ngrok', 'CF Tunnel', 'Cliente SQL', 'JWT', 'Validade de SSL', 'Workers PM2', '12 temas',
];

const NUMEROS = [
  ['1', 'binário, sem dependências'],
  ['15', 'módulos num contexto só'],
  ['12', 'temas com preview na hora'],
  ['x64/ARM', 'nos 3 sistemas'],
  ['0', 'configuração para começar'],
];

const ANTES = [
  ['docker ps -a              ', 'o que está de pé'],
  ['docker stats --no-stream  ', 'consumindo o quê'],
  ['pm2 list                  ', 'e os workers Node'],
  ['git -C /var/www/api status', 'o que ficou solto'],
  ['gh run list               ', 'a pipeline passou?'],
  ['ss -ltn | grep LISTEN     ', 'quem pegou a 8080'],
  ['nginx -T | grep server_name', 'que domínio é esse'],
  ['certbot certificates      ', 'e o SSL, vence quando'],
];

const PILARES = [
  ['a.', 'Binário único', 'Sem Node, sem Python, sem daemon, sem browser. Baixa e roda.'],
  ['b.', 'Zero configuração', 'Ele acha seus projetos sozinho no disco e detecta a stack de cada um.'],
  ['c.', 'Opera, não só observa', 'Commitar, subir, parar, deploy, túnel e SQL — dali mesmo.'],
  ['d.', 'Nunca trava', 'Coleta concorrente, com a UI desenhada sobre snapshot imutável.'],
];

const GIT = [
  ['Branches e commits lado a lado, sem checkout', ['↑↓']],
  ['Diff por arquivo, com busca', ['Enter']],
  ['Git Graph desenhado no terminal', ['Ctrl G']],
  ['Stage de tudo e commit num modal', ['⇧ A', 'c']],
  ['Cherry-pick: marcar e colar', ['x', '⇧ V']],
  ['Pull, push e abrir Pull Request', ['p', '⇧ P', 'o']],
  ['Gaveta de stashes', ['s']],
];

const DOCKER = [
  ['Logs e métricas ao vivo', 'CPU, memória, rede, I/O e PIDs por container.'],
  ['Preview HTTP', 'GET na porta publicada: status, headers e corpo.'],
  ['Detalhe em 7 abas', 'Logs, env, config, processos, compose, arquivos.'],
  ['Compose num toque', 'up, down, --build e shell dentro do container.'],
];

const MODULOS = [
  ['PROJETO', '#e8ecf1', ['Visão Geral'], 'Stack, saúde, containers, git e atividade num painel.'],
  ['CÓDIGO', '#e3b341', ['Git', 'Worktrees', 'Releases', 'GH Actions', 'Jenkins'], 'Branches, commits, PR, graph, releases, runs e trigger.'],
  ['EXECUÇÃO', '#5aa9ff', ['Tarefas', 'Containers', 'Swarm', 'Kubernetes'], 'make/npm/just, start/stop, shell, logs, services e pods.'],
  ['REDE', '#46d17e', ['Nginx', 'Ngrok', 'CF Tunnel'], 'Vhosts, expor o local, requests ao vivo e URL pública.'],
  ['DADOS', '#f47ab8', ['API', 'Database'], 'Cliente HTTP e SQL, sem sair da tela.'],
  ['MESA', '#f39a4c', ['JSON', 'JWT'], 'Formatar JSON, inspecionar e validar tokens.'],
];

const ATALHOS = [
  ['/', 'Filtrar ao vivo'], ['Ctrl P', 'Busca fuzzy'], ['Enter', 'Abrir no Git'],
  ['c', 'Abrir nos Containers'], ['Tab', 'Próximo módulo'], ['⇧ E', 'Terminal no projeto'],
  ['⇧ T', 'Trocar tema'], ['⇧ C', 'Preferências'], ['Esc', 'Voltar um nível'], ['q', 'Sair'],
];

/* Dados do simulador. Fictícios, como as gravações: "contra projetos de demonstração". */
const SIM = [
  {
    n: 'api-pedidos', s: 'laravel · main', on: true, w: '⣀⣤⣶⣿',
    git: { b: 'main', sujo: 2, c: [
      ['a41f9c2', 'fix: arredonda frete antes do desconto', ['- $total = $frete * $desc;', '+ $total = round($frete, 2) * $desc;']],
      ['7be03d1', 'feat: webhook de pagamento aprovado', ['+ Route::post(\'/webhook/pago\', PagoController::class);']],
      ['c90a2e8', 'chore: sobe laravel 13', ['- "laravel/framework": "^12.0"', '+ "laravel/framework": "^13.0"']],
    ] },
    ct: [['api-pedidos-app-1', '8000', true, '3%'], ['api-pedidos-pg-1', '5432', true, '1%'], ['api-pedidos-redis-1', '6379', true, '0%']],
  },
  {
    n: 'landing', s: 'vite · :5173', on: true, w: '⣠⣴⣾⣿',
    git: { b: 'feat/hero', sujo: 0, c: [
      ['e2d7710', 'style: hero com vídeo em loop', ['+ <video autoplay muted loop playsinline>']],
      ['91cc4ab', 'perf: imagens em webp', ['- hero.png (1.8 MB)', '+ hero.webp (96 KB)']],
    ] },
    ct: [['landing-dev-1', '5173', true, '2%']],
  },
  {
    n: 'worker-fila', s: 'parado', on: false, w: '⣀⣀⡀⠀',
    git: { b: 'main', sujo: 1, c: [
      ['3fa88b0', 'fix: retry com backoff exponencial', ['- sleep(5);', '+ sleep(2 ** $tentativa);']],
    ] },
    ct: [['worker-fila-1', '—', false, '—'], ['worker-redis-1', '6379', true, '0%']],
  },
  {
    n: 'painel-admin', s: 'vue · main', on: true, w: '⣤⣶⣿⣿',
    git: { b: 'develop', sujo: 4, c: [
      ['b6e1f43', 'feat: filtro por período no dashboard', ['+ <DateRange v-model="periodo" />']],
      ['5d0c92e', 'fix: permissão do papel financeiro', ['- can(\'ver\', \'caixa\')', '+ can(\'ver\', \'financeiro.caixa\')']],
    ] },
    ct: [['painel-nginx-1', '8080', true, '1%'], ['painel-pg-1', '5432', true, '2%']],
  },
];
---

<Base title={titulo} description={descricao}>
  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta name="theme-color" content="#0b0e13" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'DevScope',
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Linux, macOS, Windows',
        description: descricao,
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' },
        codeRepository: GH,
        author: { '@type': 'Person', name: 'Igor Fronza' },
      })}
    />
  </Fragment>

  <div class="ds">
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>

    <header class="topo">
      <nav class="nav" aria-label="Principal">
        <a class="marca" href="#topo"><span>◆</span>devscope</a>
        <div class="nav-links">
          {NAV.map(([id, t]) => <a href={`#${id}`}>{t}</a>)}
        </div>
        <div class="nav-acoes">
          <a class="btn btn-ghost btn-sm nav-gh" href={GH} rel="noopener">GitHub</a>
          <a class="btn btn-primary btn-sm" href="#instalar">Instalar</a>
        </div>
      </nav>
      <div class="progresso" id="progresso" aria-hidden="true"></div>
    </header>

    <main id="conteudo">
      <!-- HERO -->
      <section id="topo" class="sec hero">
        <div class="deco" aria-hidden="true">
          <div class="dots" style="inset:-40px 0 0 0"></div>
          <div class="glow" style="width:760px;height:760px;right:-160px;top:-40px"></div>
          <div style="width:440px;height:440px;right:4%;top:30px"><div class="dia dia-g spin"></div></div>
          <div style="width:220px;height:220px;right:31%;top:330px"><div class="dia spin-r" style="opacity:.55"></div></div>
          <div style="width:380px;height:380px;left:-150px;bottom:-120px"><div class="ring spin-ring"></div></div>
          <div style="left:46%;top:96px"><div class="cross float">+</div></div>
          <div style="left:7%;top:64px"><div class="cross float-2">+</div></div>
          <div style="width:14px;height:14px;left:41%;bottom:120px"><div class="dia dia-fill float"></div></div>
        </div>
        <div class="caixa hero-in">
          <div class="hero-txt" data-stagger>
            <p class="selo mono"><span class="dot-live" aria-hidden="true"></span>TUI open source em Go · Linux · macOS · Windows</p>
            <h1>O <span class="mono verde">htop</span><br />dos seus projetos.</h1>
            <p class="lead">Containers, Git, CI, túneis, banco e saúde de todos os seus projetos — numa tela só, dentro do terminal.</p>

            <div class="instala" data-instala>
              <div class="instala-abas" role="tablist" aria-label="Sistema operacional">
                <button role="tab" aria-selected="true" data-os="unix">Linux · macOS</button>
                <button role="tab" aria-selected="false" data-os="win">Windows</button>
              </div>
              <div class="instala-cmd">
                <code><span class="verde" data-prompt>$</span> <span data-cmd></span></code>
                <button class="copiar" data-copiar aria-label="Copiar comando de instalação">Copiar</button>
              </div>
            </div>

            <div class="cta-row">
              <a class="btn btn-primary" href="#experimente">Experimentar agora <span class="cue" aria-hidden="true">↓</span></a>
              <a class="btn btn-ghost" href={GH} rel="noopener">Ver no GitHub</a>
            </div>
          </div>

          <figure class="hero-fig" data-rv="zoom">
            <div class="janela">
              <div class="janela-barra" aria-hidden="true"><i></i><i></i><i></i><span>~/projetos — devscope</span></div>
              <video src={`${MIDIA}/overview.mp4`} poster={`${MIDIA}/overview.webp`} muted loop playsinline preload="metadata" data-video aria-label="Gravação do DevScope: lista de projetos com onda de estado, filtro, busca fuzzy, módulos, ajuda e temas" width="1200" height="686"></video>
            </div>
            <figcaption>Gravação real, contra projetos de demonstração.</figcaption>
            <div class="hero-cards" aria-hidden="true">
              <div><span class="wave verde"><b style="--i:0">⣀</b><b style="--i:1">⣤</b><b style="--i:2">⣶</b><b style="--i:3">⣿</b></span><span>api-pedidos</span><em>laravel · main</em></div>
              <div><span class="wave verde"><b style="--i:2">⣠</b><b style="--i:3">⣴</b><b style="--i:4">⣾</b><b style="--i:5">⣿</b></span><span>landing</span><em>vite · :5173</em></div>
              <div><span class="perigo">⣀⣀⡀⠀</span><span>worker-fila</span><em class="perigo">parado</em></div>
            </div>
          </figure>
        </div>
      </section>

      <!-- FAIXA -->
      <section class="faixa" aria-label="Recursos">
        <div class="marquee mono">
          {[0, 1].map((k) => (
            <div aria-hidden={k ? 'true' : undefined}>
              {FAIXA.map((f) => <><span>{f}</span><span class="verde">◆</span></>)}
            </div>
          ))}
        </div>
      </section>

      <!-- NÚMEROS -->
      <section class="numeros" aria-label="Em números">
        <div class="caixa numeros-grade" data-stagger="pop">
          {NUMEROS.map(([n, t], i) => (
            <div><b class:list={['mono', { verde: i === 4 }]}>{n}</b><span>{t}</span></div>
          ))}
        </div>
      </section>

      <!-- 01 POR QUE -->
      <section id="por-que" class="sec">
        <div class="deco" aria-hidden="true">
          <div style="width:300px;height:300px;left:-170px;top:420px"><div class="ring spin-ring"></div></div>
          <div style="left:34%;top:70px"><div class="cross float-2">+</div></div>
        </div>
        <div class="caixa duas">
          <div class="col-fixa">
            <div class="fixa" data-rv="left">
              <p class="idx"><b>01</b> / por que existe</p>
              <h2>Você trabalha em projetos. Suas ferramentas, não.</h2>
              <p class="lead">Cada ferramenta enxerga uma unidade diferente: processo, container, serviço, repositório. Saber como está tudo numa segunda de manhã custa isso.</p>
            </div>
          </div>
          <div class="col-larga">
            <div class="cartao" data-rv>
              <div class="cartao-cab"><span class="perigo mono">antes</span><span class="mono mudo">8 comandos · 8 formatos de saída</span></div>
              <pre class="antes mono" data-stagger="left">{ANTES.map(([c, n]) => <span>{c} <i># {n}</i></span>)}</pre>
              <p class="cartao-pe">E nenhum deles sabe que tudo aquilo é <strong>o mesmo projeto</strong>.</p>
            </div>
            <div class="cartao depois" data-rv="zoom">
              <div class="cartao-cab"><span class="verde mono">depois</span><span class="mono mudo">1 comando · 1 tela</span></div>
              <p class="cmd-grande mono"><span class="verde">$</span> devscope<span class="caret" aria-hidden="true"></span></p>
              <p class="cinza">Ele varre o disco, detecta a stack e liga cada container, worker, porta, domínio e certificado <strong>ao projeto certo</strong>. E você opera tudo dali.</p>
              <div class="tags mono" data-stagger="pop">
                {['containers', 'pm2', 'git', 'ci', 'portas', 'nginx', 'ssl'].map((t) => <span>{t}</span>)}
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- PILARES -->
      <section class="caixa pilares-sec" aria-label="Em 30 segundos">
        <div class="pilares" data-stagger>
          {PILARES.map(([i, t, d]) => (
            <div><p class="idx">{i}</p><h3>{t}</h3><p>{d}</p></div>
          ))}
        </div>
      </section>

      <!-- EXPERIMENTE — simulador -->
      <section id="experimente" class="sec sim-sec">
        <div class="deco" aria-hidden="true">
          <div class="gridlines" style="inset:0"></div>
          <div class="glow" style="width:820px;height:820px;left:50%;top:50%;translate:-50% -50%"></div>
        </div>
        <div class="caixa">
          <div class="cab" data-rv>
            <p class="idx"><b>02</b> / experimente</p>
            <h2>Abra o DevScope aqui mesmo.</h2>
            <p class="lead">Um simulador com dados de mentira, mas as mesmas teclas. Use as setas e <span class="kbd">Enter</span>, ou toque nos botões embaixo da tela.</p>
          </div>

          <div class="sim" id="sim" data-rv="zoom" tabindex="0" role="application" aria-label="Simulador do DevScope. Setas movem, Enter abre o Git, c abre os containers, Esc volta, interrogação abre a ajuda.">
            <div class="janela">
              <div class="janela-barra" aria-hidden="true"><i></i><i></i><i></i><span id="sim-titulo">~/projetos — devscope</span></div>
              <div class="sim-tela mono" id="sim-tela" aria-live="polite"></div>
              <div class="sim-teclas" role="group" aria-label="Teclas do simulador">
                <button class="kbd" data-k="ArrowUp" aria-label="Seta para cima">↑</button>
                <button class="kbd" data-k="ArrowDown" aria-label="Seta para baixo">↓</button>
                <button class="kbd" data-k="Enter">Enter · Git</button>
                <button class="kbd" data-k="c">c · Containers</button>
                <button class="kbd" data-k="x" id="sim-x" hidden>x · parar/iniciar</button>
                <button class="kbd" data-k="?">? · Ajuda</button>
                <button class="kbd" data-k="Escape">Esc · Voltar</button>
              </div>
            </div>
          </div>
          <p class="sim-nota">Dica: clique na tela do simulador para o teclado funcionar nela.</p>
        </div>
      </section>

      <!-- 03 GIT -->
      <section id="git" class="sec fundo2">
        <div class="deco" aria-hidden="true">
          <div style="width:520px;height:520px;right:-200px;top:-180px"><div class="ring spin-ring" style="border-color:rgba(242,184,75,.16)"></div></div>
          <div style="width:12px;height:12px;right:18%;top:150px"><div class="dia float" style="background:var(--accent);border-color:var(--accent);opacity:.7"></div></div>
          <div class="dots" style="left:-60px;bottom:-40px;width:520px;height:420px"></div>
        </div>
        <div class="caixa">
          <div class="cab cab-linha" data-rv>
            <div><p class="idx"><b>03</b> / módulo git</p><h2>Git, sem sair do terminal.</h2></div>
            <p class="lead">Aperte <span class="kbd">Enter</span> num projeto e o Git dele está ali — sem <code class="mono">cd</code>, sem decorar flag.</p>
          </div>
          <div class="lado">
            <figure class="lado-m" data-rv="zoom">
              <div class="janela"><video src={`${MIDIA}/git.mp4`} poster={`${MIDIA}/git.webp`} muted loop playsinline preload="none" data-video aria-label="Módulo Git do DevScope: branches, commits, diff, Git Graph, stage, commit, log de comandos e stashes" width="1200" height="686"></video></div>
            </figure>
            <div class="lado-t">
              <ul class="atalhos-lista" data-stagger="right">
                {GIT.map(([t, ks]) => (
                  <li><span>{t}</span><span class="ks">{ks.map((k) => <span class="kbd">{k}</span>)}</span></li>
                ))}
              </ul>
              <div class="aviso" data-rv>
                <span class="kbd">Ctrl L</span>
                <p><strong>Nada acontece escondido.</strong> <span>O log mostra o <code class="mono">git</code> exato que rodou, com a saída.</span></p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 04 DOCKER -->
      <section id="docker" class="sec">
        <div class="deco" aria-hidden="true">
          <div class="gridlines" style="left:-120px;top:80px;width:680px;height:560px"></div>
          <div style="width:180px;height:180px;left:38%;bottom:60px"><div class="dia spin" style="border-color:rgba(90,169,255,.22)"></div></div>
        </div>
        <div class="caixa">
          <div class="cab cab-linha" data-rv>
            <div><p class="idx"><b>04</b> / módulo containers</p><h2>Docker, por projeto.</h2></div>
            <p class="lead"><span class="kbd">c</span> abre os containers só daquele projeto. O postgres do projeto A não se mistura com o do B.</p>
          </div>
          <div class="lado lado-inv">
            <div class="lado-t">
              <div class="grade-cards" data-stagger>
                {DOCKER.map(([t, d]) => <div class="card lift"><b>{t}</b><span>{d}</span></div>)}
              </div>
              <div class="aviso azul" data-rv>
                <p><strong>Segredos mascarados.</strong> <span>Pode abrir em call e tirar print.</span></p>
                <code class="mono">POSTGRES_PASSWORD=<i>s3••••••••</i></code>
              </div>
              <p class="cinza" data-rv>E quando o projeto pede: módulos de <strong>Swarm</strong> e <strong>Kubernetes</strong>.</p>
            </div>
            <figure class="lado-m" data-rv="zoom">
              <div class="janela"><video src={`${MIDIA}/docker.mp4`} poster={`${MIDIA}/docker.webp`} muted loop playsinline preload="none" data-video aria-label="Módulo Containers do DevScope: lista, portas com preview HTTP, logs, métricas, env com segredos mascarados, parar e iniciar" width="1200" height="686"></video></div>
            </figure>
          </div>
        </div>
      </section>

      <!-- 05 MÓDULOS -->
      <section id="modulos" class="sec fundo2">
        <div class="deco" aria-hidden="true">
          <div style="width:480px;height:480px;left:-240px;bottom:-120px"><div class="dia spin-r" style="opacity:.7"></div></div>
          <div style="left:22%;top:90px"><div class="cross float">+</div></div>
        </div>
        <div class="caixa duas">
          <div class="col-fixa">
            <div class="fixa" data-rv="left">
              <p class="idx"><b>05</b> / módulos</p>
              <h2>15 módulos, um contexto.</h2>
              <p class="lead">Cada módulo só aparece quando faz sentido para o projeto aberto. Projeto Go sem Docker não mostra containers — <span class="kbd">t</span> mostra todos.</p>
            </div>
          </div>
          <div class="modulos col-larga">
            <div class="modulos-cab mono"><span>CATEGORIA</span><span>MÓDULOS</span></div>
            <div data-stagger="left" data-step="110">
              {MODULOS.map(([cat, cor, mods, d]) => (
                <div class="modulo row-hover" style={`--cor:${cor}`}>
                  <b class="mono">{cat}</b>
                  <div><div>{mods.map((m) => <span class="mono">{m}</span>)}</div><p>{d}</p></div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- 06 ENTREGA -->
      <section id="deploy" class="sec">
        <div class="deco" aria-hidden="true">
          <div class="dots" style="right:-80px;top:-40px;width:620px;height:440px"></div>
          <div style="width:260px;height:260px;right:8%;top:40px"><div class="ring spin-ring"></div></div>
        </div>
        <div class="caixa">
          <div class="cab" data-rv>
            <p class="idx"><b>06</b> / do commit ao ar</p>
            <h2>Lançar e publicar sem esquecer passo.</h2>
            <p class="lead">Ele confere o que bloqueia antes de agir, mostra o que vai fazer e desfaz quando algo dá errado.</p>
          </div>
          <div class="duplo" data-stagger data-step="160">
            <div class="painel lift">
              <div class="painel-cab"><h3>Releases</h3><span class="mono mudo">em qualquer repositório git</span></div>
              <ol class="passos">
                <li><span class="mono">1</span><span>Mostra a última versão e sugere a próxima: patch, minor ou major.</span></li>
                <li><span class="mono">2</span><span>Bloqueia alteração sem commit, commit não enviado e branch sem upstream.</span></li>
                <li><span class="mono">3</span><span><span class="kbd">Enter</span> cria a tag anotada, envia e acompanha o workflow até publicar.</span></li>
              </ol>
              <p class="painel-pe">Falta <code class="mono">release.yml</code> ou <code class="mono">CHANGELOG.md</code>? Ele avisa antes de tentar.</p>
            </div>
            <div class="painel lift">
              <div class="painel-cab"><h3>Publicar no nginx</h3></div>
              <p class="cinza">Nenhum caminho nem porta digitados. Slug, porta, build e perfil são detectados, e a <code class="mono">.inc</code> aparece pronta antes.</p>
              <div class="term mono">
                <p><span class="verde">$</span> devscope nginx publish meu-app</p>
                <div data-stagger="left" data-step="260" data-base="200">
                  <p><span class="verde">✓</span> escreve sites/meu-app.inc <i>(anterior → .bak)</i></p>
                  <p><span class="verde">✓</span> nginx -t <i>(recusou? desfaz tudo)</i></p>
                  <p><span class="verde">✓</span> nginx -s reload</p>
                  <p><span class="verde">✓</span> smoke test <i>301 · 200 · sem 502</i></p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 07 ATALHOS -->
      <section id="atalhos" class="sec fundo2">
        <div class="deco" aria-hidden="true">
          <div style="width:200px;height:200px;right:-60px;top:60px"><div class="dia spin" style="border-color:rgba(242,184,75,.2)"></div></div>
        </div>
        <div class="caixa duas">
          <div class="col-fixa">
            <div class="fixa" data-rv="left">
              <p class="idx"><b>07</b> / atalhos</p>
              <h2>Feito para quem vive no teclado.</h2>
              <p class="lead">Três camadas de atalho: global, contextual e local, e a local vence. <span class="kbd">?</span> mostra tudo. Seus comandos ficam em <span class="kbd">1</span>…<span class="kbd">0</span>, e seu agente de IA abre na pasta do projeto.</p>
            </div>
          </div>
          <div class="grade-atalhos col-larga" data-stagger="pop" data-step="55">
            {ATALHOS.map(([k, t]) => <div class="lift"><span class="kbd">{k}</span><span>{t}</span></div>)}
          </div>
        </div>
      </section>

      <!-- 08 ARQUITETURA -->
      <section id="arquitetura" class="sec">
        <div class="deco" aria-hidden="true"><div class="gridlines" style="inset:0"></div></div>
        <div class="caixa">
          <div class="cab cab-linha" data-rv>
            <div><p class="idx"><b>08</b> / como funciona</p><h2>Coleta concorrente. Tela que nunca congela.</h2></div>
            <p class="lead">A UI desenha o último snapshot e segue — não espera um <code class="mono">docker inspect</code> lento.</p>
          </div>
          <div class="arch" data-stagger data-step="150">
            <div class="arch-col">
              <p class="mono mudo">COLETORES · em paralelo</p>
              <p class="chip mono">disco → detectores de framework</p>
              <div class="arch-grade">
                <p class="chip mono" style="--c:var(--c-run)">docker</p>
                <p class="chip mono" style="--c:var(--c-run)">pm2</p>
                <p class="chip mono" style="--c:var(--c-code)">git</p>
                <p class="chip mono" style="--c:var(--c-net)">health · ssl</p>
                <p class="chip mono" style="--c:var(--c-net);grid-column:span 2">nginx · portas</p>
              </div>
            </div>
            <svg class="seta" aria-hidden="true" width="56" height="24" viewBox="0 0 56 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h50M44 4l8 8-8 8"></path></svg>
            <div class="arch-no verde-no"><p class="mono verde">STATESTORE</p><b>Snapshot imutável</b><span>a UI nunca lê dado mutável</span></div>
            <svg class="seta" aria-hidden="true" width="56" height="24" viewBox="0 0 56 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h50M44 4l8 8-8 8"></path></svg>
            <div class="arch-no"><p class="mono mudo">TERMINAL</p><b>Bubble Tea UI</b><span>modelo Elm</span></div>
          </div>
          <div class="arch-pe" data-rv>
            <p class="mono cinza">Go 1.24+ · Bubble Tea · Lip Gloss · Cobra + Viper</p>
            <a href={`${GH}/blob/main/docs/ARCHITECTURE.md`} rel="noopener">Ler ARCHITECTURE.md →</a>
          </div>
        </div>
      </section>

      <!-- 09 CLI / CONFIG -->
      <section id="config" class="fundo2 borda">
        <div class="caixa duplo-cod" data-stagger data-step="140">
          <div>
            <p class="idx"><b>09</b> / fora da TUI</p>
            <h3>Também para scripts e automação.</h3>
            <pre class="cod mono"><span class="verde">$</span> devscope scan --json   <i># snapshot em JSON</i>
<span class="verde">$</span> devscope watch         <i># painel com auto-refresh</i>
<span class="verde">$</span> devscope version       <i># versão, commit e build</i></pre>
          </div>
          <div>
            <p class="idx"><b>10</b> / preferências</p>
            <h3>Do seu jeito, aplicado na hora.</h3>
            <pre class="cod mono"><i># ~/.config/devscope/user_config.txt</i>
<b>Theme:</b> dracula-vivid
<b>Commands:</b> {'{ "1": {"name": "Lazygit", "command": "lazygit"} }'}
<b>AI:</b> claude</pre>
            <p class="cinza peq"><span class="kbd">⇧ C</span> edita dentro do app, sem reiniciar. Toda chave aceita env com prefixo <code class="mono">DEVSCOPE_</code>.</p>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section id="instalar" class="sec cta borda">
        <div class="deco" aria-hidden="true">
          <div class="dots" style="inset:0"></div>
          <div class="glow" style="width:900px;height:900px;right:-250px;top:-200px"></div>
          <div style="width:620px;height:620px;right:-120px;top:-60px"><div class="dia dia-g spin"></div></div>
          <div style="width:440px;height:440px;right:-30px;top:30px"><div class="dia spin-r" style="opacity:.55"></div></div>
        </div>
        <div class="caixa cta-in">
          <div class="cta-txt" data-stagger>
            <div class="wave mono verde" aria-hidden="true"><b style="--i:0">⣀</b><b style="--i:1">⣠</b><b style="--i:2">⣤</b><b style="--i:3">⣴</b><b style="--i:4">⣶</b><b style="--i:5">⣿</b></div>
            <h2>Uma tela.<br />Todos os projetos.</h2>
            <p class="lead">Instale em um comando e rode <code class="mono">devscope</code>. Para desinstalar, basta apagar um arquivo.</p>
            <div class="cta-row">
              <a class="btn btn-primary" href={GH} rel="noopener">Dar uma estrela no GitHub</a>
              <a class="btn btn-ghost" href={`${GH}/releases`} rel="noopener">Baixar binário</a>
            </div>
          </div>
          <div class="cta-cmd" data-rv="right">
