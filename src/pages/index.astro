---
import Base from '../layouts/Base.astro';

/*
  PORTFOLIO — Igor Fronza.

  Conceito: terminal. A home mostra o que eu sei fazer e a prova de cada coisa
  (skills, projetos, segurança), e deixa os sites sob medida e os preços para
  o fim da página.

  Tudo é HTML estático. O JavaScript só cuida do que é interativo: o terminal
  do topo que se monta sozinho, o filtro de skills, a vitrine de sites, o
  simulador de preço e o botão de copiar o e-mail. As animações de digitação,
  fade, glitch e parallax são CSS puro (`animation-timeline: view()` onde o
  navegador suporta) e param com `prefers-reduced-motion`.

  Os preços moram em PRECO e alimentam os cards, o simulador e o JSON-LD.
  Textos que dependem de você (disponibilidade, estudo, provas) estão nas
  constantes logo abaixo: troque ali.
*/

const BASE = import.meta.env.BASE_URL;

const EU = {
  nome: 'Igor Fronza',
  papel: 'Engenheiro de software',
  gh: 'PirataZang',
  email: 'igorfronza20@gmail.com',
  zap: '5547989022030',
  zapFmt: '(47) 98902-2030',
  cidade: 'Rio do Sul',
  uf: 'SC',
  site: 'https://igorfronza.dev',
  linkedin: 'https://www.linkedin.com/in/igor-fronza-592796249',
  insta: 'https://www.instagram.com/igorfronza_official',
};
const zap = (msg: string) => `https://wa.me/${EU.zap}?text=${encodeURIComponent(msg)}`;

const PRECO = { pagina: 500, extra: 250, pix: 0.1, hospedagem: 50 };
const brl = (v: number) =>
  'R$ ' + v.toLocaleString('pt-BR', { minimumFractionDigits: v % 1 ? 2 : 0, maximumFractionDigits: 2 });

const DISPONIBILIDADE = 'disponível para conversar';

/* rampa de braille das barras de nível, como no DevScope */
const RAMPA = ['⣀', '⣤', '⣶', '⣾', '⣿'];
const AREAS = {
  dev: { rotulo: 'dev', cor: '#fcaf3e' },
  infra: { rotulo: 'infra', cor: '#729fcf' },
  seg: { rotulo: 'seg', cor: '#8ae234' },
} as const;
type Area = keyof typeof AREAS;

const SKILLS: { area: Area; nome: string; nivel: number; prova: string }[] = [
  { area: 'dev', nome: 'Go', nivel: 4, prova: 'DevScope: TUI em Go, binário único, com releases automatizadas.' },
  { area: 'dev', nome: 'Vue 3 e Nuxt', nivel: 4, prova: 'Interfaces e sites sob medida do dia a dia.' },
  { area: 'dev', nome: 'Laravel, PHP e NestJS', nivel: 4, prova: 'Back-ends e APIs dos sistemas sob medida.' },
  { area: 'dev', nome: 'TypeScript e Astro', nivel: 4, prova: 'Este portfólio e os sites de projetos, estáticos e rápidos.' },
  { area: 'dev', nome: 'HTML, CSS e Tailwind', nivel: 5, prova: 'Demos de sites completos, do layout ao responsivo.' },
  { area: 'dev', nome: 'JavaScript no navegador', nivel: 4, prova: 'Simulador do DevScope: teclado, Git e containers funcionando no navegador.' },
  { area: 'dev', nome: 'Trabalho com IA (prompts)', nivel: 4, prova: 'Uso o Claude no dia a dia para construir este portfólio e os projetos.' },
  { area: 'infra', nome: 'Docker e Compose', nivel: 4, prova: 'Todo o ambiente deste portfólio sobe com um comando.' },
  { area: 'infra', nome: 'Linux e nginx', nivel: 4, prova: 'Servidor, proxy e publicação configurados à mão.' },
  { area: 'infra', nome: 'Git e CI', nivel: 3, prova: 'GitHub Actions e releases versionadas no DevScope.' },
  { area: 'seg', nome: 'Segurança web (OWASP)', nivel: 2, prova: 'Em estudo: OWASP Top 10 e laboratórios práticos.' },
  { area: 'seg', nome: 'Redes e HTTP', nivel: 3, prova: 'Base do estudo de segurança web e do hardening deste site.' },
  { area: 'seg', nome: 'Hardening de servidor', nivel: 3, prova: 'Em andamento: CSP, HSTS e security.txt neste site.' },
  { area: 'seg', nome: 'CTF e laboratórios', nivel: 2, prova: 'Começando: laboratórios práticos de segurança web.' },
];
const FILTROS: [string, string][] = [['all', 'todos'], ['dev', 'dev'], ['infra', 'infra'], ['seg', 'segurança']];
const contar = (f: string) => (f === 'all' ? SKILLS.length : SKILLS.filter((s) => s.area === f).length);
const resumoSkills = (lista: typeof SKILLS) =>
  `Habilidades carregadas: ${lista.length} · em estudo: ${lista.filter((s) => s.nivel <= 2).length} · falhas: 0`;

const LAB = [
  { status: 'em andamento', cor: '#4fe3b0', titulo: 'Trilha de segurança web', nota: 'Estudo guiado do OWASP Top 10, anotando o que aprendo em cada tópico.' },
  { status: 'em andamento', cor: '#4fe3b0', titulo: 'Hardening deste site', nota: 'CSP, HSTS e demais headers, com a nota pública em securityheaders.com.' },
  { status: 'a publicar', cor: '#f5a524', titulo: 'Write-up #1', nota: 'O passo a passo de um laboratório, incluindo os becos sem saída.' },
  { status: 'a publicar', cor: '#f5a524', titulo: 'Ferramenta própria', nota: 'Uma ferramenta de segurança com código aberto no GitHub.' },
  { status: 'meta', cor: '#8b95a3', titulo: 'Primeira certificação', nota: 'Entra aqui só depois de aprovado.' },
];

const DEMOS = [
  { slug: 'alpine-refresh', nome: 'Alpine Refresh', nicho: 'Marca de bebidas', desc: 'A página conta a história da marca conforme você rola, com cenas em parallax de várias camadas.', tags: ['Narrativa por scroll', 'Parallax em camadas'] },
  { slug: 'barbearia', nome: "Daniel's", nicho: 'Barbearia', desc: 'Capa com foto e agendamento em um toque.', tags: ['Capa com foto', 'Agendamento em 1 toque'] },
  { slug: 'arquitetura', nome: 'PRUMO', nicho: 'Arquitetura e engenharia', desc: 'Planta interativa para explorar o projeto e uma cena guiada pelo scroll.', tags: ['Planta interativa', 'Cena por scroll'] },
  { slug: 'marmoraria', nome: 'Marmoraria', nicho: 'Mármores e granitos', desc: 'Comparador de acabamentos lado a lado e pedido de orçamento.', tags: ['Comparador de acabamentos', 'Orçamento'] },
  { slug: 'imobiliaria', nome: 'Meridiano Imóveis', nicho: 'Imobiliária', desc: 'Carteira de imóveis com ficha em modal e ilustrações geradas no próprio build, sem fotos.', tags: ['Ficha em modal', 'Ilustrações no build'] },
  { slug: 'pulse', nome: 'PULSE', nicho: 'Festival de música eletrônica', desc: 'Carrinho, compra simulada e ingresso com QR code no final.', tags: ['Carrinho', 'Compra simulada', 'Ingresso com QR'] },
].map((d) => ({ ...d, img: `${BASE}demos/${d.slug}.webp`, url: `${BASE}sites/${d.slug}/`, ask: zap(`Oi, Igor. Quero um site como o ${d.nome}.`) }));
const DEMO0 = 3;

const PLANOS = [
  { id: 'site', nome: 'Criação de site', prazo: '1 a 2 semanas', de: PRECO.pagina, un: '', destaque: true, cta: 'Quero um site',
    d: `Uma página com escopo fechado. Página extra: + ${brl(PRECO.extra)}.`, itens: ['Design próprio', 'Formulário que chega no WhatsApp', 'Domínio e SSL configurados', '30 dias de ajustes'] },
  { id: 'sistema', nome: 'Sistema sob medida', prazo: '4 a 12 semanas', de: 3000, un: '', destaque: false, cta: 'Quero um sistema',
    d: 'Entregue em etapas, cada uma com escopo e preço fechados.', itens: ['Login por usuário', 'Relatórios em Excel e PDF', 'Integrações com nova tentativa automática', 'Backup automático'] },
  { id: 'consultoria', nome: 'Consultoria técnica', prazo: 'por hora', de: 280, un: '/h', destaque: false, cta: 'Quero uma consultoria',
    d: 'Ou pacote de 10 horas por R$ 2.500, com relatório escrito.', itens: ['Revisão de código', 'Medição de desempenho', 'Escolha de ferramentas', 'Pair programming'] },
  { id: 'hospedagem', nome: 'Hospedagem', prazo: 'por site · opcional', de: PRECO.hospedagem, un: '/mês', destaque: false, cta: 'Quero hospedagem',
    d: 'Sistema em servidor dedicado: R$ 300/mês.', itens: ['Banco de dados', 'Backups', 'Monitoramento'] },
];
const INCLUI = ['Design próprio, sem template', 'Imagens leves em WebP e botões fáceis de tocar no celular', 'Prévia bonita quando o link é compartilhado', 'Animação e 3D só quando ajudam, respeitando quem prefere menos movimento'];
const PAGTO = ['40% na entrada, o restante na entrega', 'Até 6x sem juros no cartão', '10% de desconto no Pix à vista', 'Emito nota fiscal'];

const RESUMO = [
  ['cargo', 'Engenheiro de software'],
  ['stack', 'Go · Vue · Laravel · NestJS'],
  ['infra', 'Linux · Docker · nginx'],
  ['foco', 'segurança de aplicações (estudando)'],
  ['local', `${EU.cidade}, ${EU.uf} · atendo o Brasil inteiro`],
  ['status', DISPONIBILIDADE],
];

/* ---- terminal do topo ---- */
const T_LOGS = [
  { label: 'skills', val: '11 módulos', s: 1500, ok: 2100 },
  { label: 'projetos', val: 'devscope · spill · financer', s: 1850, ok: 2500 },
  { label: 'interface', val: 'terminal', s: 2200, ok: 3000 },
  { label: 'hardening', val: 'em andamento', s: 2550, ok: 0 },
];
const LETRAS = {
  I: [' ___ ', '|_ _|', ' | | ', ' | | ', '|___|'],
  G: ['  ____ ', ' / ___|', '| |  _ ', '| |_| |', ' \\____|'],
  O: ['  ___  ', ' / _ \\ ', '| | | |', '| |_| |', ' \\___/ '],
  R: [' ____  ', '|  _ \\ ', '| |_) |', '|  _ < ', '|_| \\_\\'],
};
const BANNER = [0, 1, 2, 3, 4].map((i) => LETRAS.I[i] + LETRAS.G[i] + LETRAS.O[i] + LETRAS.R[i]);
const mix = (a: string, b: string, f: number) => {
  const h = (c: string) => [1, 3, 5].map((i) => parseInt(c.slice(i, i + 2), 16));
  const A = h(a), B = h(b);
  return '#' + A.map((v, i) => Math.round(v + (B[i] - v) * f).toString(16).padStart(2, '0')).join('');
};
const BANNER_COR = BANNER.map((_, i) => mix('#4fe3b0', '#f5a524', i / 4));
const T_INFO: [string, string, string][] = [
  ['nome', 'Igor Fronza', '#f5a524'],
  ['cargo', 'Engenheiro de software', '#f5a524'],
  ['stack', 'Go · Vue · Laravel · NestJS', '#f5a524'],
  ['infra', 'Linux · Docker · nginx', '#f5a524'],
  ['foco', 'Segurança de aplicações', '#4fe3b0'],
  ['local', `${EU.cidade}, ${EU.uf}`, '#8b95a3'],
  ['status', DISPONIBILIDADE, '#8b95a3'],
];
const T_PAL = ['#e5484d', '#f5a524', '#4fe3b0', '#5fd3ff', '#7aa2ff', '#c4b5fd', '#d8dde5', '#4a5461'];

/* ---- SEO ---- */
const titulo = `${EU.nome} — Engenheiro de software em ${EU.cidade}, ${EU.uf}`;
const descricao =
  'Engenheiro de software em Rio do Sul (SC). Ferramentas em Go, sites em Vue e Astro, Docker e Linux, com foco em segurança de aplicações. Projetos: DevScope, Spill e Financer. Sites sob medida a partir de R$ 500.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${EU.site}/#igor`,
      name: EU.nome,
      jobTitle: EU.papel,
      url: EU.site,
      email: EU.email,
      address: { '@type': 'PostalAddress', addressLocality: EU.cidade, addressRegion: EU.uf, addressCountry: 'BR' },
      knowsAbout: ['Go', 'Vue', 'Laravel', 'NestJS', 'Astro', 'Docker', 'Linux', 'Segurança de aplicações'],
      sameAs: [EU.linkedin, EU.insta, `https://github.com/${EU.gh}`],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${EU.site}/#servico`,
      name: `${EU.nome} · Desenvolvimento`,
      url: EU.site,
      areaServed: 'BR',
      provider: { '@id': `${EU.site}/#igor` },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Serviços',
        itemListElement: PLANOS.map((p) => ({
          '@type': 'Offer',
          name: p.nome,
          description: p.d,
          priceCurrency: 'BRL',
          price: String(p.de),
          priceSpecification: { '@type': 'PriceSpecification', minPrice: String(p.de), priceCurrency: 'BRL' },
        })),
      },
    },
  ],
};

const fim = (s: string) => s; // legibilidade dos blocos estáticos abaixo
const HOST = `${BASE}projetos`;
---

<Base title={titulo} description={descricao}>
  <Fragment slot="head">
    <link rel="canonical" href={EU.site} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b0d11" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&family=Ubuntu+Mono:wght@400;700&family=Geist:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="tm">
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>

      <!-- BARRA -->
      <header style="border-bottom:1px solid #232a33">
        <div style="max-width:1160px;margin:0 auto;padding:0 32px;min-height:64px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px 24px">
          <a href="#topo" style="font-family:'IBM Plex Mono',monospace;font-size:15px;font-weight:600;color:#d8dde5;padding:10px 0">igor@fronza<span style="color:#8b95a3">:~$</span></a>
          <nav class="nav" aria-label="Seções" style="display:flex;flex-wrap:wrap;gap:4px 22px;font-family:'IBM Plex Mono',monospace;font-size:14px;color:#8b95a3">
            <a href="#skills" style="padding:12px 0">skills/</a>
            <a href="#projetos" style="padding:12px 0">projetos/</a>
            <a href="#seguranca" style="padding:12px 0">seguranca/</a>
            <a href="#sites" style="padding:12px 0">sites/</a>
            <a href="#contato" style="padding:12px 0">contato.sh</a>
          </nav>
        </div>
      </header>

    <main id="conteudo">
      <!-- HERO -->
      <div style="position:relative;isolation:isolate;overflow:hidden">
      <div aria-hidden="true" style="position:absolute;inset:0;z-index:-1;pointer-events:none">
        <div class="dots" style="position:absolute;inset:0"></div>
        <div class="ruler" style="position:absolute;left:0;top:0;bottom:0"></div>
        <div class="dr" style="position:absolute;right:-170px;top:-130px;width:660px;height:660px"><div class="anel spin" style="width:100%;height:100%"></div></div>
        <div class="dr" style="position:absolute;left:-130px;bottom:-150px;width:380px;height:380px"><div class="anel2" style="width:100%;height:100%"></div></div>
        <div class="dr" style="position:absolute;right:30%;top:70px;width:170px;height:170px"><div class="sq" style="width:100%;height:100%"></div></div>
        <div class="cross" style="position:absolute;left:11%;top:64px"></div>
        <div class="cross" style="position:absolute;left:49%;bottom:90px;color:#f5a524"></div>
        <div class="cross" style="position:absolute;right:7%;top:62%;color:#4fe3b0"></div>
        <div class="cur" style="--c:#f5a524;position:absolute;left:7%;top:44%;width:9px;height:9px"></div>
        <span style="position:absolute;left:36px;bottom:20px;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.08em;color:#3a4552">27°12′S 49°38′W</span>
      </div>
      <section id="topo" style="max-width:1160px;margin:0 auto;padding:88px 32px 96px;display:flex;flex-wrap:wrap;gap:56px;align-items:center">
        <div style="flex:1 1 480px;min-width:0;display:flex;flex-direction:column;gap:24px">
          <div class="h-ty" style="--w:8.3ch;--n:8;--dur:.7s;--delay:.2s;--caret:#f5a524;font-family:'IBM Plex Mono',monospace;font-size:15px;color:#8b95a3">$ whoami</div>
          <h1 style="margin:0;font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:clamp(44px,8vw,92px);line-height:1;letter-spacing:-.04em;color:#fff">
            <span class="h-ty" style="--w:2.4em;--n:4;--dur:.5s;--delay:1s;--caret:#f5a524">Igor</span>
            <span class="h-ty" style="--w:3.5em;--n:6;--dur:.7s;--delay:1.6s;--caret:#f5a524">Fronza</span>
          </h1>
          <div style="display:flex;flex-direction:column;gap:2px;font-family:'IBM Plex Mono',monospace;font-size:clamp(16px,2.4vw,22px);line-height:1.5;color:#f5a524">
            <span class="h-ty" style="--w:22.3ch;--n:22;--dur:.9s;--delay:2.5s;--caret:#f5a524">engenheiro de software</span>
            <span class="h-ty" style="--w:19.3ch;--n:19;--dur:.8s;--delay:3.5s;--caret:#f5a524">estudando segurança</span>
          </div>
          <p class="fx" style="--d:4.5s;margin:0;font-size:18px;line-height:1.6;color:#aab3bf;max-width:56ch">Escrevo ferramentas em <span class="kw" style="--c:#f5a524;--d:5.6s">Go</span>, sites em <span class="kw" style="--c:#f5a524;--d:6s">Vue e Astro</span> e rodo tudo em <span class="kw" style="--c:#f5a524;--d:6.4s">Docker</span>. Agora estou levando esse mesmo cuidado para a <span class="kw" style="--c:#4fe3b0;--d:6.8s">segurança</span>: aprender como as coisas quebram para construir as que não quebram. Aqui embaixo está o que eu sei fazer e a prova de cada coisa.</p>
          <div class="fx" aria-hidden="true" style="--d:4.9s;display:flex;align-items:center;gap:10px;font-family:'IBM Plex Mono',monospace;font-size:15px;color:#d8dde5">
            <span style="color:#4fe3b0">$</span>
            <span style="display:grid">
              <span class="cyc" style="--w:14.2ch;--n:14;--delay:5.2s;--caret:#f5a524">go build ./...</span>
              <span class="cyc" style="--w:20.2ch;--n:20;--delay:9.2s;--caret:#f5a524">docker compose up -d</span>
              <span class="cyc" style="--w:28.2ch;--n:28;--delay:13.2s;--caret:#f5a524">curl -sI localhost | grep -i csp</span>
            </span>
          </div>
          <div class="fx" style="--d:5.1s;display:flex;flex-wrap:wrap;gap:12px;padding-top:8px">
            <a class="bt" href="#projetos" style="--sh:#d8dde5;display:inline-flex;align-items:center;min-height:48px;padding:0 22px;border-radius:8px;background:#f5a524;color:#0b0d11;font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:15px">ls projetos/</a>
            <a class="lnk bt" href="#skills" style="--sh:#f5a524;display:inline-flex;align-items:center;min-height:48px;padding:0 22px;border-radius:8px;border:1px solid #2c3540;color:#d8dde5;font-family:'IBM Plex Mono',monospace;font-size:15px">cat skills.md</a>
          </div>
        </div>

        <div class="fx" style="--d:.4s;flex:1 1 440px;min-width:0">
          <div class="term" data-terminal>
            <div class="term-bar">
              <span aria-hidden="true" style="width:10px;height:10px;border-radius:50%;background:#2c3540"></span>
              <span aria-hidden="true" style="width:10px;height:10px;border-radius:50%;background:#2c3540"></span>
              <span aria-hidden="true" style="width:10px;height:10px;border-radius:50%;background:#2c3540"></span>
              <span style="margin-left:10px;font-size:13px;color:#8b95a3">igor@fronza: ~</span>
              <button class="rp" type="button" data-replay aria-label="Repetir a animação do terminal">↻ replay</button>
            </div>
            <p class="sr">Terminal animado com o resumo do Igor Fronza: engenheiro de software em {EU.cidade}, {EU.uf}. Stack em Go, Vue, Laravel e NestJS. Infra em Linux, Docker e nginx. Foco em segurança de aplicações.</p>
            <div class="term-body tb-pending" aria-hidden="true" data-body>
              <div style="white-space:pre"><span style="color:#4fe3b0">$</span> <span data-typed data-full="./montar-portfolio.sh">./montar-portfolio.sh</span><span class="caret" data-caret style="background:#f5a524;display:none"></span></div>

              <div style="display:flex;flex-direction:column;gap:2px">
                {T_LOGS.map((l) => (
                  <div data-log data-s={l.s} data-ok={l.ok} style="display:flex;align-items:baseline;gap:10px">
                    <span style="flex:0 0 auto;white-space:pre;color:#8b95a3">[<span style="display:inline-block;width:4ch;text-align:center"><span data-oktag style={`color:#4fe3b0;${l.ok ? '' : 'display:none'}`}>ok</span><span class="sp" data-sp style={`color:#f5a524;${l.ok ? 'display:none' : ''}`}></span></span>]</span>
                    <span style="flex:0 0 auto;color:#d8dde5">{l.label}</span>
                    <span style="flex:1 1 12px;min-width:12px;border-bottom:1px dotted #2c3540;transform:translateY(-4px)"></span>
                    <span data-val style={`flex:0 0 auto;color:${l.ok ? '#8b95a3' : '#f5a524'}`}>{l.val}</span>
                  </div>
                ))}
              </div>

              <div data-build style="display:flex;align-items:center;gap:12px">
                <span style="flex:0 0 auto;color:#d8dde5">build</span>
                <span style="position:relative;flex:1 1 120px;height:10px;background:repeating-linear-gradient(90deg,#222a33 0 8px,transparent 8px 11px)"><span data-fill style="position:absolute;left:0;top:0;bottom:0;width:100%;background:repeating-linear-gradient(90deg,#f5a524 0 8px,transparent 8px 11px)"></span></span>
                <span data-pct style="flex:0 0 4ch;text-align:right;color:#4fe3b0">100%</span>
              </div>

              <div style="display:flex;flex-direction:column;font-size:16px;line-height:1.12;padding:2px 0">
                {BANNER.map((l, i) => (
