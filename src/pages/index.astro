  ...DESTAQUES.map((d) => {
    const r = porNome.get(d.repo.toLowerCase());
    return {
      ...d,
      nome: r?.name ?? d.repo,
      lang: r?.language ?? d.lang ?? null,
      estrelas: r?.stargazers_count ?? 0,
      url: r?.html_url ?? `https://github.com/${EU.gh}/${d.repo}`,
      aoVivo: r?.homepage || d.vivo || null,
      empurrado: r?.pushed_at ?? null,
    };
  }),
  ...resto,
];

