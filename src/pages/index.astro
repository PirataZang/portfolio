/*
  A API pública dá 60 chamadas por hora por IP, e o `astro dev` reexecuta este
  frontmatter a cada request — duas chamadas por reload torram a cota numa
  tarde, e a página passa a mostrar "0 repositórios". Então: cache em arquivo,
  válido por 6 h, e se a chamada falhar o cache velho ganha de nada.

  Fica em node_modules/.cache porque é lixo de build: não versiona, e o
  .dockerignore não copia — o build de produção sempre busca fresco.
*/
const PASTA = 'node_modules/.cache';
const CACHE = `${PASTA}/github-${EU.gh}.json`;
const VALIDADE = 6 * 60 * 60 * 1000;

type Dados = { perfil: any; repos: any[] };

function lerCache(): { em: number; d: Dados } | null {
  try {
    return JSON.parse(readFileSync(CACHE, 'utf8'));
  } catch {
    return null;
  }
}

async function pegar(caminho: string) {
  const r = await fetch(`https://api.github.com${caminho}`, {
    headers: { Accept: 'application/vnd.github+json', 'User-Agent': 'portfolio-build' },
  });
  if (!r.ok) throw new Error(`${r.status} em ${caminho}`);
  return r.json();
}

async function github(): Promise<Dados> {
  const cache = lerCache();
  if (cache && Date.now() - cache.em < VALIDADE) return cache.d;

  try {
    const [perfil, repos] = await Promise.all([
      pegar(`/users/${EU.gh}`),
      pegar(`/users/${EU.gh}/repos?per_page=100&sort=pushed`),
    ]);
    /* resposta de limite estourado vem 200 em alguns casos, e é um objeto:
       sem esta checagem `repos.filter` explodiria o build */
    if (!perfil?.login || !Array.isArray(repos)) throw new Error('resposta inesperada');
    const d: Dados = { perfil, repos };
    try {
      mkdirSync(PASTA, { recursive: true });
      writeFileSync(CACHE, JSON.stringify({ em: Date.now(), d }));
    } catch {
      /* sem permissão de escrita: perde só o cache, não a página */
    }
    return d;
  } catch {
    return cache?.d ?? { perfil: null, repos: [] };
  }
}

const { perfil, repos } = await github();
const porNome = new Map(repos.map((r) => [r.name.toLowerCase(), r]));

const veste = (r: any) => ({
  nome: r.name,
  tipo: r.language ?? 'Projeto',
  resumo: r.description ?? '',
  lang: r.language ?? null,
  estrelas: r.stargazers_count ?? 0,
  url: r.html_url,
  aoVivo: r.homepage || null,
  empurrado: r.pushed_at ?? null,
});

/*
  Os curados abrem a fila; todo repositório público que eu criar depois entra
  no fim sozinho, sem eu voltar aqui. Fora: fork, arquivado e o repo de mesmo
  nome do usuário, que é só o README do perfil.
*/
const naLista = new Set(DESTAQUES.map((d) => d.repo.toLowerCase()));
const resto = repos
  .filter(
    (r) =>
      !r.fork &&
      !r.archived &&
      r.name.toLowerCase() !== EU.gh.toLowerCase() &&
      !naLista.has(r.name.toLowerCase()),
  )
  .map(veste);

