---
import Base from '../layouts/Base.astro';

/*
  PORTFOLIO — Igor Fronza.

  Home enxuta: uma página que vende (sites prontos, preço, processo, projetos,
  dúvidas, contato) e nada que só enfeite. Fundo quase preto, amarelo de
  fita métrica como único acento, formas geométricas finas ao fundo.

  O fechamento acontece no WhatsApp: o formulário monta a mensagem e abre
  wa.me — site estático não tem para onde postar, e nada fica gravado aqui.

  Os preços moram em PRECO e alimentam o simulador, os cards, o JSON-LD e o
  FAQ ao mesmo tempo: mudou o valor, muda num lugar só.
*/

const BASE = import.meta.env.BASE_URL;

const EU = {
  nome: 'Igor Fronza',
  papel: 'Engenheiro de software',
  gh: 'PirataZang',
  email: 'igorfronza20@gmail.com',
  zap: '5547989022030',
  zapFmt: '(47) 98902-2030',
  cidade: 'Rio do Sul',
  uf: 'SC',
  site: 'https://igorfronza.dev',
  linkedin: 'https://www.linkedin.com/in/igor-fronza-592796249',
  insta: 'https://www.instagram.com/igorfronza_official',
};
const ZAP = `https://wa.me/${EU.zap}`;

const PRECO = { pagina: 500, extra: 250, pix: 0.1, hospedagem: 50 };

const CHECK =
  '<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--ok)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>';
const SETA =
  '<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8"></path></svg>';
const GITHUB =
  '<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-4 1.3-4-2-6-2.5M15 21v-3.5a3 3 0 0 0-.9-2.3c3-.3 6-1.5 6-6.5a5 5 0 0 0-1.4-3.5 4.6 4.6 0 0 0-.1-3.5s-1.1-.3-3.6 1.4a12.4 12.4 0 0 0-6.5 0C6 1.4 4.9 1.7 4.9 1.7a4.6 4.6 0 0 0-.1 3.5A5 5 0 0 0 3.4 8.7c0 5 3 6.2 6 6.5a3 3 0 0 0-.9 2.3V21"></path></svg>';

const NAV = [
  ['sites', 'Sites prontos'],
  ['projetos', 'Projetos'],
  ['servicos', 'Serviços'],
  ['processo', 'Como funciona'],
  ['duvidas', 'Dúvidas'],
];

const STACK = ['Vue 3', 'Nuxt', 'React', 'Laravel', 'PHP', 'NestJS', 'Go', 'Docker', 'Git', 'Claude', 'OpenAI', 'Gemini'];

const DEMOS = [
  { slug: 'alpine-refresh', nome: 'Alpine Refresh', nicho: 'Marca de bebidas', desc: 'A página conta a história da marca conforme você rola, com cenas em parallax de várias camadas.', tags: ['Narrativa por scroll', 'Parallax em camadas'] },
  { slug: 'barbearia', nome: "Daniel's", nicho: 'Barbearia', desc: 'Capa com foto e agendamento em um toque.', tags: ['Capa com foto', 'Agendamento em 1 toque'] },
  { slug: 'arquitetura', nome: 'PRUMO', nicho: 'Arquitetura e engenharia', desc: 'Planta interativa para explorar o projeto e uma cena guiada pelo scroll.', tags: ['Planta interativa', 'Cena por scroll'] },
  { slug: 'marmoraria', nome: 'Marmoraria', nicho: 'Mármores e granitos', desc: 'Comparador de acabamentos lado a lado e pedido de orçamento.', tags: ['Comparador de acabamentos', 'Orçamento'] },
  { slug: 'nova', nome: 'Vereda', nicho: 'Psicologia clínica', desc: 'Fotografia grande e planos lado a lado, fáceis de comparar.', tags: ['Fotografia grande', 'Planos comparáveis'] },
  { slug: 'pulse', nome: 'PULSE', nicho: 'Festival de música eletrônica', desc: 'Carrinho, compra simulada e ingresso com QR code no final.', tags: ['Carrinho', 'Compra simulada', 'Ingresso com QR'] },
];

/* ícones: só o conteúdo do <svg>, 24x24, traço 1.8 */
const SERVICOS = [
  {
    id: 'site', t: 'Criação de site', de: PRECO.pagina, unidade: '', prazo: '1 a 2 semanas', destaque: true,
    d: `Uma página com escopo fechado. Página extra: + R$ ${PRECO.extra}.`,
    itens: ['Design próprio', 'Formulário que chega no WhatsApp', 'Domínio e SSL configurados', '30 dias de ajustes'],
    cta: 'Quero um site',
    icone: '<rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 9h18M7 6.5h.01M10 6.5h.01"></path>',
  },
  {
    id: 'sistema', t: 'Sistema sob medida', de: 3000, unidade: '', prazo: '4 a 12 semanas',
    d: 'Entregue em etapas, cada uma com escopo e preço fechados.',
    itens: ['Login por usuário', 'Relatórios em Excel e PDF', 'Integrações com nova tentativa automática', 'Backup automático'],
    cta: 'Quero um sistema',
    icone: '<path d="M12 3l9 5-9 5-9-5 9-5z"></path><path d="M3 13l9 5 9-5"></path>',
  },
  {
    id: 'consultoria', t: 'Consultoria técnica', de: 280, unidade: '/h', prazo: 'por hora',
    d: 'Ou pacote de 10 horas por R$ 2.500, com relatório escrito.',
    itens: ['Revisão de código', 'Medição de desempenho', 'Escolha de ferramentas', 'Pair programming'],
    cta: 'Quero uma consultoria',
    icone: '<path d="M8 8l-4 4 4 4M16 8l4 4-4 4M13.5 6l-3 12"></path>',
  },
  {
    id: 'hospedagem', t: 'Hospedagem', de: PRECO.hospedagem, unidade: '/mês', prazo: 'por site · opcional',
    d: 'Sistema em servidor dedicado: R$ 300/mês.',
    itens: ['Banco de dados', 'Backups', 'Monitoramento'],
    cta: 'Quero hospedagem',
    icone: '<rect x="3" y="4" width="18" height="7" rx="2"></rect><rect x="3" y="13" width="18" height="7" rx="2"></rect><path d="M7 7.5h.01M7 16.5h.01"></path>',
  },
];

const PROCESSO = [
  { t: 'Conversa', tempo: '30 min', d: 'A gente entende o problema. O resumo escrito chega no mesmo dia.', icone: '<path d="M4 5h16v11H9l-5 4V5z"></path><path d="M8 9.5h8M8 12.5h5"></path>' },
  { t: 'Proposta', tempo: 'até 48 h', d: 'Escopo, preço e prazo por escrito. Nada muda no meio do caminho.', icone: '<path d="M7 3h7l5 5v13H7z"></path><path d="M14 3v5h5M10 13h6M10 17h6"></path>' },
  { t: 'Construção', tempo: 'ao vivo', vivo: true, d: 'Você acompanha cada etapa em tempo real por um link privado.', icone: '<path d="M8 8l-4 4 4 4M16 8l4 4-4 4M13.5 6l-3 12"></path>' },
  { t: 'Entrega', tempo: 'tudo seu', d: 'Arquivos, código e instruções para publicar onde quiser.', icone: '<path d="M3 7l9-4 9 4-9 4-9-4z"></path><path d="M3 7v10l9 4 9-4V7M12 11v10"></path>' },
  { t: 'Lançamento', tempo: '+ 30 dias', d: 'Site no ar, configurado, com 30 dias de ajustes inclusos.', icone: '<path d="M9 15l-3-3c1.5-4.5 5-8 12-9-1 7-4.5 10.5-9 12z"></path><path d="M6 12H3l2.5-3.5H9M12 18v3l3.5-2.5V15"></path><circle cx="15" cy="9" r="1.5"></circle>' },
];

/* Projetos que ganharam site próprio, em src/pages/projetos/<slug>/. */
const PROJETOS = [
  {
    slug: 'devscope', nome: 'DevScope', tag: 'Ferramenta open source', cor: '#46d17e',
    desc: 'O htop dos seus projetos: containers, Git, CI, túneis e banco numa tela só, dentro do terminal. O site tem um simulador para experimentar sem instalar nada.',
    tags: ['Go', 'Terminal (TUI)', 'MIT'],
    codigo: `https://github.com/${EU.gh}/devscope`,
  },
];

/*
  As perguntas que chegam por WhatsApp antes de qualquer orçamento, já
  respondidas com número, não com "depende".
*/
const DUVIDAS = [
  {
    p: 'Quanto custa um site?',
    r: 'A partir de R$ 500 para uma página com escopo fechado, e R$ 250 por página adicional. Sistema sob medida começa em R$ 3.000 e é orçado por etapa. São pontos de partida, não teto: o preço final depende do que o projeto precisa fazer, fecha depois da conversa, por escrito, e não muda no meio.',
  },
  {
    p: 'Em quanto tempo fica pronto?',
    r: 'Site: de 1 a 2 semanas a partir do aceite, contando que o conteúdo chegue. Sistema: de 4 a 12 semanas, entregue por etapas — você vê o primeiro pedaço funcionando bem antes do fim. Consultoria entra na agenda da mesma semana.',
  },
  {
    p: 'O que eu preciso ter pronto antes de começar?',
    r: 'Textos, fotos e logo, se existirem. Se não existirem, eu escrevo a estrutura e indico onde a foto faz falta — projeto não trava esperando conteúdo perfeito. O endereço do site é comprado por você, no seu nome: fica registrado na sua mão, e eu cuido da configuração e do cadeado de segurança, que já entram no pacote.',
  },
  {
    p: 'O código fica comigo?',
    r: 'Fica. O código é seu desde o primeiro dia, e a entrega vem pronta para rodar em qualquer empresa de hospedagem. Não uso plataforma fechada que prende o projeto: se um dia você quiser trocar de desenvolvedor, leva tudo junto. A hospedagem comigo é opcional e cobrada à parte — contratando ou não, o código é seu do mesmo jeito.',
  },
  {
    p: 'E depois que o site está no ar?',
    r: 'Os 30 primeiros dias de ajuste vão inclusos, sem custo. Depois disso, manutenção mensal é opcional e cotada separada, conforme o tamanho do site. Se quiser o site no ar comigo, com endereço próprio e cadeado de segurança, a hospedagem sai por R$ 50 ao mês, e visita no site não gera cobrança extra. E dá para me chamar pontualmente por hora quando aparecer alguma coisa.',
  },
  {
    p: 'Você atende fora de Rio do Sul?',
    r: 'Atendo o Brasil inteiro. Reunião por vídeo, entrega por link e acompanhamento pelo WhatsApp — a maior parte dos projetos acontece assim. Se você estiver no Vale do Itajaí, dá para conversar pessoalmente.',
  },
  {
    p: 'Como funciona o pagamento?',
    r: 'Entrada de 40% no aceite e o restante na entrega. Parcelo em até 6× sem juros no cartão, ou 10% de desconto no Pix à vista. Nota fiscal emitida em todo projeto.',
  },
  {
    p: 'Já tenho um site. Dá para aproveitar?',
    r: 'Quase sempre dá. Começo por uma consultoria técnica — R$ 280 a hora, ou 10 h por R$ 2.500 — para olhar o que existe e dizer o que vale manter, o que vale reescrever e quanto custa cada caminho. Se depois disso virar projeto, as horas da análise entram como crédito.',
  },
];

const NECESSIDADES = [...SERVICOS.map((s) => s.t), 'Ainda não sei'];

const titulo = `${EU.nome} — Engenheiro de software: sites, sistemas sob medida e consultoria`;
const descricao =
  'Engenheiro de software em Rio do Sul (SC). Sites a partir de R$ 500, sistemas sob medida por etapa, consultoria técnica por hora e hospedagem a partir de R$ 50 por mês. O código fica com você, e os projetos são abertos no GitHub.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${EU.site}/#servico`,
      name: `${EU.nome} · Desenvolvimento`,
      description: descricao,
      url: EU.site,
      email: EU.email,
      areaServed: 'BR',
      address: { '@type': 'PostalAddress', addressLocality: EU.cidade, addressRegion: EU.uf, addressCountry: 'BR' },
      founder: { '@type': 'Person', name: EU.nome, jobTitle: EU.papel, sameAs: `https://github.com/${EU.gh}` },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Serviços',
        itemListElement: SERVICOS.map((s) => ({
          '@type': 'Offer',
          name: s.t,
          description: s.d.replace(/ /g, ' '),
          priceCurrency: 'BRL',
          price: String(s.de),
          priceSpecification: { '@type': 'PriceSpecification', minPrice: String(s.de), priceCurrency: 'BRL' },
        })),
      },
      sameAs: [EU.linkedin, EU.insta, `https://github.com/${EU.gh}`],
    },
    {
      '@type': 'FAQPage',
      mainEntity: DUVIDAS.map((d) => ({
        '@type': 'Question',
        name: d.p,
        acceptedAnswer: { '@type': 'Answer', text: d.r },
      })),
    },
  ],
};

const brl = (v: number) => 'R$ ' + v.toLocaleString('pt-BR');
---

<Base title={titulo} description={descricao}>
  <Fragment slot="head">
    <link rel="canonical" href={EU.site} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#07080f" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="pf">
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>

    <!-- NAV -->
    <header class="topo">
      <nav class="nav caixa" aria-label="Principal">
        <a class="marca" href="#topo">Igor Fronza</a>
        <div class="nav-links">
          {NAV.map(([id, t]) => <a href={`#${id}`}>{t}</a>)}
        </div>
        <div class="nav-acoes">
          <a class="btn btn-ghost btn-sm nav-wa" href={ZAP} rel="noopener">WhatsApp</a>
          <a class="btn btn-primary btn-sm" href="#contato">Pedir orçamento</a>
          <button class="nav-burger" type="button" data-menu aria-label="Abrir menu" aria-expanded="false" aria-controls="menu">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
          </button>
        </div>
      </nav>
      <div class="nav-panel" id="menu" hidden>
        {NAV.map(([id, t]) => <a href={`#${id}`}>{t}</a>)}
        <a href={ZAP} rel="noopener">WhatsApp</a>
      </div>
    </header>

    <main id="conteudo">
      <!-- HERO -->
      <section id="topo" class="shape-sec borda-b">
        <div class="shapes" aria-hidden="true">
          <div class="shp dotgrid" style="inset:0"></div>
          <div class="shp glow" data-px="0.04" style="--d:12;width:760px;height:760px;right:-140px;top:-60px"></div>
          <div class="shp" data-px="0.08" style="--d:20;width:520px;height:520px;right:-60px;top:40px"><div class="sq spin"></div></div>
          <div class="shp anel" data-px="0.05" style="--d:12;width:460px;height:460px;left:-220px;bottom:-220px"></div>
          <div class="shp" data-px="0.18" style="--d:36;width:26px;height:26px;left:46%;top:70px"><div class="sq sq-yfill float"></div></div>
          <div class="shp" data-px="0.14" style="--d:28;width:54px;height:54px;left:4%;top:58%"><div class="sq sq-fill float-2"></div></div>
          <span class="shp plus" data-px="0.1" style="--d:22;left:38%;bottom:60px">+</span>
        </div>
        <div class="caixa hero-in">
          <div class="hero-txt">
            <p class="eyebrow">Igor Fronza · engenheiro de software em Rio do Sul, SC</p>
            <h1>Sites e sistemas feitos <span class="hl">sob medida</span>, não sobre molde.</h1>
            <p class="lead">Transformo ideias, processos e problemas em software que funciona — do site de uma página ao sistema que a sua equipe usa todo dia.</p>
            <div class="cta-row">
              <a class="btn btn-primary" href="#contato">Pedir orçamento</a>
              <a class="btn btn-ghost" href="#sites">Ver sites prontos</a>
            </div>
            <ul class="garantias">
              <li class="check"><Fragment set:html={CHECK} />O código é seu desde o dia 1</li>
              <li class="check"><Fragment set:html={CHECK} />Preço e prazo por escrito</li>
              <li class="check"><Fragment set:html={CHECK} />Atendo todo o Brasil</li>
            </ul>
          </div>

          <figure class="hero-fig">
            <div class="card painel">
              <div class="painel-cab"><span>Acompanhamento do projeto</span><span class="pilula">exemplo</span></div>
              <div class="painel-corpo">
                <div class="painel-linha"><b>Site institucional</b><span class="mono">62%</span></div>
                <div class="barra"><div class="barra-cheia"></div></div>
                <ol class="etapas">
                  <li><Fragment set:html={CHECK.replace('width="16" height="16"', 'width="18" height="18"')} /><span>Conversa de 30 min</span><em>Feito</em></li>
                  <li><Fragment set:html={CHECK.replace('width="16" height="16"', 'width="18" height="18"')} /><span>Proposta escrita</span><em>Feito</em></li>
                  <li><span class="ponto" aria-hidden="true"><i class="live"></i></span><span class="forte">Construção</span><em class="amarelo">Em andamento</em></li>
                  <li class="apagado"><span class="ponto" aria-hidden="true"><i class="vazio"></i></span><span>Entrega dos arquivos</span></li>
                  <li class="apagado"><span class="ponto" aria-hidden="true"><i class="vazio"></i></span><span>Lançamento + 30 dias de ajustes</span></li>
                </ol>
              </div>
            </div>
            <figcaption>Você acompanha cada etapa por um link privado.</figcaption>
          </figure>
        </div>
      </section>

      <!-- FAIXA DE STACKS -->
      <section aria-label="Ferramentas que uso" class="borda-b">
        <ul class="sr-only">{STACK.map((s) => <li>{s}</li>)}</ul>
        <div class="tape" aria-hidden="true">
          <div class="marquee">
            {[0, 1].map(() => STACK.map((s, i) => <span class="stack-item">{s}<small class="mono">{(i + 1) * 10}</small></span>))}
          </div>
        </div>
      </section>

      <!-- SITES PRONTOS -->
      <section id="sites" class="secao">
        <div class="caixa">
          <div class="cab cab-linha" data-rv>
            <div><p class="eyebrow">Sites prontos</p><h2>Sites completos, para você abrir e clicar.</h2></div>
            <p class="cab-nota">Seis demos publicadas, cada uma para um tipo de negócio. Escolha uma, veja no computador ou no celular e abra para clicar.</p>
          </div>

          <div class="showcase" data-rv data-showcase>
            <div class="showcase-lista">
              <ol class="demo-list" aria-label="Escolha uma demo">
                {DEMOS.map((d, i) => (
                  <li>
                    <button type="button" class:list={['demo-btn', { on: i === 0 }]} aria-pressed={i === 0 ? 'true' : 'false'} data-demo={i}>
                      <span class="n">0{i + 1}</span><span class="nm">{d.nome}</span><span class="ni">{d.nicho}</span>
                      <svg class="ch" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg>
                    </button>
                  </li>
                ))}
              </ol>
              <a class="list-cta" href="#contato">Quero um site assim →</a>
            </div>

            <div class="card janela">
              <div class="janela-barra">
                <span class="semaforo" aria-hidden="true"><i style="background:#ff6b5e"></i><i style="background:var(--primary)"></i><i style="background:var(--ok)"></i></span>
                <span class="tb-url mono" data-url>{EU.site.replace('https://', '')}/sites/{DEMOS[0].slug}</span>
                <span class="seg" role="group" aria-label="Ver no">
                  <button type="button" class="on" aria-pressed="true" data-device="desk">Computador</button>
                  <button type="button" aria-pressed="false" data-device="phone">Celular</button>
                </span>
              </div>

              <div class="stage" data-stage>
                <img class="stage-img" data-img src={`${BASE}demos/${DEMOS[0].slug}.webp`} alt={`Primeira tela do site ${DEMOS[0].nome}`} width="960" height="600" />
                <div class="phone" data-phone hidden>
                  <iframe data-frame title="Prévia do site no celular" loading="lazy" width="390" height="844"></iframe>
                </div>
              </div>

              <div class="demo-info" aria-live="polite">
                <div class="demo-topo">
                  <div>
                    <h3 data-nome>{DEMOS[0].nome}</h3>
                    <p class="mudo" data-nicho>{DEMOS[0].nicho}</p>
                  </div>
                  <div class="setas">
                    <button type="button" class="nav-arrow" data-nav="-1" aria-label="Demo anterior"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"></path></svg></button>
                    <span class="mono mudo" data-num>01 / 0{DEMOS.length}</span>
                    <button type="button" class="nav-arrow" data-nav="1" aria-label="Próxima demo"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg></button>
                  </div>
                </div>
                <p class="cinza" data-desc>{DEMOS[0].desc}</p>
                <div class="tags" data-tags>{DEMOS[0].tags.map((t) => <span class="tag">{t}</span>)}</div>
                <div class="demo-acoes">
                  <a class="btn btn-primary" data-abrir href={`${BASE}sites/${DEMOS[0].slug}/`}>Abrir o site ↗</a>
                  <a class="btn btn-ghost" href="#contato">Quero um assim</a>
                </div>
              </div>
            </div>
          </div>
        </div>
        <script type="application/json" id="demos-json" set:html={JSON.stringify(DEMOS)} />
      </section>

      <!-- SERVIÇOS -->
      <section id="servicos" class="secao fundo2 borda-tb">
        <div class="caixa">
          <div class="cab" data-rv>
            <p class="eyebrow">Serviços e preços</p>
            <h2>Quatro formas de trabalhar junto.</h2>
            <p class="lead">Os preços abaixo são o ponto de partida. O valor final fica por escrito depois da nossa conversa.</p>
          </div>

          <div class="price-grid">
            {SERVICOS.map((s, i) => (
              <div data-pop style={`--i:${i}`}>
                <article class:list={['price-card', { featured: s.destaque }]}>
                  {s.destaque && <span class="pc-badge">Mais pedido</span>}
                  <div class="pc-head">
                    <span class="pc-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={s.icone}></svg></span>
                    <h3 class="pc-name">{s.t}</h3>
                  </div>
                  <div><span class="pc-from">a partir de</span><div class="pc-price">{brl(s.de)}{s.unidade && <small>{s.unidade}</small>}</div><span class="pc-time">{s.prazo}</span></div>
                  <p class="pc-desc">{s.d}</p>
                  <ul class="pc-list">{s.itens.map((it) => <li class="check"><Fragment set:html={CHECK} />{it}</li>)}</ul>
                  <a class:list={['btn', s.destaque ? 'btn-primary' : 'btn-ghost']} href="#contato" data-need={s.t}>{s.cta}</a>
                </article>
              </div>
            ))}
          </div>

          <!-- simulador -->
          <div class="sim" data-rv data-sim>
            <div class="sim-cfg">
              <div>
                <h3>Monte seu site e veja o preço</h3>
                <p class="cinza peq-p">Três escolhas. O valor muda na hora, com os preços da tabela acima.</p>
              </div>

              <fieldset class="sim-step">
                <legend><span class="sim-n">1</span>Quantas páginas? <span class="mono mudo" data-paginas-rotulo>· 1 página</span></legend>
                <div class="pages">
                  {Array.from({ length: 10 }, (_, i) => (
                    <button type="button" class:list={['pg', { on: i === 0 }]} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={i === 0 ? '1 página' : `${i + 1} páginas`} data-pg={i + 1}>
                      <span class="pg-lines" aria-hidden="true"><i></i><i></i><i></i></span><span class="pg-n mono">{i + 1}</span>
                    </button>
                  ))}
                </div>
                <p class="sim-hint">A primeira página sai por {brl(PRECO.pagina)}; cada página extra soma {brl(PRECO.extra)}.</p>
              </fieldset>

              <fieldset class="sim-step">
                <legend><span class="sim-n">2</span>Onde o site vai ficar?</legend>
                <div class="opts opts-2">
                  <button type="button" class="opt on" aria-pressed="true" data-host="me"><span class="opt-t">Eu cuido da hospedagem</span><span class="opt-s">{brl(PRECO.hospedagem)}/mês, com domínio e SSL</span></button>
                  <button type="button" class="opt" aria-pressed="false" data-host="self"><span class="opt-t">Você hospeda onde quiser</span><span class="opt-s">o código é seu, sem mensalidade</span></button>
                </div>
              </fieldset>

              <fieldset class="sim-step">
                <legend><span class="sim-n">3</span>Como prefere pagar?</legend>
                <div class="opts opts-3">
                  <button type="button" class="opt on" aria-pressed="true" data-pay="pix"><span class="opt-t">Pix à vista</span><span class="opt-s">10% de desconto</span></button>
                  <button type="button" class="opt" aria-pressed="false" data-pay="card"><span class="opt-t">Cartão</span><span class="opt-s">até 6x sem juros</span></button>
                  <button type="button" class="opt" aria-pressed="false" data-pay="split"><span class="opt-t">40% + 60%</span><span class="opt-s">entrada e entrega</span></button>
                </div>
              </fieldset>
            </div>

            <div class="sim-out" aria-live="polite">
              <div class="sim-out-cab"><span>Seu orçamento estimado</span><span class="mudo">prazo a partir de 1 a 2 semanas</span></div>
              <ul class="receipt" data-linhas>
                <li><span>Site com a 1ª página</span><span class="dots-fill" aria-hidden="true"></span><span class="mono">{brl(PRECO.pagina)}</span></li>
                <li class="disc"><span>Desconto Pix (10%)</span><span class="dots-fill" aria-hidden="true"></span><span class="mono">− {brl(PRECO.pagina * PRECO.pix)}</span></li>
              </ul>
              <div class="sim-total-bloco">
                <span class="mudo peq-p">Total a partir de</span>
                <div class="sim-total mono" data-total>{brl(PRECO.pagina * (1 - PRECO.pix))}</div>
                <div class="cinza" data-pagamento>à vista no Pix, já com 10% de desconto</div>
                <div class="cinza" data-hospedagem>+ <span class="mono forte">{brl(PRECO.hospedagem)}</span>/mês de hospedagem</div>
              </div>
              <a class="btn btn-primary" href="#contato" data-enviar-sim>Enviar esta simulação</a>
              <p class="mudo nota-sim">É uma estimativa. O valor final fica por escrito depois da conversa.</p>
            </div>
          </div>

          <div class="duas-listas" data-rv>
            <div class="card lista-card">
              <h3>Todo site sai com</h3>
              <ul>
                {['Design próprio, sem template', 'Imagens leves em WebP e botões fáceis de tocar no celular', 'Prévia bonita quando o link é compartilhado', 'Animação e 3D só quando ajudam, respeitando quem prefere menos movimento'].map((t) => <li class="check"><Fragment set:html={CHECK} />{t}</li>)}
              </ul>
            </div>
            <div class="card lista-card">
              <h3>Pagamento</h3>
              <ul>
                {['40% na entrada, o restante na entrega', 'Até 6x sem juros no cartão', '10% de desconto no Pix à vista', 'Emito nota fiscal'].map((t) => <li class="check"><Fragment set:html={CHECK} />{t}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- COMO FUNCIONA -->
      <section id="processo" class="secao">
        <div class="caixa">
          <div class="cab" data-rv>
            <p class="eyebrow">Como funciona</p>
            <h2>Da primeira conversa ao site no ar.</h2>
          </div>
          <div class="flow" data-seq>
            <div class="flow-track" aria-hidden="true"><i class="flow-fill"></i></div>
            <ol class="flow-steps">
              {PROCESSO.map((p, i) => (
                <li class="flow-step" style={`--i:${i}`}>
                  <span class="flow-node" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={p.icone}></svg></span>
                  <div class="flow-card"><div class="flow-box">
                    <div class="flow-head">
                      <span class="mono flow-n">0{i + 1}</span>
                      <span class="flow-time">{p.vivo && <span class="live ponto-vivo"></span>}{p.tempo}</span>
                    </div>
                    <h3>{p.t}</h3>
                    <p>{p.d}</p>
                  </div></div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>

      <!-- SITES DE PROJETOS -->
      <section id="projetos" class="secao shape-sec borda-t">
        <div class="shapes" aria-hidden="true">
          <div class="shp dotgrid" style="inset:0"></div>
          <div class="shp glow" data-px="0.04" style="width:820px;height:820px;right:-160px;top:40px"></div>
          <div class="shp" data-px="0.1" style="width:460px;height:460px;right:-140px;top:-40px"><div class="sq spin"></div></div>
          <div class="shp" data-px="0.16" style="width:240px;height:240px;right:9%;top:150px"><div class="sq sq-y spin-r"></div></div>
          <div class="shp anel" data-px="0.06" style="width:600px;height:600px;left:-260px;bottom:-260px"></div>
          <div class="shp" data-px="0.2" style="width:56px;height:56px;left:6%;top:32%"><div class="sq sq-fill float"></div></div>
          <span class="shp plus" data-px="0.12" style="left:30%;top:70px">+</span>
        </div>
        <div class="caixa">
          <div class="cab" data-rv>
            <p class="eyebrow">Projetos com site próprio</p>
            <h2>Sites de projetos.</h2>
            <p class="lead">Produto bom que ninguém entende em um minuto não é usado. Aqui ficam os projetos meus que ganharam um site de verdade: o que o produto faz, como ele funciona e uma demonstração para experimentar na hora.</p>
          </div>

          {PROJETOS.map((p, i) => (
            <article data-pop class="proj-card">
              <div class="proj-shot">
                {/* prévia desenhada do DevScope; outro projeto pede o próprio bloco ou um print */}
                <div class="term" role="img" aria-label="Tela do DevScope no terminal, com uso de CPU e RAM e a lista de projetos">
                  <div class="term-bar"><i></i><i></i><i></i><span>devscope</span></div>
                  <div class="term-corpo">
                    <div class="term-topo"><span><b class="azul">DevScope v1.6.9</b> <span class="t2">Developer Command Center</span></span><span class="verde">● ao vivo</span></div>
                    <div class="t3">Linux x86_64 · up 1d 4h · load 3.10 · Docker 9</div>
                    <div class="term-bars">
                      <span>CPU <b class="verde">29%</b> <span class="bar"><i class="cpu" style="width:29%;background:#46d17e"></i></span></span>
                      <span>RAM <b style="color:#f2b84b">44%</b> <span class="bar"><i style="width:44%;background:#f2b84b"></i></span></span>
                      <span>DISK <b class="t2">6%</b> <span class="bar"><i style="width:6%;background:#a9b3bf"></i></span></span>
                    </div>
                    <div class="t2"><b class="azul">PROJETOS 4</b> · <span class="verde">1 rodando</span> · <span style="color:#f2665c">1 parado</span> · 2 sem status</div>
                    <div class="term-table">
                      <div class="tr th"><span>NOME</span><span>BRANCH</span><span class="col-path">CAMINHO</span></div>
                      <div class="tr sel"><span>▸ loja-api</span><span>main</span><span class="col-path">~/projetos/loja-api</span></div>
                      <div class="tr"><span>&nbsp; blog</span><span>main</span><span class="col-path">~/projetos/blog</span></div>
                      <div class="tr"><span>&nbsp; frete-service</span><span style="color:#f2b84b">feat/correios</span><span class="col-path">~/projetos/frete-service</span></div>
                      <div class="tr"><span>&nbsp; painel-web</span><span>main</span><span class="col-path">~/projetos/painel-web</span></div>
                    </div>
                    <div class="term-det">
                      <div><b style="color:#e8ecf1">loja-api</b> <span class="verde">rodando</span></div>
                      <div><span class="t3">stack&nbsp;&nbsp;&nbsp;</span> Node.js</div>
                      <div><span class="t3">runtime&nbsp;</span> 3 containers · <span class="azul">:8080 :6379</span> · compose</div>
                      <div><span class="t3">git&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span> main<span class="caret"></span></div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="proj-info">
                <div class="proj-meta"><span class="proj-tag mono">{p.tag}</span><span class="mono mudo peq-p">0{i + 1} / 0{PROJETOS.length}</span></div>
                <h3><span style={`color:${p.cor}`}>/</span>{p.nome}</h3>
                <p class="cinza">{p.desc}</p>
                <div class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
                <div class="proj-acoes">
                  <a class="btn btn-primary" href={`${BASE}projetos/${p.slug}/`}>Ver o site <Fragment set:html={SETA} /></a>
                  <a class="btn btn-ghost" href={p.codigo} rel="noopener"><Fragment set:html={GITHUB} />Código</a>
                </div>
              </div>
            </article>
          ))}

          <div data-rv class="proj-next">
            <div class="proj-next-mark" aria-hidden="true"><span></span><span></span><span></span></div>
            <div class="proj-next-txt">
              <strong>Mais projetos ganhando site em breve</strong>
              <span class="cinza">Enquanto isso, tudo que eu publico fica aberto no GitHub.</span>
            </div>
            <a class="btn btn-ghost" href={`https://github.com/${EU.gh}?tab=repositories`} rel="noopener"><Fragment set:html={GITHUB} />Ver todos os projetos no GitHub</a>
          </div>
        </div>
      </section>

      <!-- DÚVIDAS -->
      <section id="duvidas" class="secao shape-sec borda-t">
        <div class="shapes" aria-hidden="true">
          <div class="shp anel" data-px="0.05" style="--d:14;width:520px;height:520px;right:-200px;top:-120px"></div>
          <div class="shp" data-px="0.12" style="--d:26;width:180px;height:180px;left:4%;bottom:60px"><div class="sq spin-r"></div></div>
          <div class="shp" data-px="0.18" style="--d:34;width:22px;height:22px;left:30%;top:90px"><div class="sq sq-yfill float"></div></div>
          <span class="shp plus" data-px="0.1" style="--d:20;right:8%;bottom:120px">+</span>
        </div>
        <div class="caixa duas">
          <div class="sticky-col" data-rv>
            <p class="eyebrow">Dúvidas</p>
            <h2>O que perguntam antes de fechar.</h2>
            <p class="cinza">Não achou a sua? <a href={ZAP} rel="noopener">Pergunte no WhatsApp</a>.</p>
          </div>
          <div class="faq">
            {DUVIDAS.map((d, i) => (
              <details name="faq" open={i === 0}>
                <summary class="faq-q"><span>{d.p}</span><span class="pm" aria-hidden="true"></span></summary>
                <p class="faq-a">{d.r}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- CONTATO -->
      <section id="contato" class="secao shape-sec fundo2 borda-t">
        <div class="shapes" aria-hidden="true">
          <div class="shp dotgrid dot-left" style="inset:0"></div>
          <div class="shp glow" data-px="0.04" style="--d:10;width:760px;height:760px;right:-120px;top:-80px"></div>
          <div class="shp" data-px="0.1" style="--d:22;width:420px;height:420px;left:-170px;bottom:-150px"><div class="sq sq-y spin"></div></div>
          <div class="shp" data-px="0.16" style="--d:32;width:48px;height:48px;left:38%;bottom:70px"><div class="sq sq-fill float-2"></div></div>
        </div>
        <div class="caixa duas duas-contato">
          <div class="contato-txt" data-rv>
            <p class="eyebrow">Contato</p>
            <h2>Me conte o que precisa resolver.</h2>
            <p class="lead">Pode ser uma ideia solta. Em 30 minutos de conversa a gente já sabe se faz sentido.</p>
            <dl>
              <div><dt>WhatsApp</dt><dd><a href={ZAP} rel="noopener">{EU.zapFmt}</a></dd></div>
              <div><dt>E-mail</dt><dd><a href={`mailto:${EU.email}`}>{EU.email}</a></dd></div>
              <div><dt>Onde</dt><dd class="cinza">{EU.cidade}, {EU.uf} · todo o Brasil por vídeo, presencial no Vale do Itajaí</dd></div>
            </dl>
          </div>

          <div data-rv>
            <form class="card form" data-form data-zap={EU.zap}>
              <div class="form-2">
                <div class="field"><label for="f-nome">Seu nome</label><input id="f-nome" name="nome" class="inp" type="text" required autocomplete="name" /></div>
                <div class="field"><label for="f-contato">WhatsApp ou e-mail</label><input id="f-contato" name="contato" class="inp" type="text" required placeholder="(47) 90000-0000" /></div>
              </div>
              <fieldset class="need">
                <legend class="flabel">O que você precisa</legend>
                <input type="hidden" name="servico" value={NECESSIDADES[0]} data-servico />
                <div class="chips">
                  {NECESSIDADES.map((n, i) => (
                    <button type="button" class:list={['chip', { on: i === 0 }]} aria-pressed={i === 0 ? 'true' : 'false'} data-chip={n}>{n}</button>
                  ))}
                </div>
              </fieldset>
              <div class="form-2">
                <div class="field"><label for="f-orc">Orçamento previsto</label>
                  {/* o padrão fica na faixa do meio de propósito: ancorar no degrau mais baixo puxa todo orçamento para baixo */}
                  <select id="f-orc" name="verba" class="inp">
                    <option>Até R$ 1.000</option>
                    <option selected>R$ 1.000 a R$ 3.000</option>
                    <option>R$ 3.000 a R$ 10.000</option>
                    <option>Acima de R$ 10.000</option>
                    <option>Prefiro que você me diga</option>
                  </select></div>
                <div class="field"><label for="f-prazo">Prazo</label>
                  <select id="f-prazo" name="prazo" class="inp">
                    <option>Sem pressa</option>
                    <option selected>Nas próximas semanas</option>
                    <option>É urgente</option>
                  </select></div>
              </div>
              <div class="field"><label for="f-msg">O problema, em duas linhas</label><textarea id="f-msg" name="obs" class="inp" rows="4" required placeholder="Hoje eu perco pedido porque… / minha planilha não dá mais conta de…"></textarea></div>
              <button type="submit" class="btn btn-primary">Enviar pelo WhatsApp</button>
              <p class="mudo nota-form">Abre a conversa com tudo preenchido. Nada fica gravado neste site.</p>
            </form>
          </div>
        </div>
      </section>
    </main>

    <footer class="rodape">
      <div class="caixa rodape-in">
        <span>© 2026 {EU.nome} · {EU.cidade}, {EU.uf}</span>
        <nav aria-label="Rodapé">
          <a href={`https://github.com/${EU.gh}`} rel="noopener">GitHub</a>
          <a href={EU.linkedin} rel="noopener">LinkedIn</a>
          <a href={EU.insta} rel="noopener">Instagram</a>
          <a href={ZAP} rel="noopener">WhatsApp</a>
        </nav>
      </div>
    </footer>
  </div>
</Base>

<script>
  const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector<T>(s);
  const $$ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => [...r.querySelectorAll<T>(s)];
  const reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fino = matchMedia('(pointer: fine)').matches;
  const base = import.meta.env.BASE_URL;

  /* ---------------- menu mobile ---------------- */
  const burger = $('[data-menu]')!;
  const painel = $('#menu')!;
  const menu = (abrir: boolean) => {
    painel.hidden = !abrir;
    burger.setAttribute('aria-expanded', String(abrir));
    burger.setAttribute('aria-label', abrir ? 'Fechar menu' : 'Abrir menu');
    $('path', burger)!.setAttribute('d', abrir ? 'M6 6l12 12M18 6L6 18' : 'M4 7h16M4 12h16M4 17h16');
  };
  burger.addEventListener('click', () => menu(painel.hidden));
  painel.addEventListener('click', (e) => (e.target as HTMLElement).closest('a') && menu(false));
  addEventListener('keydown', (e) => e.key === 'Escape' && !painel.hidden && menu(false));

  /* ---------------- vitrine de demos ---------------- */
  const demos = JSON.parse($('#demos-json')!.textContent!) as {
    slug: string; nome: string; nicho: string; desc: string; tags: string[];
  }[];
  const vit = $('[data-showcase]')!;
  const palco = $('[data-stage]', vit)!;
  const img = $<HTMLImageElement>('[data-img]', vit)!;
  const celular = $('[data-phone]', vit)!;
  const frame = $<HTMLIFrameElement>('[data-frame]', vit)!;
  let atual = 0;
  let aparelho: 'desk' | 'phone' = 'desk';

  /* o iframe tem 390x844 de verdade, para o CSS da demo achar que é um celular;
     escala para caber no palco, em vez de o navegador espremer o layout */
  const escalar = () => {
    const s = (palco.clientHeight - 28) / 856;
    celular.style.setProperty('--s', String(Math.min(1, s)));
  };
  const caminho = () => `${base}sites/${demos[atual].slug}/`;

  const mostrar = () => {
    const d = demos[atual];
    $$('.demo-btn', vit).forEach((b, i) => {
      b.classList.toggle('on', i === atual);
      b.setAttribute('aria-pressed', String(i === atual));
    });
    $('[data-url]', vit)!.textContent = `${location.host}${base.replace(/\/$/, '')}/sites/${d.slug}`;
    $('[data-nome]', vit)!.textContent = d.nome;
    $('[data-nicho]', vit)!.textContent = d.nicho;
    $('[data-num]', vit)!.textContent = `0${atual + 1} / 0${demos.length}`;
    $('[data-desc]', vit)!.textContent = d.desc;
    $('[data-tags]', vit)!.replaceChildren(
      ...d.tags.map((t) => Object.assign(document.createElement('span'), { className: 'tag', textContent: t })),
    );
    $<HTMLAnchorElement>('[data-abrir]', vit)!.href = caminho();
    img.src = `${base}demos/${d.slug}.webp`;
    img.alt = `Primeira tela do site ${d.nome}`;
    if (aparelho === 'phone') frame.src = caminho();
  };
  const aparelhoPara = (a: 'desk' | 'phone') => {
    aparelho = a;
    $$('[data-device]', vit).forEach((b) => {
      const on = b.dataset.device === a;
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', String(on));
    });
    img.hidden = a === 'phone';
    celular.hidden = a === 'desk';
    /* a demo só é carregada quando alguém pede o celular */
    if (a === 'phone') { escalar(); frame.src = caminho(); }
  };
  $$('[data-demo]', vit).forEach((b) => b.addEventListener('click', () => { atual = Number(b.dataset.demo); mostrar(); }));
  $$('[data-nav]', vit).forEach((b) => b.addEventListener('click', () => {
    atual = (atual + Number(b.dataset.nav) + demos.length) % demos.length;
    mostrar();
  }));
  $$('[data-device]', vit).forEach((b) => b.addEventListener('click', () => aparelhoPara(b.dataset.device as 'desk' | 'phone')));
  addEventListener('resize', escalar, { passive: true });

  /* ---------------- formulário e simulador ---------------- */
  const form = $<HTMLFormElement>('[data-form]')!;
  const servico = $<HTMLInputElement>('[data-servico]')!;
  const msg = $<HTMLTextAreaElement>('#f-msg')!;
  const escolher = (nome: string) => {
    servico.value = nome;
    $$('[data-chip]', form).forEach((c) => {
      const on = c.dataset.chip === nome;
      c.classList.toggle('on', on);
      c.setAttribute('aria-pressed', String(on));
    });
  };
  $$('[data-chip]', form).forEach((c) => c.addEventListener('click', () => escolher(c.dataset.chip!)));
  $$('[data-need]').forEach((a) => a.addEventListener('click', () => escolher(a.dataset.need!)));

  /* site estático não tem para onde postar; o pedido vai pelo zap */
  form.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const d = new FormData(form);
    const v = (k: string) => String(d.get(k) ?? '').trim();
    const linhas = [
      'Olá, Igor! Vim pelo site.', '',
      `Preciso de: ${v('servico')}`, `Orçamento previsto: ${v('verba')}`, `Prazo: ${v('prazo')}`, '',
      `O problema: ${v('obs')}`, '',
      `Nome: ${v('nome')}`, `Contato: ${v('contato')}`,
    ];
    open(`https://wa.me/${form.dataset.zap}?text=${encodeURIComponent(linhas.join('\n'))}`, '_blank', 'noopener');
  });

  /* mesmos números de PRECO no frontmatter */
  const PAGINA = 500, EXTRA = 250, PIX = 0.1, HOSPEDAGEM = 50;
  const brl = (v: number) => 'R$ ' + v.toLocaleString('pt-BR', { minimumFractionDigits: v % 1 ? 2 : 0, maximumFractionDigits: 2 });
  const sim = $('[data-sim]')!;
  const st = { pages: 1, pay: 'pix', host: 'me' };
  let exibido = PAGINA * (1 - PIX);
  let raf = 0;

  const marcar = (sel: string, ok: (b: HTMLElement) => boolean) =>
    $$(sel, sim).forEach((b) => {
      const on = ok(b);
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', String(on));
    });

  const linha = (cls: string, rotulo: string, valor: string) => {
    const el = Object.assign(document.createElement('li'), {
      className: cls,
      innerHTML: '<span></span><span class="dots-fill" aria-hidden="true"></span><span class="mono"></span>',
    });
    el.children[0].textContent = rotulo;
    el.children[2].textContent = valor;
    return el;
  };

  const pinta = () => {
    const bruto = PAGINA + EXTRA * (st.pages - 1);
    const desc = st.pay === 'pix' ? bruto * PIX : 0;
    const total = bruto - desc;
    const extra = st.pages - 1;
    const linhas = [linha('', 'Site com a 1ª página', brl(PAGINA))];
    if (extra) linhas.push(linha('', `${extra} ${extra === 1 ? 'página extra' : 'páginas extras'} × ${brl(EXTRA)}`, brl(EXTRA * extra)));
    if (desc) linhas.push(linha('disc', 'Desconto Pix (10%)', '− ' + brl(desc)));
    $('[data-linhas]', sim)!.replaceChildren(...linhas);
    $('[data-paginas-rotulo]', sim)!.textContent = st.pages === 1 ? '· 1 página' : `· ${st.pages} páginas`;
    $('[data-pagamento]', sim)!.textContent =
      st.pay === 'pix' ? 'à vista no Pix, já com 10% de desconto'
      : st.pay === 'card' ? `ou 6x de ${brl(bruto / 6)} sem juros no cartão`
      : `${brl(bruto * 0.4)} na entrada + ${brl(bruto * 0.6)} na entrega`;
    $('[data-hospedagem]', sim)!.hidden = st.host !== 'me';
    marcar('[data-pg]', (b) => Number(b.dataset.pg) <= st.pages);
    $$('[data-pg]', sim).forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.pg) === st.pages)));
    marcar('[data-pay]', (b) => b.dataset.pay === st.pay);
    marcar('[data-host]', (b) => b.dataset.host === st.host);

    /* o total conta até o novo valor; com movimento reduzido, troca direto */
    const alvo = $('[data-total]', sim)!;
    cancelAnimationFrame(raf);
    const de = exibido;
    if (reduz) { exibido = total; alvo.textContent = brl(total); return; }
    let t0 = 0;
    const passo = (ts: number) => {
      t0 ||= ts;
      const p = Math.min(1, (ts - t0) / 520);
      exibido = Math.round(de + (total - de) * (1 - Math.pow(1 - p, 3)));
      alvo.textContent = brl(p < 1 ? exibido : total);
      if (p < 1) raf = requestAnimationFrame(passo);
    };
    raf = requestAnimationFrame(passo);
  };
  $$('[data-pg]', sim).forEach((b) => b.addEventListener('click', () => { st.pages = Number(b.dataset.pg); pinta(); }));
  $$('[data-pay]', sim).forEach((b) => b.addEventListener('click', () => { st.pay = b.dataset.pay!; pinta(); }));
  $$('[data-host]', sim).forEach((b) => b.addEventListener('click', () => { st.host = b.dataset.host!; pinta(); }));

  $('[data-enviar-sim]', sim)!.addEventListener('click', () => {
    const nomes: Record<string, string> = { pix: 'Pix à vista', card: 'cartão em até 6x', split: '40% na entrada e 60% na entrega' };
    const bruto = PAGINA + EXTRA * (st.pages - 1);
    const total = st.pay === 'pix' ? bruto * (1 - PIX) : bruto;
    escolher('Criação de site');
    msg.value =
      `Simulação: site com ${st.pages} ${st.pages === 1 ? 'página' : 'páginas'}, pagamento ${nomes[st.pay]}, ` +
      `${st.host === 'me' ? `com hospedagem (${brl(HOSPEDAGEM)}/mês)` : 'sem hospedagem'}. Total estimado: ${brl(total)}.`;
  });

  /* ---------------- parallax das formas ---------------- */
  const formas = $$('[data-px]');
  if (!reduz) {
    let agendado = false;
    const rolar = () => {
      agendado = false;
      const vh = innerHeight;
      formas.forEach((el) => {
        const r = el.closest('section')!.getBoundingClientRect();
        if (r.bottom < -200 || r.top > vh + 200) return;
        const c = r.top + r.height / 2 - vh / 2;
        el.style.setProperty('--py', (-c * (parseFloat(el.dataset.px!) || 0.1)).toFixed(1) + 'px');
      });
    };
    addEventListener('scroll', () => { if (!agendado) { agendado = true; requestAnimationFrame(rolar); } }, { passive: true });
    rolar();

    if (fino) {
      $$('.shape-sec').forEach((s) => {
        s.addEventListener('mousemove', (e) => {
          const r = s.getBoundingClientRect();
          s.style.setProperty('--mx', (((e.clientX - r.left) / r.width - 0.5) * 2).toFixed(3));
          s.style.setProperty('--my', (((e.clientY - r.top) / r.height - 0.5) * 2).toFixed(3));
        });
        s.addEventListener('mouseleave', () => { s.style.setProperty('--mx', '0'); s.style.setProperty('--my', '0'); });
      });
      /* luz que segue o ponteiro nos cards de preço */
      $$('.price-card').forEach((c) => {
        c.addEventListener('mousemove', (e) => {
          const r = c.getBoundingClientRect();
          c.style.setProperty('--mx', e.clientX - r.left + 'px');
          c.style.setProperty('--my', e.clientY - r.top + 'px');
        });
        c.addEventListener('mouseleave', () => { c.style.removeProperty('--mx'); c.style.removeProperty('--my'); });
      });
    }
  }

  /* ---------------- revelação ao rolar ---------------- */
  if (!reduz && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('anim');
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.classList.add('in');
      io.unobserve(e.target);
    }), { threshold: 0.18 });
    $$('[data-rv], [data-pop], [data-seq]').forEach((el) => io.observe(el));
  }
</script>

