  .pf .demo-topo { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; }
  .pf .demo-topo h3 { font-weight: 600; font-size: 24px; letter-spacing: -0.02em; }
  .pf .demo-topo p { margin-top: 2px; font-size: 15px; }
  .pf .setas { display: flex; gap: 8px; align-items: center; }
  .pf .setas .mono { font-size: 13px; min-width: 7ch; text-align: center; }
  .pf .nav-arrow { width: 44px; height: 44px; border-radius: 10px; border: 1px solid var(--line-2); background: transparent; color: var(--text); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: border-color .2s; }
  .pf .nav-arrow:hover { border-color: var(--text-3); }
  .pf .demo-acoes { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }

  /* preços */
  .pf .price-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; align-items: stretch; }
  .pf .price-grid > div { display: flex; }
  .pf .price-card { position: relative; flex: 1; display: flex; flex-direction: column; gap: 20px; padding: 28px 24px 24px; border: 1px solid var(--line); border-radius: 16px; background: radial-gradient(380px circle at var(--mx, 50%) var(--my, -30%), rgba(255, 255, 255, .05), transparent 60%), var(--surface); transition: transform .5s var(--mola), border-color .2s, box-shadow .3s; }
  .pf .price-card:hover { transform: translateY(-8px); border-color: var(--line-2); box-shadow: 0 22px 50px -28px rgba(0, 0, 0, .9); }
  .pf .pc-head { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .pf .pc-icon { flex: none; width: 40px; height: 40px; border-radius: 11px; display: flex; align-items: center; justify-content: center; background: var(--surface-2); border: 1px solid var(--line-2); color: var(--text-2); transition: transform .5s var(--mola); }
  .pf .price-card:hover .pc-icon { transform: rotate(-8deg) scale(1.08); }
  .pf .featured .pc-icon { background: color-mix(in srgb, var(--primary) 14%, transparent); border-color: color-mix(in srgb, var(--primary) 40%, transparent); color: var(--primary); }
  .pf .price-card.featured { border-color: color-mix(in srgb, var(--primary) 55%, transparent); background: radial-gradient(380px circle at var(--mx, 50%) var(--my, -30%), color-mix(in srgb, var(--primary) 10%, transparent), transparent 62%), var(--surface); box-shadow: 0 30px 70px -40px color-mix(in srgb, var(--primary) 45%, transparent); }
  .pf .price-card.featured:hover { border-color: var(--primary); }
  .pf .pc-name { font-weight: 600; font-size: 18px; letter-spacing: -0.01em; }
  .pf .pc-badge { position: absolute; top: -12px; right: 20px; font-size: 12px; font-weight: 600; color: var(--on-primary); background: var(--primary); border-radius: 999px; padding: 2px 10px; }
  .pf .pc-from { font-size: 13px; color: var(--text-3); }
  .pf .pc-price { font-family: var(--mono); font-size: 38px; font-weight: 500; letter-spacing: -0.03em; line-height: 1.15; }
  .pf .pc-price small { font-size: 15px; color: var(--text-3); letter-spacing: 0; }
  .pf .pc-time { display: inline-block; margin-top: 10px; font-size: 13px; color: var(--text-2); padding: 3px 10px; border-radius: 999px; background: var(--surface-2); border: 1px solid var(--line); }
  .pf .pc-desc { font-size: 15px; color: var(--text-2); padding-bottom: 18px; border-bottom: 1px solid var(--line); }
  .pf .pc-list { display: grid; gap: 9px; font-size: 15px; color: var(--text-2); flex: 1; align-content: start; }
  .pf .pc-list svg { width: 20px; height: 20px; padding: 3px; box-sizing: border-box; border-radius: 50%; background: color-mix(in srgb, var(--ok) 14%, transparent); margin-top: 2px; }
  .pf .price-card .btn { width: 100%; }
  .pf .price-card .btn-ghost:hover { background: var(--surface-2); }

  /* simulador */
  .pf .sim { margin-top: 56px; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .95fr); border: 1px solid var(--line-2); border-radius: 18px; overflow: hidden; background: var(--surface); }
  .pf .sim-cfg { padding: 32px; display: flex; flex-direction: column; gap: 28px; min-width: 0; }
  .pf .sim-cfg h3 { font-weight: 600; font-size: 22px; letter-spacing: -0.02em; }
  .pf .sim-cfg > div > p { margin-top: 4px; }
  .pf .sim-step { border: 0; margin: 0; padding: 0; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
  .pf .sim-step legend { display: flex; align-items: center; gap: 10px; padding: 0; margin-bottom: 12px; font-weight: 600; font-size: 16px; }
  .pf .sim-n { flex: none; width: 24px; height: 24px; border-radius: 50%; background: var(--primary); color: var(--on-primary); font-size: 13px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; }
  .pf .sim-hint { font-size: 13px; color: var(--text-3); }
  .pf .pages { display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); gap: 6px; }
  .pf .pg { height: 60px; box-sizing: border-box; border-radius: 8px; border: 1px dashed var(--line-2); background: transparent; cursor: pointer; display: flex; flex-direction: column; justify-content: space-between; padding: 9px 6px 5px; transition: transform .45s cubic-bezier(.34, 1.8, .5, 1), background .2s, border-color .2s; }
  .pf .pg:hover { border-color: var(--text-3); transform: translateY(-3px); }
  .pf .pg-lines { display: flex; flex-direction: column; gap: 3px; }
  .pf .pg-lines i { display: block; height: 3px; border-radius: 2px; background: var(--line-2); transition: background .2s; }
  .pf .pg-lines i:nth-child(1) { width: 70%; } .pf .pg-lines i:nth-child(2) { width: 100%; } .pf .pg-lines i:nth-child(3) { width: 50%; }
  .pf .pg-n { font-size: 10px; color: var(--text-3); text-align: right; }
  .pf .pg.on { border-style: solid; border-color: color-mix(in srgb, var(--primary) 60%, transparent); background: color-mix(in srgb, var(--primary) 10%, var(--surface)); animation: pf-pop .5s cubic-bezier(.34, 1.8, .5, 1); }
  .pf .pg.on .pg-lines i { background: color-mix(in srgb, var(--primary) 75%, transparent); }
  .pf .pg.on .pg-n { color: var(--primary); }
  @keyframes pf-pop { 0% { transform: scale(.8); } 100% { transform: scale(1); } }
  .pf .opts { display: grid; gap: 8px; }
  .pf .opts-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .pf .opts-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .pf .opt { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; min-height: 64px; padding: 12px 14px; box-sizing: border-box; text-align: left; border: 1px solid var(--line-2); border-radius: 10px; background: transparent; color: var(--text); cursor: pointer; transition: border-color .2s, background .2s, transform .45s cubic-bezier(.34, 1.8, .5, 1); }
  .pf .opt:hover { border-color: var(--text-3); }
  .pf .opt:active { transform: scale(.96); }
  .pf .opt.on { border-color: var(--primary); background: color-mix(in srgb, var(--primary) 8%, transparent); }
  .pf .opt-t { font-weight: 600; font-size: 15px; line-height: 1.3; }
  .pf .opt-s { font-size: 13px; line-height: 1.35; color: var(--text-3); }
  .pf .opt.on .opt-s { color: var(--text-2); }
  .pf .sim-out { padding: 32px; background: var(--bg-2); border-left: 1px solid var(--line); display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  .pf .sim-out-cab { display: flex; justify-content: space-between; align-items: center; gap: 12px; font-size: 14px; font-weight: 500; color: var(--text-2); }
  .pf .sim-out-cab .mudo { font-size: 13px; font-weight: 400; }
  .pf .receipt { display: grid; gap: 10px; font-size: 15px; color: var(--text-2); }
  .pf .receipt li { display: flex; align-items: baseline; gap: 8px; }
  .pf .dots-fill { flex: 1; min-width: 12px; border-bottom: 1px dotted var(--line-2); transform: translateY(-4px); }
  .pf .receipt li .mono { color: var(--text); white-space: nowrap; }
  .pf .receipt li.disc .mono { color: var(--ok); }
  .pf .sim-total-bloco { border-top: 1px dashed var(--line-2); padding-top: 18px; }
  .pf .sim-total { font-size: clamp(40px, 4.4vw, 56px); font-weight: 500; letter-spacing: -0.04em; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .pf .sim-total-bloco .cinza { font-size: 15px; }
  .pf [data-hospedagem] { margin-top: 6px; }
  .pf [data-hospedagem][hidden] { display: none; }
  .pf .sim-out .btn { margin-top: auto; }
  .pf .nota-sim { font-size: 13px; text-align: center; }
  .pf .duas-listas { margin-top: 20px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .pf .lista-card { padding: 26px; }
  .pf .lista-card h3 { margin-bottom: 16px; font-weight: 600; font-size: 17px; }
  .pf .lista-card ul { display: grid; gap: 10px; font-size: 15px; color: var(--text-2); }

  /* processo */
  .pf .flow { position: relative; }
  .pf .flow-track { position: absolute; left: calc((100% - 80px) / 10); right: calc((100% - 80px) / 10); top: 22px; height: 2px; border-radius: 2px; background: var(--line-2); overflow: hidden; }
  .pf .flow-fill { display: block; width: 100%; height: 100%; background: var(--primary); transform-origin: 0 50%; }
  .pf .flow-steps { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 20px; }
  .pf .flow-step { display: flex; flex-direction: column; align-items: center; gap: 18px; min-width: 0; }
  .pf .flow-node { position: relative; z-index: 1; flex: none; width: 46px; height: 46px; box-sizing: border-box; border-radius: 50%; background: var(--bg); border: 1.5px solid var(--primary); color: var(--primary); display: flex; align-items: center; justify-content: center; }
  .pf .flow-step:last-child .flow-node { background: var(--primary); color: var(--on-primary); }
  .pf .flow-card { align-self: stretch; flex: 1; display: flex; }
  .pf .flow-box { flex: 1; display: flex; flex-direction: column; gap: 8px; padding: 20px 18px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); transition: transform .5s var(--mola), border-color .2s, box-shadow .3s; }
  .pf .flow-box:hover { transform: translateY(-6px); border-color: var(--line-2); box-shadow: 0 20px 40px -26px rgba(0, 0, 0, .9); }
  .pf .flow-box h3 { font-weight: 600; font-size: 18px; letter-spacing: -0.01em; }
  .pf .flow-box p { font-size: 15px; color: var(--text-2); }
  .pf .flow-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .pf .flow-n { font-size: 12px; color: var(--primary); }
  .pf .flow-time { font-size: 12px; color: var(--text-2); padding: 2px 9px; border-radius: 999px; background: var(--surface-2); border: 1px solid var(--line); white-space: nowrap; }

  /* projetos */
  .pf .proj-card { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); border: 1px solid var(--line-2); border-radius: 18px; overflow: hidden; background: rgba(14, 16, 24, .82); backdrop-filter: blur(6px); }
  .pf .proj-shot { padding: 28px; background: #0b0e13; border-right: 1px solid var(--line); display: flex; align-items: center; min-width: 0; }
  .pf .proj-info { padding: 36px 32px; display: flex; flex-direction: column; gap: 18px; justify-content: center; min-width: 0; }
  .pf .proj-meta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .pf .proj-tag { font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--text-2); border: 1px solid var(--line-2); border-radius: 999px; padding: 4px 12px; }
  .pf .proj-info h3 { font-weight: 600; font-size: 34px; letter-spacing: -0.03em; }
  .pf .proj-acoes { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
  .pf .proj-next { margin-top: 24px; display: flex; align-items: center; flex-wrap: wrap; gap: 20px; padding: 22px 24px; border: 1.5px dashed var(--line-2); border-radius: 16px; background: rgba(10, 12, 20, .7); transition: border-color .3s; }
  .pf .proj-next:hover { border-color: color-mix(in srgb, var(--primary) 55%, transparent); }
  .pf .proj-next-txt { flex: 1; min-width: 220px; display: flex; flex-direction: column; }
  .pf .proj-next-txt strong { font-weight: 600; font-size: 18px; }
  .pf .proj-next-txt span { font-size: 15px; }
  .pf .proj-next-mark { display: flex; align-items: flex-end; gap: 4px; height: 28px; flex: none; }
  .pf .proj-next-mark span { display: block; width: 6px; border-radius: 2px; background: var(--primary); animation: pf-build 1.4s ease-in-out infinite; }
  .pf .proj-next-mark span:nth-child(1) { height: 40%; } .pf .proj-next-mark span:nth-child(2) { height: 70%; animation-delay: -.3s; } .pf .proj-next-mark span:nth-child(3) { height: 100%; animation-delay: -.6s; }
  @keyframes pf-build { 0%, 100% { transform: scaleY(.5); transform-origin: 50% 100%; } 50% { transform: scaleY(1); transform-origin: 50% 100%; } }
  .pf .term { width: 100%; font-family: var(--mono); font-size: 12px; line-height: 1.55; color: #a9b3bf; border: 1px solid #232a35; border-radius: 10px; overflow: hidden; background: #0b0e13; transition: transform .6s var(--mola); }
  .pf .proj-card:hover .term { transform: translateY(-4px) rotate(-.5deg); }
  .pf .term-bar { display: flex; align-items: center; gap: 6px; padding: 9px 12px; background: #141920; border-bottom: 1px solid #232a35; }
  .pf .term-bar i { width: 9px; height: 9px; border-radius: 50%; background: #2c3440; }
  .pf .term-bar span { margin-left: 8px; color: #808b98; }
  .pf .term-corpo { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 10px; }
  .pf .term-topo { display: flex; justify-content: space-between; gap: 12px; }
  .pf .term .azul { color: #5aa9ff; } .pf .term .verde { color: #46d17e; } .pf .term .t2 { color: #a9b3bf; } .pf .term .t3 { color: #808b98; }
  .pf .term-bars { display: flex; gap: 18px; flex-wrap: wrap; }
  .pf .term .bar { display: inline-block; width: 56px; height: 5px; margin-left: 4px; border-radius: 3px; background: #1b212b; vertical-align: middle; overflow: hidden; }
  .pf .term .bar i { display: block; height: 100%; border-radius: 3px; }
  .pf .term .cpu { animation: pf-cpu 3.2s ease-in-out infinite; }
  @keyframes pf-cpu { 0%, 100% { width: 29%; } 50% { width: 43%; } }
  .pf .term-table { display: grid; gap: 2px; }
  .pf .tr { display: grid; grid-template-columns: 1.2fr 1fr 1.6fr; gap: 10px; padding: 2px 6px; border-radius: 3px; white-space: nowrap; overflow: hidden; }
  .pf .tr.th { color: #808b98; }
  .pf .tr.sel { background: #16243a; color: #e8ecf1; }
  .pf .term-det { border-top: 1px solid #232a35; padding-top: 10px; display: grid; gap: 3px; color: #a9b3bf; }
  .pf .caret { display: inline-block; width: 7px; height: 13px; background: #46d17e; vertical-align: -2px; margin-left: 4px; animation: pf-blink 1.1s steps(1) infinite; }
  @keyframes pf-blink { 50% { opacity: 0; } }

  /* dúvidas */
  .pf .duas { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 72px; align-items: start; }
  .pf .sticky-col { position: sticky; top: 100px; display: flex; flex-direction: column; gap: 14px; }
  .pf .faq { border-top: 1px solid var(--line-2); }
  .pf .faq details { border-bottom: 1px solid var(--line); }
  .pf .faq-q { display: flex; width: 100%; align-items: center; justify-content: space-between; gap: 20px; min-height: 60px; padding: 18px 0; box-sizing: border-box; color: var(--text); font-size: 18px; font-weight: 500; text-align: left; cursor: pointer; list-style: none; }
  .pf .faq-q::-webkit-details-marker { display: none; }
  .pf .faq-q:hover { color: var(--primary); }
  .pf .pm { position: relative; flex: none; width: 16px; height: 16px; color: var(--text-3); }
  .pf .pm::before, .pf .pm::after { content: ""; position: absolute; left: 0; top: 50%; width: 16px; height: 1.5px; margin-top: -.75px; background: currentColor; transition: transform .25s var(--ease); }
  .pf .pm::after { transform: rotate(90deg); }
  .pf details[open] .pm::after { transform: rotate(0); }
  .pf .faq-a { padding: 0 40px 22px 0; color: var(--text-2); font-size: 16px; max-width: 40em; }

  /* contato */
  .pf .duas-contato { grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); }
  .pf .contato-txt { display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  .pf .contato-txt dl { margin-top: 12px; display: grid; gap: 14px; font-size: 16px; }
  .pf .contato-txt dt { font-size: 13px; color: var(--text-3); }
  .pf .contato-txt dd a { text-decoration: none; overflow-wrap: anywhere; }
  .pf .form { padding: 32px; display: flex; flex-direction: column; gap: 22px; }
  .pf .form-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .pf .field { display: flex; flex-direction: column; gap: 8px; }
  .pf .field label, .pf .flabel { font-size: 14px; font-weight: 500; color: var(--text-2); }
  .pf .inp { min-height: 48px; box-sizing: border-box; width: 100%; padding: 12px 14px; border-radius: 8px; border: 1px solid var(--line-2); background: var(--surface-2); color: var(--text); font-size: 16px; transition: border-color .2s; }
  .pf .inp::placeholder { color: #6f7689; }
  .pf .inp:focus { outline: none; border-color: var(--primary); }
  .pf textarea.inp { resize: vertical; line-height: 1.5; }
  .pf .need { border: 0; margin: 0; padding: 0; min-width: 0; }
  .pf .need legend { padding: 0; margin-bottom: 10px; }
  .pf .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .pf .chip { min-height: 44px; padding: 0 14px; border-radius: 8px; border: 1px solid var(--line-2); background: transparent; color: var(--text-2); font-size: 15px; cursor: pointer; transition: border-color .2s, color .2s, background .2s; }
  .pf .chip:hover { border-color: var(--text-3); color: var(--text); }
  .pf .chip.on { background: var(--surface-2); border-color: var(--primary); color: var(--text); }
  .pf .nota-form { font-size: 13px; text-align: center; }
  .pf .rodape { border-top: 1px solid var(--line); }
  .pf .rodape-in { padding-block: 28px; display: flex; flex-wrap: wrap; gap: 16px 32px; justify-content: space-between; font-size: 14px; color: var(--text-3); }
  .pf .rodape-in nav { display: flex; flex-wrap: wrap; gap: 4px 20px; }
  .pf .rodape-in a { display: inline-flex; align-items: center; min-height: 44px; color: var(--text-2); text-decoration: none; }
  .pf .rodape-in a:hover { color: var(--text); }

  /* revelação: só com html.anim */
  .anim .pf [data-rv] { opacity: 0; transform: translateY(12px); transition: opacity .6s var(--ease), transform .6s var(--ease); }
  .anim .pf [data-rv].in { opacity: 1; transform: none; }
  .anim .pf [data-pop] { opacity: 0; transform: translateY(70px) scale(.86); transition-property: opacity, transform; transition-duration: .4s, .95s; transition-timing-function: ease-out, cubic-bezier(.3, 1.9, .5, 1); }
  .anim .pf [data-pop].in { opacity: 1; transform: none; transition-delay: calc(var(--i, 0) * 160ms); }
  .anim .pf .flow .flow-fill { transform: scaleX(0); transition: transform 2s cubic-bezier(.45, 0, .55, 1); }
  .anim .pf .flow.in .flow-fill { transform: scaleX(1); transition-delay: .15s; }
  .anim .pf .flow .flow-node { opacity: 0; transform: scale(.2); border-color: var(--line-2); color: var(--text-3); transition: opacity .25s ease-out, transform .65s cubic-bezier(.3, 1.9, .5, 1), border-color .3s, color .3s, background .3s; }
  .anim .pf .flow.in .flow-node { opacity: 1; transform: none; border-color: var(--primary); color: var(--primary); transition-delay: calc(var(--i) * .45s); }
  .anim .pf .flow.in .flow-step:last-child .flow-node { color: var(--on-primary); }
  .anim .pf .flow .flow-card { opacity: 0; transform: translateY(34px) scale(.92); transition: opacity .4s ease-out, transform .85s cubic-bezier(.3, 1.9, .5, 1); }
  .anim .pf .flow.in .flow-card { opacity: 1; transform: none; transition-delay: calc(var(--i) * .45s + .12s); }

  /* responsivo */
  @media (max-width: 1024px) {
    .pf .price-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 861px) and (max-width: 1024px) {
    .pf .flow-box { padding: 16px 14px; }
  }
  @media (max-width: 860px) {
    .pf { --sec-y: 80px; --gut: 20px; }
    .pf .nav-links, .pf .nav-wa { display: none; }
    .pf .nav-burger { display: inline-flex; }
    .pf .nav-panel:not([hidden]) { display: flex; }
    .pf .hero-in { grid-template-columns: minmax(0, 1fr); padding-block: 48px 72px; gap: 48px; }
    .pf .duas, .pf .duas-contato { grid-template-columns: minmax(0, 1fr); gap: 36px; }
    .pf .sticky-col { position: static; }
    .pf .lead { font-size: 17px; }
    .pf .cta-row .btn { flex: 1 1 auto; }
    .pf .form { padding: 22px; }
    .pf .showcase { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .pf .demo-list { flex-direction: row; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 6px; }
    .pf .demo-list > li { flex: 0 0 auto; scroll-snap-align: start; }
    .pf .demo-btn { width: auto; min-width: 190px; border-color: var(--line); }
    .pf .demo-btn .ch, .pf .list-cta { display: none; }
    .pf .tb-url { display: none; }
    .pf .sim { grid-template-columns: minmax(0, 1fr); }
    .pf .sim-cfg, .pf .sim-out { padding: 22px; }
    .pf .sim-out { border-left: 0; border-top: 1px solid var(--line); }
