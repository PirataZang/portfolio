/*
  Os fios do mapa são traçados pelo JS, em pixels, a partir do tamanho real do
  céu — e não num viewBox de 0 a 100 esticado. Esticar o viewBox entortaria a
  espessura do traço e quebraria a conta do `pathLength`, que é justamente o
  que deixa cada fio acender só mexendo em `stroke-dashoffset`.
*/
/* poeira de fundo: pontos fixos, gerados no build para não variar entre reloads */
const POEIRA = Array.from({ length: 26 }, (_, i) => {
  const r = (n: number) => ((Math.sin(i * 12.9898 + n) * 43758.5453) % 1 + 1) % 1;
  return { x: +(r(1) * 98).toFixed(2), y: +(r(7) * 96).toFixed(2), o: +(0.1 + r(3) * 0.28).toFixed(2), d: +(2.4 + r(5) * 4).toFixed(2) };
});

