/*
  O campo de formas. Coordenadas em cima de um viewBox 1200×700 recortado
  (`slice`), então cada seção ganha um recorte diferente do mesmo plano.
  Escolhidas à mão: aleatório de verdade sempre empilha duas no mesmo canto.
*/
type Forma = { f: string; x: number; y: number; s: number; r?: number; o?: number };

/*
  Como cada forma se mexe. Quem tem eixo claro gira; quem é aberto ou
  direcional flutua, porque um arco girando sem parar vira ventilador.
  Duração e atraso saem do índice e não de random: precisa ser estável entre
  um build e outro, e nenhuma dupla pode entrar em sincronia.
*/
const GIRA = new Set(['x', 'ast', 'mira', 'hex', 'los', 'qua', 'malha']);
const modo = (f: string) => (GIRA.has(f) ? 'gira' : 'flutua');
const ritmo = (i: number) => ({
  dur: 22 + ((i * 7) % 9) * 3.5,    // 22 s a 50 s
  atraso: -((i * 3.7) % 19),         // negativo: cada uma já começa no meio
  sentido: i % 3 === 0 ? 'reverse' : 'normal',
});

