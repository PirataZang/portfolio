}
@media (prefers-reduced-motion: reduce){
.h-ty,.cyc,.cmd{width:auto!important;animation:none!important}
.fx,.sv{opacity:1!important;animation:none!important;transform:none!important}
.cyc:not(:first-child){display:none}
.pct,.kw,.spin,.dr,.cur,.bc,.wv,.lv{animation:none!important}
.ph,.rowerr,.pop,.gl,.tg{animation:none!important}
.p4,.pa{opacity:1!important}
.pop{transform:none!important}
}
.tm button{font:inherit}
 .tm :focus-visible{outline:2px solid #fff;outline-offset:3px}
body{background:#0b0d11}
.tm{background:#0b0d11;color:#d8dde5;font-family:'IBM Plex Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased;overflow-x:clip}
.tm .pular{position:absolute;left:-9999px;top:8px;z-index:50;padding:10px 16px;background:#f5a524;color:#0b0d11;font-family:'IBM Plex Mono',monospace;border-radius:6px}
.tm .pular:focus{left:12px}
.tm .sr{position:absolute;width:1px;height:1px;margin:0;overflow:hidden;clip-path:inset(50%);white-space:nowrap}

/* terminal do topo */
.tm .term{border:1px solid #232a33;border-radius:12px;background:#0f1217;overflow:hidden;font-family:'IBM Plex Mono',monospace;color:#d8dde5}
.tm .term-bar{display:flex;align-items:center;gap:7px;padding:0 6px 0 16px;min-height:44px;border-bottom:1px solid #232a33;background:#12161c}
.tm .rp{margin-left:auto;min-height:44px;padding:0 12px;background:none;border:0;color:#8b95a3;font-size:12px;cursor:pointer}
.tm .rp:hover{color:#fff}
.tm .term-body{padding:18px 20px 22px;display:flex;flex-direction:column;gap:16px;font-size:13px;line-height:1.5}
.js .tb-pending{visibility:hidden}
@keyframes spf{0%{content:'|'}25%{content:'/'}50%{content:'-'}75%{content:'\\'}}
.tm .caret{display:inline-block;width:.6em;height:1.05em;vertical-align:-.15em;animation:blinkc 1.1s steps(1) infinite}
.tm .sp::before{content:'|';animation:spf .6s steps(1) infinite}
@media (prefers-reduced-motion: reduce){.tm .caret,.tm .sp::before{animation:none}}

/* skills: janela de terminal do Ubuntu */
.tm .ubu-body{background:#300a24;padding:22px 24px 26px;font-family:'Ubuntu Mono','IBM Plex Mono',monospace;font-size:16px;line-height:1.55;color:#eeeeec;display:flex;flex-direction:column;gap:4px}
.tm .fb{min-height:44px;padding:0 14px;border-radius:4px;cursor:pointer;font-family:'Ubuntu Mono',monospace;font-size:16px;border:1px solid #5e2750;background:transparent;color:#d9cdd8}
.tm .fb.on{border-color:#eeeeec;background:#5e2750;color:#fff}
.tm .off{display:none!important}

/* vitrine */
.tm .pick{display:flex;align-items:center;gap:14px;width:100%;min-height:56px;padding:8px 14px;cursor:pointer;border-radius:8px;border:1px solid transparent;background:transparent;text-align:left}
.tm .pick:hover{background:#0f1217}
.tm .pick.on{border-color:#2c3540;background:#12161c}
.tm .dv{min-height:36px;padding:0 12px;border-radius:6px;cursor:pointer;font-family:'IBM Plex Mono',monospace;font-size:12.5px;border:1px solid transparent;background:transparent;color:#8b95a3}
.tm .dv.on{border-color:#2c3540;background:#0b0d11;color:#fff}
.tm .nv{min-width:44px;min-height:44px;border:1px solid #2c3540;border-radius:8px;background:transparent;color:#d8dde5;cursor:pointer;font-family:'IBM Plex Mono',monospace;font-size:16px}
.tm .nv:hover{border-color:#8b95a3}
.tm [data-mob]{display:grid}
.tm .fone{width:232px;border:8px solid #1b2128;border-radius:30px;overflow:hidden;background:#000;box-shadow:0 18px 40px -16px #000}
.tm .fone-tela{position:relative;width:216px;height:468px;overflow:hidden}
.tm .fone-tela iframe{position:absolute;left:0;top:0;width:390px;height:844px;border:0;transform:scale(.5538);transform-origin:0 0;background:#fff}

/* simulador */
.tm .sim-t{display:flex;align-items:center;gap:10px;font-family:'IBM Plex Mono',monospace;font-size:15px;color:#fff}
.tm .sim-n{display:grid;place-items:center;width:22px;height:22px;border-radius:50%;background:#f5a524;color:#0b0d11;font-size:12px;font-weight:600}
.tm .pg{display:flex;flex-direction:column;align-items:center;gap:6px;min-height:56px;padding:8px 0;border-radius:6px;cursor:pointer;font-family:'IBM Plex Mono',monospace;font-size:11px;color:#6b7683;border:1px dashed #2c3540;background:transparent}
.tm .pg.on{color:#f5a524;border:1px solid #6b5320;background:#1c1710}
.tm .pg.sel{border-color:#f5a524}
.tm .op{display:flex;flex-direction:column;gap:2px;text-align:left;min-height:56px;padding:10px 14px;border-radius:8px;cursor:pointer;border:1px solid #2c3540;background:#0b0d11}
.tm .op b{font-family:'IBM Plex Mono',monospace;font-weight:500;font-size:14px;color:#fff}
.tm .op span{font-size:13px;color:#8b95a3}
.tm .op.on{border-color:#f5a524;background:#1c1710}
.tm .rec{display:flex;align-items:baseline;gap:10px;color:#d8dde5}
.tm .rec .pt{flex:1 1 auto;border-bottom:1px dotted #2c3540;transform:translateY(-3px)}
.tm .rec.desc{color:#4fe3b0}

</style>

<script>
const reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;
const $ = <T extends HTMLElement = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector<T>(s);
const $$ = <T extends HTMLElement = HTMLElement>(s: string, r: ParentNode = document) => [...r.querySelectorAll<T>(s)];
const brl = (v: number) => 'R$ ' + v.toLocaleString('pt-BR', { minimumFractionDigits: v % 1 ? 2 : 0, maximumFractionDigits: 2 });

/* ---------- terminal do topo: tudo é função do tempo t (ms) ---------- */
(() => {
  const root = $('[data-terminal]');
  if (!root) return;
  const END = 9400;
  const POOL = '01#$%&@/<>=+*?';
  const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
  const vis = (el: HTMLElement, on: boolean) => { el.style.visibility = on ? '' : 'hidden'; };

  const body = $('[data-body]', root)!;
  const typed = $('[data-typed]', root)!;
  const caret = $('[data-caret]', root)!;
  const CMD = typed.dataset.full!;
  const logs = $$('[data-log]', root);
  const build = $('[data-build]', root)!;
  const fill = $('[data-fill]', root)!;
  const pct = $('[data-pct]', root)!;
  const rows = [...$$('[data-b]', root), ...$$('[data-info]', root)];
  const pal = $$('[data-pal]', root);
  const final = $('[data-final]', root)!;

  /* os primeiros k caracteres já resolveram; o resto ainda embaralha */
  const decode = (row: HTMLElement, t: number, start: number, step: number) => {
    const full = row.dataset.full!;
    const k = clamp(Math.floor((t - start) / step) + 1, 0, full.length);
    const seed = Math.floor(t / 55);
    let rest = '';
    for (let i = k; i < full.length; i++) rest += full[i] === ' ' ? ' ' : POOL[(((i + 1) * 374761393 + seed * 668265263) >>> 0) % POOL.length];
    $('[data-done]', row)!.textContent = full.slice(0, k);
    $('[data-rest]', row)!.textContent = rest;
  };

  const frame = (t: number) => {
    typed.textContent = CMD.slice(0, clamp(Math.floor((t - 400) / 38) + 1, 0, CMD.length));
    caret.style.display = t >= 400 && t < 1450 ? '' : 'none';

    for (const l of logs) {
      const s = Number(l.dataset.s), ok = Number(l.dataset.ok);
      const done = ok > 0 && t >= ok;
      vis(l, t >= s);
      $('[data-oktag]', l)!.style.display = done ? '' : 'none';
      $('[data-sp]', l)!.style.display = done ? 'none' : '';
      vis($('[data-val]', l)!, done || ok === 0);
    }

    const bp = clamp((t - 3300) / 1400, 0, 1), be = 1 - Math.pow(1 - bp, 3);
    vis(build, t >= 3300);
    fill.style.width = (be * 100).toFixed(1) + '%';
    pct.textContent = Math.round(be * 100) + '%';
    pct.style.color = bp >= 1 ? '#4fe3b0' : '#d8dde5';

    for (const r of rows) {
      const s = Number(r.dataset.s);
      vis(r, t >= s);
      decode(r, t, 'b' in r.dataset ? s : s + 100, 'b' in r.dataset ? 14 : 24);
    }
    pal.forEach((p, k) => vis(p, t >= 8600 + k * 70));
    vis(final, t >= 9200);
  };

  let raf = 0;
  const play = () => {
    cancelAnimationFrame(raf);
    if (reduz) { frame(END); body.classList.remove('tb-pending'); return; }
    const t0 = performance.now();
    let last = -99;
    const tick = (now: number) => {
      const t = now - t0;
      if (t >= END) { frame(END); return; }
      if (t - last > 28) { last = t; frame(t); }
      raf = requestAnimationFrame(tick);
    };
    frame(0);
    body.classList.remove('tb-pending');
    raf = requestAnimationFrame(tick);
  };
  $('[data-replay]', root)!.addEventListener('click', play);
  play();
})();

/* ---------- skills: filtro por área ---------- */
(() => {
  const barra = $('[data-filtros]');
  if (!barra) return;
  const linhas = $$('[data-area]');
  const resumo = $('[data-resumo-skills]')!;
  barra.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-f]');
    if (!b) return;
    const f = b.dataset.f!;
    $$('[data-f]', barra).forEach((x) => { const on = x === b; x.classList.toggle('on', on); x.setAttribute('aria-pressed', String(on)); });
    let n = 0, estudo = 0;
    for (const l of linhas) {
      const ver = f === 'all' || l.dataset.area === f;
      l.classList.toggle('off', !ver);
      if (!ver) continue;
      n++;
      if (Number($('.lv', l)!.style.getPropertyValue('--p')) <= 2) estudo++;
    }
    resumo.textContent = `Habilidades carregadas: ${n} · em estudo: ${estudo} · falhas: 0`;
  });
})();

/* ---------- vitrine de sites ---------- */
(() => {
  const vit = $('[data-vitrine]');
  if (!vit) return;
  type Demo = { nome: string; nicho: string; desc: string; tags: string[]; img: string; url: string; ask: string };
  const demos: Demo[] = JSON.parse(vit.dataset.demos!);
  const picks = $$('.pick', vit);
  const img = $<HTMLImageElement>('[data-img]', vit)!;
  const frame = $<HTMLIFrameElement>('[data-frame]', vit)!;
  const desk = $('[data-desk]', vit)!, mob = $('[data-mob]', vit)!;
  let cur = Math.max(0, picks.findIndex((p) => p.classList.contains('on')));
  let dev = 'desk';

  const render = () => {
    const d = demos[cur];
    img.src = d.img;
    img.alt = `Captura da página inicial do site ${d.nome}`;
    $('[data-url]', vit)!.textContent = 'igorfronza.dev' + d.url;
    $('[data-nome]', vit)!.textContent = d.nome;
    $('[data-nicho]', vit)!.textContent = d.nicho;
    $('[data-desc]', vit)!.textContent = d.desc;
    $('[data-n]', vit)!.textContent = `${String(cur + 1).padStart(2, '0')} / ${String(demos.length).padStart(2, '0')}`;
    $<HTMLAnchorElement>('[data-abrir]', vit)!.href = d.url;
    $<HTMLAnchorElement>('[data-quero]', vit)!.href = d.ask;
    $('[data-tags]', vit)!.replaceChildren(...d.tags.map((t) => {
      const s = document.createElement('span');
      s.textContent = t;
      s.style.cssText = 'padding:4px 10px;border:1px solid #2c3540;border-radius:999px;color:#aab3bf';
      return s;
    }));
    picks.forEach((p, i) => {
      p.classList.toggle('on', i === cur);
      p.setAttribute('aria-pressed', String(i === cur));
      $('.seta', p)!.textContent = i === cur ? '›' : '';
    });
    /* o iframe só carrega quando alguém pede o celular */
    if (dev === 'mob' && frame.getAttribute('src') !== d.url) frame.src = d.url;
  };
  const setDev = (d: string) => {
    dev = d;
    $$('[data-dev]', vit).forEach((b) => { const on = b.dataset.dev === d; b.classList.toggle('on', on); b.setAttribute('aria-pressed', String(on)); });
    desk.hidden = d !== 'desk';
    mob.hidden = d !== 'mob';
    render();
  };
  picks.forEach((p, i) => p.addEventListener('click', () => { cur = i; render(); }));
  $$('[data-nav]', vit).forEach((b) => b.addEventListener('click', () => {
    cur = (cur + Number(b.dataset.nav) + demos.length) % demos.length;
    render();
  }));
  $$('[data-dev]', vit).forEach((b) => b.addEventListener('click', () => setDev(b.dataset.dev!)));
})();

/* ---------- simulador de preço (mesmos números dos cards) ---------- */
(() => {
  const sim = $('[data-sim]');
  if (!sim) return;
  const PAGINA = Number(sim.dataset.pagina), EXTRA = Number(sim.dataset.extra), PIX = Number(sim.dataset.pix), HOSP = Number(sim.dataset.hosp);
  const st = { pages: 1, pay: 'pix', host: 'me' };
  let exibido = PAGINA * (1 - PIX);
  let raf = 0;

  const marcar = (sel: string, ok: (b: HTMLElement) => boolean) =>
    $$(sel, sim).forEach((b) => { const on = ok(b); b.classList.toggle('on', on); b.setAttribute('aria-pressed', String(on)); });
  const linha = (cls: string, rotulo: string, valor: string) => {
    const el = document.createElement('div');
    el.className = 'rec' + (cls ? ' ' + cls : '');
    el.innerHTML = '<span></span><span class="pt" aria-hidden="true"></span><span></span>';
    el.children[0].textContent = rotulo;
    el.children[2].textContent = valor;
    return el;
  };

  const pinta = () => {
    const bruto = PAGINA + EXTRA * (st.pages - 1);
    const desc = st.pay === 'pix' ? bruto * PIX : 0;
    const total = bruto - desc;
    const extra = st.pages - 1;
    const linhas = [linha('', 'Site com a 1ª página', brl(PAGINA))];
    if (extra) linhas.push(linha('', `${extra} ${extra === 1 ? 'página extra' : 'páginas extras'} × ${brl(EXTRA)}`, brl(EXTRA * extra)));
    if (desc) linhas.push(linha('desc', 'Desconto Pix (10%)', '− ' + brl(desc)));
    $('[data-linhas]', sim)!.replaceChildren(...linhas);
    $('[data-rotulo]', sim)!.textContent = st.pages === 1 ? '· 1 página' : `· ${st.pages} páginas`;
    $('[data-pagto]', sim)!.textContent =
      st.pay === 'pix' ? 'à vista no Pix, já com 10% de desconto'
      : st.pay === 'card' ? `ou 6x de ${brl(bruto / 6)} sem juros no cartão`
      : `${brl(bruto * 0.4)} na entrada + ${brl(bruto * 0.6)} na entrega`;
    $('[data-hospedagem]', sim)!.hidden = st.host !== 'me';
    $$('[data-pg]', sim).forEach((b) => {
      const n = Number(b.dataset.pg);
      b.classList.toggle('on', n <= st.pages);
      b.classList.toggle('sel', n === st.pages);
      b.setAttribute('aria-pressed', String(n === st.pages));
    });
    marcar('[data-pay]', (b) => b.dataset.pay === st.pay);
    marcar('[data-host]', (b) => b.dataset.host === st.host);

    const nomes: Record<string, string> = { pix: 'Pix à vista', card: 'cartão em até 6x', split: '40% na entrada e 60% na entrega' };
    $<HTMLAnchorElement>('[data-enviar]', sim)!.href = `${sim.dataset.zap}?text=${encodeURIComponent(
      `Oi, Igor. Simulação: site com ${st.pages} ${st.pages === 1 ? 'página' : 'páginas'}, pagamento ${nomes[st.pay]}, ` +
      `${st.host === 'me' ? `com hospedagem (${brl(HOSP)}/mês)` : 'sem hospedagem'}. Total estimado: ${brl(total)}.`,
    )}`;

    /* o total conta até o novo valor; com movimento reduzido, troca direto */
    const alvo = $('[data-total]', sim)!;
    cancelAnimationFrame(raf);
    const de = exibido;
    if (reduz) { exibido = total; alvo.textContent = brl(total); return; }
    let t0 = 0;
    const passo = (ts: number) => {
      t0 ||= ts;
      const p = Math.min(1, (ts - t0) / 520);
      exibido = Math.round(de + (total - de) * (1 - Math.pow(1 - p, 3)));
      alvo.textContent = brl(p < 1 ? exibido : total);
      if (p < 1) raf = requestAnimationFrame(passo);
    };
    raf = requestAnimationFrame(passo);
  };
  $$('[data-pg]', sim).forEach((b) => b.addEventListener('click', () => { st.pages = Number(b.dataset.pg); pinta(); }));
  $$('[data-pay]', sim).forEach((b) => b.addEventListener('click', () => { st.pay = b.dataset.pay!; pinta(); }));
  $$('[data-host]', sim).forEach((b) => b.addEventListener('click', () => { st.host = b.dataset.host!; pinta(); }));
})();

/* ---------- copiar e-mail ---------- */
(() => {
  const b = $('[data-copiar]');
  if (!b) return;
  const aviso = $('[data-copiado]');
  let t = 0;
  b.addEventListener('click', () => {
    const ok = () => {
      b.textContent = 'copiado :]';
      b.style.color = '#4fe3b0';
      if (aviso) aviso.textContent = 'E-mail copiado.';
      clearTimeout(t);
      t = window.setTimeout(() => { b.textContent = 'copiar'; b.style.color = ''; if (aviso) aviso.textContent = ''; }, 2000);
    };
    /* sem permissão de área de transferência, o link de e-mail ao lado continua valendo */
    navigator.clipboard?.writeText(b.dataset.copiar!).then(ok, () => { if (aviso) aviso.textContent = 'Não consegui copiar. Use o link de e-mail.'; });
  });
})();

</script>
