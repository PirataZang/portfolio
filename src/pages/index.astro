@keyframes glitchin{
0%{opacity:0;transform:translateX(-16px) skewX(8deg);clip-path:inset(0 0 88% 0);filter:hue-rotate(90deg) saturate(2)}
10%{opacity:1;transform:translateX(12px) skewX(-4deg);clip-path:inset(22% 0 52% 0)}
20%{transform:translateX(-9px) skewX(5deg);clip-path:inset(62% 0 8% 0);filter:hue-rotate(-70deg) saturate(2)}
30%{opacity:.5;transform:translateX(7px);clip-path:inset(-40px)}
42%{opacity:1;transform:translateX(-5px) skewX(-3deg);clip-path:inset(40% 0 30% 0);filter:none}
56%{transform:translateX(3px);clip-path:inset(8% 0 70% 0);filter:hue-rotate(40deg)}
72%{transform:translateX(-2px);clip-path:inset(-40px);filter:none}
100%{opacity:1;transform:none;clip-path:inset(-40px);filter:none}
}
@keyframes tglitch{0%,34%{text-shadow:none;transform:none}35%{text-shadow:-3px 0 #f2665c,3px 0 #5fd3ff;transform:translateX(2px) skewX(-6deg)}37%{text-shadow:3px 0 #f2665c,-3px 0 #5fd3ff;transform:translateX(-2px)}39%{text-shadow:-2px 0 #f2665c,2px 0 #5fd3ff;transform:translateX(1px)}41%{text-shadow:2px 0 #f2665c,-2px 0 #5fd3ff;transform:none}43%,100%{text-shadow:none;transform:none}}
