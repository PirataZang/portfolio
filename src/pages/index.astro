    <meta name="theme-color" content="#07080f" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.documentElement.classList.add('anima-on');
    </script>
  </Fragment>

  <div class="pf">
    {/* ---------- biblioteca de formas: definida uma vez, usada em todo lugar ---------- */}
    <svg class="formas-defs" aria-hidden="true" focusable="false">
      <defs>
        {/*
          Traço de 1 px que não engrossa quando o <use> escala. O atributo vai
          na forma, não no <g>: vector-effect não é herdado, então num grupo
          ele não desceria para o path. fill/stroke, esses sim são herdados —
          vêm do CSS do .campo e atravessam o clone do <use>.
        */}
        <g id="s-x"><path vector-effect="non-scaling-stroke" d="M3 3 21 21M21 3 3 21" /></g>
        <g id="s-cir"><circle vector-effect="non-scaling-stroke" cx="12" cy="12" r="10.5" /></g>
        <g id="s-tri"><path vector-effect="non-scaling-stroke" d="M12 2 22.5 21H1.5Z" /></g>
        <g id="s-qua"><rect vector-effect="non-scaling-stroke" x="2.5" y="2.5" width="19" height="19" rx="2.5" /></g>
        <g id="s-lin"><path vector-effect="non-scaling-stroke" d="M0 12h24" /></g>
        <g id="s-los"><path vector-effect="non-scaling-stroke" d="M12 1 23 12 12 23 1 12Z" /></g>
        <g id="s-hex"><path vector-effect="non-scaling-stroke" d="M12 1.5 21.5 7v10L12 22.5 2.5 17V7Z" /></g>
        <g id="s-chev"><path vector-effect="non-scaling-stroke" d="M7 2.5 18 12 7 21.5" /></g>
        <g id="s-arc"><path vector-effect="non-scaling-stroke" d="M2 21A19 19 0 0 1 21 2" /></g>
        <g id="s-zig"><path vector-effect="non-scaling-stroke" d="M1 17 6.75 7l5.75 10 5.75-10L23 17" /></g>
        <g id="s-ast"><path vector-effect="non-scaling-stroke" d="M12 1v22M2.5 6.5 21.5 17.5M21.5 6.5 2.5 17.5" /></g>
        {/*
          Marcas de desenho técnico. Entraram no lugar de uma forma orgânica
          que era a única coisa sem régua no conjunto — e por isso destoava de
          todo o resto. Mira de centro, cota e marca de canto dão a variedade
          sem sair da prancheta.
        */}
        <g id="s-mira">
          <circle vector-effect="non-scaling-stroke" cx="12" cy="12" r="7" />
          <path vector-effect="non-scaling-stroke" d="M12 1v6M12 17v6M1 12h6M17 12h6" />
        </g>
        <g id="s-cota">
          <path vector-effect="non-scaling-stroke" d="M2 4v16M22 4v16M2 12h20" />
          <path vector-effect="non-scaling-stroke" d="M6.5 8.5 2 12l4.5 3.5M17.5 8.5 22 12l-4.5 3.5" />
        </g>
        <g id="s-canto">
          <path vector-effect="non-scaling-stroke" d="M2 9.5V2h7.5M22 14.5V22h-7.5" />
        </g>
        {/* nove aros de 1 px viram sujeira: esta é a única forma preenchida */}
        <g id="s-malha">
          <circle cx="3" cy="3" r="1.5" /><circle cx="12" cy="3" r="1.5" /><circle cx="21" cy="3" r="1.5" />
          <circle cx="3" cy="12" r="1.5" /><circle cx="12" cy="12" r="1.5" /><circle cx="21" cy="12" r="1.5" />
          <circle cx="3" cy="21" r="1.5" /><circle cx="12" cy="21" r="1.5" /><circle cx="21" cy="21" r="1.5" />
        </g>
      </defs>
    </svg>

    <a class="pular" href="#conteudo">Pular para o conteúdo</a>

    <header class="topo">
      <div class="topo-barra" data-progresso aria-hidden="true"></div>
      <a class="marca" href="#">
        <span class="marca-sig">IF</span>
        <span class="marca-txt">{EU.nome}<small>{EU.papel}</small></span>
      </a>
      <nav class="topo-nav" aria-label="Seções">
        <a href="#servicos">Serviços</a>
        <a href="#projetos">Projetos</a>
        <a href="#demos">Demos</a>
        <a href="#processo">Como funciona</a>
      </nav>
      <a class="btn btn-p btn-min menu-cta" href="#contato">
        <i class="fa-solid fa-paper-plane" aria-hidden="true"></i> Pedir orçamento
      </a>
      {/* só existe abaixo de 920 px — acima disso o nav completo já está à mostra */}
      <button
        class="menu-alterna"
        type="button"
        aria-expanded="false"
        aria-controls="menu-movel"
        data-menu-abre
      >
        <span class="menu-icone" aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="sr-only">Abrir menu</span>
      </button>
    </header>

    {/* cortina + painel: nascem fechados no CSS, e abrirMenu()/fecharMenu() no JS troca a classe */}
    <div class="menu-cortina" data-menu-cortina aria-hidden="true"></div>
    <div class="menu-movel" id="menu-movel" data-menu-movel>
      <nav aria-label="Seções">
        <a href="#servicos">Serviços</a>
        <a href="#projetos">Projetos</a>
        <a href="#demos">Demos</a>
        <a href="#processo">Como funciona</a>
      </nav>
      <a class="btn btn-p btn-g btn-cheio" href="#contato">
        <i class="fa-solid fa-paper-plane" aria-hidden="true"></i> Pedir orçamento
      </a>
      <ul class="menu-movel-contato">
        <li>
          <a href={`https://wa.me/${EU.zap}`} rel="noopener">
            <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> {EU.zapFmt}
          </a>
        </li>
        <li>
          <a href={`mailto:${EU.email}`}>
            <i class="fa-solid fa-envelope" aria-hidden="true"></i> {EU.email}
          </a>
        </li>
      </ul>
    </div>

    <main id="conteudo">
      {/* ================= HERÓI ================= */}
      <section class="heroi blueprint">
        <div class="halo halo-anil" aria-hidden="true"></div>
        <div class="halo halo-roxo" aria-hidden="true"></div>
        <svg class="campo" viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice" data-campo="0.16" aria-hidden="true" focusable="false">
          {
            CAMPO_HEROI.map((f, i) => (
              <g transform={`translate(${f.x} ${f.y}) scale(${f.s / 24})`}>
                <use
                  href={`#s-${f.f}`}
                  opacity={f.o ?? 1}
                  class={`fm fm-${modo(f.f)}`}
                  style={`--r:${f.r ?? 0}deg; --d:${ritmo(i).dur}s; --a:${ritmo(i).atraso}s; --sentido:${ritmo(i).sentido}`}
                />
              </g>
            ))
          }
        </svg>

        <div class="heroi-txt">
          <p class="fita" data-anima>
            <span class="pisca" aria-hidden="true"></span>
            Disponível para projeto · {EU.local}
          </p>
          <h1>
            <span class="linha" data-linha>Sites e sistemas</span>
            <span class="linha" data-linha>feitos <em>sob medida</em>,</span>
            <span class="linha" data-linha>não sobre molde.</span>
          </h1>
          <p class="lead" data-anima>
            {perfil?.bio ?? '💻 Fullstack Developer | Criador de Soluções Inteligentes'} —
            escrevo Vue, Go e TypeScript, entrego em container e deixo o
            código aberto para você conferir.
          </p>
          <div class="acoes" data-anima>
            <a class="btn btn-p btn-g" href="#servicos">
              <i class="fa-solid fa-tags" aria-hidden="true"></i> Ver serviços e preços
            </a>
            <a class="btn btn-fant btn-g" href={`https://github.com/${EU.gh}`} rel="noopener">
              <i class="fa-brands fa-github" aria-hidden="true"></i> Ver o código
            </a>
          </div>

          <dl class="nums" data-anima>
            {
              numeros.map((n) => (
                <div>
                  <dt data-conta-ate={n.v} data-ano={n.ano ? '1' : null}>{n.v}</dt>
                  <dd>{n.l}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <p class="rola" aria-hidden="true">scroll</p>
      </section>

      {/* ================= O CAMINHO — seção presa, uma etapa por vez ================= */}
      {/*
        Mesmo mecanismo das cenas 3D dos outros sites do portfolio: a seção é
        alta, o miolo fica `sticky` e o scroll troca o conteúdo no lugar. A
        classe `.presa` entra pelo JS — sem ela, e sem JS, as cinco caixas
        aparecem empilhadas numa lista normal, que é um estado legível.
      */}
      <section class="caminho blueprint" id="processo" data-caminho>
        <div class="caminho-miolo">
          <div class="caixa caminho-caixa">
            <header class="cab" data-anima>
              <p class="olho olho-escuro">Como a coisa anda</p>
              <h2>Da primeira conversa ao container rodando</h2>
            </header>

            {/* a barra fica ACIMA da caixa e avança junto com o scroll */}
            <div class="cam-barra" aria-hidden="true">
              <span class="cam-trilho"><span class="cam-preenche" data-cam-preenche></span></span>
              <ol class="cam-marcos">
                {CAMINHO.map((c) => (
                  <li data-cam-marco><span></span>{c.n}</li>
                ))}
              </ol>
            </div>

            <p class="cam-conta" aria-live="polite">
              <b data-cam-atual>1</b> de {CAMINHO.length}
            </p>

            <div class="cam-palco">
              {CAMINHO.map((c, i) => (
                <article class="cam-cx" data-cam-cx aria-hidden={i === 0 ? null : 'true'}>
                  <div class="cam-cx-cab">
                    <span class="cam-n">{c.n}</span>
                    <i class={c.i} aria-hidden="true"></i>
                    <span class="cam-marco">{c.marco}</span>
                  </div>
                  <h3>{c.t}</h3>
                  <p>{c.d}</p>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>

      {/* ================= SERVIÇOS ================= */}
      <section class="secao servicos blueprint" id="servicos">
        <svg class="campo" viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice" data-campo="-0.1" aria-hidden="true" focusable="false">
          {
            CAMPO_SERVICOS.map((f, i) => (
              <g transform={`translate(${f.x} ${f.y}) scale(${f.s / 24})`}>
                <use
                  href={`#s-${f.f}`}
                  class={`fm fm-${modo(f.f)}`}
                  style={`--r:${f.r ?? 0}deg; --d:${ritmo(i).dur}s; --a:${ritmo(i).atraso}s; --sentido:${ritmo(i).sentido}`}
                />
              </g>
            ))
          }
        </svg>

        <div class="caixa caixa-larga">
          <header class="cab" data-anima>
            <p class="olho">Serviços</p>
            <h2>Três formas de trabalhar junto</h2>
            <p class="lead">
              Preço de referência para você calibrar orçamento agora. O valor
              fecha depois da conversa, por escrito, e não muda no meio.
            </p>
          </header>

          <ul class="grade-serv">
            {
              SERVICOS.map((s) => (
                <li class={`serv${s.destaque ? ' serv-d' : ''}`} data-anima data-brilho>
                  <div class="serv-luz" aria-hidden="true"></div>
                  {s.destaque && <span class="serv-selo">mais pedido</span>}
                  <i class={`serv-i ${s.icone}`} aria-hidden="true"></i>
                  <h3>{s.t}</h3>
                  <p class="serv-sub">{s.sub}</p>
                  <p class="serv-preco">
                    <small>a partir de</small>
                    <b>{s.de}</b>
                    <span>{s.unidade}</span>
                  </p>
                  {s.extra && <p class="serv-extra">{s.extra}</p>}
                  <p class="serv-txt">{s.d}</p>
                  <ul class="serv-itens">
                    {s.itens.map((i) => (
                      <li>
                        <i class="fa-solid fa-check" aria-hidden="true"></i>
                        {i}
                      </li>
                    ))}
                  </ul>
                  {s.naoEntra && <p class="serv-fora">{s.naoEntra}</p>}
                  <p class="serv-prazo">
                    <i class="fa-solid fa-stopwatch" aria-hidden="true"></i> {s.prazo}
                  </p>
                  <a class={`btn ${s.destaque ? 'btn-p' : 'btn-fant'} btn-cheio`} href={`#contato`} data-servico={s.t}>
                    Quero um orçamento
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="nota-preco" data-anima>
            Parcelo em até 6× sem juros no cartão, ou 10% de desconto no Pix à
            vista. Manutenção mensal é opcional e cotada separada.
          </p>
        </div>
      </section>

      {/* ================= PROJETOS DO GITHUB ================= */}
      <section class="secao projetos" id="projetos">
        <svg class="campo" viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice" data-campo="0.13" aria-hidden="true" focusable="false">
          {
            CAMPO_PROJETOS.map((f, i) => (
              <g transform={`translate(${f.x} ${f.y}) scale(${f.s / 24})`}>
                <use
                  href={`#s-${f.f}`}
                  class={`fm fm-${modo(f.f)}`}
                  style={`--r:${f.r ?? 0}deg; --d:${ritmo(i).dur}s; --a:${ritmo(i).atraso}s; --sentido:${ritmo(i).sentido}`}
                />
              </g>
            ))
          }
        </svg>

        <div class="caixa">
          <header class="cab" data-anima>
            <p class="olho">Código aberto</p>
            <h2>Projetos no GitHub</h2>
            <p class="lead">
              Puxado da API pública do GitHub na hora do build. Nada de
              mockup: é o repositório, com a linguagem e a data reais. Passe o
              ponteiro para a esteira parar, ou arraste para o lado.
            </p>
          </header>
        </div>

        {/*
          Esteira infinita. A fila é renderizada duas vezes e a faixa desliza
          exatamente uma cópia, então a emenda nunca aparece. A segunda cópia é
          decoração: `aria-hidden` e `inert` para não duplicar link nem parada
          de tabulação para quem navega por teclado ou leitor de tela.
        */}
        <div class="trilha-envolve">
          <div class="trilha no-bar" data-trilha data-anima>
            <div class="esteira">
              {
                [0, 1].map((copia) => (
                  <ul class={`fila${copia ? ' fila-clone' : ''}`} aria-hidden={copia ? 'true' : null} inert={copia === 1}>
                    {
                      projetos.map((p) => (
                  <li class="proj" data-brilho>
                    <div class="serv-luz" aria-hidden="true"></div>
                    <div class="proj-cab">
                      <span class="proj-tipo">{p.tipo}</span>
                      {p.estrelas > 0 && (
                        <span class="proj-estrela">
                          <i class="fa-solid fa-star" aria-hidden="true"></i> {p.estrelas}
                        </span>
                      )}
                    </div>
                    <h3><span class="cerquilha">/</span>{p.nome}</h3>
                    <p class="proj-d">{p.resumo}</p>
                    <p class="proj-pe">
                      {p.lang && (
                        <span class="proj-lang">
                          <i style={`--cor:${CORES[p.lang] ?? '#8b93b5'}`} aria-hidden="true"></i>
                          {p.lang}
                        </span>
                      )}
                      {p.empurrado && (
                        <span class="proj-data">
                          {new Date(p.empurrado).toLocaleDateString('pt-BR', { month: 'short', year: 'numeric' })}
                        </span>
                      )}
                    </p>
                    <div class="proj-links">
                      <a href={p.url} rel="noopener">
                        <i class="fa-brands fa-github" aria-hidden="true"></i> Código
                      </a>
                      {p.aoVivo && (
                        <a href={p.aoVivo} rel="noopener" class="proj-vivo">
                          <i class="fa-solid fa-up-right-from-square" aria-hidden="true"></i> Ver no ar
                        </a>
                      )}
                    </div>
                  </li>
                      ))
                    }
                  </ul>
                ))
              }
            </div>
          </div>
          {/* só existem onde tem mouse de verdade — no toque, o próprio arraste já navega */}
          <button class="trilha-seta trilha-seta-e" type="button" data-trilha-seta="-1" aria-label="Projeto anterior">
            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
          </button>
          <button class="trilha-seta trilha-seta-d" type="button" data-trilha-seta="1" aria-label="Próximo projeto">
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
          </button>
        </div>

        <div class="caixa">
          <p class="trilha-pe" data-anima>
            <a class="btn btn-fant" href={`https://github.com/${EU.gh}?tab=repositories`} rel="noopener">
              <i class="fa-brands fa-github" aria-hidden="true"></i>
              Ver todos os projetos
            </a>
          </p>
        </div>
      </section>

      {/* ================= DEMOS ================= */}
      <section class="secao demos" id="demos">
        <div class="caixa">
          <header class="cab" data-anima>
            <p class="olho">Demonstrações</p>
            <h2>Sites completos, para você abrir e clicar</h2>
            <p class="lead">
              Cada demo é um site de verdade, com conteúdo escrito e fluxo que
              funciona. É o que eu entrego, não um print.
            </p>
          </header>

          <ul class="grade-demos">
            {
              DEMOS.map((d) => (
                <li class="demo" data-anima>
                  <a href={`/sites/${d.slug}`} class={d.pronto ? '' : 'demo-wip'}>
                    <span class="demo-tag">{d.tag}</span>
                    <span class="demo-nome">{d.nome}</span>
                    <span class="demo-nota">{d.nota}</span>
                    <span class="demo-seta" aria-hidden="true">
                      <i class="fa-solid fa-arrow-right"></i>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      {/* ================= STACK ================= */}
      <section class="secao stack blueprint" id="stack">
        <div class="caixa">
          <header class="cab" data-anima>
            <p class="olho">Ferramental</p>
            <h2>Com o que eu construo</h2>
            <p class="lead">
              Escolha de stack é decisão de manutenção, não de moda. Estas são
              as que eu sustento em produção.
            </p>
          </header>

          <div class="grade-stack">
            {
              STACK.map((g) => (
                <section class="stack-g" data-anima>
                  <h3>{g.g}</h3>
                  <ul>
                    {g.itens.map((i) => <li>{i}</li>)}
                  </ul>
                </section>
              ))
            }
          </div>

          {linguagens.length > 0 && (
            <p class="stack-nota" data-anima>
              Nos repositórios públicos hoje:{' '}
              {linguagens.map((l, i) => (
                <>
                  <span class="stack-lang">
                    <i style={`--cor:${CORES[l] ?? '#8b93b5'}`} aria-hidden="true"></i>{l}
                  </span>
                  {i < linguagens.length - 1 ? ' · ' : ''}
                </>
              ))}
            </p>
          )}
        </div>
      </section>

      {/* ================= CONTATO ================= */}
      <section class="secao contato" id="contato">
        <svg class="campo" viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice" data-campo="-0.14" aria-hidden="true" focusable="false">
          {
            CAMPO_CONTATO.map((f, i) => (
              <g transform={`translate(${f.x} ${f.y}) scale(${f.s / 24})`}>
                <use
                  href={`#s-${f.f}`}
                  class={`fm fm-${modo(f.f)}`}
                  style={`--r:${f.r ?? 0}deg; --d:${ritmo(i).dur}s; --a:${ritmo(i).atraso}s; --sentido:${ritmo(i).sentido}`}
                />
              </g>
            ))
          }
        </svg>
        <div class="halo halo-roxo halo-baixo" aria-hidden="true"></div>

        <div class="caixa">
          <div class="contato-grade">
            <div data-anima>
              <p class="olho">Contato</p>
              <h2>Me conte o que precisa resolver</h2>
              <p class="lead">
                Responda em três campos e eu volto com uma faixa de preço e um
                prazo no mesmo dia. Se não for meu tipo de projeto, eu digo — e
                indico quem faz.
              </p>
              <ul class="contato-links">
                <li>
                  <a href={`https://wa.me/${EU.zap}`} rel="noopener">
                    <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> WhatsApp {EU.zapFmt}
                  </a>
                </li>
                <li>
                  <a href={`mailto:${EU.email}`}>
                    <i class="fa-solid fa-envelope" aria-hidden="true"></i> {EU.email}
                  </a>
                </li>
                <li>
                  <a href={`https://github.com/${EU.gh}`} rel="noopener">
                    <i class="fa-brands fa-github" aria-hidden="true"></i> github.com/{EU.gh}
                  </a>
                </li>
              </ul>
            </div>

            <form class="form" data-form data-zap={EU.zap} data-anima>
              <div class="form-2">
                <label>
                  Nome
                  <input name="nome" type="text" required autocomplete="name" placeholder="Como te chamo" />
                </label>
                <label>
                  WhatsApp ou e-mail
                  <input name="contato" type="text" required placeholder="(47) 90000-0000" />
                </label>
              </div>

              <label>
                O que você precisa
                <select name="servico" data-alvo>
                  {SERVICOS.map((s) => <option>{s.t}</option>)}
                  <option>Ainda não sei</option>
                </select>
              </label>

              <div class="form-2">
                <label>
                  Orçamento previsto
                  <select name="verba">
                    <option>Até R$ 1.500</option>
                    <option selected>R$ 1.500 a R$ 3.000</option>
                    <option>R$ 3.000 a R$ 8.000</option>
                    <option>Acima de R$ 8.000</option>
                    <option>Prefiro que você me diga</option>
                  </select>
                </label>
                <label>
                  Prazo
                  <select name="prazo">
                    <option>Sem pressa</option>
                    <option selected>Nas próximas semanas</option>
                    <option>É urgente</option>
                  </select>
                </label>
