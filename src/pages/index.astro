</Base>

<style>
  .pf {
    /* noite azulada: preto que puxa para anil, nunca cinza */
    --noite: #07080f;
    --noite-2: #0a0c17;
    --noite-3: #0f1224;
    --carta: #121629;

    /* o azul quase preto das formas do fundo */
    --tracado: #1b2650;

    --anil: #1e2b6b;
    --anil-luz: #4472f7;
    --roxo: #5b2ec4;
    --roxo-luz: #a259f7;
    --ciano: #35d6f0;

    --gelo: #eaeefc;
    --gelo-60: #98a1c4;
    --gelo-40: #666f93;
    --borda: #1c2140;
    --borda-viva: #2b3468;

    --clara: #eef1f9;
    --clara-2: #e2e7f4;
    --escuro: #0b0e1c;
    --escuro-60: #4a5273;

    --raio: 14px;
    --raio-g: 22px;
    --topo-h: 4rem;
    --t: 0.4s;
    --e: cubic-bezier(0.22, 0.61, 0.36, 1);
    --brilho: 0 0 0 1px var(--borda-viva), 0 20px 50px -24px rgba(91, 46, 196, 0.55);

    position: relative;
    background: var(--noite);
    color: var(--gelo);
    font-family: 'Sora', ui-sans-serif, system-ui, sans-serif;
    font-size: 1rem;
    line-height: 1.62;
  }

  :global(body) { background: #07080f; color: #eaeefc; }
  :global(::selection) { background: #5b2ec4; color: #fff; }
  /* trava o fundo enquanto o menu móvel está aberto, senão a página rola por baixo dele */
  :global(body.menu-travado) { overflow: hidden; }

  .formas-defs { position: absolute; width: 0; height: 0; overflow: hidden; }

  .pular {
    position: absolute; left: -9999px; top: 0; z-index: 100;
    background: var(--roxo); color: #fff; padding: 0.7rem 1.1rem;
    text-decoration: none; border-radius: 0 0 var(--raio) 0;
  }
  .pular:focus { left: 0; }

  /* ---------- tipografia ---------- */
  h1, h2, h3 {
    font-weight: 700; letter-spacing: -0.032em; line-height: 1.1;
    margin: 0; text-wrap: balance;
  }
  h1 { font-size: clamp(2.4rem, 6.2vw, 4.6rem); font-weight: 800; line-height: 1.04; }
  h2 { font-size: clamp(1.8rem, 3.6vw, 2.9rem); }
  h3 { font-size: 1.18rem; letter-spacing: -0.02em; }
  p { margin: 0; text-wrap: pretty; }
  .lead { font-size: 1.04rem; color: var(--gelo-60); max-width: 56ch; }

  .olho {
    display: inline-flex; align-items: center; gap: 0.55rem;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.7rem; font-weight: 500; letter-spacing: 0.2em;
    text-transform: uppercase; margin: 0 0 0.9rem;
    color: var(--anil-luz);
  }
  .olho::before {
    content: ''; width: 22px; height: 1px; flex: none;
    background: linear-gradient(90deg, transparent, var(--roxo-luz));
  }
  .olho-escuro { color: #2743b8; }
  .olho-escuro::before { background: linear-gradient(90deg, transparent, #6b21d6); }

  /*
    Texto em gradiente. Cor sólida é o estado base, e o gradiente só entra
    onde background-clip: text existe — senão `color: transparent` deixaria
    título e rótulo invisíveis.
  */
  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .olho, h1 em, .nums dt, .serv-d .serv-preco b {
      color: transparent;
      -webkit-background-clip: text; background-clip: text;
    }
    .olho { background-image: linear-gradient(90deg, var(--anil-luz), var(--roxo-luz)); }
    .olho-escuro { background-image: linear-gradient(90deg, #2743b8, #6b21d6); }
    h1 em { background-image: linear-gradient(100deg, var(--anil-luz) 8%, var(--roxo-luz) 62%, var(--ciano)); }
    .nums dt { background-image: linear-gradient(140deg, var(--gelo) 25%, var(--anil-luz)); }
    .serv-d .serv-preco b { background-image: linear-gradient(110deg, var(--gelo), var(--roxo-luz)); }
  }

  .caixa { max-width: 1200px; margin: 0 auto; padding-inline: clamp(1rem, 4vw, 2.6rem); }
  /* quatro cartões de preço lado a lado não cabem em 1200: esta seção usa
     mais tela que o resto da página, de propósito */
  .caixa-larga { max-width: 1560px; }
  /* o campo de formas transborda de propósito; o corte é aqui e não no .pf,
     que é ancestral do topo fixo */
  .secao { position: relative; overflow: hidden; padding-block: clamp(3.8rem, 8vw, 7rem); }
  .cab { margin-bottom: clamp(2.2rem, 4vw, 3.2rem); max-width: 60ch; }
  .cab .lead { margin-top: 0.9rem; }
  .cab-larga {
    max-width: none; display: flex; flex-wrap: wrap; gap: 1.5rem;
    align-items: flex-end; justify-content: space-between;
  }
  .cab-larga > div:first-child { max-width: 60ch; }

  /* ---------- botões ---------- */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.55rem;
    padding: 0.78rem 1.4rem; border-radius: 999px;
    font-family: inherit; font-size: 0.93rem; font-weight: 600; text-decoration: none;
    border: 1px solid transparent; white-space: nowrap; cursor: pointer;
    transition: background var(--t) var(--e), border-color var(--t) var(--e),
      color var(--t) var(--e), box-shadow var(--t) var(--e);
  }
  .btn-g { padding: 0.95rem 1.7rem; font-size: 1rem; }
  .btn-min { padding: 0.55rem 1.05rem; font-size: 0.85rem; }
  .btn-cheio { width: 100%; }
  .btn-p {
    background: linear-gradient(120deg, var(--anil-luz), var(--roxo));
    color: #fff;
    box-shadow: 0 12px 30px -16px rgba(91, 46, 196, 0.95);
  }
  .btn-p:hover {
    box-shadow: 0 0 0 1px rgba(162, 89, 247, 0.5), 0 16px 40px -16px rgba(91, 46, 196, 1);
  }
  .btn-fant { background: rgba(234, 238, 252, 0.04); color: var(--gelo); border-color: var(--borda-viva); }
  .btn-fant:hover { border-color: var(--roxo-luz); background: rgba(162, 89, 247, 0.1); }

  /* ---------- formas de fundo ---------- */
  .campo {
    position: absolute; inset: -6% -2%; width: 104%; height: 112%;
    /* fill/stroke são herdados e atravessam o <use>; vector-effect não é,
       e por isso mora como atributo nos <g> do <defs> */
    fill: none; stroke: var(--tracado); stroke-width: 1;
    pointer-events: none; z-index: 0;
  }
  /* a malha de pontos é sólida, senão nove aros minúsculos viram sujeira */
  .campo use[href='#s-malha'] { fill: var(--tracado); stroke: none; }

  /*
    O movimento de cada forma. A posição vive no <g> de fora e a animação no
    <use> de dentro, e essa separação é obrigatória: `transform` em CSS
    SUBSTITUI o atributo transform do SVG — no mesmo elemento, a forma perderia
    o lugar e voaria para o canto da tela.

    `transform-box: fill-box` faz o eixo ser o centro da própria forma e não a
    origem do SVG. Sem isso, girar 20° manda a peça para o outro lado.
  */
  .fm {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    transform: rotate(var(--r, 0deg));
  }
  @media (prefers-reduced-motion: no-preference) {
    .fm-gira {
      animation: fm-gira var(--d, 30s) linear var(--a, 0s) infinite;
      animation-direction: var(--sentido, normal);
    }
    .fm-flutua {
      animation: fm-flutua var(--d, 30s) ease-in-out var(--a, 0s) infinite;
      animation-direction: var(--sentido, normal);
    }
  }
  @keyframes fm-gira {
    from { transform: rotate(var(--r, 0deg)); }
    to { transform: rotate(calc(var(--r, 0deg) + 360deg)); }
  }
  /* deriva curta com uma inclinada de ida e volta. O valor é pré-escala,
     então forma grande deriva mais — profundidade de graça. */
  @keyframes fm-flutua {
    0%, 100% { transform: rotate(var(--r, 0deg)) translate(0, 0); }
    33% { transform: rotate(calc(var(--r, 0deg) + 5deg)) translate(1.5px, -3.5px); }
    66% { transform: rotate(calc(var(--r, 0deg) - 4deg)) translate(-1.5px, 2.5px); }
  }
  .secao > .caixa, .heroi-txt { position: relative; z-index: 2; }

  /* halo: a luz que faz o preto não ser preto */
  .halo {
    position: absolute; border-radius: 50%; pointer-events: none; z-index: 1;
    filter: blur(90px); opacity: 0.5;
  }
  .halo-anil {
    width: 46rem; height: 32rem; top: -14rem; right: -12rem;
    background: radial-gradient(circle, var(--anil) 0%, transparent 68%);
  }
  .halo-roxo {
    width: 38rem; height: 30rem; bottom: -14rem; left: -10rem;
    background: radial-gradient(circle, var(--roxo) 0%, transparent 66%);
    opacity: 0.38;
  }
  .halo-baixo { top: auto; bottom: -16rem; left: 50%; translate: -50% 0; }

  /* malha de engenharia, esmaecida no meio */
  /*
    A grade de prancheta. Dois níveis é o que separa papel de engenharia de uma
    grade qualquer: fio fino a cada 34 px e fio forte a cada 170 px, um a cada
    cinco. Esmaece no topo e no pé para não cortar seco na emenda das seções.

    Uma regra só, e cada seção escolhe a cor pelas duas variáveis — a clara
    precisa de azul escuro, as escuras de azul luminoso.
  */
  .blueprint {
    --g-fina: rgba(68, 114, 247, 0.045);
    --g-forte: rgba(68, 114, 247, 0.09);
  }
  .blueprint::before {
    content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background-image:
      linear-gradient(to right, var(--g-fina) 1px, transparent 1px),
      linear-gradient(to bottom, var(--g-fina) 1px, transparent 1px),
      linear-gradient(to right, var(--g-forte) 1px, transparent 1px),
      linear-gradient(to bottom, var(--g-forte) 1px, transparent 1px);
    background-size: 34px 34px, 34px 34px, 170px 170px, 170px 170px;
    mask-image: linear-gradient(180deg, transparent, #000 16%, #000 84%, transparent);
  }

  /* ---------- herói ---------- */
  .heroi {
    position: relative; overflow: hidden;
    min-height: min(94svh, 52rem);
    display: grid; align-items: center;
    padding: calc(var(--topo-h) + clamp(2.5rem, 6vh, 4.5rem)) clamp(1rem, 4vw, 2.6rem)
      clamp(4.5rem, 10vh, 7rem);
    border-bottom: 1px solid var(--borda);
  }
  .heroi-txt { max-width: 1200px; margin: 0 auto; width: 100%; }

  .fita {
    display: inline-flex; align-items: center; gap: 0.6rem;
    padding: 0.42rem 0.95rem 0.42rem 0.75rem; margin-bottom: 1.7rem;
    border-radius: 999px; border: 1px solid var(--borda-viva);
    background: rgba(68, 114, 247, 0.08);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.74rem; color: var(--gelo-60);
  }
  .pisca {
    width: 7px; height: 7px; border-radius: 50%; flex: none;
    background: #37e08a; box-shadow: 0 0 10px 1px #37e08a;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pisca { animation: respira 2.4s ease-in-out infinite; }
  }
  @keyframes respira { 50% { opacity: 0.35; box-shadow: 0 0 4px 0 #37e08a; } }

  h1 .linha { display: block; }
  h1 em { font-style: normal; color: var(--roxo-luz); }
  .heroi .lead { margin-top: 1.6rem; font-size: 1.1rem; max-width: 48ch; }
  .acoes { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.2rem; }

  .nums {
    margin: 3.2rem 0 0; padding-top: 1.8rem;
    border-top: 1px solid var(--borda);
    display: grid; gap: 1.4rem 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr));
  }
  .nums dt {
    font-size: clamp(1.9rem, 3.4vw, 2.5rem); font-weight: 800; letter-spacing: -0.04em;
    line-height: 1; font-variant-numeric: tabular-nums;
    color: var(--gelo);
  }
  .nums dd {
    margin: 0.5rem 0 0; font-size: 0.82rem; color: var(--gelo-40);
    max-width: 20ch; line-height: 1.5;
  }

  .rola {
    position: absolute; z-index: 2; left: 50%; bottom: 1.2rem; translate: -50% 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--gelo-40);
  }
  .rola::after {
    content: ''; display: block; width: 1px; height: 2rem; margin: 0.55rem auto 0;
    background: linear-gradient(var(--roxo-luz), transparent);
  }

  /* ---------- serviços ---------- */
  .servicos { background: var(--noite-2); border-bottom: 1px solid var(--borda); }
  /*
    Quatro colunas fixas a partir de 1180 px. `auto-fit` resolvia pela largura
    e não pela contagem: com quatro cartões dava 3+1, e o último ficava órfão
    na fileira de baixo. Abaixo disso vai para 2+2, e no celular empilha.

    Sem `align-items: start`: os quatro esticam até a mesma altura e o
    `flex: 1` da lista empurra prazo e botão para a mesma linha de base.
  */
  .grade-serv {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: clamp(0.9rem, 1.6vw, 1.3rem);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .grade-serv { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1180px) { .grade-serv { grid-template-columns: repeat(4, 1fr); } }
  .serv, .proj {
    position: relative; overflow: hidden;
    display: flex; flex-direction: column;
    background: var(--carta); border: 1px solid var(--borda);
    border-radius: var(--raio-g); padding: clamp(1.2rem, 1.9vw, 1.6rem);
    transition: border-color var(--t) var(--e), box-shadow var(--t) var(--e),
      background var(--t) var(--e);
  }
  .serv:hover, .proj:hover { border-color: var(--borda-viva); box-shadow: var(--brilho); }
  /* fio luminoso no topo do card, mais forte no destaque */
  .serv::before, .proj::before {
    content: ''; position: absolute; inset: 0 0 auto; height: 1px;
    background: linear-gradient(90deg, transparent, var(--anil-luz), var(--roxo-luz), transparent);
    opacity: 0.35; transition: opacity var(--t) var(--e);
  }
  .serv:hover::before, .proj:hover::before { opacity: 1; }
  .serv-d { border-color: var(--borda-viva); background: linear-gradient(170deg, #17193a, var(--carta) 55%); }
  .serv-d::before { opacity: 1; }

  /* o brilho que segue o ponteiro — coordenadas vêm do JS em --mx/--my */
  .serv-luz {
    position: absolute; inset: -1px; pointer-events: none; opacity: 0;
    background: radial-gradient(
      16rem 16rem at var(--mx, 50%) var(--my, 0%),
      rgba(162, 89, 247, 0.16),
      transparent 62%
    );
    transition: opacity 0.45s var(--e);
  }
  .serv:hover .serv-luz, .proj:hover .serv-luz { opacity: 1; }

  .serv-selo {
    position: absolute; right: 1rem; top: 1rem;
    padding: 0.22rem 0.6rem; border-radius: 999px;
    background: linear-gradient(100deg, var(--anil-luz), var(--roxo));
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
  }
  .serv-i {
    width: 2.5rem; height: 2.5rem; display: grid; place-items: center;
    border-radius: 11px; margin-bottom: 1rem; font-size: 1rem;
    color: var(--anil-luz);
    background: rgba(68, 114, 247, 0.1);
    border: 1px solid var(--borda-viva);
  }
  .serv-d .serv-i { color: var(--roxo-luz); background: rgba(162, 89, 247, 0.12); }
  .serv-sub { margin-top: 0.3rem; font-size: 0.85rem; color: var(--gelo-40); }
  .serv-preco {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem;
    margin: 1.3rem 0 0; padding: 1rem 0; border-block: 1px solid var(--borda);
  }
  .serv-preco small {
    width: 100%; font-family: 'JetBrains Mono', monospace;
    font-size: 0.64rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gelo-40);
  }
  .serv-preco b { font-size: clamp(1.6rem, 2.4vw, 1.95rem); font-weight: 800; letter-spacing: -0.04em; }
  .serv-preco span { font-size: 0.76rem; color: var(--gelo-40); }

  .serv-txt { margin-top: 1rem; font-size: 0.87rem; color: var(--gelo-60); }
  .serv-itens { list-style: none; margin: 1.2rem 0 0; padding: 0; display: grid; gap: 0.55rem; flex: 1; }
  .serv-itens li {
    display: grid; grid-template-columns: 0.95rem 1fr; gap: 0.5rem;
    font-size: 0.83rem; color: var(--gelo-60); line-height: 1.42;
  }
  .serv-itens i { color: var(--ciano); font-size: 0.68rem; margin-top: 0.35rem; }
  .serv-prazo {
    display: flex; align-items: center; gap: 0.45rem;
    margin: 1.3rem 0 1.1rem;
    font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; color: var(--gelo-40);
  }
  .nota-preco {
    margin-top: 1.6rem; font-size: 0.82rem; color: var(--gelo-40); text-align: center;
  }

  /* ---------- projetos ---------- */
  .projetos { background: var(--noite); }

  /*
    Esteira infinita — rolagem nativa, não `transform`.

    `trilha.scrollLeft` anda sozinho via rAF, e some (`-= período`) sempre que
    passa de uma fila inteira; como a segunda fila é clone pixel a pixel da
    primeira, o salto não aparece. A diferença de fundo para a versão antiga
    (que animava `transform` com o Motion): `overflow-x` continua `auto` o
    tempo inteiro, então o dedo/mouse pode arrastar por cima do piloto
    automático a qualquer momento — não existe um modo "travado" à parte.

    Estado sem JS (ou com `prefers-reduced-motion`): rolagem horizontal
    manual comum e o clone escondido, que seria lista duplicada para leitor
    de tela e para quem navega por teclado.
  */
  .trilha {
    --vao: clamp(1.7rem, 3.2vw, 3rem);
    position: relative; z-index: 2;
    overflow-x: auto; overflow-y: hidden;
    scroll-behavior: auto;
    -webkit-overflow-scrolling: touch;
    padding-block: 0.5rem;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  /*
    Sem scroll-snap de propósito: testado, e ele briga com o passo contínuo do
    JS (avança 1px, o navegador puxa de volta pro ponto de encaixe mais perto)
    — o piloto automático nunca sai do lugar. O respiro entre os cartões já diz
    visualmente que dá pra rolar; não precisa travar em cada um.
  */
  .trilha:not(.ligada) .fila-clone { display: none; }
  .esteira { display: flex; width: max-content; }
  .fila { list-style: none; margin: 0; padding: 0; display: flex; }
  .proj { flex: 0 0 clamp(16.5rem, 25vw, 20.5rem); margin-right: var(--vao); }

  /* setas de navegação — flutuam sobre as bordas, só onde tem mouse de verdade */
  .trilha-envolve { position: relative; }
  .trilha-seta {
    display: none; position: absolute; top: 50%; z-index: 3;
    translate: 0 -50%;
    width: 2.75rem; height: 2.75rem; align-items: center; justify-content: center;
    border-radius: 999px; border: 1px solid var(--borda-viva);
    background: rgba(10, 12, 23, 0.82); backdrop-filter: blur(8px);
    color: var(--gelo); cursor: pointer; opacity: 0;
    transition: opacity var(--t) var(--e), border-color var(--t) var(--e), background var(--t) var(--e);
  }
  .trilha-envolve:hover .trilha-seta, .trilha-seta:focus-visible { opacity: 1; }
  .trilha-seta:hover { border-color: var(--roxo-luz); background: rgba(162, 89, 247, 0.16); }
  .trilha-seta-e { left: -0.4rem; }
  .trilha-seta-d { right: -0.4rem; }
  @media (min-width: 1300px) {
    .trilha-seta-e { left: -1.4rem; }
    .trilha-seta-d { right: -1.4rem; }
  }
  @media (hover: hover) and (pointer: fine) {
    .trilha-seta { display: flex; }
  }

  .proj-cab { display: flex; align-items: center; justify-content: space-between; gap: 0.8rem; margin-bottom: 1.1rem; }
  .proj-tipo {
    padding: 0.24rem 0.65rem; border-radius: 999px;
    border: 1px solid var(--borda-viva); background: rgba(68, 114, 247, 0.09);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gelo-60);
  }
  .proj-estrela {
    display: inline-flex; align-items: center; gap: 0.3rem;
    font-family: 'JetBrains Mono', monospace; font-size: 0.74rem; color: #f5c451;
  }
  .proj h3 { font-size: 1.1rem; word-break: break-word; }
  .cerquilha { color: var(--roxo-luz); font-weight: 800; }
  .proj-d { margin-top: 0.7rem; font-size: 0.87rem; color: var(--gelo-60); flex: 1; }
  .proj-pe {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 1rem;
    margin-top: 1.2rem; padding-top: 1rem; border-top: 1px solid var(--borda);
    font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; color: var(--gelo-40);
  }
  .proj-lang { display: inline-flex; align-items: center; gap: 0.4rem; }
  .proj-lang i, .stack-lang i {
    width: 8px; height: 8px; border-radius: 50%; flex: none;
    background: var(--cor, #8b93b5); box-shadow: 0 0 8px -1px var(--cor, #8b93b5);
  }
  .proj-links { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.1rem; }
  .proj-links a {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.5rem 0.85rem; border-radius: 999px;
    font-size: 0.79rem; font-weight: 600; text-decoration: none;
    color: var(--gelo-60); border: 1px solid var(--borda);
    transition: color var(--t) var(--e), border-color var(--t) var(--e), background var(--t) var(--e);
  }
  .proj-links a:hover {
    color: #fff; border-color: var(--roxo-luz);
    background: rgba(162, 89, 247, 0.16);
    box-shadow: 0 0 0 1px rgba(162, 89, 247, 0.45), 0 0 18px -2px rgba(162, 89, 247, 0.55);
  }
  /* "Ver no ar" é a ação principal do card: nasce preenchido, não vazado */
  .proj-vivo {
    color: var(--noite) !important; font-weight: 700;
    background: linear-gradient(110deg, var(--ciano), #7fe3f5) !important;
    border-color: transparent !important;
    box-shadow: 0 6px 18px -10px rgba(53, 214, 240, 0.9);
  }
  .proj-vivo:hover {
    color: var(--noite) !important;
    background: linear-gradient(110deg, #5ce3fa, #a5eeff) !important;
    box-shadow: 0 0 0 1px rgba(53, 214, 240, 0.7), 0 0 24px -2px rgba(53, 214, 240, 0.8) !important;
  }
  .proj-vivo i { color: var(--noite); }
  .trilha-pe { margin-top: 2rem; text-align: center; }

  /* ---------- demos ---------- */
  .demos { background: var(--noite-3); border-block: 1px solid var(--borda); }
  .grade-demos {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: clamp(0.8rem, 1.6vw, 1.1rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  }
  .demo a {
    position: relative; overflow: hidden;
    display: grid; gap: 0.35rem; height: 100%;
    padding: 1.5rem 3.2rem 1.5rem 1.5rem;
    border-radius: var(--raio-g); text-decoration: none;
    background: var(--carta); border: 1px solid var(--borda);
    transition: border-color var(--t) var(--e), background var(--t) var(--e), box-shadow var(--t) var(--e);
  }
  .demo a:hover { border-color: var(--borda-viva); box-shadow: var(--brilho); }
  .demo-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.64rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--anil-luz);
  }
  .demo-nome { font-size: 1.22rem; font-weight: 700; letter-spacing: -0.02em; color: var(--gelo); }
  .demo-nota { font-size: 0.84rem; color: var(--gelo-40); }
  .demo-seta {
    position: absolute; right: 1.3rem; top: 50%; translate: 0 -50%;
    color: var(--gelo-40); transition: color var(--t) var(--e), translate var(--t) var(--e);
  }
  .demo a:hover .demo-seta { color: var(--roxo-luz); translate: 4px -50%; }
  .demo-wip { opacity: 0.55; }
  .demo-wip .demo-nota { color: #c78a3f; }

  /* ---------- processo: a seção que inverte o contraste ---------- */
  .caminho {
    position: relative; z-index: 2;
    background: var(--clara); color: var(--escuro);
  }
  /* fundo claro: a grade tem que ser azul escuro para aparecer */
  .caminho { --g-fina: rgba(30, 43, 107, 0.05); --g-forte: rgba(30, 43, 107, 0.095); }
  .caminho .caixa { position: relative; z-index: 2; }
  .caminho h2, .caminho h3 { color: var(--escuro); }
  .caminho .lead { color: var(--escuro-60); }
  /* ---------- o caminho: seção presa, uma etapa por vez ---------- */

  /* estado base — e o que vê quem está sem JS: cinco blocos empilhados */
  .caminho-caixa { padding-block: clamp(3.6rem, 7.5vw, 6rem); }
  .cam-palco { display: grid; gap: 1rem; }
  .cam-cx {
    background: #fff; border: 1px solid #d5dcee; border-radius: var(--raio-g);
    padding: clamp(1.4rem, 3vw, 2.2rem);
    box-shadow: 0 1px 2px rgba(11, 14, 28, 0.04), 0 18px 40px -26px rgba(30, 43, 107, 0.35);
  }
  .cam-cx-cab { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 0.9rem; }
  .cam-n {
    font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; font-weight: 700;
    letter-spacing: 0.1em; color: #6b21d6;
  }
  .cam-cx-cab i { font-size: 1.05rem; color: #2743b8; }
  .cam-marco {
    margin-left: auto; padding: 0.24rem 0.7rem; border-radius: 999px;
    background: #eef1f9; border: 1px solid #d5dcee;
    font-family: 'JetBrains Mono', monospace; font-size: 0.64rem;
    letter-spacing: 0.08em; color: #4a5273;
  }
  .cam-cx h3 { font-size: clamp(1.25rem, 2.4vw, 1.75rem); color: var(--escuro); margin-bottom: 0.6rem; }
  .cam-cx p { font-size: clamp(0.92rem, 1.5vw, 1.05rem); color: var(--escuro-60); max-width: 60ch; }

  /* a barra de progresso, acima da caixa */
  .cam-barra { margin: 0 0 1.6rem; }
  .cam-trilho {
    display: block; height: 4px; border-radius: 999px;
    background: #d9dfef; overflow: hidden;
  }
  .cam-preenche {
    display: block; height: 100%; width: 100%; border-radius: 999px;
    background: linear-gradient(90deg, #2743b8, #6b21d6);
    transform: scaleX(var(--cam, 1)); transform-origin: 0 50%;
  }
  .cam-marcos {
    list-style: none; margin: 0.7rem 0 0; padding: 0;
    display: flex; justify-content: space-between;
    font-family: 'JetBrains Mono', monospace; font-size: 0.66rem; color: #9aa2bd;
  }
  .cam-marcos li { display: flex; align-items: center; gap: 0.4rem; transition: color var(--t) var(--e); }
  .cam-marcos li span {
    width: 7px; height: 7px; border-radius: 50%; background: #c8d0e6;
    transition: background var(--t) var(--e), scale var(--t) var(--e);
  }
  .cam-marcos li.feito { color: #6b21d6; }
  .cam-marcos li.feito span { background: #6b21d6; scale: 1.3; }
  .cam-conta {
    margin-bottom: 1rem; font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem; letter-spacing: 0.1em; color: #9aa2bd;
  }
  .cam-conta b { color: #6b21d6; font-size: 1.1rem; }

  /*
    O modo preso. Altura da seção = uma tela por etapa, e o miolo gruda no
    topo: rolar avança a barra e troca a caixa sem a seção sair do lugar.
    As caixas passam a ocupar o mesmo ponto, empilhadas.
  */
  .caminho.presa { height: calc(var(--etapas, 5) * 88vh); }
  .caminho.presa .caminho-miolo {
    position: sticky; top: 0; min-height: 100svh;
    display: grid; align-items: center;
  }
  .caminho.presa .cam-palco {
    position: relative; display: block;
    min-height: clamp(14rem, 34vh, 20rem);
  }
  .caminho.presa .cam-cx {
    position: absolute; inset: 0 0 auto; opacity: 0;
  }
  .caminho.presa .cam-cx.ativa { opacity: 1; }

  .passos {
    list-style: none; margin: 0; padding: 0; counter-reset: p;
    display: grid; gap: clamp(1rem, 2vw, 1.4rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }
  .passos li {
    position: relative;
    background: #fff; border: 1px solid #d5dcee;
    border-radius: var(--raio-g); padding: 1.6rem 1.4rem;
    box-shadow: 0 1px 2px rgba(11, 14, 28, 0.04), 0 14px 32px -22px rgba(30, 43, 107, 0.3);
  }
  .passos li::before {
    content: ''; position: absolute; inset: 0 0 auto; height: 3px;
    border-radius: var(--raio-g) var(--raio-g) 0 0;
    background: linear-gradient(90deg, #2743b8, #6b21d6);
  }
  .passo-n {
    display: block; margin-bottom: 0.8rem;
    font-family: 'JetBrains Mono', monospace; font-size: 0.82rem; font-weight: 700;
    letter-spacing: 0.1em; color: #6b21d6;
  }
  .passos h3 { font-size: 1.1rem; margin-bottom: 0.45rem; }
  .passos p { font-size: 0.88rem; color: var(--escuro-60); }

  /* ---------- stack ---------- */
  .stack { background: var(--noite-2); border-bottom: 1px solid var(--borda); }
  .grade-stack {
    display: grid; gap: clamp(1rem, 2vw, 1.5rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
  }
  .stack-g {
    background: var(--carta); border: 1px solid var(--borda);
    border-radius: var(--raio-g); padding: 1.5rem 1.4rem;
  }
  .stack-g h3 {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--anil-luz); margin-bottom: 1.1rem;
  }
  .stack-g ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .stack-g li {
    padding: 0.4rem 0.8rem; border-radius: 8px;
    background: rgba(234, 238, 252, 0.045); border: 1px solid var(--borda);
    font-size: 0.84rem; color: var(--gelo-60);
    transition: border-color var(--t) var(--e), color var(--t) var(--e);
  }
  .stack-g li:hover { border-color: var(--borda-viva); color: var(--gelo); }
  .stack-nota {
    margin-top: 1.6rem; font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem; color: var(--gelo-40);
  }
  .stack-lang { display: inline-flex; align-items: center; gap: 0.35rem; }

  /* ---------- contato ---------- */
  .contato { position: relative; overflow: hidden; background: var(--noite); }
  .contato-grade { display: grid; gap: clamp(2rem, 4vw, 3.5rem); align-items: start; }
  .contato-links { list-style: none; margin: 1.8rem 0 0; padding: 0; display: grid; gap: 0.7rem; }
  .contato-links a {
    display: inline-flex; align-items: center; gap: 0.6rem;
    color: var(--gelo); text-decoration: none; font-size: 0.93rem; font-weight: 500;
    transition: color var(--t) var(--e);
  }
  .contato-links i { color: var(--roxo-luz); width: 1.1rem; }
  .contato-links a:hover { color: var(--roxo-luz); }

  .form {
    display: grid; gap: 0.9rem;
    background: var(--carta); border: 1px solid var(--borda);
    border-radius: var(--raio-g); padding: clamp(1.2rem, 2.8vw, 1.9rem);
  }
  .form label {
    display: grid; gap: 0.35rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem; font-weight: 500; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--gelo-40);
  }
  .form-2 { display: grid; gap: 0.9rem; grid-template-columns: 1fr; }
  .form :is(input, select, textarea) {
    font-family: 'Sora', sans-serif; font-size: 0.93rem; font-weight: 400;
    letter-spacing: 0; text-transform: none; color: var(--gelo);
    background: var(--noite); border: 1px solid var(--borda); border-radius: 10px;
    padding: 0.68rem 0.8rem; width: 100%;
    transition: border-color var(--t) var(--e), box-shadow var(--t) var(--e);
  }
  .form :is(input, select, textarea):focus {
    outline: none; border-color: var(--roxo-luz);
    box-shadow: 0 0 0 3px rgba(162, 89, 247, 0.16);
  }
  .form textarea { resize: vertical; }
  .form option { background: var(--noite-3); color: var(--gelo); }
  .form-nota { font-family: 'JetBrains Mono', monospace; font-size: 0.68rem; color: var(--gelo-40); text-align: center; }

  /* ---------- topo ---------- */
  .topo {
    position: fixed; inset: 0 0 auto; z-index: 60;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 0.7rem clamp(1rem, 4vw, 2.6rem);
    background: rgba(7, 8, 15, 0.72);
    backdrop-filter: blur(16px) saturate(1.4);
    border-bottom: 1px solid var(--borda);
  }
  .topo-barra {
    position: absolute; inset: auto 0 -1px; height: 2px;
    background: linear-gradient(90deg, var(--anil-luz), var(--roxo-luz), var(--ciano));
    transform: scaleX(0); transform-origin: 0 50%;
  }
  .marca { display: flex; align-items: center; gap: 0.7rem; text-decoration: none; color: var(--gelo); }
  .marca-sig {
    width: 2.4rem; height: 2.4rem; display: grid; place-items: center; flex: none;
    border-radius: 9px; font-family: 'JetBrains Mono', monospace;
    font-size: 0.92rem; font-weight: 700; color: #fff;
    background: linear-gradient(130deg, var(--anil-luz), var(--roxo));
    box-shadow: 0 6px 18px -8px rgba(91, 46, 196, 0.9);
  }
  .marca-txt { font-size: 1.12rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; }
  .marca-txt small {
    display: block; font-family: 'JetBrains Mono', monospace; font-weight: 400;
    font-size: 0.68rem; letter-spacing: 0.13em; text-transform: uppercase;
    color: var(--gelo-60); margin-top: 0.3rem;
  }
  .topo-nav { display: none; gap: 1.5rem; }
  .topo-nav a {
    position: relative; font-size: 0.89rem; font-weight: 500;
    color: var(--gelo-60); text-decoration: none;
    transition: color var(--t) var(--e);
  }
  .topo-nav a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -5px; height: 1px;
    background: linear-gradient(90deg, var(--anil-luz), var(--roxo-luz));
    transform: scaleX(0); transform-origin: 0 50%;
    transition: transform var(--t) var(--e);
  }
  .topo-nav a:hover { color: var(--gelo); }
  .topo-nav a:hover::after { transform: scaleX(1); }

  /* abaixo de 920 px o nav completo some (regra acima) e este botão assume */
  .menu-cta { display: none; }
  .menu-alterna {
    display: inline-flex; align-items: center; justify-content: center; flex: none;
    width: 2.75rem; height: 2.75rem; border-radius: 10px;
    border: 1px solid var(--borda-viva); background: rgba(234, 238, 252, 0.04);
    color: var(--gelo); cursor: pointer;
    transition: background var(--t) var(--e), border-color var(--t) var(--e);
  }
  .menu-alterna:hover { border-color: var(--roxo-luz); }
  .menu-icone { position: relative; width: 1.15rem; height: 0.8rem; display: block; }
  .menu-icone span {
    position: absolute; left: 0; right: 0; height: 2px; border-radius: 2px;
    background: currentColor;
    transition: top var(--t) var(--e), transform var(--t) var(--e), opacity var(--t) var(--e);
  }
  .menu-icone span:nth-child(1) { top: 0; }
  .menu-icone span:nth-child(2) { top: 50%; translate: 0 -50%; }
  .menu-icone span:nth-child(3) { bottom: 0; }
  /* três traços viram X: o do meio some, os de fora giram para o centro */
  .menu-alterna[aria-expanded='true'] .menu-icone span:nth-child(1) {
    top: 50%; transform: translateY(-50%) rotate(45deg);
  }
  .menu-alterna[aria-expanded='true'] .menu-icone span:nth-child(2) { opacity: 0; }
  .menu-alterna[aria-expanded='true'] .menu-icone span:nth-child(3) {
    top: 50%; transform: translateY(-50%) rotate(-45deg);
  }

  /* cortina: escurece o resto da página e fecha o menu ao toque fora dele */
  .menu-cortina {
    position: fixed; inset: var(--topo-h) 0 0; z-index: 58;
    background: rgba(3, 4, 10, 0.6);
    opacity: 0; visibility: hidden;
    transition: opacity var(--t) var(--e), visibility 0s var(--t);
  }
  .menu-cortina.aberto {
    opacity: 1; visibility: visible;
    transition: opacity var(--t) var(--e);
  }

  /* painel: dropdown preso no topo, não off-canvas — mais rápido de alcançar com o polegar */
  .menu-movel {
    position: fixed; inset: var(--topo-h) 0 auto; z-index: 59;
    max-height: calc(100svh - var(--topo-h)); overflow-y: auto;
    display: grid; gap: 1.3rem;
    padding: 1.3rem clamp(1rem, 4vw, 2.6rem) 1.7rem;
    background: rgba(10, 12, 23, 0.98);
    backdrop-filter: blur(16px) saturate(1.4);
    border-bottom: 1px solid var(--borda);
    box-shadow: 0 24px 50px -20px rgba(3, 4, 10, 0.7);
    transform: translateY(-10px); opacity: 0; visibility: hidden;
    transition: transform var(--t) var(--e), opacity var(--t) var(--e), visibility 0s var(--t);
  }
  .menu-movel.aberto {
    transform: translateY(0); opacity: 1; visibility: visible;
    transition: transform var(--t) var(--e), opacity var(--t) var(--e);
  }
  .menu-movel nav { display: grid; }
  .menu-movel nav a {
    display: flex; align-items: center; min-height: 2.9rem;
    font-size: 1.05rem; font-weight: 600; color: var(--gelo); text-decoration: none;
    border-bottom: 1px solid var(--borda);
  }
  .menu-movel nav a:last-child { border-bottom: none; }
  .menu-movel nav a:active { color: var(--roxo-luz); }
  .menu-movel-contato { list-style: none; margin: 0; padding-top: 0.2rem; display: grid; gap: 0.2rem; }
  .menu-movel-contato a {
    display: flex; align-items: center; gap: 0.6rem; min-height: 2.6rem;
    font-size: 0.9rem; color: var(--gelo-60); text-decoration: none;
  }
  .menu-movel-contato i { color: var(--roxo-luz); width: 1.1rem; }

  .pf section[id] { scroll-margin-top: calc(var(--topo-h) + 0.8rem); }

  /* ---------- rodapé ---------- */
  .rodape { background: var(--noite-2); border-top: 1px solid var(--borda); color: var(--gelo-60); }
  .rodape-grade {
    display: grid; gap: 2.4rem;
    padding-block: clamp(2.6rem, 6vw, 4rem) 1.6rem;
  }
  .rodape-marca { font-size: 1.15rem; font-weight: 700; letter-spacing: -0.02em; color: var(--gelo); }
  .rodape-marca small {
    display: block; font-family: 'JetBrains Mono', monospace; font-weight: 400;
    font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--gelo-40); margin-top: 0.45rem;
  }
  .rodape-d { margin-top: 1rem; font-size: 0.86rem; color: var(--gelo-40); max-width: 40ch; }
  .rodape-t {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.66rem; font-weight: 500; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--gelo); margin-bottom: 1rem;
  }
  .rodape ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  .rodape a { color: var(--gelo-60); text-decoration: none; font-size: 0.88rem; transition: color var(--t) var(--e); }
  .rodape a:hover { color: var(--roxo-luz); }
  .rodape-fim {
    display: flex; flex-wrap: wrap; gap: 0.8rem; justify-content: space-between;
    padding-block: 1.2rem 1.7rem; border-top: 1px solid var(--borda);
    font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; color: var(--gelo-40);
  }

  .pf :focus-visible { outline: 2px solid var(--roxo-luz); outline-offset: 3px; border-radius: 8px; }
  .caminho :focus-visible { outline-color: #6b21d6; }

  /* o que o Motion revela nasce escondido — só com JS e com vontade de movimento */
  :global(.anima-on) .pf [data-anima],
  :global(.anima-on) .pf [data-linha] { opacity: 0; }

  /* ---------- do tablet para cima ---------- */
  @media (min-width: 700px) {
    .form-2 { grid-template-columns: 1fr 1fr; }
    .rodape-grade { grid-template-columns: 1.4fr 1fr 1fr; }
  }
  @media (min-width: 920px) {
    .pf { --topo-h: 4.4rem; }
    .topo-nav { display: flex; }
    .contato-grade { grid-template-columns: 1fr 1.05fr; }
    .menu-cta { display: inline-flex; }
    .menu-alterna, .menu-cortina, .menu-movel { display: none; }
  }

  /* ---------- só celular: toque maior, menos peso de GPU, rolagem mais curta ---------- */
  @media (max-width: 640px) {
    /* dois números por linha fica mais denso que um por linha */
    .nums { grid-template-columns: repeat(2, 1fr); }
    /* blur pesa em GPU de aparelho médio; metade do raio já basta para a luz */
    .halo { filter: blur(50px); }
    /* 5 etapas × 88vh vira quase 4,5 telas de rolagem — no dedo isso cansa */
    .caminho.presa { height: calc(var(--etapas, 5) * 62vh); }
    /* cartão de projeto e link de contato ganham mais altura de toque, sem
       mudar o card em telas maiores onde o mouse já tem precisão de sobra */
    .proj-links a { padding-block: 0.65rem; }
    .contato-links a { padding-block: 0.4rem; }
  }

  /* ---------- movimento reduzido ---------- */
  @media (prefers-reduced-motion: reduce) {
    .pf * {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
    .fila-clone { display: none; }
  }
</style>

<script>
  /*
    Movimento pelo Motion One. Regra de sempre: conteúdo antes de efeito — se
    o import falhar, o `catch` devolve tudo visível.
  */
  const reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const SAIDA = [0.22, 0.61, 0.36, 1] as const;
  const raiz = document.documentElement;

  /* ---------------- menu móvel ---------------- */
  /* fica fora do ligarMovimento(): tem que funcionar mesmo se o Motion falhar em carregar */
  const menuBotao = document.querySelector<HTMLButtonElement>('[data-menu-abre]');
  const menuPainel = document.querySelector<HTMLElement>('[data-menu-movel]');
  const menuCortina = document.querySelector<HTMLElement>('[data-menu-cortina]');

  const fecharMenu = () => {
    menuBotao?.setAttribute('aria-expanded', 'false');
    menuPainel?.classList.remove('aberto');
    menuCortina?.classList.remove('aberto');
    document.body.classList.remove('menu-travado');
  };
  const abrirMenu = () => {
    menuBotao?.setAttribute('aria-expanded', 'true');
    menuPainel?.classList.add('aberto');
    menuCortina?.classList.add('aberto');
    document.body.classList.add('menu-travado');
  };
  menuBotao?.addEventListener('click', () => {
    if (menuBotao.getAttribute('aria-expanded') === 'true') fecharMenu();
    else abrirMenu();
  });
  menuCortina?.addEventListener('click', fecharMenu);
  menuPainel?.querySelectorAll('a').forEach((a) => a.addEventListener('click', fecharMenu));
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape') fecharMenu();
  });
  /* girar a tela para desktop com o menu aberto deixaria a cortina/travamento presos */
  matchMedia('(min-width: 920px)').addEventListener('change', (e) => {
    if (e.matches) fecharMenu();
  });

  /* ---------------- esteira de projetos ---------------- */
  /*
    Rolagem nativa (`scrollLeft` por `requestAnimationFrame`), não `transform`
    pelo Motion. Dois motivos pra tirar isso do ligarMovimento():

    1. Lá, a esteira só ligava depois do `import('motion')` resolver — se
       aquele import falhasse ou demorasse (rede, bloqueador), a esteira
       inteira nunca ativava e sobrava uma lista comum, que termina seca no
       último card. Era exatamente o "não é infinita, quebra no fim".
    2. Uma vez ligada, `.trilha.ligada{overflow:hidden}` desligava a rolagem
       nativa de vez — no toque, o dedo não arrastava mais nada.

    Aqui `overflow-x` continua `auto` o tempo inteiro: o piloto automático e
    o dedo escrevem no mesmo `scrollLeft`, então dá pra arrastar por cima do
    piloto a qualquer momento, em qualquer aparelho.
  */
  const trilha = document.querySelector<HTMLElement>('[data-trilha]');
  const filaUm = trilha?.querySelector<HTMLElement>('.fila');
  if (trilha && filaUm && !reduz) {
    const PX_POR_S = 58;
    const FOLGA_MS = 2200; // pausa depois que o usuário mexe, antes do piloto retomar sozinho
    let periodo = 0;
    let emPausa = false; // ponteiro ou foco em cima: pausa enquanto durar
    let livreEm = 0; // toque/roda/arraste: pausa temporária, com retomada sozinha
    let ultimoT = 0;
    let ultimoScroll = trilha.scrollLeft;

    const medir = () => { periodo = filaUm.getBoundingClientRect().width; };
    medir();
    trilha.classList.add('ligada');

    const passo = (agora: number) => {
      if (periodo > 1) {
        if (!(emPausa || agora < livreEm) && ultimoT) {
          trilha.scrollLeft += (PX_POR_S * (agora - ultimoT)) / 1000;
        }
        /* a emenda: passou de uma fila inteira, volta um período. Como a
           segunda fila é clone pixel a pixel da primeira, o salto não
           aparece — e roda sempre, tanto faz se foi o piloto ou o dedo. */
        if (trilha.scrollLeft >= periodo) trilha.scrollLeft -= periodo;
        else if (trilha.scrollLeft < 0) trilha.scrollLeft += periodo;
      }
      ultimoT = agora;
      ultimoScroll = trilha.scrollLeft;
      requestAnimationFrame(passo);
    };
    requestAnimationFrame(passo);

    /* fonte que chega atrasada muda a largura do cartão, e com ela o período */
    document.fonts?.ready.then(medir);
    let redim: number | undefined;
    addEventListener('resize', () => {
      clearTimeout(redim);
      redim = setTimeout(medir, 200) as unknown as number;
    });

    /* mouse: pausa enquanto o ponteiro (ou o foco do teclado) estiver em cima */
    trilha.addEventListener('pointerenter', () => { emPausa = true; });
    trilha.addEventListener('pointerleave', () => { emPausa = false; });
    trilha.addEventListener('focusin', () => { emPausa = true; });
    trilha.addEventListener('focusout', () => { emPausa = false; });

    /* toque, trackpad, roda do mouse, barra de rolagem: o navegador já rola de
       verdade — só detecta que foi o usuário e dá uma folga antes de o piloto
       automático retomar */
    trilha.addEventListener(
      'scroll',
      () => {
        if (Math.abs(trilha.scrollLeft - ultimoScroll) > 1.2) livreEm = performance.now() + FOLGA_MS;
      },
      { passive: true },
    );

    /* setas: mesmo passo de um cartão, com a folga de sempre */
    document.querySelectorAll<HTMLButtonElement>('[data-trilha-seta]').forEach((botao) => {
      botao.addEventListener('click', () => {
        const cartao = filaUm.querySelector<HTMLElement>('.proj');
        if (!cartao) return;
        const passoPx = cartao.getBoundingClientRect().width + parseFloat(getComputedStyle(cartao).marginRight || '0');
        trilha.scrollBy({ left: passoPx * Number(botao.dataset.trilhaSeta), behavior: 'smooth' });
        livreEm = performance.now() + FOLGA_MS;
      });
    });
  }

  /* ---------------- formulário ---------------- */

  /* clicar em "quero um orçamento" num card já escolhe o serviço no form */
  const alvo = document.querySelector<HTMLSelectElement>('[data-alvo]');
  document.querySelectorAll<HTMLAnchorElement>('[data-servico]').forEach((a) => {
    a.addEventListener('click', () => {
      if (alvo) alvo.value = a.dataset.servico!;
    });
  });

  /* site estático não tem para onde postar; o pedido vai pelo zap */
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  form?.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const d = new FormData(form);
    const v = (k: string) => String(d.get(k) ?? '').trim();
    const linhas = [
      'Olá, Igor! Vim pelo site.',
      '',
      `Preciso de: ${v('servico')}`,
      `Orçamento previsto: ${v('verba')}`,
      `Prazo: ${v('prazo')}`,
      '',
      `O problema: ${v('obs')}`,
      '',
      `Nome: ${v('nome')}`,
      `Contato: ${v('contato')}`,
    ];
    window.open(
      `https://wa.me/${form.dataset.zap}?text=${encodeURIComponent(linhas.join('\n'))}`,
      '_blank',
      'noopener',
    );
  });

  /* ---------------- luz que segue o ponteiro ---------------- */

  /* ponteiro fino só: no toque não existe hover, e o listener seria desperdício */
  if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('[data-brilho]').forEach((el) => {
      el.addEventListener(
        'pointermove',
        (e) => {
          const r = el.getBoundingClientRect();
          el.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
          el.style.setProperty('--my', `${((e.clientY - r.top) / r.height) * 100}%`);
        },
        { passive: true },
      );
    });
  }

  /* ---------------- movimento ---------------- */

  async function ligarMovimento() {
    if (reduz) return;
    const { animate, inView, scroll, stagger, press } = await import('motion');

    /* inView do Motion re-dispara a cada reentrada; revelação é estreia */
    const umaVez = (
      el: Element,
      efeito: () => void,
      opcoes?: Parameters<typeof inView>[2],
    ) => {
      let parar = () => {};
      parar = inView(el, () => { efeito(); parar(); }, opcoes);
    };

    /* 1. barra de progresso do topo */
    const barra = document.querySelector<HTMLElement>('[data-progresso]');
    if (barra) scroll(animate(barra, { scaleX: [0, 1] }, { ease: 'linear' }));

    /* 2. herói: as linhas do título sobem por baixo de uma máscara */
    animate(
      document.querySelectorAll('[data-linha]'),
      { opacity: [0, 1], y: [26, 0], filter: ['blur(8px)', 'blur(0px)'] },
      { duration: 0.8, delay: stagger(0.09), ease: SAIDA },
    );
    animate(
      document.querySelectorAll('.heroi [data-anima]'),
      { opacity: [0, 1], y: [16, 0] },
      { duration: 0.7, delay: stagger(0.09, { startDelay: 0.3 }), ease: SAIDA },
    );

    /* 3. revelação em cascata, agrupada por pai para o stagger correr entre irmãos */
    const grupos = new Map<Element, HTMLElement[]>();
    for (const el of document.querySelectorAll<HTMLElement>('[data-anima]')) {
      if (el.closest('.heroi')) continue;
      const pai = el.parentElement!;
      grupos.set(pai, [...(grupos.get(pai) ?? []), el]);
    }
    for (const irmaos of grupos.values()) {
      umaVez(
        irmaos[0],
        () =>
          animate(
            irmaos,
            { opacity: [0, 1], y: [22, 0] },
            { duration: 0.65, delay: stagger(0.075), ease: SAIDA },
          ),
        { amount: 0.12, margin: '0px 0px -8% 0px' },
      );
    }

    /* 4. os números contam ao entrar na tela */
    document.querySelectorAll<HTMLElement>('[data-conta-ate]').forEach((el) => {
      const fim = Number(el.dataset.contaAte);
      const ano = el.dataset.ano === '1';
      /* ano não é contagem: 1.400 anos passando na tela não quer dizer nada */
      if (ano) return;
      umaVez(
        el,
        () =>
          animate(0, fim, {
            duration: 1.2,
            ease: SAIDA,
            onUpdate: (n) => (el.textContent = String(Math.round(n))),
          }),
        { amount: 0.8 },
      );
    });

    /* 5. as camadas de formas andam em velocidades diferentes: profundidade sem 3D */
    document.querySelectorAll<HTMLElement>('[data-campo]').forEach((el) => {
      const v = Number(el.dataset.campo) * 220;
      scroll(animate(el, { y: [-v, v] }, { ease: 'linear' }), {
        target: el.parentElement!,
        offset: ['start end', 'end start'],
      });
    });

    /*
      6. O CAMINHO. A seção prende no topo e o scroll dela vira progresso:
      a barra avança contínua, a caixa troca em degrau. Mesma mecânica das
      cenas 3D dos outros sites do portfolio — `scroll()` com offset
      start/start a end/end cobre exatamente o trecho em que o sticky está
      grudado, então p vai de 0 a 1 ao longo das cinco etapas.

      A classe `.presa` só entra aqui: sem JS a seção continua sendo a lista
      empilhada do CSS base, que é legível e não depende de nada.
    */
    const caminho = document.querySelector<HTMLElement>('[data-caminho]');
    const caixas = caminho ? [...caminho.querySelectorAll<HTMLElement>('[data-cam-cx]')] : [];
    if (caminho && caixas.length) {
      const marcos = [...caminho.querySelectorAll<HTMLElement>('[data-cam-marco]')];
      const preenche = caminho.querySelector<HTMLElement>('[data-cam-preenche]');
      const conta = caminho.querySelector<HTMLElement>('[data-cam-atual]');

      caminho.style.setProperty('--etapas', String(caixas.length));
      caminho.classList.add('presa');

      let atual = -1;
      const mostrar = (i: number) => {
        if (i === atual || !caixas[i]) return;
        const antes = caixas[atual];
        atual = i;
        /* a que sai desce um fio, a que entra sobe: dá direção ao avanço */
        if (antes) {
          antes.classList.remove('ativa');
          antes.setAttribute('aria-hidden', 'true');
          animate(antes, { opacity: 0, y: -14 }, { duration: 0.25, ease: 'easeIn' });
        }
        caixas[i].classList.add('ativa');
        caixas[i].removeAttribute('aria-hidden');
        animate(caixas[i], { opacity: [0, 1], y: [18, 0] }, { duration: 0.45, ease: SAIDA });
        marcos.forEach((m, n) => m.classList.toggle('feito', n <= i));
        if (conta) conta.textContent = String(i + 1);
      };
      mostrar(0);

      scroll(
        (p: number) => {
          /* barra contínua, caixa em degrau — as duas leem o mesmo p */
          if (preenche) preenche.style.setProperty('--cam', p.toFixed(4));
          mostrar(Math.min(caixas.length - 1, Math.floor(p * caixas.length * 0.999)));
        },
        { target: caminho, offset: ['start start', 'end end'] },
      );
    }

    /* 7. tato: tudo que se clica afunda um fio */
    press('.pf :is(.btn, .demo a, .proj-links a)', (el) => {
      animate(el, { scale: 0.97 }, { duration: 0.12 });
      return () => animate(el, { scale: 1 }, { type: 'spring', stiffness: 480, damping: 26 });
    });

    /* 8. o halo do herói respira junto com o scroll */
    document.querySelectorAll<HTMLElement>('.heroi .halo').forEach((h, i) => {
      scroll(animate(h, { opacity: [0.5, 0.14], scale: [1, 1.18 + i * 0.06] }, { ease: 'linear' }), {
        target: document.querySelector<HTMLElement>('.heroi')!,
        offset: ['start start', 'end start'],
      });
    });
  }

  const revelarTudo = () => raiz.classList.remove('anima-on');
  const socorro = setTimeout(revelarTudo, 3000);
  ligarMovimento()
    .catch(revelarTudo)
    .finally(() => clearTimeout(socorro));
  if (reduz) revelarTudo();
</script>
