  .caminho.presa .carta[data-lado='d'] {
    translate: var(--fol) -50%; transform-origin: left center;
  }
  .caminho.presa .carta[data-lado='e'] {
    translate: calc(-100% - var(--fol)) -50%; transform-origin: right center;
