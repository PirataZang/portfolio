@keyframes rowerr{0%,34%{transform:none;background:transparent}35%{transform:translateX(-5px);background:rgba(242,102,92,.16)}37%{transform:translateX(5px)}39%{transform:translateX(-4px)}41%{transform:translateX(3px)}43%,73%{transform:none;background:rgba(242,102,92,.1)}75%,100%{transform:none;background:transparent}}
