---
import Base from '../../../layouts/Base.astro';
import Moldura from '../../../components/Moldura.astro';
import MarcaDaniels from '../../../components/MarcaDaniels.astro';

/*
  DANIEL'S — BARBAS E CABELOS.

  ─── O que esta versão corrige ───

  A anterior abria com um quadro de 116 horários. Era original e era inútil:
  ninguém sente vontade de ir a um lugar olhando uma planilha. Tela densa é
  tela de operação, não de venda (§46). E a foto de capa deixava aparecer a
  placa de outra barbearia, o que derruba a credibilidade num segundo (§47).

  ─── A direção ───

  Vende-se a sala antes do horário. A capa é a fotografia das cadeiras, grande,
  em graduação quente e escura, com a marca por cima e um único gesto: ver os
  horários. A agenda continua existindo e continua sendo o produto — mas entra
  como três horários próximos, não como uma parede de números.

  Premium aqui é espaço e contenção (§48): pouca coisa por tela, escala
  tipográfica larga, latão usado só onde algo precisa ser lido primeiro.

  ─── Movimento ───

  A entrada é lenta e confiante: a foto assenta de uma escala levemente maior,
  o texto sobe em sequência. Depois disso, movimento só onde há resposta a um
  toque. Nada de revelação em cada seção.
*/

const LOJA = {
  nome: "Daniel's",
  sub: 'Barbas e Cabelos',
  desde: 1998,
  rua: 'Rua Aurora, 447',
  bairro: 'Santa Cecília',
  cidade: 'São Paulo',
  uf: 'SP',
  cep: '01209-001',
  fone: '(99) 9999-9999',
  foneLink: '+559999999999',
  zap: '5599999999999',
  zapFmt: '(99) 99999-9999',
  email: 'contato@danielsbarbearia.com.br',
  insta: 'danielsbarbearia',
  site: 'https://danielsbarbearia.com.br',
};

const mapaQuery = encodeURIComponent(
  `${LOJA.rua}, ${LOJA.bairro}, ${LOJA.cidade} - ${LOJA.uf}, ${LOJA.cep}`,
);

/* expediente por dia da semana (0 = domingo); null fecha o dia */
const EXPEDIENTE: (null | { abre: number; fecha: number })[] = [
  null, null,
  { abre: 9, fecha: 20 }, { abre: 9, fecha: 20 },
  { abre: 9, fecha: 20 }, { abre: 9, fecha: 20 },
  { abre: 9, fecha: 18 },
];

/* a duração real na cadeira: é ela que define quais horários cabem no dia */
const SERVICOS = [
  { id: 'combo', nome: 'Corte + barba', preco: 110, min: 75, padrao: true,
    d: 'O serviço completo, com quinze minutos a mais de acabamento. Sai R$ 15 mais barato que os dois separados.' },
  { id: 'corte', nome: 'Corte clássico', preco: 70, min: 45,
    d: 'Tesoura e máquina, acabamento na navalha e finalização com pomada. Inclui lavagem.' },
  { id: 'barba', nome: 'Barba na navalha', preco: 55, min: 30,
    d: 'Toalha quente, óleo, duas passadas na navalha e bálsamo gelado no fim.' },
  { id: 'infantil', nome: 'Corte infantil', preco: 55, min: 40,
    d: 'Até 10 anos, com banquinho na cadeira e a paciência que a idade pede.' },
  { id: 'pigmento', nome: 'Pigmentação de barba', preco: 65, min: 40,
    d: 'Preenche falha e uniformiza o tom. Dura de duas a três semanas.' },
  { id: 'pezinho', nome: 'Pezinho e contorno', preco: 30, min: 15,
    d: 'Manutenção entre um corte e outro. Nuca, costeletas e contorno na navalha.' },
];

const BARBEIROS = [
  { id: 'daniel', nome: 'Daniel', desde: 1998, faz: 'Navalha e barba desenhada' },
  { id: 'rui', nome: 'Rui', desde: 2011, faz: 'Degradê e social clássico' },
  { id: 'tiao', nome: 'Tião', desde: 2016, faz: 'Infantil e pigmentação' },
];

const dois = (n: number) => String(n).padStart(2, '0');
const SEM = ['dom', 'seg', 'ter', 'qua', 'qui', 'sex', 'sáb'];
const SEM_L = ['domingo', 'segunda', 'terça', 'quarta', 'quinta', 'sexta', 'sábado'];
const MES = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];
const PASSO = 30;

/*
  Ocupação determinística: hash do dia + horário. A grade reaparece igual a cada
  carregamento — agenda que sorteia de novo destrói a confiança de quem escolhe.
*/
function ocupado(iso: string, m: number) {
  let h = 2166136261;
  for (const c of `${iso}|${m}`) {
    h ^= c.charCodeAt(0);
    h = Math.imul(h, 16777619);
  }
  return ((h >>> 0) % 100) < 42;
}

/*
  O servidor calcula só o suficiente para a página existir sem JS: os três
  próximos horários e a placa da porta. A agenda completa é do cliente, a
  partir da data real de quem abriu.
*/
const HOJE = new Date('2026-09-04T09:00:00');
const PADRAO = SERVICOS.find((s) => s.padrao)!;

function proximosLivres(base: Date, quantos: number, dur: number) {
  const out: { iso: string; m: number; rot: string; quando: string }[] = [];
  for (let i = 0; out.length < quantos && i < 21; i++) {
    const d = new Date(base);
    d.setDate(base.getDate() + i);
    const exp = EXPEDIENTE[d.getDay()];
    if (!exp) continue;
    const iso = `${d.getFullYear()}-${dois(d.getMonth() + 1)}-${dois(d.getDate())}`;
    const cedo = i === 0 ? base.getHours() * 60 + base.getMinutes() : 0;
    /*
      Um por dia. Três horários do mesmo dia informam menos e vendem menos que
      "hoje, amanhã, sábado" — que já diz de cara que a agenda tem folga.
    */
    for (let m = exp.abre * 60; m <= exp.fecha * 60 - dur; m += PASSO) {
      if (m < cedo || ocupado(iso, m)) continue;
      out.push({
        iso, m,
        rot: `${dois(Math.floor(m / 60))}:${dois(m % 60)}`,
        quando: i === 0 ? 'hoje' : i === 1 ? 'amanhã' : `${SEM[d.getDay()]} ${d.getDate()}`,
      });
      break;
    }
  }
  return out;
}

const PROXIMOS = proximosLivres(HOJE, 3, PADRAO.min);

const expHoje = EXPEDIENTE[HOJE.getDay()];
const agora = HOJE.getHours() * 60 + HOJE.getMinutes();
const aberto = !!expHoje && agora >= expHoje.abre * 60 && agora < expHoje.fecha * 60;

const brl = (n: number) => `R$ ${n}`;
const IMG = `${import.meta.env.BASE_URL}img/barbearia/salao`;
const IMG_NAVALHA = `${import.meta.env.BASE_URL}img/barbearia/navalha`;
const IMG_TIME = `${import.meta.env.BASE_URL}img/barbearia`;

const titulo = `Barbearia em ${LOJA.bairro}, ${LOJA.cidade} — ${LOJA.nome} ${LOJA.sub}`;
const descricao =
  'Barbearia clássica na Rua Aurora, Santa Cecília, São Paulo, desde 1998. Corte na tesoura, barba na navalha com toalha quente e hora marcada. Veja os horários livres e reserve pelo WhatsApp.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HairSalon',
  '@id': `${LOJA.site}/#barbearia`,
  name: `${LOJA.nome} ${LOJA.sub}`,
  description: descricao,
  url: LOJA.site,
  image: `${LOJA.site}/img/barbearia/salao.jpg`,
  telephone: LOJA.foneLink,
  email: LOJA.email,
  priceRange: 'R$ 30 – R$ 110',
  foundingDate: '1998',
  currenciesAccepted: 'BRL',
  paymentAccepted: 'Dinheiro, Pix, cartão',
  address: {
    '@type': 'PostalAddress',
    streetAddress: LOJA.rua, addressLocality: LOJA.cidade,
    addressRegion: LOJA.uf, postalCode: LOJA.cep, addressCountry: 'BR',
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '20:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '09:00', closes: '18:00' },
  ],
  makesOffer: SERVICOS.map((s) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: s.nome, description: s.d },
    price: s.preco, priceCurrency: 'BRL',
  })),
  employee: BARBEIROS.map((b) => ({ '@type': 'Person', name: b.nome, jobTitle: 'Barbeiro' })),
};
---

<Base title={titulo} description={descricao}>
  <Fragment slot="head">
    <link rel="canonical" href={LOJA.site} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:image" content={`${LOJA.site}/img/barbearia/salao.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#12100e" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Hanken+Grotesk:wght@400;500;600&display=swap"
    />
    <link rel="preload" as="image" href={`${IMG}.webp`} type="image/webp" media="(min-width: 800px)" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.documentElement.classList.add('mov');
    </script>
  </Fragment>

  <div class="bd">
    <a class="pular" href="#reservar">Pular para a reserva</a>
    <script type="application/json" data-servicos set:html={JSON.stringify(SERVICOS)}></script>
    <script type="application/json" data-barbeiros set:html={JSON.stringify(BARBEIROS)}></script>
    <script type="application/json" data-expediente set:html={JSON.stringify(EXPEDIENTE)}></script>
    <span hidden data-zap={LOJA.zap}></span>

    {/*
      ═══════════ CAPA ═══════════

      Tela cheia, uma imagem só. A metade-e-metade da versão anterior era
      educada demais: dividia a atenção e nenhuma das duas partes ganhava. Aqui
      a sala ocupa tudo, e o texto mora no canto onde a foto já é escura — a
      perspectiva do salão foge para a direita, então a coluna da esquerda está
      livre por composição, não por acaso.
    */}
    <header class="capa">
      <div class="capa-foto">
        <picture>
          <source media="(min-width: 760px)" srcset={`${IMG}.webp`} type="image/webp" />
          <source media="(min-width: 760px)" srcset={`${IMG}.jpg`} />
          <source srcset={`${IMG}-alto.webp`} type="image/webp" />
          <img
            src={`${IMG}-alto.jpg`}
            alt="Salão da Daniel's: cadeiras de barbeiro em couro preto e cromado enfileiradas sob luminárias de luz quente, espelhos com moldura e prateleiras de produtos."
            width="1600" height="1067" fetchpriority="high" decoding="async"
          />
        </picture>
        <span class="capa-veu" aria-hidden="true"></span>
      </div>

      {/*
        O topo era o nome de um lado e o telefone do outro, com um vão enorme
        no meio. Agora é uma barra de três partes: a marca com símbolo à
        esquerda, os atalhos das seções no centro e o contato com a reserva à
        direita. No celular o centro sai — lá o gesto único é reservar.
      */}
      <div class="capa-topo">
        <a class="marca" href="#conteudo" aria-label={`${LOJA.nome} ${LOJA.sub}, ir para o conteúdo`}>
          <MarcaDaniels tamanho={38} />
          <span class="marca-txt">
            <span class="marca-nome">{LOJA.nome}</span>
            <span class="marca-sub">Barbas e cabelos · {LOJA.desde}</span>
          </span>
        </a>

        <nav class="capa-nav" aria-label="Seções">
          <a href="#precos">Serviços</a>
          <a href="#equipe">Quem corta</a>
          <a href="#visita">Onde ficamos</a>
        </nav>

        <div class="capa-acoes">
          <a class="capa-fone" href={`tel:${LOJA.foneLink}`}>{LOJA.fone}</a>
          <button type="button" class="capa-bt" data-abrir-agenda>Reservar</button>
        </div>
      </div>

      <div class="capa-txt">
        <p class="olho" data-ent><span class="ponto" aria-hidden="true"></span>Desde {LOJA.desde} · {LOJA.bairro}</p>

        <h1 data-ent>
          Barba feita<br />
          <em>com tempo</em>
        </h1>

        <p class="capa-d" data-ent>
          Três cadeiras, uma pessoa por vez. Toalha quente, navalha aberta na
          sua frente e ninguém apressando o acabamento.
        </p>

        {/*
          A agenda entra como três horários prontos: quem só quer marcar resolve
          aqui, sem sair da primeira tela. Quem quer escolher serviço, barbeiro
          ou outro dia abre a folha.
        */}
        <div class="proximos" data-ent id="reservar">
          <p class="proximos-t">Próximos horários livres</p>
          <ul>
            {PROXIMOS.map((h) => (
              <li>
                <button type="button" class="vaga" data-vaga data-dia={h.iso} data-hora={h.m}>
                  <span class="vaga-quando">{h.quando}</span>
                  <span class="vaga-hora">{h.rot}</span>
                </button>
              </li>
            ))}
          </ul>
          <button type="button" class="mais" data-abrir-agenda>
            Ver a agenda da semana
          </button>
        </div>
      </div>

      <p class="capa-pe">
        <span class:list={['estado', aberto && 'estado-on']}>
          {aberto ? `Aberto agora, até as ${expHoje!.fecha}h` : 'Fechado agora'}
        </span>
        <span class="sep" aria-hidden="true">·</span>
        {LOJA.rua}, {LOJA.bairro}
      </p>
    </header>

    <main id="conteudo">
      {/*
        ═══════════ O OFÍCIO ═══════════

        Segundo golpe da página, e de propósito com outra composição: o herói é
        imagem em tela cheia, então este não repete a mesma solução (§13). É um
        painel dividido — a navalha à esquerda, e à direita as três coisas que
        a casa promete, em prosa numerada.

        É aqui que a página convence: o herói mostra a sala, este mostra a mão.
      */}
      <section class="oficio" aria-labelledby="t-oficio">
        <figure class="oficio-foto">
          <picture>
            <source srcset={`${IMG_NAVALHA}.webp`} type="image/webp" />
            <img
              src={`${IMG_NAVALHA}.jpg`}
              alt="Barbeiro de luvas pretas fazendo a barba de um cliente com navalha, sobre a espuma."
              width="900" height="968" loading="lazy" decoding="async"
            />
          </picture>
        </figure>

        <div class="oficio-txt">
          <p class="olho olho-esc"><span class="ponto" aria-hidden="true"></span>O ofício</p>
          <h2 id="t-oficio">A navalha é aberta<br /><em>na sua frente</em></h2>

          <ol class="compromissos entra">
            <li style={`--i:0`}>
              <span class="comp-n" aria-hidden="true">01</span>
              <p><b>Lâmina nova, sempre.</b> Descartável, aberta na sua frente a cada
              atendimento. O resto da ferramenta sai da autoclave.</p>
            </li>
            <li style={`--i:1`}>
              <span class="comp-n" aria-hidden="true">02</span>
              <p><b>Uma cadeira por vez.</b> Ninguém corta duas cabeças ao mesmo tempo
              aqui. O horário que você marcou é seu inteiro.</p>
            </li>
            <li style={`--i:2`}>
              <span class="comp-n" aria-hidden="true">03</span>
              <p><b>Quinze minutos de tolerância.</b> Depois disso a cadeira passa para
              quem está esperando — é o que faz a agenda funcionar para todo mundo.</p>
            </li>
          </ol>
        </div>
      </section>

      {/* ═══════════ SERVIÇOS ═══════════ */}
      <section class="bloco precos" id="precos" aria-labelledby="t-precos">
        <div class="caixa">
          <header class="cab">
            <h2 id="t-precos">O que fazemos</h2>
            <p>Preço por pessoa, sem taxa e sem valor diferente no sábado.</p>
          </header>

          <ul class="tabela entra">
            {SERVICOS.map((s, i) => (
              <li style={`--i:${i}`}>
                <div class="tab-txt">
                  <h3>{s.nome}</h3>
                  <p>{s.d}</p>
                </div>
                <p class="tab-num">
                  <span class="tab-min">{s.min} min</span>
                  <span class="tab-preco">{brl(s.preco)}</span>
                </p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      {/* ═══════════ EQUIPE ═══════════ */}
      <section class="bloco equipe" id="equipe" aria-labelledby="t-equipe">
        <div class="caixa">
          <header class="cab">
            <h2 id="t-equipe">Quem corta</h2>
            <p>Você escolhe com quem quer sentar, ou deixa com quem estiver livre.</p>
          </header>

          <ul class="gente entra">
            {BARBEIROS.map((b, i) => (
              <li style={`--i:${i}`}>
                <Moldura
                  class="gente-foto"
                  src={`${IMG_TIME}/${b.id}`}
                  alt={`${b.nome}, barbeiro da casa desde ${b.desde}`}
                  largura={760}
                  altura={1013}
                  legenda={b.nome}
                />
                <p class="gente-faz">{b.faz}</p>
                <p class="gente-desde">na casa desde {b.desde}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      {/* ═══════════ VISITA ═══════════ */}
      <section class="bloco visita" id="visita" aria-labelledby="t-visita">
        <div class="caixa visita-grade">
          <div>
            <h2 id="t-visita">Onde ficamos</h2>
            <address>
              {LOJA.rua}<br />
              {LOJA.bairro} · {LOJA.cidade}/{LOJA.uf}<br />
              CEP {LOJA.cep}
            </address>
            <p class="visita-nota">Duas quadras da estação Marechal Deodoro.</p>
            <p class="visita-acoes">
              <a class="bt bt-fraco" href={`https://www.google.com/maps/search/?api=1&query=${mapaQuery}`} rel="noopener">
                Abrir no mapa
              </a>
              <a class="bt bt-fraco" href={`https://wa.me/${LOJA.zap}`} rel="noopener">
                WhatsApp
              </a>
            </p>
          </div>

          <dl class="horas">
            <div><dt>terça a sexta</dt><dd><time>9h–20h</time></dd></div>
            <div><dt>sábado</dt><dd><time>9h–18h</time></dd></div>
            <div class="off"><dt>domingo e segunda</dt><dd>fechado</dd></div>
          </dl>
        </div>
      </section>
    </main>

    {/*
      O rodapé era uma linha de contatos. Agora ele fecha a página: a marca em
      escala grande, o NAP inteiro em texto (endereço, telefone, horário — é
      o que a busca local lê, §49) e um último convite para reservar. Continua
      sem cartão e sem caixa: colunas sobre o breu, separadas por respiro.
    */}
    <footer class="pe">
      <div class="caixa">
        <div class="pe-marca">
          <MarcaDaniels tamanho={62} class="pe-simbolo" />
          <div>
            <p class="pe-nome">{LOJA.nome}</p>
            <p class="pe-sub">{LOJA.sub} · desde {LOJA.desde}</p>
          </div>
        </div>

        <div class="pe-grade">
          <section class="pe-col">
            <h2>Onde</h2>
            <address>
              {LOJA.rua}<br />
              {LOJA.bairro}, {LOJA.cidade}/{LOJA.uf}<br />
              CEP {LOJA.cep}
            </address>
            <a
              class="pe-linkinho"
              href={`https://www.google.com/maps/search/?api=1&query=${mapaQuery}`}
              rel="noopener"
            >
              Como chegar
            </a>
          </section>

          <section class="pe-col">
            <h2>Quando</h2>
            <dl class="pe-horas">
              <div><dt>Terça a sexta</dt><dd><time>9h–20h</time></dd></div>
              <div><dt>Sábado</dt><dd><time>9h–18h</time></dd></div>
              <div class="off"><dt>Domingo e segunda</dt><dd>Fechado</dd></div>
            </dl>
          </section>

          <section class="pe-col">
            <h2>Falar com a gente</h2>
            <ul class="pe-contato">
              <li><a href={`tel:${LOJA.foneLink}`}>{LOJA.fone}</a></li>
              <li><a href={`https://wa.me/${LOJA.zap}`} rel="noopener">WhatsApp {LOJA.zapFmt}</a></li>
              <li><a href={`https://instagram.com/${LOJA.insta}`} rel="noopener">@{LOJA.insta}</a></li>
              <li><a href={`mailto:${LOJA.email}`}>{LOJA.email}</a></li>
            </ul>
          </section>

          <section class="pe-col pe-chamada">
            <h2>Sua cadeira</h2>
            <p>Escolha o horário em trinta segundos. Sem cadastro, sem pagar antes.</p>
            <button type="button" class="bt bt-forte" data-abrir-agenda>Reservar</button>
          </section>
        </div>

        <div class="pe-fim">
          <p class="pe-legal">
            Demonstração de portfólio. {LOJA.nome} {LOJA.sub} é uma barbearia
            fictícia: endereço, telefone e agenda são de exemplo, e nenhuma
            reserva é registrada de verdade.
          </p>
          <p class="pe-topo-link"><a href="#conteudo">Voltar ao topo</a></p>
        </div>
      </div>
    </footer>

    {/* ═══════════ FOLHA DA RESERVA ═══════════ */}
    <dialog class="folha" data-folha aria-label="Reservar horário">
      <button type="button" class="folha-x" data-fechar aria-label="Fechar">✕</button>

      <div class="folha-corpo">
        <p class="folha-passo">1 · Serviço</p>
        <div class="ops" data-op-servicos role="radiogroup" aria-label="Serviço"></div>

        <p class="folha-passo">2 · Barbeiro</p>
        <div class="ops ops-2" data-op-barbeiros role="radiogroup" aria-label="Barbeiro"></div>

        <p class="folha-passo">3 · Dia e hora</p>
        <div class="dias-trilho">
