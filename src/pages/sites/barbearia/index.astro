<style>
  /*
    ─── Espresso, latão e creme ───

    Escuro quente, não neutro: a foto tem luz âmbar e o fundo tem que pertencer
    a ela. O latão aparece pouco — rótulo, hora escolhida, botão. Premium aqui é
    espaço e contenção, então quase tudo é tipografia sobre ar.
  */
  .bd {
    --breu: #12100e;
    --breu-2: #1a1714;
    --carta: #221e1a;
    --linha: #322c26;
    --linha-viva: #453d34;

    --creme: #f5efe6;
    --c70: #b9afa2;
    --c50: #91887d;
    --latao: #c9a15e;
    --latao-esc: #a9834a;

    --t: 0.35s;
    --e: cubic-bezier(0.22, 0.61, 0.36, 1);

    position: relative;
    background: var(--breu);
    color: var(--creme);
    /*
      Newsreader e Hanken Grotesk, e não Fraunces com Inter: esse par é para
      onde todo site "premium" gerado automaticamente converge, e usá-lo mina
      exatamente o que esta página precisa provar. Newsreader traz itálico de
      verdade — o "com tempo" do título é itálico, não uma oblíqua sintética.
    */
    font-family: 'Hanken Grotesk', ui-sans-serif, system-ui, sans-serif;
    line-height: 1.65;
    overflow-x: clip;
  }
  :global(body) { background: #12100e; color: #f5efe6; }
  :global(html) { scrollbar-color: #453d34 #1a1714; }
  :global(::selection) { background: #c9a15e; color: #12100e; }

  .bd a { color: inherit; }
  .pular {
    position: absolute; left: -9999px; top: 0; z-index: 100;
    background: var(--latao); color: var(--breu); padding: 0.7rem 1.1rem;
    text-decoration: none; font-weight: 600;
  }
  .pular:focus { left: 0; }
  .bd :is(a, button):focus-visible { outline: 2px solid var(--latao); outline-offset: 3px; }

  .caixa { max-width: 68rem; margin: 0 auto; padding-inline: clamp(1.2rem, 5vw, 3rem); }
  h1, h2, h3 { margin: 0; font-weight: 400; }
  p { margin: 0; text-wrap: pretty; }

  /* ─────────── capa ─────────── */
  /*
    Uma grade de três linhas sobre a foto: marca em cima, texto no fundo,
    rodapé colado embaixo. A foto é irmã do grid, não um painel ao lado —
    é isso que faz a imagem parecer o assunto e não uma ilustração de apoio.
  */
  .capa {
    position: relative; min-height: 100svh;
    display: grid; grid-template-rows: auto 1fr auto;
    padding: clamp(1.2rem, 3vw, 2.2rem) clamp(1.2rem, 5vw, 4rem) clamp(1.4rem, 3vw, 2.4rem);
    isolation: isolate;
  }
  .capa-foto {
    position: absolute; inset: 0; z-index: -1; overflow: hidden;
    /* sombra interna no pé: a foto afunda no breu em vez de cortar em aresta */
    box-shadow: inset 0 -9rem 7rem -4rem var(--breu);
  }
  .capa-foto img {
    width: 100%; height: 100%; object-fit: cover; object-position: 42% 62%;
    display: block;
  }
  @media (min-width: 760px) { .capa-foto img { object-position: 50% 58%; } }
  /*
    O véu escurece a coluna da esquerda e o pé, que é onde o texto mora, e
    deixa a fuga do salão à direita quase intacta — a profundidade da foto é
    metade do argumento.
  */
  .capa-veu {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(18, 16, 14, 0.72) 0%, rgba(18, 16, 14, 0.15) 26%, rgba(18, 16, 14, 0.55) 58%, rgba(18, 16, 14, 0.94) 88%, var(--breu) 100%),
      linear-gradient(90deg, rgba(18, 16, 14, 0.88) 0%, rgba(18, 16, 14, 0.5) 34%, rgba(18, 16, 14, 0.05) 68%);
  }
  @media (min-width: 760px) {
    .capa-veu {
      background:
        linear-gradient(180deg, rgba(18, 16, 14, 0.6) 0%, rgba(18, 16, 14, 0.05) 22%, rgba(18, 16, 14, 0.45) 62%, rgba(18, 16, 14, 0.9) 87%, var(--breu) 100%),
        linear-gradient(90deg, rgba(18, 16, 14, 0.9) 0%, rgba(18, 16, 14, 0.55) 30%, rgba(18, 16, 14, 0) 62%);
    }
  }

  .capa-topo {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  }

  .marca { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; color: inherit; }
  .marca-txt { display: grid; gap: 0.12rem; }
  .marca-nome {
    font-family: 'Newsreader', Georgia, serif; font-size: 1.42rem;
    letter-spacing: -0.01em; line-height: 1; color: var(--creme);
  }
  .marca-sub {
    font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--c50); line-height: 1;
  }
  .marca :global(.m-quadro) { transition: opacity 0.35s var(--e); }
  .marca:hover :global(.m-quadro) { opacity: 1; }

  /* atalhos do centro: só a partir do desktop, e como texto, não como botões */
  .capa-nav { display: none; }
  @media (min-width: 900px) {
    .capa-nav { display: flex; gap: 1.9rem; }
    .capa-nav a {
      font-size: 0.86rem; color: var(--c70); text-decoration: none;
      padding-bottom: 0.2rem; border-bottom: 1px solid transparent;
