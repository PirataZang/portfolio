  .capa-fone:hover { color: var(--creme); }
  .capa-bt {
    min-height: 40px; padding: 0 1.1rem;
    border: 1px solid var(--latao); background: transparent; color: var(--latao);
    font-family: inherit; font-size: 0.86rem; font-weight: 600; cursor: pointer;
    transition: background 0.25s var(--e), color 0.25s var(--e);
  }
  .capa-bt:hover { background: var(--latao); color: var(--breu); }

  .capa-txt { align-self: end; max-width: 33rem; padding-bottom: clamp(1rem, 3vw, 2rem); }
  .olho {
    display: inline-flex; align-items: center; gap: 0.6rem;
    font-size: 0.72rem; font-weight: 500; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--latao); margin-bottom: 1.3rem;
  }
  .ponto { width: 5px; height: 5px; border-radius: 50%; background: var(--latao); }

  h1 {
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(3.2rem, 9vw, 5.8rem); line-height: 0.96;
    letter-spacing: -0.03em;
    text-shadow: 0 2px 30px rgba(18, 16, 14, 0.6);
  }
  h1 em { font-style: italic; color: var(--latao); }
  .capa-d {
    margin-top: 1.5rem; max-width: 33ch;
    font-size: clamp(1rem, 1.5vw, 1.1rem); color: var(--c70);
    text-shadow: 0 1px 16px rgba(18, 16, 14, 0.8);
  }

  /* três horários prontos, não uma parede */
  .proximos { margin-top: 2.2rem; }
  .proximos-t {
    font-size: 0.68rem; font-weight: 600; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--c50); margin-bottom: 0.75rem;
  }
  .proximos ul { list-style: none; margin: 0 0 1rem; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .vaga {
    display: grid; gap: 0.1rem; min-height: 58px; padding: 0.5rem 1.15rem;
    border: 1px solid rgba(201, 161, 94, 0.4);
    background: rgba(18, 16, 14, 0.5); backdrop-filter: blur(6px);
    color: var(--creme); cursor: pointer; font-family: inherit; text-align: left;
    transition: background var(--t) var(--e), border-color var(--t) var(--e), color var(--t) var(--e);
  }
  .vaga:hover { background: var(--latao); border-color: var(--latao); color: var(--breu); }
  .vaga-quando { font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--latao); }
  .vaga:hover .vaga-quando { color: rgba(18, 16, 14, 0.7); }
  .vaga-hora { font-size: 1.08rem; font-weight: 600; font-variant-numeric: tabular-nums; }

  .mais {
    border: 0; background: transparent; padding: 0.3rem 0; cursor: pointer;
    font-family: inherit; font-size: 0.9rem; color: var(--creme);
    border-bottom: 1px solid rgba(245, 239, 230, 0.35);
    transition: color var(--t) var(--e), border-color var(--t) var(--e);
  }
  .mais:hover { color: var(--latao); border-color: var(--latao); }

  .capa-pe {
    align-self: end; font-size: 0.84rem; color: var(--c50);
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem;
  }
  .estado { color: var(--c70); }
  .estado-on { color: var(--latao); }
  .sep { color: var(--linha-viva); }

  /* ─────────── o ofício ─────────── */
  /*
    Painel dividido, sem borda e sem cartão: a foto encosta na borda esquerda
    da tela e o texto ocupa a coluna da direita com folga. A assimetria (1,05 /
    0,95 e depois a caixa de texto recuada) evita o "duas metades iguais" que
    faria a seção parecer um bloco de template.
  */
  .oficio { display: grid; position: relative; isolation: isolate; }
  /*
    A emenda entre a capa e esta seção era uma aresta. Agora a foto de baixo
    nasce do escuro: uma sombra desce do topo da seção e encontra a sombra que
    sobe do pé da capa, então a passagem é de sombra para sombra, sem linha.
  */
  .oficio::before,
  .oficio::after {
    content: ''; position: absolute; inset: 0 0 auto; height: clamp(5rem, 14vh, 11rem);
    z-index: 2; pointer-events: none;
    background: linear-gradient(180deg, var(--breu) 0%, rgb(18 16 14 / 0.7) 42%, transparent 100%);
  }
  /* e o mesmo no pé, para a foto entregar a página escura para os preços */
  .oficio::after {
    inset: auto 0 0; height: clamp(6rem, 18vh, 13rem);
    background: linear-gradient(0deg, #0a0908 0%, #0a0908 12%, rgb(10 9 8 / 0.82) 38%, rgb(10 9 8 / 0.4) 68%, transparent 100%);
  }
  @media (min-width: 860px) {
    .oficio { grid-template-columns: 1.05fr 0.95fr; align-items: stretch; }
  }
  .oficio-foto { margin: 0; overflow: hidden; background: var(--breu-2); position: relative; }
  .oficio-foto img {
    display: block; width: 100%; height: 100%; object-fit: cover;
    object-position: 52% 46%;
    aspect-ratio: 4 / 3;
  }
  @media (min-width: 860px) { .oficio-foto img { aspect-ratio: auto; min-height: 34rem; } }
  /*
    A foto não termina em aresta: a borda esquerda escurece até o breu da
    página, então a mão e a navalha emergem do escuro em vez de sentarem
    dentro de um retângulo colado no fundo.
  */
  .oficio-foto::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(to right, var(--breu) 0%, rgb(18 16 14 / 0.72) 14%, rgb(18 16 14 / 0.22) 34%, transparent 58%);
  }
  @media (max-width: 859px) {
    .oficio-foto::after {
      background:
        linear-gradient(to right, var(--breu) 0%, rgb(18 16 14 / 0.55) 16%, transparent 46%),
        linear-gradient(to bottom, transparent 55%, var(--breu) 100%);
    }
  }

  .oficio-txt {
    display: grid; align-content: center;
    padding: clamp(2.6rem, 7vw, 5rem) clamp(1.4rem, 5vw, 4rem);
  }
  .olho-esc { color: var(--latao); }
  .oficio-txt h2 {
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(2rem, 4.4vw, 3rem); line-height: 1.06; letter-spacing: -0.025em;
    margin-bottom: 2.2rem;
  }
  .oficio-txt h2 em { font-style: italic; color: var(--latao); }

  /* prosa numerada, não cartões: cada item é uma frase com um número ao lado */
  .compromissos { list-style: none; margin: 0; padding: 0; display: grid; gap: 2.1rem; }
  .compromissos li {
    display: grid; grid-template-columns: 3.1rem 1fr; gap: 1.1rem; align-items: baseline;
  }
  .comp-n {
    font-family: 'Newsreader', Georgia, serif; font-size: 1.5rem; line-height: 1;
    color: var(--latao); font-variant-numeric: tabular-nums;
  }
  .compromissos p { font-size: 1.06rem; line-height: 1.62; color: #cbc1b3; max-width: 40ch; }
  .compromissos b { color: var(--creme); font-weight: 600; }

  /*
    Listas que entram item a item, só em opacidade: nada desliza, nada escala.
    O passo é o --p de cada lista — o ofício respira mais (são três frases para
    ler), a tabela de preços corre, porque ali o olho já está varrendo.
  */
  :global(.mov) .entra > * { opacity: 0; }
  :global(.mov) .entra.vista > * {
    animation: surge 0.6s ease forwards;
    animation-delay: calc(var(--i) * var(--p, 0.3s));
  }
  @keyframes surge { to { opacity: 1; } }

  /* ─────────── blocos ─────────── */
  .bloco { padding-block: clamp(3.4rem, 9vw, 6.5rem); border-top: 1px solid var(--linha); }
  /*
    Depois da foto do ofício, uma linha de 1px seria um corte. A seção de
    preços troca a borda por sombra: o escuro da foto desce e vira o fundo
    desta seção, do mesmo jeito que a capa entrega para o ofício.
  */
  .precos { border-top: 0; position: relative; isolation: isolate; }
  .precos::before {
    content: ''; position: absolute; inset: 0 0 auto; height: clamp(4rem, 11vh, 8rem);
    z-index: 2; pointer-events: none;
    background: linear-gradient(180deg, #0a0908 0%, rgb(10 9 8 / 0.55) 45%, transparent 100%);
  }
  .tabela { --p: 0.09s; }
  .compromissos { --p: 0.3s; }
  .cab { max-width: 44ch; margin-bottom: clamp(2rem, 5vw, 3.2rem); }
  .cab h2 {
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(1.9rem, 4.5vw, 2.9rem); line-height: 1.1; letter-spacing: -0.02em;
  }
  .cab p { margin-top: 0.9rem; color: var(--c70); font-size: 0.98rem; }

  /* tabela de preços: linhas, não cartões */
  .tabela { list-style: none; margin: 0; padding: 0; }
  .tabela li {
    display: grid; gap: 0.4rem 2rem; align-items: baseline;
    grid-template-columns: 1fr auto;
    padding: 1.3rem 0; border-top: 1px solid var(--linha);
  }
  .tabela li:last-child { border-bottom: 1px solid var(--linha); }
  .tab-txt h3 {
    font-family: 'Newsreader', Georgia, serif; font-size: 1.3rem; letter-spacing: -0.01em;
  }
  .tab-txt p { margin-top: 0.3rem; font-size: 0.9rem; color: var(--c70); max-width: 54ch; }
  .tab-num { display: flex; align-items: baseline; gap: 1.2rem; white-space: nowrap; }
  .tab-min { font-size: 0.82rem; color: var(--c50); font-variant-numeric: tabular-nums; }
  .tab-preco {
    font-family: 'Newsreader', Georgia, serif; font-size: 1.5rem; color: var(--latao);
    font-variant-numeric: tabular-nums;
  }

  /* equipe: três colunas de texto, sem foto e sem caixa */
  .gente {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 2rem;
  }
  @media (min-width: 720px) { .gente { grid-template-columns: repeat(3, 1fr); gap: 2.6rem; } }
  .gente li { --p: 0.14s; }
  /*
    Três retratos do mesmo tamanho lado a lado viram fila de crachá. O do meio
    desce um pouco e o terceiro desce mais: a linha de base fica quebrada e a
    seção lê como página de revista, não como grade de cartões.
  */
  @media (min-width: 720px) {
    .gente li:nth-child(2) { margin-top: 2.6rem; }
    .gente li:nth-child(3) { margin-top: 5.2rem; }
  }
  .gente-foto { margin-bottom: 1.2rem; transition: border-color 0.4s var(--e), transform 0.5s var(--e); }
  .gente-foto :global(img) {
    filter: grayscale(0.2) contrast(1.02);
    transition: filter 0.5s var(--e), scale 0.7s var(--e);
  }
  .gente li:hover .gente-foto { border-color: #6b5834; transform: translateY(-3px); }
  .gente li:hover .gente-foto :global(img) { filter: grayscale(0) contrast(1.02); scale: 1.03; }
  .gente-faz { font-size: 0.98rem; color: var(--c70); text-align: center; }
  .gente-desde {
    margin-top: 0.35rem; font-size: 0.72rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--c50); text-align: center;
  }

  /* visita */
  .visita-grade { display: grid; gap: 2.4rem; }
  @media (min-width: 760px) { .visita-grade { grid-template-columns: 1.2fr 0.8fr; gap: 4rem; } }
  .visita h2 {
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(1.9rem, 4.5vw, 2.9rem); line-height: 1.1; letter-spacing: -0.02em;
    margin-bottom: 1.2rem;
  }
  .visita address { font-style: normal; font-size: 1.05rem; line-height: 1.9; }
  .visita-nota { margin-top: 0.7rem; font-size: 0.88rem; color: var(--c50); }
  .visita-acoes { margin-top: 1.6rem; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .horas { margin: 0; align-self: start; }
  .horas > div {
    display: flex; justify-content: space-between; gap: 1.5rem;
    padding: 0.85rem 0; border-top: 1px solid var(--linha); font-size: 0.95rem;
  }
  .horas > div:last-child { border-bottom: 1px solid var(--linha); }
  .horas dt { color: var(--c70); }
  .horas dd { margin: 0; font-variant-numeric: tabular-nums; }
  .off { color: var(--c50); }

  /* botões */
  .bt {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 48px; padding: 0.75rem 1.5rem; border: 1px solid var(--linha-viva);
    background: transparent; color: var(--creme); cursor: pointer;
    font-family: inherit; font-size: 0.92rem; font-weight: 500; text-decoration: none;
    transition: background var(--t) var(--e), border-color var(--t) var(--e), color var(--t) var(--e);
  }
  .bt-fraco:hover { border-color: var(--latao); color: var(--latao); }
  .bt-forte { background: var(--latao); border-color: var(--latao); color: var(--breu); font-weight: 600; width: 100%; }
  .bt-forte:hover { background: var(--creme); border-color: var(--creme); }
  .bt[aria-disabled='true'] { opacity: 0.4; pointer-events: none; }

  /* rodapé */
  .pe {
    padding-block: clamp(3rem, 8vw, 5.5rem) 2.6rem;
    border-top: 0; position: relative; isolation: isolate;
    background: #0d0b0a;
  }
  .pe::before {
    content: ''; position: absolute; inset: 0 0 auto; height: clamp(4rem, 10vh, 7rem);
    z-index: 2; pointer-events: none;
    background: linear-gradient(180deg, #060505 0%, rgb(6 5 5 / 0.5) 48%, transparent 100%);
  }

  .pe-marca {
    display: flex; align-items: center; gap: clamp(0.9rem, 2.5vw, 1.5rem);
    padding-bottom: clamp(2rem, 5vw, 3rem);
  }
  .pe-simbolo { width: clamp(2.6rem, 7vw, 3.9rem); height: auto; }
  .pe-nome {
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(2.4rem, 8vw, 4.6rem); line-height: 0.95; letter-spacing: -0.03em;
    color: var(--creme);
  }
  .pe-sub {
    margin-top: 0.5rem; font-size: 0.8rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--latao);
  }

  .pe-grade {
    display: grid; gap: 2.4rem 2rem;
    padding-block: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--linha);
  }
  @media (min-width: 640px) { .pe-grade { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .pe-grade { grid-template-columns: 1fr 1.15fr 1.25fr 1fr; gap: 2.6rem; } }

  .pe-col h2 {
    font-size: 0.74rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--c50); margin-bottom: 0.9rem;
  }
  .pe-col address { font-style: normal; font-size: 0.95rem; line-height: 1.7; color: var(--c70); }
  .pe-linkinho {
    display: inline-block; margin-top: 0.8rem; font-size: 0.88rem;
    color: var(--creme); text-decoration: none;
    border-bottom: 1px solid var(--linha-viva); padding-bottom: 0.15rem;
    transition: border-color 0.25s, color 0.25s;
  }
  .pe-linkinho:hover { color: var(--latao); border-color: var(--latao); }

  .pe-horas { display: grid; gap: 0.55rem; font-size: 0.95rem; }
  .pe-horas > div { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; }
  .pe-horas dt { color: var(--c70); }
  .pe-horas dd { color: var(--creme); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .pe-horas .off dt, .pe-horas .off dd { color: var(--c50); }

  .pe-contato { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; font-size: 0.95rem; }
  .pe-contato a { color: var(--c70); text-decoration: none; transition: color 0.25s; }
  .pe-contato a:hover { color: var(--latao); }

  .pe-chamada p { font-size: 0.92rem; color: var(--c70); margin-bottom: 1.1rem; max-width: 30ch; }

  .pe-fim {
    display: grid; gap: 1rem; padding-top: 1.8rem;
    border-top: 1px solid var(--linha);
  }
  @media (min-width: 760px) {
    .pe-fim { grid-template-columns: 1fr auto; align-items: start; }
  }
  .pe-legal { font-size: 0.76rem; line-height: 1.6; color: var(--c50); max-width: 62ch; }
  .pe-topo-link a { font-size: 0.8rem; color: var(--c50); text-decoration: none; white-space: nowrap; }
  .pe-topo-link a:hover { color: var(--latao); }

  /* ─────────── folha da reserva ─────────── */
  .folha {
    position: fixed; inset: 0; margin: auto;   /* o preflight do Tailwind zera a margem */
    width: min(34rem, calc(100vw - 1.5rem));
    max-width: none; max-height: calc(100dvh - 1.5rem);
    padding: 0; overflow: hidden;
    border: 1px solid var(--linha-viva);
    background: var(--breu-2); color: var(--creme);
  }
  .folha[open] { display: flex; flex-direction: column; }
  .folha::backdrop { background: rgba(10, 9, 8, 0.72); }
  .folha-x {
    position: absolute; top: 0.7rem; right: 0.7rem; z-index: 3;
    width: 44px; height: 44px; border: 0; background: transparent;
    color: var(--c70); cursor: pointer; font-size: 1rem;
    transition: color var(--t) var(--e);
  }
  .folha-x:hover { color: var(--creme); }
  .folha-corpo { overflow-y: auto; overscroll-behavior: contain; padding: 1.6rem clamp(1.1rem, 4vw, 1.7rem) 1.2rem; }
  .folha-passo {
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--latao); margin: 1.6rem 0 0.7rem;
  }
  .folha-passo:first-child { margin-top: 0; }
  .ops { display: grid; gap: 2px; }
  .ops-2 { grid-template-columns: 1fr 1fr; }
  /*
    O trilho de dias rola na horizontal. Antes a barra estava escondida e não
    havia seta nenhuma: no desktop os últimos dias eram inalcançáveis. Agora as
    setas ficam por cima das pontas, desabilitam quando não há mais para onde
    ir, e o véu nas bordas mostra que o trilho continua.
  */
  /*
    As setas ficam fora do trilho, não por cima: sobrepostas elas cobriam o
    primeiro e o último dia e roubavam o clique deles.
  */
  .dias-trilho {
    display: grid; grid-template-columns: 2.2rem 1fr 2.2rem;
    align-items: stretch; margin-bottom: 0.6rem;
  }
  .dias {
    display: flex; gap: 2px; overflow-x: auto; scrollbar-width: none;
    scroll-snap-type: x proximity;
  }
  .dias::-webkit-scrollbar { display: none; }

  .dias-seta {
    display: grid; place-items: center; padding: 0;
    background: transparent; border: 0; cursor: pointer; color: var(--c70);
    transition: opacity 0.25s var(--e), color 0.25s var(--e);
  }
  .dias-seta:hover { color: var(--latao); }
  .dias-seta:disabled { opacity: 0.18; pointer-events: none; }
  .horas-grade { display: grid; grid-template-columns: repeat(auto-fill, minmax(4.4rem, 1fr)); gap: 2px; }

  /*
    Tudo abaixo nasce de JS: sem :global o escopo do Astro não alcança e a
    folha sai sem estilo nenhum. Continua escopo, ancorado em .folha.
  */
  .folha :global(.op) {
    display: flex; align-items: baseline; justify-content: space-between; gap: 0.8rem;
    width: 100%; min-height: 48px; padding: 0.65rem 0.9rem; text-align: left;
    border: 1px solid var(--linha); background: transparent; color: var(--creme);
    cursor: pointer; font-family: inherit; font-size: 0.93rem;
    transition: background var(--t) var(--e), border-color var(--t) var(--e), color var(--t) var(--e);
  }
  .folha :global(.op:hover:not(:disabled)) { border-color: var(--linha-viva); background: rgba(245, 239, 230, 0.03); }
  .folha :global(.op[aria-checked='true']) { background: var(--latao); border-color: var(--latao); color: var(--breu); }
  .folha :global(.op small) { font-size: 0.78rem; color: var(--c50); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .folha :global(.op[aria-checked='true'] small) { color: rgba(18, 16, 14, 0.7); }
  .folha :global(.op:disabled) { color: var(--c50); opacity: 0.45; cursor: not-allowed; }

  .folha :global(.dia) {
    flex: 0 0 auto; scroll-snap-align: start;
    display: grid; gap: 0.1rem; justify-items: center; align-content: center;
    min-width: 3.9rem; min-height: 52px; padding: 0.5rem 0.6rem;
    border: 1px solid var(--linha); background: transparent; color: var(--c70);
    cursor: pointer; font-family: inherit;
    transition: background var(--t) var(--e), border-color var(--t) var(--e), color var(--t) var(--e);
  }
  .folha :global(.dia:hover) { border-color: var(--linha-viva); color: var(--creme); }
  .folha :global(.dia[aria-selected='true']) { background: var(--creme); border-color: var(--creme); color: var(--breu); }
  .folha :global(.dia b) { font-size: 1rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .folha :global(.dia span) { font-size: 0.64rem; letter-spacing: 0.1em; text-transform: uppercase; }

  .folha :global(.hora) {
    min-height: 44px; border: 1px solid var(--linha); background: transparent;
    color: var(--creme); cursor: pointer; font-family: inherit;
    font-size: 0.9rem; font-variant-numeric: tabular-nums;
    transition: background var(--t) var(--e), border-color var(--t) var(--e), color var(--t) var(--e);
  }
  .folha :global(.hora:hover:not(:disabled)) { border-color: var(--latao); color: var(--latao); }
  .folha :global(.hora[aria-checked='true']) { background: var(--latao); border-color: var(--latao); color: var(--breu); font-weight: 600; }
  .folha :global(.hora:disabled) { color: var(--linha-viva); cursor: not-allowed; border-color: transparent; }

  .folha-pe {
    padding: 1.1rem clamp(1.1rem, 4vw, 1.7rem) calc(1.2rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--linha); background: var(--carta);
  }
  .folha-resumo { font-size: 0.88rem; color: var(--c70); margin-bottom: 0.8rem; }

  /* ─────────── entrada ─────────── */
  /*
    A capa assenta: a foto vem de uma escala levemente maior e o texto sobe em
    sequência. É a única animação de chegada da página — o resto responde a
    toque. `mov` só entra quando há movimento permitido.
  */
  :global(.mov) .capa-foto img { animation: assenta 2.4s var(--e) both; }
  :global(.mov) [data-ent] { animation: sobe 0.8s var(--e) both; }
  :global(.mov) .capa-txt [data-ent]:nth-child(1) { animation-delay: 0.35s; }
  :global(.mov) .capa-txt [data-ent]:nth-child(2) { animation-delay: 0.48s; }
  :global(.mov) .capa-txt [data-ent]:nth-child(3) { animation-delay: 0.62s; }
  :global(.mov) .capa-txt [data-ent]:nth-child(4) { animation-delay: 0.76s; }
  :global(.mov) .capa-topo, :global(.mov) .capa-pe { animation: sobe 0.8s var(--e) both; animation-delay: 0.9s; }

  @keyframes assenta {
    from { scale: 1.1; opacity: 0; }
    to { scale: 1; opacity: 1; }
  }
  @keyframes sobe {
    from { opacity: 0; translate: 0 14px; }
    to { opacity: 1; translate: 0 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bd *, .bd *::before, .bd *::after {
      animation: none !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  /*
    A capa resolve o caso comum em um toque: três horários prontos. A folha
    existe para quem quer escolher serviço, barbeiro ou outro dia.
  */
  const ler = <T,>(sel: string): T => {
    const el = document.querySelector<HTMLElement>(sel);
    try { return JSON.parse(el?.textContent || 'null'); } catch { return null as T; }
  };

  type Servico = { id: string; nome: string; preco: number; min: number; padrao?: boolean };
  type Barbeiro = { id: string; nome: string; faz: string };
  type Exp = null | { abre: number; fecha: number };

  const SERVICOS = ler<Servico[]>('[data-servicos]') ?? [];
  const BARBEIROS = ler<Barbeiro[]>('[data-barbeiros]') ?? [];
  const EXPEDIENTE = ler<Exp[]>('[data-expediente]') ?? [];
  if (SERVICOS.length) agendar();

  function agendar() {
    const PASSO = 30;
    const SEM = ['dom', 'seg', 'ter', 'qua', 'qui', 'sex', 'sáb'];
    const SEM_L = ['domingo', 'segunda', 'terça', 'quarta', 'quinta', 'sexta', 'sábado'];
    const MES = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];
    const dois = (n: number) => String(n).padStart(2, '0');
    const hhmm = (m: number) => `${dois(Math.floor(m / 60))}:${dois(m % 60)}`;
    const iso = (d: Date) => `${d.getFullYear()}-${dois(d.getMonth() + 1)}-${dois(d.getDate())}`;

    /* mesma conta do servidor: as duas grades têm que bater */
    const ocupado = (dia: string, m: number) => {
      let h = 2166136261;
      for (const c of `${dia}|${m}`) { h ^= c.charCodeAt(0); h = Math.imul(h, 16777619); }
      return ((h >>> 0) % 100) < 42;
    };

    const PADRAO = SERVICOS.find((s) => s.padrao) ?? SERVICOS[0];
    const estado = { servico: PADRAO.id, barbeiro: 'qualquer', dia: '', hora: -1 };

    const folha = document.querySelector<HTMLDialogElement>('[data-folha]')!;
    const opServ = folha.querySelector<HTMLElement>('[data-op-servicos]')!;
    const opBarb = folha.querySelector<HTMLElement>('[data-op-barbeiros]')!;
    const elDias = folha.querySelector<HTMLElement>('[data-dias]')!;
    const elHoras = folha.querySelector<HTMLElement>('[data-horas]')!;
    const resumo = folha.querySelector<HTMLElement>('[data-resumo]')!;
    const zap = folha.querySelector<HTMLAnchorElement>('[data-ir-zap]')!;
    const numero = document.querySelector<HTMLElement>('[data-zap]')?.dataset.zap ?? '';

    /* os próximos dias em que a casa abre */
    const hoje = new Date();
    hoje.setHours(0, 0, 0, 0);
    const dias: Date[] = [];
    for (let i = 0; dias.length < 10 && i < 28; i++) {
      const d = new Date(hoje);
      d.setDate(hoje.getDate() + i);
      if (EXPEDIENTE[d.getDay()]) dias.push(d);
    }

    const servAtual = () => SERVICOS.find((s) => s.id === estado.servico)!;

    function pintarOpcoes() {
      opServ.innerHTML = SERVICOS.map((s) =>
        `<button type="button" class="op" role="radio" data-serv="${s.id}" aria-checked="${s.id === estado.servico}">` +
        `<b>${s.nome}</b><small>${s.min} min · R$ ${s.preco}</small></button>`,
      ).join('');

      opBarb.innerHTML = [{ id: 'qualquer', nome: 'Tanto faz' }, ...BARBEIROS]
        .map((b) =>
          `<button type="button" class="op" role="radio" data-barb="${b.id}" aria-checked="${b.id === estado.barbeiro}">` +
          `<b>${b.nome}</b></button>`,
        ).join('');
    }

    const setaAnt = folha.querySelector<HTMLButtonElement>('[data-dias-ant]')!;
    const setaProx = folha.querySelector<HTMLButtonElement>('[data-dias-prox]')!;

    /* a seta some quando aquele lado do trilho acabou */
    function pintarSetas() {
      const fim = elDias.scrollWidth - elDias.clientWidth;
      setaAnt.disabled = elDias.scrollLeft <= 1;
      setaProx.disabled = elDias.scrollLeft >= fim - 1;
    }
    const passo = () => Math.max(elDias.clientWidth * 0.7, 160);
    setaAnt.addEventListener('click', () => elDias.scrollBy({ left: -passo(), behavior: 'smooth' }));
    setaProx.addEventListener('click', () => elDias.scrollBy({ left: passo(), behavior: 'smooth' }));
    elDias.addEventListener('scroll', pintarSetas, { passive: true });

    function pintarDias() {
      elDias.innerHTML = dias.map((d) =>
        `<button type="button" class="dia" role="tab" data-dia="${iso(d)}" aria-selected="${iso(d) === estado.dia}">` +
        `<span>${SEM[d.getDay()]}</span><b>${dois(d.getDate())}</b></button>`,
      ).join('');

      /*
        Centraliza o dia escolhido sem usar scrollIntoView: ele arrastaria
        também a folha inteira. Aqui só o trilho anda.
      */
      const sel = elDias.querySelector<HTMLElement>('[aria-selected="true"]');
      if (sel) elDias.scrollLeft = sel.offsetLeft - (elDias.clientWidth - sel.offsetWidth) / 2;
      pintarSetas();
    }

    function pintarHoras() {
      const d = dias.find((x) => iso(x) === estado.dia);
      if (!d) { elHoras.innerHTML = ''; return; }
      const exp = EXPEDIENTE[d.getDay()]!;
      const serv = servAtual();
      let html = '';
      for (let m = exp.abre * 60; m <= exp.fecha * 60 - serv.min; m += PASSO) {
        const livre = !ocupado(estado.dia, m);
        html +=
          `<button type="button" class="hora" role="radio" data-hora="${m}"` +
          `${livre ? '' : ' disabled'} aria-checked="${estado.hora === m}"` +
          ` aria-label="${hhmm(m)}, ${livre ? 'livre' : 'ocupado'}">${hhmm(m)}</button>`;
      }
      elHoras.innerHTML = html;
    }

    function pintarPe() {
      const serv = servAtual();
      const pronto = Boolean(estado.dia) && estado.hora >= 0;
      if (!pronto) {
        resumo.textContent = 'Escolha um dia e um horário';
        zap.setAttribute('aria-disabled', 'true');
        zap.removeAttribute('href');
        return;
      }
      const d = new Date(`${estado.dia}T12:00:00`);
      const quem = estado.barbeiro === 'qualquer'
        ? 'quem estiver livre'
        : BARBEIROS.find((b) => b.id === estado.barbeiro)?.nome ?? '';
      const quando = `${SEM_L[d.getDay()]}, ${d.getDate()} de ${MES[d.getMonth()]} às ${hhmm(estado.hora)}`;
      resumo.textContent = `${serv.nome} com ${quem} · ${quando} · R$ ${serv.preco}`;
      zap.setAttribute('aria-disabled', 'false');
      zap.href =
        `https://wa.me/${numero}?text=` +
        encodeURIComponent(
          `Olá! Queria marcar ${serv.nome.toLowerCase()} com ${quem}, ${quando}. ` +
          `São ${serv.min} minutos, R$ ${serv.preco}.`,
        );
    }

    function pintarTudo() { pintarOpcoes(); pintarDias(); pintarHoras(); pintarPe(); }

    folha.addEventListener('click', (ev) => {
      const alvo = (ev.target as HTMLElement).closest<HTMLButtonElement>(
        '[data-serv],[data-barb],[data-dia],[data-hora]',
      );
      if (!alvo || alvo.disabled) {
        if (ev.target === folha) folha.close();   /* clique no fundo fecha */
        return;
      }
      if (alvo.dataset.serv) {
        estado.servico = alvo.dataset.serv;
        // a duração mudou: alguns horários deixam de caber antes de fechar
        if (estado.hora >= 0) estado.hora = -1;
        pintarTudo();
      } else if (alvo.dataset.barb) {
        estado.barbeiro = alvo.dataset.barb;
        pintarOpcoes(); pintarPe();
      } else if (alvo.dataset.dia) {
        estado.dia = alvo.dataset.dia;
        estado.hora = -1;
        pintarDias(); pintarHoras(); pintarPe();
      } else {
        estado.hora = Number(alvo.dataset.hora);
        pintarHoras(); pintarPe();
      }
    });

    folha.querySelector('[data-fechar]')?.addEventListener('click', () => folha.close());

    function abrir(dia?: string, hora?: number) {
      estado.dia = dia ?? estado.dia ?? iso(dias[0]);
      if (!estado.dia) estado.dia = iso(dias[0]);
      estado.hora = hora ?? -1;
      pintarTudo();
      folha.showModal();
      /*
        Antes de showModal o diálogo não tem caixa: clientWidth é 0 e as setas
        nasciam desabilitadas. Só depois de aberto o trilho tem medida.
      */
      const sel = elDias.querySelector<HTMLElement>('[aria-selected="true"]');
      if (sel) elDias.scrollLeft = sel.offsetLeft - (elDias.clientWidth - sel.offsetWidth) / 2;
      pintarSetas();
    }

    /* os três atalhos da capa abrem a folha já com dia e hora preenchidos */
    document.querySelectorAll<HTMLElement>('[data-vaga]').forEach((b) => {
      b.addEventListener('click', () => abrir(b.dataset.dia, Number(b.dataset.hora)));
    });
    document.querySelectorAll('[data-abrir-agenda]').forEach((b) => b.addEventListener('click', () => abrir()));
  }

  /* cada lista marcada entra item a item, na primeira vez que aparece */
  {
    const olho = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('vista');
          olho.unobserve(e.target);
        }),
      { threshold: 0.2 },
    );
    document.querySelectorAll('.entra').forEach((l) => olho.observe(l));
  }
</script>
