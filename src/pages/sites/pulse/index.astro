  .cesta :global(.cesta-v) { font-family: 'DM Mono', monospace; font-size: 0.92rem; text-align: right; }
  .cesta :global(.cesta-ctrl) { grid-column: 1 / -1; display: flex; align-items: center; gap: 0.5rem; }
  .cesta :global(.cesta-ctrl button) {
    width: 1.8rem; height: 1.8rem; border-radius: 8px; cursor: pointer;
    border: 1px solid var(--linha); background: rgba(255, 255, 255, 0.04);
    color: var(--branco); font-size: 0.9rem; line-height: 1;
    transition: border-color 0.3s ease, color 0.3s ease;
  }
  .cesta :global(.cesta-ctrl button:hover) { border-color: var(--ciano); color: var(--ciano); }
  .cesta :global(.cesta-q) { font-family: 'DM Mono', monospace; min-width: 1.4rem; text-align: center; }
  .cesta :global(.cesta-tira) {
    margin-left: auto; border: 0; background: transparent; cursor: pointer;
    color: var(--c40); font-size: 0.76rem; text-decoration: underline;
    transition: color 0.3s ease;
  }
  .cesta :global(.cesta-tira:hover) { color: var(--neon-2); }
  .cesta-vazia {
    display: grid; gap: 0.7rem; justify-items: center; text-align: center;
    padding: 2.5rem 1rem; color: var(--c40); font-size: 0.88rem;
  }
  .cesta-vazia i { font-size: 1.6rem; color: var(--linha-viva); }
