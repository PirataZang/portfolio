  .bilhete-cima { padding: 1.1rem 1.2rem; background: var(--neon); }
  .bilhete-evento { font-family: 'Anton', sans-serif; font-size: 1.5rem; text-transform: uppercase; color: #fff; line-height: 1; }
  .bilhete-evento span { opacity: 0.72; }
  .bilhete-data { margin-top: 0.35rem; font-size: 0.66rem; letter-spacing: 0.1em; color: rgba(255, 255, 255, 0.85); }
  /* serrilha do canhoto: o recorte que diz "isto é um ingresso" */
  .bilhete-serrilha {
    height: 14px; background:
      radial-gradient(circle at 7px 0, transparent 7px, var(--carta) 7.5px) repeat-x;
    background-size: 18px 14px;
    border-bottom: 1px dashed var(--linha-viva);
  }
  .bilhete-baixo { display: flex; gap: 1rem; padding: 1.1rem 1.2rem 1.3rem; align-items: flex-start; }
  .bilhete-qr { width: 92px; height: 92px; flex: none; background: #fff; border-radius: 8px; padding: 6px; }
  .bilhete-qr svg { display: block; width: 100%; height: 100%; }
  .bilhete-info { min-width: 0; }
  .bilhete-nome { font-weight: 700; font-size: 0.95rem; }
  .bilhete-info :global(ul) { list-style: none; margin: 0.4rem 0 0; padding: 0; display: grid; gap: 0.2rem; font-size: 0.78rem; color: var(--c60); }
  .bilhete-info :global(li) { list-style: none; }
  .bilhete-cod { margin-top: 0.7rem; font-size: 0.72rem; color: var(--ciano); letter-spacing: 0.08em; }

  /* ---------- rodapé ---------- */
  .rodape { background: var(--breu-2); border-top: 1px solid var(--linha); padding-top: clamp(2.8rem, 6vw, 4.2rem); }
  .rodape-grade { display: grid; gap: 2.2rem clamp(1.4rem, 3vw, 2.6rem); padding-bottom: clamp(2.2rem, 4.5vw, 3.4rem); }
  .rodape-marca { font-family: 'Anton', sans-serif; font-size: 1.8rem; text-transform: uppercase; line-height: 1; }
  .rodape-marca span { color: var(--ciano); }
  .rodape-d { margin-top: 0.8rem; font-size: 0.85rem; color: var(--c60); max-width: 34ch; }
  .rodape .redes { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.2rem 0 0; padding: 0; }
  .rodape .redes a {
    display: grid; place-items: center; width: 2.3rem; height: 2.3rem;
    border-radius: 12px; border: 1px solid var(--linha);
    background: var(--carta); color: var(--c60); font-size: 0.9rem; text-decoration: none;
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease, translate 0.3s ease;
  }
  .rodape .redes a:hover { background: var(--neon); border-color: var(--neon); color: #fff; translate: 0 -3px; }
  .rodape-t {
    font-family: 'DM Mono', monospace; font-size: 0.64rem;
    letter-spacing: 0.2em; text-transform: uppercase; color: var(--branco); margin-bottom: 0.9rem;
  }
  .rodape ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .rodape a { color: var(--c60); text-decoration: none; font-size: 0.85rem; transition: color 0.3s ease; }
  .rodape a:hover { color: var(--ciano); }
  .rodape-contato li { display: grid; grid-template-columns: 1.1rem 1fr; gap: 0.6rem; font-size: 0.85rem; color: var(--c60); }
  .rodape-contato i { color: var(--neon-2); font-size: 0.8rem; margin-top: 0.32rem; }
  .rodape-mapa iframe {
    width: 100%; height: 160px; border: 0; display: block; border-radius: var(--raio);
    filter: grayscale(0.9) invert(0.92) contrast(0.85);
  }
  .rodape-mini { margin-top: 0.6rem; font-size: 0.75rem; color: var(--c40); }
  .rodape-aviso { padding-block: 1rem; border-top: 1px solid var(--linha); }
  .rodape-aviso p { display: flex; gap: 0.7rem; align-items: baseline; font-size: 0.79rem; color: var(--c60); }
  .rodape-aviso i { color: var(--lima); }
  .rodape-fim {
    display: flex; flex-wrap: wrap; gap: 0.6rem 1.4rem; justify-content: space-between;
    padding-block: 1.1rem 1.7rem; border-top: 1px solid var(--linha);
