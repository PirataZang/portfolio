    transition: border-color 0.3s ease;
  }
  .fq details[open] { border-color: var(--linha-viva); }
  .fq summary {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 1rem 1.3rem; cursor: pointer; list-style: none;
    font-weight: 600; font-size: 0.94rem;
    transition: color 0.3s ease;
  }
  .fq summary::-webkit-details-marker { display: none; }
  .fq summary:hover { color: var(--ciano); }
  .fq summary i {
    flex: none; width: 1.7rem; height: 1.7rem; display: grid; place-items: center;
    border-radius: 50%; background: rgba(0, 224, 255, 0.1); color: var(--ciano);
    font-size: 0.64rem;
    transition: rotate 0.3s ease, background 0.3s ease, color 0.3s ease;
  }
  .fq details[open] summary i { rotate: 135deg; background: var(--neon); color: #fff; }
  .fq details p { padding: 0 1.3rem 1.25rem; font-size: 0.89rem; color: var(--c60); max-width: 68ch; }
  @media (prefers-reduced-motion: no-preference) {
    .fq details::details-content {
      block-size: 0; overflow: hidden;
      transition: block-size var(--t) var(--e), content-visibility var(--t) allow-discrete;
    }
    .fq details[open]::details-content { block-size: auto; }
  }

  /* ---------- gaveta do carrinho ---------- */
  .gaveta {
    width: min(100%, 27rem); max-width: none; height: 100dvh; max-height: none;
    margin: 0 0 0 auto; padding: 0; border: 0;
    border-left: 1px solid var(--linha);
    background: var(--breu-2); color: var(--branco);
    display: flex; flex-direction: column;
    translate: 100% 0; opacity: 0;
    transition: translate var(--t) var(--e), opacity var(--t) var(--e), overlay var(--t) allow-discrete, display var(--t) allow-discrete;
  }
  .gaveta[open] { translate: 0 0; opacity: 1; }
  @starting-style { .gaveta[open] { translate: 100% 0; opacity: 0; } }
  .gaveta::backdrop {
    background: rgba(5, 3, 10, 0.72); backdrop-filter: blur(3px);
    opacity: 0; transition: opacity var(--t) var(--e), overlay var(--t) allow-discrete, display var(--t) allow-discrete;
  }
  .gaveta[open]::backdrop { opacity: 1; }
  @starting-style { .gaveta[open]::backdrop { opacity: 0; } }

  .gaveta-cab {
    display: flex; align-items: center; justify-content: space-between;
    padding: 1.1rem 1.3rem; border-bottom: 1px solid var(--linha); flex: none;
  }
  .gaveta-t { font-size: 1.05rem; font-weight: 700; }
  .gaveta-x {
    width: 2.2rem; height: 2.2rem; border-radius: 50%; cursor: pointer;
    border: 1px solid var(--linha); background: transparent; color: var(--c60);
    transition: border-color 0.3s ease, color 0.3s ease;
  }
  .gaveta-x:hover { border-color: var(--neon); color: var(--neon-2); }
  .gaveta-corpo {
    flex: 1; overflow-y: auto; padding: 1.3rem;
    display: flex; flex-direction: column; gap: 1rem;
  }
  .gaveta-corpo[hidden] { display: none; }

  /* os itens da sacola nascem de innerHTML: sem :global o escopo do Astro não
     alcança, e a linha do carrinho fica sem estilo nenhum */
  .cesta { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
  .cesta :global(li) {
    display: grid; grid-template-columns: 1fr auto; gap: 0.6rem 0.9rem;
