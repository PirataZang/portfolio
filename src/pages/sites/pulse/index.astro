    letter-spacing: normal; text-transform: none;
    transition: border-color 0.3s ease, background 0.3s ease;
  }
  .form :is(input, select):focus {
    outline: none; border-color: var(--neon); background: rgba(5, 3, 10, 0.85);
  }
  .form input[type='checkbox'] { width: auto; }
  /* .form label (0,1,1) ganha de .marca-caixa (0,1,0) — o seletor precisa empatar */
  .form .marca-caixa {
    grid-template-columns: auto 1fr; align-items: center; gap: 0.6rem;
    font-family: 'Bai Jamjuree', sans-serif; font-size: 0.82rem;
    letter-spacing: normal; text-transform: none; color: var(--c60);
    cursor: pointer;
  }
  .form-nota {
    font-size: 0.74rem; color: var(--c40); text-align: center;
    display: flex; align-items: center; justify-content: center; gap: 0.4rem;
  }
  .aviso-demo { color: var(--neon-2); }

  /* cartão de membro */
  .cartao {
    position: relative; overflow: hidden;
    padding: clamp(1.4rem, 3vw, 2rem);
    border-radius: var(--raio-g); border: 1px solid rgba(255, 45, 149, 0.4);
    background:
      radial-gradient(120% 90% at 88% 8%, rgba(139, 47, 255, 0.32), transparent 60%),
      linear-gradient(150deg, var(--carta-2), var(--carta));
  }
  .cartao[hidden] { display: none; }
  .cartao-topo { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .cartao-marca {
    font-family: 'Anton', sans-serif; font-size: 1.35rem; text-transform: uppercase;
    display: flex; flex-direction: column; line-height: 1;
  }
  .cartao-marca span {
    font-family: 'DM Mono', monospace; font-size: 0.6rem; letter-spacing: 0.28em;
    color: var(--ciano); margin-top: 0.35rem;
  }
  .cartao-chip {
    width: 2.4rem; height: 1.8rem; border-radius: 6px;
    background: linear-gradient(140deg, var(--lima), var(--ciano));
