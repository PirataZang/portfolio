  .pl :focus-visible { outline: 2px solid var(--ciano); outline-offset: 3px; border-radius: 8px; }

  /* o que o Motion revela nasce escondido — só com JS e com vontade de movimento */
  :global(.anima-on) .pl [data-anima] { opacity: 0; }

  /* ---------- tablet ---------- */
  @media (min-width: 700px) {
