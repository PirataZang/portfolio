  .cartao-nome { margin-top: 1.6rem; font-size: 1.25rem; font-weight: 700; }
  .cartao-dados {
    display: grid; gap: 0.9rem 1.4rem; margin: 1.2rem 0 1.6rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 130px), 1fr));
  }
  .cartao-dados dt {
    font-family: 'DM Mono', monospace; font-size: 0.6rem;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--c40);
  }
  .cartao-dados dd { margin: 0.2rem 0 0; font-size: 0.88rem; word-break: break-word; }
  .cartao-acoes { display: grid; gap: 0.6rem; }

  /* ---------- dúvidas ---------- */
  .duvidas { background: var(--breu-2); border-top: 1px solid var(--linha); }
  .duvidas-grade { display: grid; gap: clamp(2rem, 4vw, 3.4rem); align-items: start; }
  .duvidas .cab { margin-bottom: 0; }
  .duvidas .cab .btn { margin-top: 1.5rem; }
  .fq { display: grid; gap: 0.6rem; }
  .fq details {
    border: 1px solid var(--linha); border-radius: var(--raio-g);
