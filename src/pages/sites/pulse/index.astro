  .soma { margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--linha); display: grid; gap: 0.5rem; }
  .soma[hidden] { display: none; }
  .soma div { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.88rem; color: var(--c60); }
  .soma dt, .soma dd { margin: 0; }
  .soma dd { font-family: 'DM Mono', monospace; }
  .soma-total { font-size: 1.05rem; color: var(--branco); font-weight: 700; padding-top: 0.5rem; border-top: 1px dashed var(--linha); }
  .soma-total dd { color: var(--ciano); }

  .trilha-passo {
    list-style: none; margin: 0 0 0.5rem; padding: 0; display: flex; gap: 0.4rem;
    font-family: 'DM Mono', monospace; font-size: 0.62rem;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--c40);
  }
  .trilha-passo li { display: flex; align-items: center; gap: 0.4rem; }
  .trilha-passo li:not(:last-child)::after { content: '›'; color: var(--linha-viva); }
  .trilha-passo .feito { color: var(--c60); }
  .trilha-passo .agora { color: var(--ciano); }
  .gaveta .form { border: 0; padding: 0; background: transparent; }

  .pag-opcoes { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
  .pag-opcoes button {
    display: grid; gap: 0.2rem; padding: 0.9rem 0.8rem; cursor: pointer;
    border-radius: var(--raio); border: 1px solid var(--linha);
    background: var(--carta); color: var(--branco);
    font-family: inherit; font-size: 0.9rem; font-weight: 600;
    transition: border-color 0.3s ease, background 0.3s ease;
  }
  .pag-opcoes button small { font-weight: 400; font-size: 0.7rem; color: var(--c40); }
  .pag-opcoes button.ativo { border-color: var(--neon); background: var(--carta-2); }
  .pag-resumo {
    display: flex; justify-content: space-between; align-items: baseline;
    padding: 0.9rem 1rem; border-radius: var(--raio);
    border: 1px solid var(--linha); background: var(--carta); font-size: 0.9rem;
  }
  .pag-resumo b { font-family: 'DM Mono', monospace; font-size: 1.15rem; color: var(--ciano); }
  .pag-nota { font-size: 0.8rem; color: var(--c40); }

  /* bilhete emitido */
  .pronto-topo { display: grid; gap: 0.4rem; justify-items: center; text-align: center; padding-block: 0.5rem 1rem; }
  .pronto-ok {
    width: 3rem; height: 3rem; display: grid; place-items: center; border-radius: 50%;
    background: rgba(200, 255, 54, 0.14); color: var(--lima); font-size: 1.2rem;
    margin-bottom: 0.4rem;
  }
  .pronto-t { font-size: 1.2rem; font-weight: 700; }
  .pronto-d { font-size: 0.85rem; color: var(--c60); }
