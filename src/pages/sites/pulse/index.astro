  .form {
    display: grid; gap: 0.85rem;
    padding: clamp(1.4rem, 3vw, 2rem);
    border-radius: var(--raio-g); border: 1px solid var(--linha); background: var(--carta);
  }
  .form-t {
    font-family: 'DM Mono', monospace; font-size: 0.68rem;
    letter-spacing: 0.2em; text-transform: uppercase; color: var(--ciano);
    margin-bottom: 0.4rem;
  }
  .form-2 { display: grid; gap: 0.85rem; }
  .form label {
    display: grid; gap: 0.38rem;
    font-family: 'DM Mono', monospace; font-size: 0.66rem;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--c40);
  }
  .form :is(input, select) {
    width: 100%; padding: 0.75rem 0.9rem;
    border-radius: 12px; border: 1px solid var(--linha);
