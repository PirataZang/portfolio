</style>

<script>
  /*
    Bilheteria inteira do lado do cliente. Três estados moram aqui: o carrinho,
    a conta e o passo do checkout. Os dois primeiros sobrevivem ao refresh pelo
    localStorage; o terceiro não deve sobreviver, e por isso não é salvo.
  */
  const reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const SAIDA = [0.22, 0.61, 0.36, 1] as const;
  const raiz = document.documentElement;
  const TAXA = 0.1;

  const brl = (n: number) =>
    n.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', minimumFractionDigits: 0, maximumFractionDigits: 2 });

  /* ═════════════ 1. contagem regressiva ═════════════ */

  const relogio = document.querySelector<HTMLElement>('[data-relogio]');
  if (relogio) {
    const alvo = new Date(relogio.dataset.alvo!).getTime();
    const casa = (k: string) => relogio.querySelector<HTMLElement>(`[data-r="${k}"]`)!;
    const campos = { d: casa('d'), h: casa('h'), m: casa('m'), s: casa('s') };
    const dois = (n: number) => String(n).padStart(2, '0');
    const tique = () => {
      const falta = Math.max(0, alvo - Date.now());
      const seg = Math.floor(falta / 1000);
      campos.d.textContent = String(Math.floor(seg / 86400));
      campos.h.textContent = dois(Math.floor(seg / 3600) % 24);
      campos.m.textContent = dois(Math.floor(seg / 60) % 60);
      campos.s.textContent = dois(seg % 60);
    };
    tique();
    setInterval(tique, 1000);
  }

  /* ═════════════ 2. carrinho ═════════════ */

  type Item = { id: string; nome: string; tipo: 'inteira' | 'meia'; preco: number; qtd: number };

  const CHAVE_CARRINHO = 'pulse:carrinho';
  const CHAVE_CONTA = 'pulse:conta';

  const ler = <T,>(chave: string, padrao: T): T => {
    try { return JSON.parse(localStorage.getItem(chave) ?? '') as T; } catch { return padrao; }
  };
  const gravar = (chave: string, v: unknown) => {
    try { localStorage.setItem(chave, JSON.stringify(v)); } catch { /* modo privado: segue sem persistir */ }
  };

  let carrinho: Item[] = ler<Item[]>(CHAVE_CARRINHO, []).filter(
    (i) => i && typeof i.preco === 'number' && typeof i.qtd === 'number' && i.qtd > 0,
  );

  const gaveta = document.querySelector<HTMLDialogElement>('[data-carrinho]');
  const cesta = document.querySelector<HTMLElement>('[data-cesta]');
  const vazia = document.querySelector<HTMLElement>('[data-vazia]');
  const soma = document.querySelector<HTMLElement>('[data-soma]');
  const contador = document.querySelector<HTMLElement>('[data-carrinho-n]');
  const btnContinuar = document.querySelector<HTMLButtonElement>('[data-ir-dados]');

  const subtotal = () => carrinho.reduce((s, i) => s + i.preco * i.qtd, 0);
  const total = () => subtotal() * (1 + TAXA);
  const pecas = () => carrinho.reduce((s, i) => s + i.qtd, 0);

  const escreverTotais = () => {
    const sub = subtotal();
    const setar = (sel: string, v: string) => {
      document.querySelectorAll<HTMLElement>(sel).forEach((el) => (el.textContent = v));
    };
    setar('[data-subtotal]', brl(sub));
    setar('[data-taxa]', brl(sub * TAXA));
    setar('[data-total]', brl(sub * (1 + TAXA)));
    setar('[data-total-pag]', brl(sub * (1 + TAXA)));
  };

  function pintarCarrinho() {
    if (!cesta) return;
    cesta.innerHTML = '';
    for (const [n, item] of carrinho.entries()) {
      const li = document.createElement('li');
      li.innerHTML = `
        <div>
          <p class="cesta-nome">${item.nome}</p>
          <p class="cesta-tipo">${item.tipo}</p>
        </div>
        <p class="cesta-v">${brl(item.preco * item.qtd)}</p>
        <div class="cesta-ctrl">
          <button type="button" data-c-menos="${n}" aria-label="Menos um">−</button>
          <span class="cesta-q">${item.qtd}</span>
          <button type="button" data-c-mais="${n}" aria-label="Mais um">+</button>
          <button type="button" class="cesta-tira" data-c-tira="${n}">remover</button>
        </div>`;
      cesta.append(li);
    }
    const tem = carrinho.length > 0;
    if (vazia) vazia.hidden = tem;
    if (soma) soma.hidden = !tem;
    if (btnContinuar) btnContinuar.disabled = !tem;
    if (contador) {
      contador.textContent = String(pecas());
      contador.hidden = !tem;
    }
    escreverTotais();
    if (avisoLogin) avisoLogin.hidden = !tem || logado();
    gravar(CHAVE_CARRINHO, carrinho);
  }

  cesta?.addEventListener('click', (ev) => {
    const alvo = (ev.target as HTMLElement).closest<HTMLElement>('[data-c-menos],[data-c-mais],[data-c-tira]');
    if (!alvo) return;
    const { cMenos, cMais, cTira } = alvo.dataset;
    const n = Number(cMenos ?? cMais ?? cTira);
    if (cTira !== undefined) carrinho.splice(n, 1);
    else if (cMais !== undefined) carrinho[n].qtd = Math.min(10, carrinho[n].qtd + 1);
    else if (carrinho[n].qtd > 1) carrinho[n].qtd -= 1;
    else carrinho.splice(n, 1);
    pintarCarrinho();
  });

  const abrir = () => { irPara('itens'); gaveta?.showModal(); };
  document.querySelectorAll('[data-abrir-carrinho]').forEach((b) => b.addEventListener('click', abrir));
  document.querySelectorAll('[data-fechar]').forEach((b) => b.addEventListener('click', () => gaveta?.close()));

  /* ═════════════ 4. cards de ingresso ═════════════ */

  document.querySelectorAll<HTMLElement>('[data-setor]').forEach((card) => {
    const saida = card.querySelector<HTMLOutputElement>('[data-qtd]');
    const add = card.querySelector<HTMLButtonElement>('[data-add]');
    if (!saida || !add) return;

    let qtd = 1;
    let tipo: 'inteira' | 'meia' = 'inteira';
    const base = Number(card.dataset.preco);
    const nome = card.dataset.nome!;

    card.querySelector('[data-mais]')?.addEventListener('click', () => {
      qtd = Math.min(10, qtd + 1);
      saida.textContent = String(qtd);
    });
    card.querySelector('[data-menos]')?.addEventListener('click', () => {
      qtd = Math.max(1, qtd - 1);
      saida.textContent = String(qtd);
    });

    const valor = card.querySelector<HTMLElement>('[data-valor]');
    const legenda = card.querySelector<HTMLElement>('[data-legenda]');

    card.querySelectorAll<HTMLButtonElement>('[data-tipo]').forEach((b) => {
      b.addEventListener('click', () => {
        tipo = b.dataset.tipo as 'inteira' | 'meia';
        card.querySelectorAll('[data-tipo]').forEach((o) => o.classList.toggle('ativo', o === b));
        /* o preço grande é o que a pessoa lê: ele tem que virar meia junto */
        const meia = tipo === 'meia';
        if (valor) valor.textContent = String(meia ? base / 2 : base);
        if (legenda) {
          legenda.textContent = meia
            ? `meia-entrada · inteira sai por R$ ${base}`
            : `inteira · meia sai por R$ ${base / 2}`;
        }
      });
    });

    add.addEventListener('click', () => {
      const preco = tipo === 'meia' ? base / 2 : base;
      const id = `${card.dataset.setor}:${tipo}`;
      /* mesmo setor e mesmo tipo somam quantidade em vez de virar duas linhas */
      const existente = carrinho.find((i) => i.id === id);
      if (existente) existente.qtd = Math.min(10, existente.qtd + qtd);
      else carrinho.push({ id, nome, tipo, preco, qtd });
      pintarCarrinho();
      abrir();
    });
  });

  /* ═════════════ 5. checkout em passos ═════════════ */

  const passos = ['itens', 'dados', 'pagamento', 'pronto'] as const;
  type Passo = (typeof passos)[number];

  function irPara(p: Passo) {
    for (const nome of passos) {
      const el = document.querySelector<HTMLElement>(`[data-passo="${nome}"]`);
      if (el) el.hidden = nome !== p;
    }
    document.querySelector<HTMLElement>('.gaveta-corpo:not([hidden])')?.scrollTo(0, 0);
  }

  let comprador = { nome: '', email: '', cpf: '' };

  /* máscara de CPF só de dígitos: nada de regex de validação, é demonstração */
  document.querySelector<HTMLInputElement>('[data-cpf]')?.addEventListener('input', (ev) => {
    const el = ev.target as HTMLInputElement;
    const d = el.value.replace(/\D/g, '').slice(0, 11);
    el.value = d
      .replace(/^(\d{3})(\d)/, '$1.$2')
      .replace(/^(\d{3})\.(\d{3})(\d)/, '$1.$2.$3')
      .replace(/\.(\d{3})(\d{1,2})$/, '.$1-$2');
  });

  btnContinuar?.addEventListener('click', () => {
    if (!logado()) {
      pedirLogin('Entre para finalizar a compra. O ingresso é nominal e fica na sua conta.', () => irPara('dados'));
      return;
    }
    irPara('dados');
  });
  document.querySelector('[data-voltar-itens]')?.addEventListener('click', () => irPara('itens'));
  document.querySelector('[data-voltar-dados]')?.addEventListener('click', () => irPara('dados'));

  document.querySelector<HTMLFormElement>('[data-form-dados]')?.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const d = new FormData(ev.target as HTMLFormElement);
    comprador = {
      nome: String(d.get('nome') ?? '').trim(),
      email: String(d.get('email') ?? '').trim(),
      cpf: String(d.get('cpf') ?? '').trim(),
    };
    escreverTotais();
    irPara('pagamento');
  });

  const notaPag = document.querySelector<HTMLElement>('[data-pag-nota]');
  document.querySelectorAll<HTMLButtonElement>('[data-pag]').forEach((b) => {
    b.addEventListener('click', () => {
      document.querySelectorAll('[data-pag]').forEach((o) => o.classList.toggle('ativo', o === b));
      if (notaPag) {
        notaPag.textContent =
          b.dataset.pag === 'pix'
            ? 'O código Pix vale por 15 minutos e o ingresso é emitido assim que o pagamento cai.'
            : 'Em até 6× sem juros. O ingresso é emitido na aprovação, normalmente em segundos.';
      }
    });
  });

  /*
    QR ilustrativo. Uma grade 25×25 derivada de um hash do código, com os três
    olhos de canto desenhados por cima — não decodifica nada e a legenda diz
    isso, mas dá ao bilhete a única coisa que faltava para parecer um bilhete.
  */
  function desenharQR(codigo: string) {
    const N = 25;
    let h = 2166136261;
    for (const c of codigo) { h ^= c.charCodeAt(0); h = Math.imul(h, 16777619); }
    const prox = () => { h ^= h << 13; h ^= h >>> 17; h ^= h << 5; return (h >>> 0) / 4294967296; };

    const olho = (x: number, y: number) =>
      (x < 7 && y < 7) || (x >= N - 7 && y < 7) || (x < 7 && y >= N - 7);
    const dentroOlho = (x: number, y: number) => {
      const ox = x < 7 ? x : x - (N - 7);
      const oy = y < 7 ? y : y - (N - 7);
      const borda = ox === 0 || ox === 6 || oy === 0 || oy === 6;
      const miolo = ox >= 2 && ox <= 4 && oy >= 2 && oy <= 4;
      return borda || miolo;
    };

    let d = '';
    for (let y = 0; y < N; y++) {
      for (let x = 0; x < N; x++) {
        const preto = olho(x, y) ? dentroOlho(x, y) : prox() > 0.52;
        if (preto) d += `M${x} ${y}h1v1h-1z`;
      }
    }
    return `<svg viewBox="0 0 ${N} ${N}" xmlns="http://www.w3.org/2000/svg"><path d="${d}" fill="#05030a"/></svg>`;
  }

  document.querySelector('[data-pagar]')?.addEventListener('click', () => {
    if (!carrinho.length) return;
    /* segunda tranca: ninguém fecha compra sem conta, nem chegando por atalho */
    if (!logado()) {
      pedirLogin('Entre para finalizar a compra.', () => irPara('pagamento'));
      return;
    }
    const codigo =
      'PLS-' +
      Array.from({ length: 8 }, () => 'ABCDEFGHJKMNPQRSTUVWXYZ23456789'[Math.floor(Math.random() * 31)]).join('');

    const setar = (sel: string, v: string) => {
      const el = document.querySelector<HTMLElement>(sel);
      if (el) el.textContent = v;
    };
    setar('[data-pronto-nome]', comprador.nome || 'Convidado');
    setar('[data-pronto-email]', comprador.email || '—');
    setar('[data-pronto-cod]', codigo);

    const lista = document.querySelector<HTMLElement>('[data-pronto-itens]');
    if (lista) {
      lista.innerHTML = carrinho
        .map((i) => `<li>${i.qtd}× ${i.nome} · ${i.tipo}</li>`)
        .join('');
    }
    const qr = document.querySelector<HTMLElement>('[data-qr]');
    if (qr) qr.innerHTML = desenharQR(codigo);

    /* compra fechada: o carrinho zera, como zeraria de verdade */
    carrinho = [];
    pintarCarrinho();
    irPara('pronto');
  });

  /* ═════════════ 6. conta e login, só no navegador ═════════════ */

  type Conta = { nome: string; email: string; estilo: string; avisos: boolean; desde: string; id: string };

  const formCadastro = document.querySelector<HTMLFormElement>('[data-cadastro]');
  const cartao = document.querySelector<HTMLElement>('[data-cartao]');
  const modalLogin = document.querySelector<HTMLDialogElement>('[data-login]');
  const btnEntrar = document.querySelector<HTMLElement>('[data-abrir-login]');
  const boxUsuario = document.querySelector<HTMLDetailsElement>('[data-usuario]');
  const avisoLogin = document.querySelector<HTMLElement>('[data-precisa-login]');

  let conta: Conta | null = null;
  /* de onde veio o pedido de login: o checkout continua sozinho depois */
  let aposLogin: (() => void) | null = null;

  const logado = () => !!conta;

  function pintarTopo() {
    if (btnEntrar) btnEntrar.hidden = logado();
    if (boxUsuario) {
      boxUsuario.hidden = !logado();
      boxUsuario.open = false;
      if (conta) {
        const ini = boxUsuario.querySelector<HTMLElement>('[data-u-ini]');
        const mail = boxUsuario.querySelector<HTMLElement>('[data-u-mail]');
        if (ini) ini.textContent = (conta.nome || conta.email).trim().charAt(0) || '?';
        if (mail) mail.textContent = conta.email;
      }
    }
    if (avisoLogin) avisoLogin.hidden = logado() || carrinho.length === 0;
    /* o e-mail do checkout é o da conta, e não se digita de novo */
    const campo = document.querySelector<HTMLInputElement>('[data-email-conta]');
    if (campo) campo.value = conta?.email ?? '';
    const nomeCampo = document.querySelector<HTMLFormElement>('[data-form-dados]')?.elements.namedItem('nome');
    if (nomeCampo instanceof HTMLInputElement && conta?.nome && !nomeCampo.value) nomeCampo.value = conta.nome;
  }

  function entrar(email: string, nome?: string) {
    conta = conta ?? {
      nome: nome ?? email.split('@')[0].replace(/[._-]+/g, ' '),
      email,
      estilo: 'Escuto tudo',
      avisos: true,
      desde: new Date().toLocaleDateString('pt-BR'),
      id: 'PLS' + Math.floor(100000 + Math.random() * 899999),
    };
    conta.email = email;
    if (nome) conta.nome = nome;
    gravar(CHAVE_CONTA, conta);
    pintarConta(conta);
    pintarTopo();
  }

  function pedirLogin(motivo: string, depois: () => void) {
    aposLogin = depois;
    const nota = document.querySelector<HTMLElement>('[data-login-motivo]');
    if (nota) nota.textContent = motivo;
    modalLogin?.showModal();
  }

  btnEntrar?.addEventListener('click', () => {
    aposLogin = null;
    pedirLogin(
      'Entre para ver seus ingressos, reemitir o QR e comprar sem digitar tudo de novo.',
      () => {},
    );
  });
  document.querySelector('[data-fechar-login]')?.addEventListener('click', () => modalLogin?.close());
  document.querySelector('[data-ir-cadastro]')?.addEventListener('click', () => {
    modalLogin?.close();
    gaveta?.close();
  });

  document.querySelector<HTMLFormElement>('[data-form-login]')?.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const d = new FormData(ev.target as HTMLFormElement);
    const email = String(d.get('email') ?? '').trim();
    if (!email) return;
    entrar(email);
    modalLogin?.close();
    const seguir = aposLogin;
    aposLogin = null;
    seguir?.();
  });

  const sair = () => {
    try { localStorage.removeItem(CHAVE_CONTA); } catch { /* nada a limpar */ }
    conta = null;
    formCadastro?.reset();
    pintarConta(null);
    pintarTopo();
  };
  document.querySelector('[data-sair-topo]')?.addEventListener('click', sair);

  function pintarConta(c: Conta | null) {
    if (!formCadastro || !cartao) return;
    formCadastro.hidden = !!c;
    cartao.hidden = !c;
    if (!c) return;
    const setar = (sel: string, v: string) => {
      const el = cartao.querySelector<HTMLElement>(sel);
      if (el) el.textContent = v;
    };
    setar('[data-c-nome]', c.nome);
    setar('[data-c-email]', c.email);
    setar('[data-c-estilo]', c.estilo);
    setar('[data-c-desde]', c.desde);
    setar('[data-c-id]', c.id);
  }

  formCadastro?.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const d = new FormData(formCadastro);
    const nova: Conta = {
      nome: String(d.get('nome') ?? '').trim(),
      email: String(d.get('email') ?? '').trim(),
      estilo: String(d.get('estilo') ?? ''),
      avisos: d.get('avisos') === 'on',
      desde: new Date().toLocaleDateString('pt-BR'),
      id: 'PLS' + Math.floor(100000 + Math.random() * 899999),
    };
    conta = nova;
    gravar(CHAVE_CONTA, nova);
    pintarConta(nova);
    pintarTopo();
    /* o formulário some, então o foco precisa ir para o cartão que apareceu */
    cartao?.setAttribute('tabindex', '-1');
    cartao?.focus();
  });

  document.querySelector('[data-sair]')?.addEventListener('click', sair);

  conta = ler<Conta | null>(CHAVE_CONTA, null);
  pintarConta(conta);
  pintarCarrinho();
  pintarTopo();

  /* ═════════════ 7. movimento ═════════════ */

  async function ligarMovimento() {
    if (reduz) return;
    const { animate, inView, scroll, stagger } = await import('motion');

    const umaVez = (el: Element, efeito: () => void, opcoes?: Parameters<typeof inView>[2]) => {
      let parar = () => {};
      parar = inView(el, () => { efeito(); parar(); }, opcoes);
    };

    const barra = document.querySelector<HTMLElement>('[data-progresso]');
    if (barra) scroll(animate(barra, { scaleX: [0, 1] }, { ease: 'linear' }));

    const topo = document.querySelector<HTMLElement>('[data-topo]');
    if (topo) {
      const marcar = () => { topo.dataset.topo = scrollY > 12 ? 'rolou' : ''; };
      marcar();
      addEventListener('scroll', marcar, { passive: true });
    }

    animate(
      document.querySelectorAll('.heroi [data-anima]'),
      { opacity: [0, 1], y: [18, 0] },
      { duration: 0.75, delay: stagger(0.08), ease: SAIDA },
    );

    /* revelação em cascata, agrupada por pai para o stagger correr entre irmãos */
    const grupos = new Map<Element, HTMLElement[]>();
    for (const el of document.querySelectorAll<HTMLElement>('[data-anima]')) {
      if (el.closest('.heroi')) continue;
      const pai = el.parentElement!;
      grupos.set(pai, [...(grupos.get(pai) ?? []), el]);
    }
    for (const irmaos of grupos.values()) {
      umaVez(
        irmaos[0],
        () => animate(irmaos, { opacity: [0, 1], y: [20, 0] }, { duration: 0.6, delay: stagger(0.07), ease: SAIDA }),
        { amount: 0.12, margin: '0px 0px -8% 0px' },
      );
    }

    /* foto do herói com paralaxe curta, para a luz não parecer colada */
    const foto = document.querySelector<HTMLElement>('.heroi-foto');
    if (foto) scroll(animate(foto, { y: [0, 90], scale: [1.06, 1.14] }, { ease: 'linear' }), { target: foto });

    /*
      Os dois trilhos da galeria. Correm em sentidos opostos enquanto a seção
      atravessa a tela; a distância é medida do próprio conteúdo, então
      continua certa em qualquer largura.
    */
    const secaoGaleria = document.querySelector<HTMLElement>('.galeria');
    if (secaoGaleria) {
      document.querySelectorAll<HTMLElement>('[data-trilho]').forEach((trilho) => {
        const sentido = Number(trilho.dataset.trilho);
        const curso = Math.max(0, trilho.scrollWidth - innerWidth) * 0.5;
        scroll(
          animate(trilho, { x: sentido > 0 ? [0, -curso] : [-curso, 0] }, { ease: 'linear' }),
          { target: secaoGaleria, offset: ['start end', 'end start'] },
        );
      });
    }
  }

  const revelarTudo = () => raiz.classList.remove('anima-on');
  const socorro = setTimeout(revelarTudo, 3000);
  ligarMovimento().catch(revelarTudo).finally(() => clearTimeout(socorro));
  if (reduz) revelarTudo();
</script>
