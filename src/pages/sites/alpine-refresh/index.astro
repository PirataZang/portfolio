<script>
  /*
    Um laço só: o scroll marca "tem quadro pendente", o requestAnimationFrame
    lê scrollY uma vez e entrega a cada cena a sua entrada `e` (o fade por cima
    da cena anterior) e o progresso `p` do trecho de conteúdo. As posições são
    medidas no load e no resize, nunca dentro do quadro.

    Cada cena, de cima para baixo:
      [ entrada: --fade ][ conteúdo: p de 0 a 1 ][ saída: a próxima entra ]
  */
  const raiz = document.documentElement;
  const topo = document.querySelector<HTMLElement>('[data-topo]')!;
  const menuBt = document.querySelector<HTMLButtonElement>('[data-menu-bt]')!;
  const lim = (n: number, a = 0, b = 1) => Math.min(b, Math.max(a, n));
  const suave = (t: number) => 1 - Math.pow(1 - t, 3);
  const faixa = (p: number, de: number, ate: number) => lim((p - de) / (ate - de));

  /* menu do celular */
  const fecharMenu = () => { topo.classList.remove('aberto'); menuBt.setAttribute('aria-expanded', 'false'); };
  menuBt.addEventListener('click', () => {
    const abre = !topo.classList.contains('aberto');
    topo.classList.toggle('aberto', abre);
    menuBt.setAttribute('aria-expanded', String(abre));
  });
  document.querySelectorAll('[data-menu] a').forEach((a) => a.addEventListener('click', fecharMenu));
  addEventListener('keydown', (e) => { if (e.key === 'Escape') fecharMenu(); });

  const anda = raiz.classList.contains('anda');
  let k = 1; // intensidade dos deslocamentos: menor no celular
  const mqCel = matchMedia('(max-width: 760px)');

  const q = <T extends HTMLElement = HTMLElement>(sel: string, el: ParentNode = document) => el.querySelector<T>(sel)!;
  const qq = (sel: string, el: ParentNode = document) => [...el.querySelectorAll<HTMLElement>(sel)];
  const pct = (el: HTMLElement, nome: string) => parseFloat(getComputedStyle(el).getPropertyValue(nome));
  const vis = (el: HTMLElement, o: number, y = 0) => { el.style.opacity = String(o); el.style.transform = `translate3d(0, ${y}px, 0)`; };

  const hCeu = q('.h-ceu'), hTexto = q('.h-texto'), hMacico = q('.h-macico'), hDescer = q('.descer'), hVeu = q('.h-veu');
  const oRot = q('.o-rotulo'), oJan = q('.o-janela'), oFoto = q('.o-foto'), oSombra = q('.o-sombra'), oSombra2 = q('.o-sombra2'), oTexto = q('.o-texto'), oTexto2 = q('.o-texto2');
  const rConteudo = q('.r-conteudo'), rCab = qq('.r-cab > *'), rLinha = q('.r-linha'), rItens = qq('.atributos li');
  const mFundos = qq('.m-fundo'), mFotos = qq('.m-foto'), mTxts = qq('.m-dest-txt'), mCab = q('.m-cab');
  const zSol = q('.z-sol'), zNoite = q('.z-noite'), zMacico = q('.z-macico'), zBrilho = q('.z-brilho'), zTexto = q('.z-texto');
  let hDe = 0, hAte = 0, zDe = 0, zAte = 0, janY = 0, janX = 0;
  /* o texto de uma cena sai na primeira metade do fade da seguinte: só as fotos se cruzam */
  const saida = (x: number) => 1 - lim(x * 2.2);

  /* p: conteúdo, e: entrada (fade por cima da anterior), x: entrada da próxima. Pode devolver o tom do topo. */
  const FN: Record<string, (p: number, e: number, x: number) => string | void> = {
    heroi(p) {
      hCeu.style.transform = `translate3d(0, ${-p * 5 * k}%, 0) scale(${1.03 + p * 0.09})`;
      hMacico.style.transform = `translate3d(0, ${hDe + (hAte - hDe) * suave(lim(p / 0.85))}%, 0)`;
      const t = faixa(p, 0, 0.42);
      hTexto.style.opacity = String(1 - t);
      hTexto.style.transform = `translate3d(0, ${-t * 14 * k}vh, 0)`;
      hDescer.style.opacity = String(1 - faixa(p, 0, 0.12));
      hVeu.style.opacity = String(faixa(p, 0.72, 1));
    },
    origem(p, _e, x) {
      // a janela abre sobre o branco como uma foto revelada; depois o lago fica parado
      const i = 1 - suave(faixa(p, 0.02, 0.32));
      oRot.style.opacity = String(1 - faixa(p, 0, 0.14));
      oJan.style.clipPath = i > 0.001 ? `inset(${i * janY}% ${i * janX}% round ${i * 4}px)` : 'none';
      oFoto.style.transform = i > 0.001 ? `scale(${1 + i * 0.22})` : 'none';
      const fora = saida(x);
      const t1 = suave(faixa(p, 0.34, 0.5));
      oSombra.style.opacity = String(t1);
      vis(oTexto, t1 * fora, (1 - t1) * 36);
      const t2 = suave(faixa(p, 0.6, 0.8));
      oSombra2.style.opacity = String(t2);
      vis(oTexto2, t2 * fora, (1 - t2) * 30);
      return p > 0.24 ? 'escuro' : 'claro';
    },
    refresco(p, _e, x) {
      // primeiro o texto de cima, depois a linha e os três atributos, um por vez
      rCab.forEach((el, i) => { const t = suave(faixa(p, i * 0.04, 0.16 + i * 0.04)); vis(el, t, (1 - t) * 24); });
      rLinha.style.transform = `scaleX(${suave(faixa(p, 0.26, 0.44))})`;
      rItens.forEach((el, i) => { const t = suave(faixa(p, 0.36 + i * 0.14, 0.5 + i * 0.14)); vis(el, t, (1 - t) * 20); });
      rConteudo.style.opacity = String(saida(x));
    },
    momentos(p, _e, x) {
      // s anda de um destino ao outro; os 12% finais seguram o último
      const n = mFundos.length;
      const s = lim(p / 0.88) * (n - 1);
      for (let i = 0; i < n; i++) {
        const o = i === 0 ? 1 : suave(faixa(s, i - 0.55, i - 0.05));
        mFundos[i].style.opacity = String(o);
        mFundos[i].style.transform = `scale(${1.08 + 0.16 * lim((s - i + 0.55) / 1.6)})`;
        mFotos[i].style.opacity = String(o);
        // o texto sai antes do próximo entrar: nunca dois parágrafos sobrepostos
        const entra = i === 0 ? 1 : suave(faixa(s, i - 0.3, i - 0.05));
        const sai = i === n - 1 ? 0 : faixa(s, i + 0.45, i + 0.65);
        const t = entra * (1 - sai);
        vis(mTxts[i], t * saida(x), (1 - entra) * 18 - sai * 12);
      }
      mCab.style.opacity = String(saida(x));
    },
    horizonte(p) {
      zMacico.style.transform = `translate3d(0, ${zDe + (zAte - zDe) * suave(lim(p / 0.75))}%, 0)`;
      zSol.style.transform = `translate3d(0, ${p * 20}vh, 0)`;
      zNoite.style.opacity = String(p * 0.4);
      zBrilho.style.opacity = String(1 - p * 0.3);
      const t = suave(faixa(p, 0.1, 0.45));
      vis(zTexto, t, (1 - t) * 30);
    },
  };

  type Cena = { el: HTMLElement; palco: HTMLElement; tom: string; top: number; alt: number; din: number; dout: number; e: number; fn: (typeof FN)[string] };
  const cenas: Cena[] = qq('[data-cena]').map((el) => ({
    el, palco: q('.palco', el), tom: el.dataset.tom ?? 'escuro',
    top: 0, alt: 0, din: 0, dout: 0, e: 1, fn: FN[el.dataset.cena!],
  }));
  let vh = innerHeight;

  function medir() {
    k = mqCel.matches ? 0.55 : 1;
    vh = cenas[0].palco.offsetHeight; // 100svh: a mesma unidade das alturas no CSS
    cenas.forEach((c, i) => {
      c.top = c.el.getBoundingClientRect().top + scrollY;
      c.alt = c.el.offsetHeight;
      c.din = i ? -parseFloat(getComputedStyle(c.el).marginTop) - vh : 0;
    });
    cenas.forEach((c, i) => {
      // a última cena "sai" pelo rodapé, que sobe por cima dela
      c.dout = cenas[i + 1]?.din ?? (q('.rodape', c.el)?.offsetHeight || 0);
    });
    hDe = pct(hMacico, '--de'); hAte = pct(hMacico, '--ate');
    zDe = pct(zMacico, '--de'); zAte = pct(zMacico, '--ate');
    janY = pct(oJan, '--jan-y'); janX = pct(oJan, '--jan-x');
  }

  let pendente = false;
  let ultimoY = scrollY;
  function quadro() {
    pendente = false;
    const y = scrollY;
    let tom = cenas[0].tom;
    if (anda) {
      for (const c of cenas) c.e = c.din ? lim((y - c.top) / c.din) : 1;
      cenas.forEach((c, i) => {
        // escondida antes de entrar ou quando a próxima já a cobre inteira: não pinta
        const coberta = (cenas[i + 1]?.e ?? 0) >= 1;
        const ativa = c.e > 0 && !coberta && y < c.top + c.alt;
        c.palco.style.visibility = ativa ? 'visible' : 'hidden';
        if (!ativa) return;
        if (c.din) c.palco.style.opacity = String(c.e);
        const ini = c.top + c.din, fim = c.top + c.alt - vh - c.dout;
        const t = c.fn(lim((y - ini) / Math.max(1, fim - ini)), c.e, cenas[i + 1]?.e ?? 0);
        if (c.e > 0.5) tom = t || c.tom;
      });
    } else {
      const sob = cenas.findLast((c) => c.el.getBoundingClientRect().top <= 36);
      if (sob) tom = sob.tom;
    }
    topo.dataset.tom = tom;
    // some descendo, volta subindo; o fim do smooth scroll anda de 1 em 1 px e não conta
    const d = y - ultimoY;
    if (Math.abs(d) > 6) {
      if (!topo.classList.contains('aberto')) topo.classList.toggle('some', d > 0 && y > vh * 0.6);
      ultimoY = y;
    }
  }
  const pedir = () => { if (!pendente) { pendente = true; requestAnimationFrame(quadro); } };

  medir();
  quadro();
  addEventListener('scroll', pedir, { passive: true });
  addEventListener('resize', () => { medir(); pedir(); });
  addEventListener('load', () => { medir(); pedir(); });
  topo.addEventListener('focusin', () => topo.classList.remove('some'));
</script>
