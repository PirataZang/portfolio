---
import Base from '../../../layouts/Base.astro';

/*
  ALPINE REFRESH — marca conceitual de refresco, nascida nas montanhas.

  Uma página só, contada pela rolagem: a montanha de manhã, o lago, a garrafa
  na pedra, quatro destinos e a mesma montanha ao entardecer. O começo e o fim
  usam o mesmo maciço (o PNG recortado) de propósito: a história fecha onde
  abriu, com a luz de outra hora do dia.

  Paleta: azul-glacial, verde-pinho, branco natural, pedra e um fio de ciano.
  Tipografia: Instrument Serif nos títulos, Instrument Sans no texto.

  Continuidade: não há emenda entre seções. Cada cena tem um palco fixo
  (sticky) e a seguinte começa `100svh + --fade` antes do fim dela (margem
  negativa), então durante `--fade` de rolagem as duas estão paradas e a nova
  entra em fade por cima da antiga. Nenhuma imagem desliza para fora da tela;
  só o rodapé sobe, no fim, por cima do horizonte parado.

  Profundidade: só onde existe camada de verdade. No início, a foto do pico
  (fundo, lenta) e o maciço recortado (frente, rápido) saindo da neblina; no
  fim, céu em gradiente, sol que se põe e o maciço com a alpenglow aplicada
  pela própria silhueta (mask com o mesmo PNG). Fotos achatadas recebem só
  escala.

  Movimento: um único laço em requestAnimationFrame lê o scroll uma vez por
  quadro, com as posições das cenas medidas no resize. Só transform e opacity.
  Sem `.anda` no <html> (sem JS ou com movimento reduzido) as cenas viram
  telas comuns, uma embaixo da outra, no estado final.
*/

const IMG = `${import.meta.env.BASE_URL}img/alpine-refresh`;

const MARCA = { nome: 'Alpine Refresh' };

const NAV = [
  { id: 'origem', t: 'Origem' },
  { id: 'refresco', t: 'O refresco' },
  { id: 'momentos', t: 'Momentos' },
  { id: 'horizonte', t: 'Horizonte' },
];

const ATRIBUTOS = [
  {
    t: 'Frescor que inspira',
    icone: '<path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9"/><path d="M9.5 4.5 12 7l2.5-2.5M9.5 19.5 12 17l2.5 2.5M3.6 10.6l3.4.9-.9 3.4M20.4 13.4l-3.4-.9.9-3.4M6.1 9.1 7 12.5l-3.4.9M17.9 14.9 17 11.5l3.4-.9"/>',
  },
  {
    t: 'Sabor que surpreende',
    icone: '<path d="M12 3.2c3.4 4.3 5.8 7.6 5.8 10.6a5.8 5.8 0 0 1-11.6 0c0-3 2.4-6.3 5.8-10.6Z"/><path d="M9.2 14.4a2.9 2.9 0 0 0 2.4 2.7"/>',
  },
  {
    t: 'Leveza para seguir em frente',
    icone: '<path d="M2.5 19.5 9 9.5l3.6 5.2 2.6-3.6 6.3 8.4"/><path d="M9 9.5 7.6 4.5" stroke-dasharray="1.2 2"/>',
  },
];

/*
  Os destinos de Momentos, na ordem de um dia: manhã, meio do dia, fim de
  tarde, entardecer — o último já puxa a luz quente do horizonte que vem
  depois. `fundo` é a foto inteira, em baixa resolução, que cobre a seção com
  zoom; `quadro` é o recorte 4:5 nítido que aparece emoldurado.
*/
const DESTINOS = [
  {
    nome: 'Acima das nuvens', hora: 'Manhã', fundo: 'topo-1200', quadro: 'd-pico',
    texto: 'O dia começa devagar lá em cima. A neblina ainda cobre o vale e o único som é o do vento.',
    alt: 'Pico nevado sob céu azul, com a base escondida por um mar de nuvens',
  },
  {
    nome: 'O lago espelho', hora: 'Meio do dia', fundo: 'f-espelho', quadro: 'd-espelho',
    texto: 'A água parada repete o céu inteiro. Uma pedra na margem, os pés na água fria e nenhuma pressa de voltar.',
    alt: 'Lago de águas paradas entre encostas de pinheiros, refletindo as nuvens do céu',
  },
  {
    nome: 'A última luz', hora: 'Fim de tarde', fundo: 'lago-1200', quadro: 'd-cumes',
    texto: 'O sol se despede pelos cumes, um de cada vez. É a hora de sentar na margem e só olhar.',
    alt: 'Cumes rochosos rosados pelo último sol, acima de um lago e de um morro escuro com casas',
  },
  {
    nome: 'A vila no fim da trilha', hora: 'Entardecer', fundo: 'f-vila', quadro: 'd-vila',
    texto: 'Telhados aquecidos pelo sol e cheiro de lenha no ar. O caminho termina onde a conversa começa.',
    alt: 'Telhados de cerâmica de uma vila entre colinas arborizadas, sob a luz alaranjada do entardecer',
  },
];
const nn = (i: number) => String(i + 1).padStart(2, '0');

const titulo = 'Alpine Refresh · Respire fundo. O mundo é seu.';
const descricao =
  'Alpine Refresh: um refresco nascido entre montanhas, água cristalina e o silêncio da natureza. Descubra o frescor de desacelerar.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Brand',
  name: MARCA.nome,
  slogan: 'Respire fundo. O mundo é seu.',
  description: descricao,
  logo: `${IMG}/macico-1200.webp`,
};
---

<Base title={titulo} description={descricao}>
  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:image" content={`${IMG}/topo-1200.webp`} />
    <meta name="theme-color" content="#92b5d1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Instrument+Sans:wght@400;500;600&display=swap"
    />
    <link rel="preload" as="image" href={`${IMG}/topo-2400.webp`} imagesrcset={`${IMG}/topo-1200.webp 1200w, ${IMG}/topo-2400.webp 2400w`} imagesizes="100vw" fetchpriority="high" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.documentElement.classList.add('anda');
    </script>
  </Fragment>

  <div class="ar">
    <a class="pular" href="#origem">Pular para o conteúdo</a>

    <header class="topo" data-topo data-tom="claro">
      <a class="marca" href="#inicio" aria-label="Alpine Refresh, voltar ao início">
        <span class="marca-a">Alpine</span><span class="marca-r">Refresh</span>
      </a>
      <nav class="nav" aria-label="Seções">
        <ul id="menu" data-menu>
          {NAV.map((n) => <li><a href={`#${n.id}`}>{n.t}</a></li>)}
        </ul>
      </nav>
      <button class="menu-bt" type="button" aria-expanded="false" aria-controls="menu" data-menu-bt>
        <span class="menu-bt-txt">Menu</span>
        <span class="menu-bt-traco" aria-hidden="true"></span>
      </button>
    </header>

    <main>
      {/* ═════════ 01 · A montanha de manhã ═════════ */}
      <section class="cena heroi" id="inicio" data-cena="heroi" data-tom="claro">
        <div class="palco">
          <img
            class="h-ceu"
            src={`${IMG}/topo-2400.webp`}
            srcset={`${IMG}/topo-1200.webp 1200w, ${IMG}/topo-2400.webp 2400w`}
            sizes="100vw" width="2400" height="1600"
            alt="Pico nevado sob céu azul, com a base escondida por um mar de nuvens"
            fetchpriority="high" decoding="async"
          />
          <div class="h-texto">
            <h1>Respire fundo.<br /><em>O mundo é seu.</em></h1>
            <p>Descubra o frescor de desacelerar, apreciar o caminho e encontrar novos horizontes.</p>
          </div>
          <img
            class="h-macico"
            src={`${IMG}/macico-2400.webp`}
            srcset={`${IMG}/macico-1200.webp 1200w, ${IMG}/macico-2400.webp 2400w`}
            sizes="(max-width: 760px) 200vw, 112vw" width="2400" height="1470"
            alt="" decoding="async"
          />
          <div class="h-nevoa" aria-hidden="true"></div>
          <div class="h-veu" aria-hidden="true"></div>
          <a class="descer" href="#origem">
            <span>Explore</span>
            <span class="descer-fio" aria-hidden="true"></span>
          </a>
        </div>
      </section>

      {/* ═════════ 02 · Origem: o lago ═════════ */}
      <section class="cena origem" id="origem" data-cena="origem" data-tom="claro">
        <div class="palco">
          <p class="o-rotulo" aria-hidden="true">Origem</p>
          <div class="o-janela">
          <img
            class="o-foto"
            src={`${IMG}/lago-2400.webp`}
            srcset={`${IMG}/lago-1200.webp 1200w, ${IMG}/lago-2400.webp 2400w`}
            sizes="100vw" width="2400" height="1600"
            alt="Lago de águas calmas diante de uma cordilheira com os picos iluminados pelo sol do fim de tarde"
            loading="lazy" decoding="async"
          />
          </div>
          <div class="o-sombra" aria-hidden="true"></div>
          <div class="o-sombra2" aria-hidden="true"></div>
          <div class="o-texto">
            <p class="rotulo">Origem</p>
            <h2>Tudo começa onde o mundo <em>desacelera.</em></h2>
            <p class="o-lead">Entre montanhas, água cristalina e o silêncio da natureza, redescubra o prazer das coisas simples.</p>
          </div>
          <div class="o-texto2">
            <p class="o-frase">Aqui o tempo tem <em>outra medida.</em></p>
            <p class="o-sub">O vento desenha a superfície do lago, a luz desce devagar pelas encostas e cada respiração parece um pouco mais funda.</p>
          </div>
        </div>
      </section>

      {/* ═════════ 03 · O refresco ═════════ */}
      <section class="cena refresco" id="refresco" data-cena="refresco" data-tom="escuro">
        <div class="palco">
          <div class="r-foto">
            <img
              src={`${IMG}/garrafa-1672.webp`}
              srcset={`${IMG}/garrafa-900.webp 900w, ${IMG}/garrafa-1672.webp 1672w`}
              sizes="100vw" width="1672" height="941"
              alt="Garrafa transparente coberta de gotas, apoiada numa rocha à beira de um lago azul entre montanhas e pinheiros"
              loading="lazy" decoding="async"
            />
          </div>
          <div class="r-conteudo">
            <div class="r-cab">
              <p class="rotulo">O refresco</p>
              <h2>O sabor que <em>te acompanha.</em></h2>
              <p class="r-lead">Seja no topo da montanha ou no fim de uma trilha, um bom refresco transforma pequenos momentos em grandes lembranças.</p>
            </div>
            <div class="r-itens">
              <span class="r-linha" aria-hidden="true"></span>
              <ul class="atributos">
                {
                  ATRIBUTOS.map((a) => (
                    <li>
                      <svg viewBox="0 0 24 24" aria-hidden="true" set:html={a.icone} />
                      <span>{a.t}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </section>

      {/* ═════════ 04 · Momentos: quatro destinos ═════════ */}
      <section class="cena momentos" id="momentos" data-cena="momentos" data-tom="escuro">
        <div class="palco m-palco">
          <div class="m-fundos" aria-hidden="true">
            {DESTINOS.map((d) => <img class="m-fundo" src={`${IMG}/${d.fundo}.webp`} width="1200" height="800" alt="" loading="lazy" decoding="async" />)}
          </div>
          <div class="m-veu" aria-hidden="true"></div>

          <div class="m-cab">
            <p class="rotulo">Momentos</p>
            <h2>Alguns momentos merecem ser vividos <em>sem pressa.</em></h2>
            <p class="m-lead">Desconecte-se da rotina, encontre seu próprio caminho e aproveite cada instante.</p>
          </div>

          <div class="m-destinos">
            {
              DESTINOS.map((d, i) => (
                <article class="m-dest" aria-label={`Destino ${nn(i)}: ${d.nome}`}>
                  <div class="m-dest-txt">
                    <p class="m-dest-rot"><span>Destino {nn(i)}</span><span class="m-hora">{d.hora}</span></p>
                    <h3>{d.nome}</h3>
                    <p class="m-dest-p">{d.texto}</p>
                  </div>
                  <figure class="m-foto">
                    <div class="m-foto-img">
                      <img src={`${IMG}/${d.quadro}.webp`} width="1000" height="1250" alt={d.alt} loading="lazy" decoding="async" />
                    </div>
                    <figcaption>
                      <span class="m-n">{nn(i)}</span>
                      <span class="m-nome">{d.nome}</span>
                      <span class="m-marcas" aria-hidden="true">
                        {DESTINOS.map((_, j) => <i class:list={[{ on: j === i }]} />)}
                      </span>
                    </figcaption>
                  </figure>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      {/* ═════════ 05 · Horizonte (o rodapé sobe por cima, a cena fica parada) ═════════ */}
      <section class="cena horizonte" id="horizonte" data-cena="horizonte" data-tom="escuro">
        <div class="palco">
          <div class="z-ceu" aria-hidden="true"></div>
          <div class="z-sol" aria-hidden="true"></div>
          <div class="z-noite" aria-hidden="true"></div>
          <div class="z-macico" style={`--mascara: url(${IMG}/macico-1200.webp)`}>
            <img src={`${IMG}/macico-2400.webp`}
              srcset={`${IMG}/macico-1200.webp 1200w, ${IMG}/macico-2400.webp 2400w`}
              sizes="(max-width: 760px) 230vw, 100vw" width="2400" height="1470"
              alt="Maciço nevado com os cumes rosados pela luz do entardecer" loading="lazy" decoding="async" />
            <div class="z-brilho" aria-hidden="true"></div>
          </div>
          <div class="z-chao" aria-hidden="true"></div>
          <div class="z-texto">
            <h2>Encontre seu próximo <em>horizonte.</em></h2>
            <p>A natureza está lá fora. O próximo capítulo começa quando você decide ir.</p>
            <a class="z-voltar" href="#inicio">
              <span>Recomeçar a subida</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6" /></svg>
            </a>
          </div>
        </div>
        <div class="z-espaco" aria-hidden="true"></div>

        <footer class="rodape" role="contentinfo">
          <div class="f-linha">
            <a class="marca" href="#inicio" aria-label="Alpine Refresh, voltar ao início">
              <span class="marca-a">Alpine</span><span class="marca-r">Refresh</span>
            </a>
            <nav aria-label="Navegação do rodapé">
              <ul>
                {NAV.map((n) => <li><a href={`#${n.id}`}>{n.t}</a></li>)}
              </ul>
            </nav>
          </div>
          <div class="f-creditos">
            <p>Alpine Refresh é uma marca fictícia, criada como estudo de portfólio.</p>
            <p>Fotos: Freepik, Ben Kupke (Unsplash) e Ana Maria Antonenco (Pexels) · Projeto e código: <a href={import.meta.env.BASE_URL}>Igor Fronza</a></p>
          </div>
        </footer>
      </section>
    </main>
  </div>
</Base>

<style is:global>
  .ar {
    --gelo: #f3f5f2;
    --ceu: #92b5d1;
    --noite: #0f2230;
    --fundo: #0d1a24;
    --pinho-fundo: #10221d;
    --ciano: #6fd3e3;
    --claro: #f6f8f7;
    --serif: 'Instrument Serif', 'Times New Roman', serif;
    --sans: 'Instrument Sans', system-ui, sans-serif;
    --margem: clamp(1rem, 5vw, 5.5rem);
    --suave: cubic-bezier(0.22, 0.61, 0.21, 1);
    /* quanto de rolagem dura cada fade cruzado entre cenas */
    --fade: 80svh;

    font-family: var(--sans);
    color: var(--noite);
    background: var(--fundo);
    overflow-x: clip;
  }
  body:has(.ar) { background: var(--fundo); }
  html:has(.ar) { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html:has(.ar) { scroll-behavior: auto; } }

  .ar ::selection { background: var(--ciano); color: var(--noite); }
  .ar :focus-visible { outline: 2px solid var(--ciano); outline-offset: 4px; border-radius: 2px; }
  .ar img { display: block; max-width: none; }
  .ar h1, .ar h2, .ar h3 {
    font-family: var(--serif);
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 0.98;
    text-wrap: balance;
  }
  .ar h1 em, .ar h2 em, .ar p em { font-style: italic; }
  .ar p { text-wrap: pretty; }
  .ar .rotulo {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--ciano);
    margin: 0 0 1.6rem;
  }
  .ar .rotulo::before { content: ''; width: 2.25rem; height: 1px; background: currentColor; opacity: 0.6; }

  .pular {
    position: fixed; left: 1rem; top: -4rem; z-index: 60;
    background: var(--noite); color: #fff; padding: 0.75rem 1rem; font-size: 0.875rem;
  }
  .pular:focus { top: 1rem; }

  /* ── topo ── */
  .topo {
    position: fixed; inset: 0 0 auto; z-index: 50;
    display: flex; align-items: center; justify-content: space-between;
    padding: 1.4rem var(--margem);
    color: var(--noite);
    transition: color 0.5s var(--suave), transform 0.6s var(--suave);
  }
  .topo[data-tom='escuro'] { color: var(--claro); }
  .topo.some { transform: translateY(-110%); }
  .marca { display: inline-flex; align-items: baseline; gap: 0.45rem; color: inherit; text-decoration: none; }
  .marca-a { font-weight: 600; font-size: 0.82rem; letter-spacing: 0.34em; text-transform: uppercase; }
  .marca-r { font-family: var(--serif); font-style: italic; font-size: 1.3rem; line-height: 1; }
  .nav ul { display: flex; gap: clamp(1.25rem, 2.6vw, 2.6rem); list-style: none; margin: 0; padding: 0; }
  .nav a, .rodape nav a {
    color: inherit; text-decoration: none; font-size: 0.875rem; letter-spacing: 0.02em;
    position: relative; padding: 0.6rem 0;
  }
  .nav a::after, .rodape nav a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0.3rem; height: 1px;
    background: currentColor; transform: scaleX(0); transform-origin: right;
    transition: transform 0.45s var(--suave);
  }
  .nav a:hover::after, .rodape nav a:hover::after { transform: scaleX(1); transform-origin: left; }
  .menu-bt { display: none; }

  /* ── cenas: palco fixo e fade cruzado com a anterior ── */
  .cena { position: relative; }
  .palco { position: sticky; top: 0; height: 100svh; overflow: hidden; background: var(--fundo); }
  .anda .cena + .cena { margin-top: calc(-100svh - var(--fade)); scroll-margin-top: calc(-1 * var(--fade)); }
  .anda .cena + .cena > .palco { opacity: 0; visibility: hidden; }
  /* altura = a tela + o fade de entrada + o trecho de conteúdo + o fade de saída */
  .anda .heroi { height: calc(200svh + var(--fade)); }
  .anda .origem { height: calc(300svh + 2 * var(--fade)); }
  .anda .refresco { height: calc(240svh + 2 * var(--fade)); }
  .anda .momentos { height: calc(370svh + 2 * var(--fade)); }
  .anda .z-espaco { height: calc(90svh + var(--fade)); }

  /* ── 01 · heroi ── */
  .heroi .palco { background: var(--ceu); }
  .h-ceu {
    position: absolute; left: 0; width: 100%;
    top: 16%; height: 84%;
    object-fit: cover; object-position: 50% 30%;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 22%);
    mask-image: linear-gradient(to bottom, transparent, #000 22%);
    transform-origin: 50% 70%;
  }
  .h-texto {
    position: absolute; left: 0; right: 0; top: 13svh;
    padding: 0 var(--margem);
    text-align: center;
  }
  .h-texto h1 { font-size: clamp(3rem, 7.6vw, 7.4rem); margin: 0; }
  .h-texto p {
    max-width: 33rem; margin: 1.4rem auto 0;
    font-size: clamp(1rem, 1.25vw, 1.125rem); line-height: 1.55;
    color: rgb(15 34 48 / 0.82);
  }
  .h-macico {
    --de: 74%; --ate: 8%;
    position: absolute; bottom: 0; left: 50%;
    width: 112vw; height: auto; margin-left: -56vw;
    transform: translate3d(0, var(--ate), 0);
    filter: saturate(0.82) brightness(0.97);
  }
  .h-nevoa {
    position: absolute; inset: auto 0 0; height: 34%;
    background: linear-gradient(to bottom, rgb(243 245 242 / 0), rgb(243 245 242 / 0.7) 55%, var(--gelo));
  }
  .h-veu { position: absolute; inset: 0; background: var(--gelo); opacity: 0; pointer-events: none; }
  .descer {
    position: absolute; left: var(--margem); bottom: 2rem;
    display: flex; align-items: center; gap: 1rem;
    color: var(--noite); text-decoration: none;
    font-size: 0.75rem; letter-spacing: 0.24em; text-transform: uppercase;
    padding: 0.5rem 0;
  }
  .descer-fio { position: relative; width: 4.5rem; height: 1px; background: rgb(15 34 48 / 0.25); overflow: hidden; }
  .descer-fio::after {
    content: ''; position: absolute; inset: 0; background: var(--noite);
    transform: translateX(-100%);
    animation: fio 2.6s var(--suave) infinite;
  }
  @keyframes fio { 0% { transform: translateX(-100%); } 55% { transform: translateX(0); } 100% { transform: translateX(101%); } }

  /* entrada da tipografia: curta, para não segurar a leitura */
  .anda .h-texto h1, .anda .h-texto p { animation: entra 1.1s var(--suave) both; }
  .anda .h-texto p { animation-delay: 0.25s; }
  .anda .descer { animation: entra 1s 0.6s var(--suave) both; }
