  .js .flo .heroi-foto img { transform: scale(1.12); animation: assenta-foto 7s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  @keyframes assenta-foto { to { transform: scale(1); } }
  /* véu: roxo profundo à esquerda para o texto, foto limpa à direita */
