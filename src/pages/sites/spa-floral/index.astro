  }
  .flo .topo-menu span { width: 18px; height: 2px; border-radius: 2px; background: currentColor; transition: transform .3s var(--e); }
  .flo .menu-aberto .topo-menu span:first-child { transform: translateY(4px) rotate(45deg); }
  .flo .menu-aberto .topo-menu span:last-child { transform: translateY(-4px) rotate(-45deg); }
  .flo .menu-movel { padding: 0.5rem var(--margem) 1.5rem; border-top: 1px solid var(--fio); background: var(--branco); }
  .flo .menu-movel a:not(.botao) { display: block; padding: 0.9rem 0; border-bottom: 1px solid var(--fio); font-size: 1.1rem; font-weight: 500; text-decoration: none; }
  .flo .menu-movel a[aria-current] { color: var(--roxo); font-weight: 600; }
  .flo .menu-movel .botao { width: 100%; margin-top: 1.2rem; }
  @media (max-width: 1239px) {
    .flo .nav { display: none; }
    .flo .topo-menu { display: inline-flex; }
    .flo .topo-in { height: 68px; gap: 0.75rem; }
  }
  @media (max-width: 479px) { .flo .botao-topo { display: none; } }

  /* ─────────────── início ─────────────── */
  .flo .heroi {
    position: relative; overflow: hidden; isolation: isolate;
    min-height: max(700px, min(100svh, 940px));
    display: flex; align-items: center;
    background: #4A1266; color: var(--branco);
  }
  .flo .heroi-foto { position: absolute; inset: 0; z-index: -2; overflow: hidden; }
  .flo .heroi-foto picture { position: absolute; inset: 0; }
