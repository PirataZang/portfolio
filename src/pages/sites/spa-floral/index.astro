      linear-gradient(180deg, rgba(40, 8, 58, 0.55) 0%, rgba(40, 8, 58, 0) 20%),
      linear-gradient(90deg, rgba(58, 12, 84, 0.96) 0%, rgba(110, 31, 149, 0.86) 30%, rgba(136, 41, 179, 0.42) 52%, rgba(136, 41, 179, 0) 70%),
