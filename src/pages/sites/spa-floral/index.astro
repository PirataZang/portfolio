    width: 100%; max-width: calc(var(--largura) + 2 * var(--margem)); margin: 0 auto;
    padding: 120px var(--margem) 150px;
  }
  .flo .heroi-texto { position: relative; z-index: 3; max-width: 36rem; display: grid; gap: 1.6rem; }
  .flo .heroi h1 { font-size: clamp(3rem, 6.4vw, 6rem); line-height: 0.98; font-weight: 500; letter-spacing: -0.03em; }
  .flo .heroi-lide { font-size: 1.15rem; line-height: 1.65; color: #F6ECFB; max-width: 30rem; }
  .flo .heroi-acoes { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.8rem; margin-top: 0.4rem; }
  .flo .link-claro {
    color: var(--branco); font-weight: 600; text-decoration: none;
    background: linear-gradient(var(--lima), var(--lima)) 0 100% / 100% 2px no-repeat; padding-bottom: 4px;
    transition: background-size .35s var(--e);
  }
  .flo .link-claro:hover { background-size: 40% 2px; }
  .flo .heroi :focus-visible { outline-color: var(--lima); }
  .flo .heroi-hora { display: flex; align-items: center; gap: 0.55rem; font-size: 0.93rem; color: rgba(255, 255, 255, 0.78); }
  .flo .heroi-hora i { color: var(--lima); }

  /* ── entrada lenta: palavras saem de um desfoque, uma de cada vez ── */
  .flo .palavra { display: inline-block; }
