  .flo h2 { font-size: clamp(2.1rem, 4vw, 3.2rem); line-height: 1.1; }
  .flo .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .flo .pular { position: fixed; left: 16px; top: -64px; z-index: 80; padding: 10px 16px; border-radius: 12px; background: var(--roxo); color: var(--branco); }
