  .flo .marca-flor { width: 34px; height: 34px; fill: var(--roxo); }
  .flo .marca-flor .miolo { fill: var(--lima); }
  .flo .nav ul { display: flex; gap: 0.1rem; }
  .flo .nav a {
    position: relative; display: block; padding: 0.5rem 0.75rem; border-radius: 999px;
    font-size: 0.95rem; font-weight: 500; text-decoration: none; color: var(--tinta-2);
    transition: color .2s ease, background-color .2s ease;
  }
  .flo .nav a:hover { color: var(--roxo); background: var(--nevoa); }
  .flo .nav a[aria-current] { color: var(--roxo); background: var(--lilas-claro); font-weight: 600; }
  .flo .botao-topo { min-height: 44px; padding: 0 1.2rem; }
  /* sobre a foto: tudo em branco */
  .flo .topo[data-estado='sobre-foto']:not(.menu-aberto) .marca { color: var(--branco); }
