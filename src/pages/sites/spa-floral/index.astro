  .flo .topo[data-estado='sobre-foto']:not(.menu-aberto) .nav a:hover,
  .flo .topo[data-estado='sobre-foto']:not(.menu-aberto) .nav a[aria-current] { color: var(--branco); background: rgba(255, 255, 255, 0.14); }
  .flo .topo[data-estado='sobre-foto']:not(.menu-aberto) .botao-topo { background: var(--branco); color: var(--roxo); }
  .flo .topo[data-estado='sobre-foto']:not(.menu-aberto) .topo-menu { background: rgba(255, 255, 255, 0.16); color: var(--branco); }
  .flo .topo[data-estado='sobre-foto'] :focus-visible { outline-color: var(--branco); }
  .flo .topo-menu {
    display: none; width: 44px; height: 44px; border: 0; border-radius: 999px; background: var(--nevoa); color: var(--roxo);
