  .flo :focus-visible { outline: 2px solid var(--roxo); outline-offset: 3px; border-radius: 6px; }
  .flo h1, .flo h2, .flo h3, .flo p, .flo ul, .flo ol, .flo figure { margin: 0; padding: 0; }
  .flo ul, .flo ol { list-style: none; }
