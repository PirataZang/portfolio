  @media (prefers-reduced-motion: reduce) {
    .js .flo [data-fade], .js .flo .entra { opacity: 1; transition: none; animation: none; }
  }

  /* ─────────────── botões ─────────────── */
  .flo .botao {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem;
    min-height: 50px; padding: 0 1.5rem; border: 1.5px solid transparent; border-radius: 999px;
    font: 600 1rem/1 var(--f); text-decoration: none; cursor: pointer; white-space: nowrap;
