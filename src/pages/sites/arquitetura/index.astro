    }
    .cena { height: 120vh; }
    .svg-planta [data-risca] { stroke-dashoffset: 0 !important; }
  }
</style>

<script>
  /*
    Movimento pelo Motion One. Antes esta página usava `animation-timeline`
    nativo: mais barato, mas só existe em navegador recente e não deixa
    sequenciar a planta camada por camada como uma prancha de verdade.

    Se o Motion não carregar, o `catch` devolve o conteúdo visível — desenho é
    enfeite, texto é o produto.
  */
  const reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const SAIDA = [0.22, 0.61, 0.36, 1] as const;
  const raiz = document.documentElement;

  /* ---------------- formulário ---------------- */

  /* site estático não tem para onde postar, e cliente de obra responde no zap */
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  form?.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const d = new FormData(form);
    const v = (k: string) => String(d.get(k) ?? '').trim();
    const linhas = [
      `Olá! Sou ${v('nome')} e quero um diagnóstico.`,
      '',
      `Preciso de: ${v('tipo')}`,
      v('area') && `Área aproximada: ${v('area')} m²`,
      `Terreno: ${v('terreno')}`,
      `Começo previsto: ${v('prazo')}`,
      v('msg') && `O que a obra precisa resolver: ${v('msg')}`,
      '',
      `Meu WhatsApp: ${v('fone')}`,
    ].filter(Boolean);
    window.open(
      `https://wa.me/${form.dataset.zap}?text=${encodeURIComponent(linhas.join('\n'))}`,
      '_blank',
      'noopener',
    );
  });

  /* cena 3D — só monta quando a seção entra na tela e nunca no meio da rolagem.
     `reduz` vem declarado no topo deste script. */
  type Etapa = { em: number; t: string; d: string; det: string };
  const ilha = document.querySelector<HTMLElement>('[data-etapas]');
  const ETAPAS: Etapa[] = ilha ? JSON.parse(ilha.textContent || '[]') : [];

  /* a montagem termina antes do fim da seção: o resto do scroll segura o resultado */
  const FIM = 0.82;

  async function ligarCena() {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-canvas]');
    const secao = document.querySelector<HTMLElement>('[data-cena]');
    if (!canvas || !secao || !ETAPAS.length) return;

    const tEl = document.querySelector<HTMLElement>('[data-etapa-t]');
    const dEl = document.querySelector<HTMLElement>('[data-etapa-d]');
    const detEl = document.querySelector<HTMLElement>('[data-etapa-det]');
    const passos = [...document.querySelectorAll<HTMLElement>('[data-passo]')];

    let etapa = -1;
    const mostrar = (p: number) => {
      let i = 0;
      while (i + 1 < ETAPAS.length && ETAPAS[i + 1].em <= p) i++;
      if (i === etapa) return;
      etapa = i;
      if (tEl) tEl.textContent = ETAPAS[i].t;
      if (dEl) dEl.textContent = ETAPAS[i].d;
      if (detEl) detEl.textContent = ETAPAS[i].det;
      passos.forEach((el, n) => el.classList.toggle('ativo', n <= i));
    };

    const { criarCasa } = await import('../../../scripts/casa-3d');
    const { scroll } = await import('motion');

    let cena: ReturnType<typeof criarCasa> = null;
    let alvo = 0;
    let atual = 0;
    let visivel = false;
    let rodando = false;
    let montando = false;

    const laco = () => {
      if (!visivel) { rodando = false; return; }
      const dif = alvo - atual;
      if (cena && Math.abs(dif) > 0.0004) {
        atual += dif * 0.08;
        const local = Math.min(1, atual / FIM);
        cena.atualizar(local);
        cena.render();
        mostrar(local);
      }
      requestAnimationFrame(laco);
    };

    const montar = () => {
      if (cena || montando) return;
      montando = true;
      const fazer = () => {
        cena = criarCasa(canvas);
        montando = false;
        if (!cena) return;
        canvas.classList.add('pronto');
        addEventListener('resize', () => cena?.redimensionar());
        if (reduz) {
          cena.atualizar(1);
          cena.render();
          mostrar(1);
        } else if (!rodando) {
          rodando = true;
          requestAnimationFrame(laco);
        }
      };
      // criar contexto WebGL trava o quadro: nunca no meio de uma rolagem
      if ('requestIdleCallback' in window) requestIdleCallback(fazer, { timeout: 600 });
      else setTimeout(fazer, 0);
    };

    new IntersectionObserver(
      ([e]) => {
        visivel = e.isIntersecting;
        if (!visivel) return;
        montar();
        if (cena && !reduz && !rodando) { rodando = true; requestAnimationFrame(laco); }
      },
      { rootMargin: '300px' },
    ).observe(secao);

    if (!reduz) scroll((p: number) => { alvo = p; }, { target: secao, offset: ['start start', 'end end'] });
  }

  if ('requestIdleCallback' in window) requestIdleCallback(() => ligarCena());
  else setTimeout(ligarCena, 200);

  if ('requestIdleCallback' in window) requestIdleCallback(() => ligarCena());
  else setTimeout(ligarCena, 200);

  /* ---------------- movimento ---------------- */

  async function ligarMovimento() {
    if (reduz) return;
    const { animate, inView, scroll, stagger } = await import('motion');

    /* inView re-dispara a cada reentrada; revelação é estreia */
    const umaVez = (
      el: Element,
      efeito: () => void,
      opcoes?: Parameters<typeof inView>[2],
    ) => {
      let parar = () => {};
      parar = inView(el, () => { efeito(); parar(); }, opcoes);
    };

    /* 1. o fio de prumo desce com a página */
    const prumo = document.querySelector<HTMLElement>('[data-prumo]');
    if (prumo) scroll(animate(prumo, { scaleY: [0, 1] }, { ease: 'linear' }));

    /* 2. capa: as linhas do título sobem escalonadas */
    animate(
      document.querySelectorAll('[data-linha]'),
      { opacity: [0, 1], y: [24, 0] },
      { duration: 0.8, delay: stagger(0.09), ease: SAIDA },
    );
    animate(
      document.querySelectorAll('.capa [data-anima]'),
      { opacity: [0, 1], y: [16, 0] },
      { duration: 0.7, delay: stagger(0.09, { startDelay: 0.28 }), ease: SAIDA },
    );

    /*
      3. a elevação lateral se desenha. Cada traço vira um tracejado do
      comprimento do próprio traço, e o deslocamento vai a zero: é o desenho
      saindo da caneta. `getTotalLength` só existe em geometria, então rect e
      polyline entram por opacidade.
    */
    const desenho = document.querySelector<HTMLElement>('[data-desenha]');
    if (desenho) {
      const tracos = [...desenho.querySelectorAll<SVGGeometryElement>('line, polyline, path')];
      for (const t of tracos) {
        const c = t.getTotalLength?.();
        if (!c) continue;
        t.style.strokeDasharray = String(c);
        t.style.strokeDashoffset = String(c);
      }
      const massas = desenho.querySelectorAll('rect, text');
      (massas as NodeListOf<HTMLElement>).forEach((m) => (m.style.opacity = '0'));
      umaVez(
        desenho,
        () => {
          animate(tracos, { strokeDashoffset: 0 }, { duration: 1.4, delay: stagger(0.02), ease: SAIDA });
          animate(massas, { opacity: [0, 1] }, { duration: 0.6, delay: stagger(0.03, { startDelay: 0.5 }), ease: SAIDA });
        },
        { amount: 0.3 },
      );
    }

    /* 4. revelação em cascata, agrupada por pai para o stagger correr entre irmãos */
    const grupos = new Map<Element, HTMLElement[]>();
    for (const el of document.querySelectorAll<HTMLElement>('[data-anima]')) {
      if (el.closest('.capa')) continue;
      const pai = el.parentElement!;
      grupos.set(pai, [...(grupos.get(pai) ?? []), el]);
    }
    for (const irmaos of grupos.values()) {
      umaVez(
        irmaos[0],
        () =>
          animate(
            irmaos,
            { opacity: [0, 1], y: [20, 0] },
            { duration: 0.65, delay: stagger(0.07), ease: SAIDA },
          ),
        { amount: 0.1, margin: '0px 0px -8% 0px' },
      );
    }

    /* 5. os números contam ao entrar na tela */
    document.querySelectorAll<HTMLElement>('[data-conta-ate]').forEach((el) => {
      const fim = Number(el.dataset.contaAte);
      umaVez(
        el,
        () =>
          animate(0, fim, {
            duration: 1.2,
            ease: SAIDA,
            onUpdate: (n) => (el.textContent = String(Math.round(n))),
          }),
        { amount: 0.8 },
      );
    });

    /* 6. as seções escuras se abrem de cima para baixo */
    document.querySelectorAll<HTMLElement>('[data-escura]').forEach((s) => {
      umaVez(
        s,
        () =>
          animate(
            s,
            { clipPath: ['inset(0 0 100% 0)', 'inset(0 0 0% 0)'] },
            { duration: 0.8, ease: SAIDA },
          ),
        { amount: 0.04, margin: '0px 0px -12% 0px' },
      );
    });

    /*
      7. A PRANCHA. A planta se levanta na ordem em que um desenhista desenha,
      e o painel de camadas acende junto. Cada `data-risca` já vem com
      pathLength="1" do markup, então tracejado e deslocamento valem 1 e a
      conta é a mesma para um traço de 30 cm e um de 10 m.
    */
    const palco = document.querySelector<HTMLElement>('.prancha-palco');
    if (palco) {
      const camadas = [...palco.querySelectorAll<HTMLElement>('[data-camada]')];
      const g = (s: string) => palco.querySelectorAll(s);
      const riscas = (s: string) => {
        const els = [...palco.querySelectorAll<SVGGeometryElement>(s)];
        els.forEach((e) => {
          e.style.strokeDasharray = '1';
          e.style.strokeDashoffset = '1';
        });
        return els;
      };

      const paredes = riscas('.pl-parede [data-risca]');
      const esquadrias = riscas('.pl-janela [data-risca], .pl-porta [data-risca]');
      const camadaFixa = [g('.pl-piso'), g('.pl-jan-caixa'), g('.pl-cota'), g('.pl-nome'), g('.pl-info')];
      camadaFixa.forEach((lista) =>
        (lista as NodeListOf<HTMLElement>).forEach((e) => (e.style.opacity = '0')),
      );

      const acende = (i: number) => camadas[i]?.classList.add('ativa');

      umaVez(
        palco,
        async () => {
          /* 1 · eixos e piso */
          acende(0);
          await animate(g('.pl-piso'), { opacity: [0, 1] }, { duration: 0.5, ease: SAIDA }).finished;
          /* 2 · alvenaria, traço por traço */
          acende(1);
          await animate(paredes, { strokeDashoffset: 0 }, { duration: 0.9, delay: stagger(0.02), ease: SAIDA }).finished;
          /* 3 · esquadrias: caixa da janela e depois o vidro e a folha */
          acende(2);
          animate(g('.pl-jan-caixa'), { opacity: [0, 1] }, { duration: 0.4, ease: SAIDA });
          await animate(esquadrias, { strokeDashoffset: 0 }, { duration: 0.7, delay: stagger(0.03), ease: SAIDA }).finished;
          /* 4 · cotas */
          acende(3);
          await animate(g('.pl-cota'), { opacity: [0, 1] }, { duration: 0.5, ease: SAIDA }).finished;
          /* 5 · textos, áreas, norte e escala */
          acende(4);
          animate([...g('.pl-nome'), ...g('.pl-info')], { opacity: [0, 1] }, { duration: 0.6, delay: stagger(0.12), ease: SAIDA });
        },
        { amount: 0.25 },
      );
    }

    /* 8. o carimbo de folha troca conforme a seção entra */
    const cod = document.querySelector<HTMLElement>('[data-folha-cod]');
    const nome = document.querySelector<HTMLElement>('[data-folha-nome]');
    if (cod && nome) {
      /* este inView tem que continuar disparando: é estado, não estreia */
      document.querySelectorAll<HTMLElement>('[data-folha]').forEach((s) => {
        inView(
          s,
          () => {
            cod.textContent = s.dataset.folha!;
            nome.textContent = s.dataset.folhaT!;
            animate(
              [cod, nome],
              { opacity: [0, 1], y: [-4, 0] },
              { duration: 0.3, ease: SAIDA },
            );
          },
          { amount: 0.2 },
        );
      });
    }
  }

  const revelarTudo = () => raiz.classList.remove('anima-on');
  const socorro = setTimeout(revelarTudo, 3000);
  ligarMovimento()
    .catch(revelarTudo)
    .finally(() => clearTimeout(socorro));
  if (reduz) revelarTudo();
</script>
