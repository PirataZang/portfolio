/* ---------- geração do SVG da planta a partir do módulo compartilhado ---------- */
const S = 100;                                   // px por metro
const px = (x: number) => +((x - LIM.x1) * S).toFixed(1);
const py = (z: number) => +((z - LIM.z1) * S).toFixed(1);
const W = LARG * S;
const Hp = PROF * S;

const todos = PAREDES.flatMap((p) => blocos(p));
const cheias = todos.filter((b) => b.y0 === 0 && Math.abs(b.y1 - H) < 1e-6);
const peitoris = todos.filter((b) => b.y0 === 0 && b.y1 < H - 1e-6);   // janelas
const todosVaos = PAREDES.flatMap((p) => vaos(p));

/* porta: folha + arco de abertura, sempre girando para dentro da casa */
const portas = todosVaos.filter((v) => v.tipo === 'porta').map((v) => {
  const mx = (v.ax + v.bx) / 2;
  const mz = (v.az + v.bz) / 2;
  const s = -mx * v.nx - mz * v.nz >= 0 ? 1 : -1;
  const nx = v.nx * s;
  const nz = v.nz * s;
  const r = v.larg;
  const k = 0.5523 * r;
  const p0 = [v.ax + v.ux * r, v.az + v.uz * r];
  const p3 = [v.ax + nx * r, v.az + nz * r];
  const p1 = [p0[0] + nx * k, p0[1] + nz * k];
  const p2 = [p3[0] + v.ux * k, p3[1] + v.uz * k];
  return {
    folha: { x1: px(v.ax), y1: py(v.az), x2: px(p3[0]), y2: py(p3[1]) },
    arco: `M ${px(p0[0])} ${py(p0[1])} C ${px(p1[0])} ${py(p1[1])} ${px(p2[0])} ${py(p2[1])} ${px(p3[0])} ${py(p3[1])}`,
  };
});

const cotasH = [
  { a: LIM.x1, b: LIM.x2, z: LIM.z2, off: 72, txt: '10,40' },
  { a: -5.2, b: -1.8, z: LIM.z1, off: -46, txt: '3,40' },
  { a: -1.8, b: 0.8, z: LIM.z1, off: -46, txt: '2,60' },
  { a: 0.8, b: 2.4, z: LIM.z1, off: -46, txt: '1,60' },
  { a: 2.4, b: 5.2, z: LIM.z1, off: -46, txt: '2,80' },
];
const cotasV = [
  { a: LIM.z1, b: LIM.z2, x: LIM.x1, off: -72, txt: '8,00' },
  { a: LIM.z1, b: -0.2, x: LIM.x2, off: 46, txt: '3,80' },
  { a: -0.2, b: 1.0, x: LIM.x2, off: 46, txt: '1,20' },
  { a: 1.0, b: LIM.z2, x: LIM.x2, off: 46, txt: '3,00' },
];

const comodos = COMODOS.map((c) => ({
  ...c,
  cx: px((c.x1 + c.x2) / 2),
  cy: py((c.z1 + c.z2) / 2),
  a: m2(area(c)),
}));

const AREA_UTIL_TXT = m2(COMODOS.reduce((s, c) => s + area(c), 0));

/*
  Elevação lateral — sai da parede oeste (PAREDES[3]) e das constantes de
  cobertura. É a mesma casa da planta e do 3D, vista de lado.
*/
const E = 56;                                   // px por metro
const TOPO = Y_LAJE + SUBIDA + 0.35;
const ex = (m: number) => +(m * E).toFixed(1);
const ey = (m: number) => +((TOPO - m) * E).toFixed(1);

const elevVaos = vaos(PAREDES[3]).map((v) => ({
  x: ex(v.at), l: ex(v.larg), y: ey(v.y1), a: ex(v.y1 - v.y0),
}));
const elevTelhado = [
  [ex(-BEIRAL), ey(Y_LAJE)],
  [ex(PROF / 2), ey(Y_LAJE + SUBIDA)],
  [ex(PROF + BEIRAL), ey(Y_LAJE)],
].map((c) => c.join(',')).join(' ');

const titulo = 'Arquitetura e Engenharia Civil em São Paulo | Projeto, Aprovação e Obra — PRUMO';
const descricao =
  'Escritório de arquitetura e engenharia civil em São Paulo. Projeto arquitetônico e estrutural, instalações, aprovação na prefeitura, orçamento analítico e gerenciamento de obra. Da planta ao habite-se.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['ProfessionalService', 'HomeAndConstructionBusiness'],
      '@id': `${EMPRESA.site}/#escritorio`,
      name: `${EMPRESA.nome} ${EMPRESA.sub}`,
      description: descricao,
      url: EMPRESA.site,
      telephone: EMPRESA.fone,
      email: EMPRESA.email,
      priceRange: 'R$$$',
      foundingDate: String(EMPRESA.desde),
      numberOfEmployees: { '@type': 'QuantitativeValue', value: EQUIPE.length + 2 },
      address: {
        '@type': 'PostalAddress',
        streetAddress: EMPRESA.rua,
        addressLocality: EMPRESA.cidade,
        addressRegion: EMPRESA.uf,
        postalCode: EMPRESA.cep,
        addressCountry: 'BR',
      },
      geo: { '@type': 'GeoCoordinates', latitude: EMPRESA.lat, longitude: EMPRESA.lon },
      openingHoursSpecification: [
        { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '18:00' },
      ],
      employee: EQUIPE.map((p) => ({ '@type': 'Person', name: p.n, jobTitle: p.c })),
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Serviços de arquitetura e engenharia',
        itemListElement: servicos.map((s) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: s.t, description: s.d },
        })),
      },
    },
    {
      '@type': 'ItemList',
      '@id': `${EMPRESA.site}/#acervo`,
      name: 'Obras projetadas e executadas',
      itemListElement: OBRAS.map((o, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'Residence',
          name: o.nome,
          description: `${o.tipo} · ${o.area} m² · ${o.sistema} · ${o.local}`,
        },
      })),
    },
    {
      '@type': 'FAQPage',
      '@id': `${EMPRESA.site}/#duvidas`,
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.p,
        acceptedAnswer: { '@type': 'Answer', text: f.r },
      })),
    },
  ],
};
---

<Base title={titulo} description={descricao}>
  <Fragment slot="head">
    <link rel="canonical" href={EMPRESA.site} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="geo.region" content="BR-SP" />
    <meta name="geo.placename" content="São Paulo" />
    <meta name="geo.position" content={`${EMPRESA.lat};${EMPRESA.lon}`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={EMPRESA.nome} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={EMPRESA.site} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {/* bloqueante e mínimo: esconde o que o Motion vai revelar, antes da primeira pintura */}
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.documentElement.classList.add('anima-on');
    </script>
  </Fragment>

  <div class="pr">
    <script type="application/json" data-etapas set:html={JSON.stringify(ETAPAS)}></script>

    <a class="pular" href="#conteudo">Pular para o conteúdo</a>

    {/* fio de prumo: o progresso da página medido como quem confere alinhamento */}
    <div class="prumo" aria-hidden="true"><span data-prumo></span></div>

    {/* carimbo de folha, fixo no canto — troca de número conforme a seção entra */}
    <p class="folha-atual" aria-hidden="true">
      <span data-folha-cod>ARQ-01</span><em data-folha-nome>Capa</em>
    </p>

    <header class="topo">
      <a class="marca" href={import.meta.env.BASE_URL}>
        <span class="marca-simbolo" aria-hidden="true"></span>
        <span class="marca-txt">{EMPRESA.nome}<small>{EMPRESA.sub}</small></span>
      </a>
      <nav class="topo-nav" aria-label="Seções">
        <a href="#projeto">Prancha</a>
        <a href="#obra">Obra</a>
        <a href="#acervo">Acervo</a>
        <a href="#servicos">Serviços</a>
        <a href="#investimento">Investimento</a>
        <a href="#duvidas">Dúvidas</a>
      </nav>
      <a class="btn btn-p btn-min" href="#contato">Pedir diagnóstico</a>
    </header>

    <main id="conteudo">
      {/* ═════════ ARQ-01 · CAPA ═════════ */}
      <section class="capa" data-folha="ARQ-01" data-folha-t="Capa">
        <div class="capa-grade">
          <div class="capa-txt">
            <h1>
              <span class="linha" data-linha>Da primeira linha</span>
              <span class="linha" data-linha>no papel <em>ao habite-se</em></span>
              <span class="linha" data-linha>na sua mão.</span>
            </h1>
            <p class="lead" data-anima>
              Projeto, aprovação, orçamento e execução no mesmo escritório, com o
              mesmo responsável técnico assinando do estudo preliminar à vistoria
              de entrega. Você acompanha por prancha, cronograma e medição.
            </p>
            <div class="capa-acoes" data-anima>
              <a class="btn btn-p btn-g" href="#contato">Quero um diagnóstico</a>
              <a class="btn btn-v btn-g" href="#projeto">Ver um projeto nascendo</a>
            </div>
            <ul class="selos" data-anima>
              <li>Executivo compatibilizado em BIM</li>
              <li>Aprovação e habite-se inclusos</li>
              <li>Medição semanal de obra</li>
            </ul>
          </div>

          <div class="capa-lado" aria-hidden="true">
            <div class="capa-desenho" data-desenha>
                <svg viewBox={`${ex(-BEIRAL) - 150} -18 ${ex(PROF + BEIRAL * 2) + 430} ${ey(0) + 96}`} class="svg-elev">
                  <polyline class="el-telha" points={elevTelhado} />
                  <rect class="el-laje" x={ex(-0.06)} y={ey(Y_LAJE)} width={ex(PROF + 0.12)} height={ex(Y_LAJE - H)} />
                  <rect class="el-parede" x="0" y={ey(H)} width={ex(PROF)} height={ex(H)} />
                  {elevVaos.map((v) => (
                    <>
                      <rect class="el-vao" x={v.x} y={v.y} width={v.l} height={v.a} />
                      <line class="el-vao-c" x1={v.x} y1={v.y + v.a / 2} x2={v.x + v.l} y2={v.y + v.a / 2} />
                    </>
                  ))}
                  <line class="el-solo" x1={ex(-BEIRAL) - 34} y1={ey(0)} x2={ex(PROF + BEIRAL) + 34} y2={ey(0)} />
                  {Array.from({ length: 19 }, (_, i) => (
                    <line class="el-hachura"
                          x1={ex(-BEIRAL) - 28 + i * 30} y1={ey(0)}
                          x2={ex(-BEIRAL) - 42 + i * 30} y2={ey(0) + 14} />
                  ))}
                  <g class="el-cota">
                    <line x1={ex(PROF) + 44} y1={ey(0)} x2={ex(PROF) + 44} y2={ey(Y_LAJE + SUBIDA)} />
                    <line class="el-ext" x1={ex(PROF)} y1={ey(0)} x2={ex(PROF) + 52} y2={ey(0)} />
                    <line class="el-ext" x1={ex(PROF / 2)} y1={ey(Y_LAJE + SUBIDA)} x2={ex(PROF) + 52} y2={ey(Y_LAJE + SUBIDA)} />
                    <text x={ex(PROF) + 36} y={ey((Y_LAJE + SUBIDA) / 2)}
                          transform={`rotate(-90 ${ex(PROF) + 36} ${ey((Y_LAJE + SUBIDA) / 2)})`}>4,79</text>
                  </g>
                  <g class="el-nota">
                    <line x1={ex(PROF / 2 + 1.1)} y1={ey(Y_LAJE + SUBIDA * 0.55)} x2={ex(PROF) + 70} y2={ey(Y_LAJE + SUBIDA + 0.45)} />
                    <text x={ex(PROF) + 76} y={ey(Y_LAJE + SUBIDA + 0.5)}>TELHA CERÂMICA · i=36 %</text>
                    <line x1={ex(0.5)} y1={ey(H + 0.1)} x2={ex(-BEIRAL) - 26} y2={ey(H + 0.9)} />
                    <text x={ex(-BEIRAL) - 32} y={ey(H + 0.95)} text-anchor="end">LAJE + CINTA</text>
                  </g>
                  <text class="el-titulo" x="0" y={ey(0) + 48}>ELEVAÇÃO LATERAL · ESC. 1:100</text>
                </svg>
            </div>

            <div class="carimbo">
              <div class="carimbo-l"><span>Projeto</span><b>Residência unifamiliar</b></div>
              <div class="carimbo-l"><span>Área</span><b>{m2(AREA_CONSTRUIDA)} m²</b></div>
              <div class="carimbo-l"><span>Escala</span><b>1:100</b></div>
              <div class="carimbo-l"><span>Prancha</span><b>ARQ-01 / 12</b></div>
              <div class="carimbo-l"><span>Resp. técnico</span><b>{EMPRESA.cau}</b></div>
            </div>
          </div>
        </div>

        <p class="rolar" aria-hidden="true"><span></span>role para entrar no projeto</p>
      </section>

      {/* ═════════ NÚMEROS ═════════ */}
      <section class="faixa" aria-label="Números do escritório">
        <dl class="nums">
          {numeros.map((n) => (
            <div class="num" data-anima>
              <dt><span data-conta-ate={n.v}>{n.v}</span><i>{n.u}</i></dt>
              <dd>{n.l}</dd>
            </div>
          ))}
        </dl>
      </section>

      {/* ═════════ ARQ-02 · ABORDAGEM ═════════ */}
      <section class="secao" id="abordagem" data-folha="ARQ-02" data-folha-t="Abordagem">
        <div class="caixa">
          <div class="dupla">
            <header class="cab" data-anima>
              <h2>Uma prancha só resolve a obra quando alguém responde por ela até o fim.</h2>
              <p class="lead">
                O projeto barato costuma ser o que para na aprovação. O nosso segue
                até a vistoria — e é o mesmo CAU e o mesmo CREA que assinam as duas
                pontas.
              </p>
              <a class="btn btn-p" href="#contato">Começar pelo diagnóstico</a>
            </header>

            <dl class="ficha" data-anima>
              <p class="ficha-t">Ficha do escritório</p>
              {ficha.map((f) => (
                <div><dt>{f.d}</dt><dd>{f.v}</dd></div>
              ))}
            </dl>
          </div>

          <ul class="pilares">
            {pilares.map((p, i) => (
              <li data-anima>
                <span class="pilar-n">{String(i + 1).padStart(2, '0')}</span>
                <b>{p.t}</b>
                <span class="pilar-d">{p.d}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      {/* ═════════ ARQ-03 · PRANCHA (a planta se desenha) ═════════ */}
      <section class="prancha" id="projeto" data-folha="ARQ-03" data-folha-t="Planta baixa" data-escura>
        <div class="caixa">
          <header class="prancha-cab" data-anima>
            <h2>Tudo começa por um desenho que já sabe quanto vai custar.</h2>
            <p class="lead-claro">
              Planta real do acervo: {m2(AREA_CONSTRUIDA)} m² de área construída,
              {' '}{AREA_UTIL_TXT} m² de área útil, três dormitórios e varanda. Cada parede
              já tem espessura, cada vão já tem verga e cada cota foi conferida contra
              o levantamento do terreno. Ela se desenha na ordem em que um desenhista
              desenha.
            </p>
          </header>

          <div class="prancha-palco">
            <ol class="camadas" aria-hidden="true">
              {['Eixos e piso', 'Alvenaria', 'Esquadrias', 'Cotas', 'Textos e áreas'].map((c) => (
                <li data-camada>{c}</li>
              ))}
            </ol>

        <figure class="folha">
          <svg class="svg-planta" viewBox={`-140 -120 ${W + 280} ${Hp + 300}`} role="img"
               aria-label="Planta baixa da residência com três dormitórios, sala integrada, cozinha, área de serviço e varanda">
            <defs>
              <pattern id="malha" width="50" height="50" patternUnits="userSpaceOnUse">
                <path d="M 50 0 L 0 0 0 50" fill="none" stroke="rgba(255,255,255,.13)" stroke-width="1" />
              </pattern>
              <pattern id="malha-g" width="250" height="250" patternUnits="userSpaceOnUse">
                <path d="M 250 0 L 0 0 0 250" fill="none" stroke="rgba(255,255,255,.24)" stroke-width="1.2" />
              </pattern>
            </defs>

            <rect x="-140" y="-120" width={W + 280} height={Hp + 300} fill="url(#malha)" />
            <rect x="-140" y="-120" width={W + 280} height={Hp + 300} fill="url(#malha-g)" />

            {/* piso dos cômodos */}
            <g class="pl-piso">
              {comodos.map((c) => (
                <rect x={px(c.x1)} y={py(c.z1)} width={px(c.x2) - px(c.x1)} height={py(c.z2) - py(c.z1)} />
              ))}
            </g>

            {/* alvenaria */}
            <g class="pl-parede">
              {cheias.map((b, i) => (
                <line data-risca style={`--i:${i}`} pathLength="1"
                      x1={px(b.ax)} y1={py(b.az)} x2={px(b.bx)} y2={py(b.bz)}
                      stroke-width={ESP * S} />
              ))}
            </g>

            {/* janelas: peitoril cheio + linha do vidro */}
            <g class="pl-janela">
              {peitoris.map((b, i) => (
                <>
                  <line class="pl-jan-caixa" x1={px(b.ax)} y1={py(b.az)} x2={px(b.bx)} y2={py(b.bz)} stroke-width={ESP * S} />
                  <line class="pl-jan-vidro" data-risca style={`--i:${i + 24}`} pathLength="1"
                        x1={px(b.ax)} y1={py(b.az)} x2={px(b.bx)} y2={py(b.bz)} />
                </>
              ))}
            </g>

            {/* portas */}
            <g class="pl-porta">
              {portas.map((p, i) => (
                <>
                  <line data-risca style={`--i:${i + 30}`} pathLength="1"
                        x1={p.folha.x1} y1={p.folha.y1} x2={p.folha.x2} y2={p.folha.y2} class="pl-folha" />
                  <path d={p.arco} class="pl-arco" data-risca style={`--i:${i + 32}`} pathLength="1" />
                </>
              ))}
            </g>

            {/* cotas */}
            <g class="pl-cota">
              {cotasH.map((c) => (
                <>
                  <line x1={px(c.a)} y1={py(c.z) + c.off} x2={px(c.b)} y2={py(c.z) + c.off} />
                  <line class="pl-ext" x1={px(c.a)} y1={py(c.z)} x2={px(c.a)} y2={py(c.z) + c.off * 1.18} />
                  <line class="pl-ext" x1={px(c.b)} y1={py(c.z)} x2={px(c.b)} y2={py(c.z) + c.off * 1.18} />
                  <text x={(px(c.a) + px(c.b)) / 2} y={py(c.z) + c.off + (c.off > 0 ? 26 : -12)}>{c.txt}</text>
                </>
              ))}
              {cotasV.map((c) => (
                <>
                  <line x1={px(c.x) + c.off} y1={py(c.a)} x2={px(c.x) + c.off} y2={py(c.b)} />
                  <line class="pl-ext" x1={px(c.x)} y1={py(c.a)} x2={px(c.x) + c.off * 1.18} y2={py(c.a)} />
                  <line class="pl-ext" x1={px(c.x)} y1={py(c.b)} x2={px(c.x) + c.off * 1.18} y2={py(c.b)} />
                  <text x={px(c.x) + c.off} y={(py(c.a) + py(c.b)) / 2}
                        transform={`rotate(-90 ${px(c.x) + c.off} ${(py(c.a) + py(c.b)) / 2})`}
                        dy="-12">{c.txt}</text>
                </>
              ))}
            </g>

            {/* nomes dos ambientes */}
            <g class="pl-nome">
              {comodos.map((c) => (
                <>
                  <text x={c.cx} y={c.cy - 6} class="pl-nome-t">{c.nome.toUpperCase()}</text>
                  <text x={c.cx} y={c.cy + 18} class="pl-nome-a">{c.a} m²</text>
                </>
              ))}
            </g>

            {/* norte e escala */}
            <g class="pl-info">
              <g transform={`translate(${W + 96} -56)`}>
                <circle r="26" class="pl-norte-c" />
                <path d="M 0 -34 L 9 8 L 0 1 L -9 8 Z" class="pl-norte-s" />
                <text y="-40" class="pl-norte-t">N</text>
              </g>
              <g transform={`translate(0 ${Hp + 128})`}>
                <line x1="0" y1="0" x2="500" y2="0" class="pl-esc" />
                {[0, 100, 200, 300, 400, 500].map((v) => (
                  <line x1={v} y1="-7" x2={v} y2="7" class="pl-esc" />
                ))}
                <rect x="0" y="-6" width="100" height="12" class="pl-esc-b" />
                <rect x="200" y="-6" width="100" height="12" class="pl-esc-b" />
                <rect x="400" y="-6" width="100" height="12" class="pl-esc-b" />
                <text x="0" y="34" class="pl-esc-t">0</text>
                <text x="500" y="34" class="pl-esc-t">5 m</text>
              </g>
            </g>
          </svg>
        </figure>
          </div>

          <ul class="legenda" data-anima>
            <li><b>Pé-direito</b> {m2(H).replace('.', ',')} m livre</li>
            <li><b>Parede</b> {(ESP * 100).toFixed(0)} cm em bloco cerâmico com reboco</li>
            <li><b>Vãos</b> verga e contraverga em 100 % das aberturas</li>
            <li><b>Cobertura</b> duas águas, 20°, beiral de 60 cm</li>
          </ul>
        </div>
      </section>

      {/* ═════════ ARQ-04 · A PLANTA VIRA OBRA (cena 3D preservada) ═════════ */}
      <section class="cena" id="obra" data-cena data-folha="ARQ-04" data-folha-t="Da planta à obra">
        <div class="cena-fixa">
          <canvas class="cena-canvas" data-canvas></canvas>

          <div class="cena-hud">
            <h2 data-etapa-t>{ETAPAS[0].t}</h2>
            <p class="cena-d" data-etapa-d>{ETAPAS[0].d}</p>
            <p class="cena-det" data-etapa-det>{ETAPAS[0].det}</p>
            <ol class="trilha">
              {ETAPAS.map((e) => <li data-passo><span></span>{e.t}</li>)}
            </ol>
          </div>

          <p class="cena-nota">Modelo gerado a partir da mesma planta acima — nada é ilustração.</p>
        </div>
      </section>

      {/* ═════════ ARQ-05 · ACERVO ═════════ */}
      <section class="secao" id="acervo" data-folha="ARQ-05" data-folha-t="Acervo">
        <div class="caixa">
          <header class="cab cab-larga" data-anima>
            <div>
              <h2>Seis obras, do sobrado de oito metros ao pavilhão de vão livre</h2>
              <p class="lead">
                Cada card traz o diagrama de massa na escala real de pavimentos — um
                prédio de oito andares tem que parecer alto ao lado de um galpão de um.
              </p>
            </div>
            <p class="cab-nota">
              {OBRAS.filter((o) => o.status === 'Entregue').length} entregues ·
              {' '}{OBRAS.filter((o) => o.status === 'Em obra').length} em obra ·
              {' '}{OBRAS.reduce((s, o) => s + o.area, 0).toLocaleString('pt-BR')} m² somados
            </p>
          </header>

          <ul class="grade-obras">
            {OBRAS.map((o) => (
              <li class="obra" data-anima>
                <div class="obra-cab">
                  <span class="obra-cod">{o.cod}</span>
                  <span class={`obra-status${o.status === 'Em obra' ? ' obra-status-a' : ''}`}>{o.status}</span>
                </div>

                {/*
                  Diagrama de massa: um retângulo por pavimento, altura fixa por
                  pavimento. A informação está na proporção, não no desenho.
                */}
                <svg class="obra-massa" viewBox="0 0 150 140" aria-hidden="true">
                  {Array.from({ length: o.pav }, (_, i) => (
                    <rect x="26" y={120 - (i + 1) * 13} width="98" height="13" />
                  ))}
                  {o.pav <= 2 && (
                    <path class="obra-agua" d={`M 20 ${120 - o.pav * 13} L 75 ${120 - o.pav * 13 - 16} L 130 ${120 - o.pav * 13}`} />
                  )}
                  <line class="obra-solo" x1="8" y1="120" x2="142" y2="120" />
                  {Array.from({ length: 12 }, (_, i) => (
                    <line class="obra-hachura" x1={10 + i * 11} y1="120" x2={4 + i * 11} y2="128" />
                  ))}
                </svg>

                <h3>{o.nome}</h3>
                <p class="obra-tipo">{o.tipo}</p>
                <p class="obra-nota">{o.nota}</p>
                <dl class="obra-dados">
                  <div><dt>Local</dt><dd>{o.local}</dd></div>
                  <div><dt>Área</dt><dd>{o.area.toLocaleString('pt-BR')} m²</dd></div>
                  <div><dt>Pavimentos</dt><dd>{o.pav}</dd></div>
                  <div><dt>Sistema</dt><dd>{o.sistema}</dd></div>
                  <div><dt>Obra</dt><dd>{o.obra}</dd></div>
                  <div><dt>Ano</dt><dd>{o.ano}</dd></div>
                </dl>
              </li>
            ))}
          </ul>
        </div>
      </section>

      {/* ═════════ ARQ-06 · SERVIÇOS ═════════ */}
      <section class="secao secao-osso" id="servicos" data-folha="ARQ-06" data-folha-t="Serviços">
        <div class="caixa">
          <header class="cab" data-anima>
            <h2>Seis frentes, e você contrata só as que precisa</h2>
            <p class="lead">
              Dá para levar o pacote inteiro ou uma prancha só. O que não dá é
              começar a obra sem a parte que sustenta o resto.
            </p>
          </header>

          <ul class="grade-serv">
            {servicos.map((s) => (
              <li class="serv" data-anima>
                <span class="serv-cod">{s.cod}</span>
                <h3>{s.t}</h3>
                <p>{s.d}</p>
                <ul class="serv-itens">
                  {s.itens.map((i) => <li>{i}</li>)}
                </ul>
              </li>
            ))}
          </ul>
        </div>
      </section>

      {/* ═════════ ARQ-07 · SISTEMAS CONSTRUTIVOS ═════════ */}
      <section class="secao" id="sistemas" data-folha="ARQ-07" data-folha-t="Sistemas">
        <div class="caixa">
          <header class="cab" data-anima>
            <h2>A pergunta da segunda reunião, respondida em tabela</h2>
            <p class="lead">
              Escolhe-se pelo vão que a planta pede, pelo prazo que você tem e pelo
              acesso do terreno — nessa ordem. Faixa de custo de obra em São Paulo,
              sem projeto e sem terreno.
            </p>
          </header>

          <div class="tabela-rolo no-bar">
            <table class="tabela" data-anima>
              <caption class="sr">Comparativo de sistemas construtivos</caption>
              <thead>
                <tr>
                  <th scope="col">Sistema</th>
                  <th scope="col">Vão livre</th>
                  <th scope="col">Prazo</th>
                  <th scope="col">Custo de obra</th>
                  <th scope="col">Quando faz sentido</th>
                </tr>
              </thead>
              <tbody>
                {SISTEMAS.map((s) => (
                  <tr data-linha-tab>
                    <th scope="row">{s.s}</th>
                    <td class="mono">{s.vao}</td>
                    <td><span class={`prazo prazo-${s.prazo.toLowerCase()}`}>{s.prazo}</span></td>
                    <td class="mono">{s.custo}</td>
                    <td class="td-q">{s.q}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      {/* ═════════ ARQ-08 · ETAPAS ═════════ */}
      <section class="secao secao-osso" id="etapas" data-folha="ARQ-08" data-folha-t="Cronograma">
        <div class="caixa">
          <header class="cab" data-anima>
            <h2>Sete etapas, com o prazo de cada uma escrito antes de começar</h2>
            <p class="lead">
              A etapa 03 é a única cujo prazo não é nosso: quem responde é a
              prefeitura. Por isso ela entra no cronograma desde o primeiro dia,
              e não como surpresa no meio.
            </p>
          </header>

          <ol class="fases">
            {fases.map((f) => (
              <li class="fase" data-anima>
                <span class="fase-n">{f.n}</span>
                <div class="fase-txt">
                  <h3>{f.t}</h3>
                  <p>{f.d}</p>
                </div>
                <span class="fase-p">{f.p}</span>
              </li>
            ))}
          </ol>
        </div>
      </section>

      {/* ═════════ ARQ-09 · INVESTIMENTO ═════════ */}
      <section class="secao" id="investimento" data-folha="ARQ-09" data-folha-t="Investimento">
        <div class="caixa">
          <header class="cab" data-anima>
            <h2>Número antes da reunião, porque orçamento não é surpresa</h2>
            <p class="lead">
              Faixas de referência para São Paulo. O valor fecha depois do
              levantamento, por escrito, em orçamento analítico por composição de
              serviço — e não muda no meio.
            </p>
          </header>

          <div class="trio">
            {PADROES.map((p) => (
              <article class="padrao" data-anima>
                <p class="padrao-t">Padrão {p.p}</p>
                <p class="padrao-v">{p.m2}<small>por m² de obra</small></p>
                <p class="padrao-d">{p.d}</p>
              </article>
            ))}
          </div>

          <div class="dupla dupla-topo">
            <div data-anima>
              <h3 class="sub">Honorários de projeto</h3>
              <dl class="lista-preco">
                {HONORARIOS.map((h) => (
                  <div><dt>{h.i}</dt><dd class="mono">{h.v}</dd></div>
                ))}
              </dl>
            </div>

            <div data-anima>
              <h3 class="sub">O que o CUB/m² não cobre</h3>
              <p class="aviso">
                O CUB do Sinduscon é a referência oficial, mas é um custo parcial.
                É por isso que a obra real de padrão normal fica entre 1,5 e 1,8 vez
                o CUB do mês — e por isso um orçamento por “CUB × área” sempre
                estoura.
              </p>
              <ul class="fora">
                {FORA_DO_CUB.map((f) => <li>{f}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </section>

      {/* ═════════ ARQ-10 · EQUIPE ═════════ */}
      <section class="secao secao-osso" id="equipe" data-folha="ARQ-10" data-folha-t="Equipe">
        <div class="caixa">
          <header class="cab" data-anima>
            <h2>Quem assina embaixo</h2>
            <p class="lead">
              Registro profissional é público e verificável no CAU e no CREA. Se um
              escritório não mostra o número, comece perguntando por ele.
            </p>
          </header>

          <ul class="grade-equipe">
            {EQUIPE.map((p) => (
              <li class="pessoa" data-anima>
                <span class="pessoa-ini" aria-hidden="true">
                  {p.n.split(' ').map((x) => x[0]).slice(0, 2).join('')}
                </span>
                <b>{p.n}</b>
                <span class="pessoa-c">{p.c}</span>
                <span class="pessoa-r mono">{p.r}</span>
                <span class="pessoa-f">{p.f}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      {/* ═════════ ARQ-11 · TÉCNICO ═════════ */}
      <section class="secao" id="tecnico" data-folha="ARQ-11" data-folha-t="Técnico">
        <div class="caixa">
          <header class="cab" data-anima>
            <h2>As normas que o projeto obedece, e o que você recebe no fim</h2>
            <p class="lead">
              Norma não é burocracia: é a diferença entre trinca em dois anos e
              casa em pé em cinquenta. Cada item da esquerda tem consequência
              direta na coluna da direita.
            </p>
          </header>

          <div class="dupla">
            <ul class="normas">
              {normas.map((n) => (
                <li data-anima>
                  <span class="norma-n mono">{n.n}</span>
                  <b>{n.t}</b>
                  <span class="norma-d">{n.d}</span>
                </li>
              ))}
            </ul>

            <div class="entrega-bloco" data-anima>
              <h3 class="sub">O pacote entregue</h3>
              <p class="entrega-i">
                {entregaveis.length} pranchas e documentos, em DWG, PDF e IFC.
                O IFC é o que permite outro profissional abrir o modelo sem
                depender de nós.
              </p>
              <ul class="entregas">
                {entregaveis.map((e) => <li>{e}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </section>

      {/* ═════════ ARQ-12 · DEPOIMENTOS ═════════ */}
      <section class="secao secao-escura" id="clientes" data-folha="ARQ-12" data-folha-t="Clientes" data-escura>
        <div class="caixa">
          <header class="cab" data-anima>
            <h2>Três obras, contadas por quem pagou a conta</h2>
          </header>
          <ul class="depoimentos">
            {DEPOIMENTOS.map((d) => (
              <li data-anima>
                <blockquote>{d.t}</blockquote>
                <p class="dep-a"><b>{d.n}</b><span>{d.o}</span></p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      {/* ═════════ ARQ-13 · DÚVIDAS ═════════ */}
      <section class="secao" id="duvidas" data-folha="ARQ-13" data-folha-t="Dúvidas">
        <div class="caixa">
          <header class="cab" data-anima>
            <h2>As dez perguntas que aparecem em toda primeira reunião</h2>
          </header>
          <div class="faq">
            {faq.map((f) => (
              <details data-anima>
                <summary>{f.p}</summary>
                <p>{f.r}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      {/* ═════════ ARQ-14 · CONTATO ═════════ */}
      <section class="secao secao-cta" id="contato" data-folha="ARQ-14" data-folha-t="Contato">
        <div class="caixa">
          <div class="dupla">
            <div data-anima>
              <h2>Comece pelo diagnóstico do terreno</h2>
              <p class="lead">
                Uma hora de conversa com consulta de zoneamento inclusa: você
                descobre a taxa de ocupação, o recuo e o coeficiente do seu lote
                antes de contratar qualquer coisa. Se o terreno não permitir o que
                você quer, é melhor saber agora.
              </p>
              <dl class="contato-dados">
                <div><dt>WhatsApp</dt><dd><a href={`https://wa.me/${EMPRESA.zap}`} rel="noopener">{EMPRESA.zapFmt}</a></dd></div>
                <div><dt>Telefone</dt><dd><a href={`tel:${EMPRESA.foneLink}`}>{EMPRESA.fone}</a></dd></div>
                <div><dt>E-mail</dt><dd><a href={`mailto:${EMPRESA.email}`}>{EMPRESA.email}</a></dd></div>
                <div><dt>Escritório</dt><dd>{EMPRESA.rua}<br />{EMPRESA.bairro} · {EMPRESA.cidade}/{EMPRESA.uf}</dd></div>
                <div><dt>Horário</dt><dd>Segunda a sexta, 9h às 18h</dd></div>
              </dl>
            </div>

            <form class="form" data-form data-zap={EMPRESA.zap} data-anima>
              <div class="form-2">
                <label>
                  Nome
                  <input name="nome" type="text" required autocomplete="name" placeholder="Como te chamamos" />
                </label>
                <label>
                  WhatsApp
                  <input name="fone" type="tel" required autocomplete="tel" placeholder="(11) 90000-0000" />
                </label>
              </div>

              <div class="form-2">
                <label>
                  O que você precisa
                  <select name="tipo">
                    <option>Casa nova</option>
                    <option>Reforma ou ampliação</option>
                    <option>Multifamiliar</option>
                    <option>Comercial ou industrial</option>
                    <option>Retrofit ou regularização</option>
                    <option>Só o projeto executivo</option>
                    <option>Só gerenciamento de obra</option>
                  </select>
                </label>
                <label>
                  Área aproximada
                  <input name="area" type="text" inputmode="numeric" placeholder="m² construídos" />
                </label>
              </div>

              <div class="form-2">
                <label>
                  Situação do terreno
                  <select name="terreno">
                    <option>Já é meu</option>
                    <option>Em negociação</option>
                    <option>Ainda procurando</option>
                    <option>Imóvel existente para reformar</option>
                  </select>
                </label>
                <label>
                  Quando pretende começar
                  <select name="prazo">
                    <option>Nos próximos 3 meses</option>
                    <option selected>Neste ano</option>
                    <option>Ainda estudando</option>
                  </select>
                </label>
              </div>

              <label>
                O que a obra precisa resolver
                <textarea name="msg" rows="3" placeholder="Somos quatro e a casa tem dois dormitórios… / o galpão precisa de vão livre de 20 m…"></textarea>
              </label>

              <button class="btn btn-p btn-cheio btn-g" type="submit">Enviar pelo WhatsApp</button>
              <p class="form-nota">
                Abre a conversa com tudo preenchido. Nada fica gravado neste site.
              </p>
            </form>
          </div>
        </div>
      </section>
    </main>

    <footer class="rodape">
      <div class="caixa rodape-grade">
        <div>
          <p class="rodape-marca">{EMPRESA.nome}<small>{EMPRESA.sub}</small></p>
          <p class="rodape-d">
            Escritório de arquitetura e engenharia civil em {EMPRESA.cidade}.
            Projeto, aprovação, orçamento e obra sob a mesma responsabilidade técnica.
          </p>
          <p class="rodape-reg mono">{EMPRESA.cau}<br />{EMPRESA.crea}</p>
        </div>

        <nav aria-label="Rodapé">
          <p class="rodape-t">Pranchas</p>
          <ul>
            <li><a href="#projeto">ARQ-03 · Planta baixa</a></li>
            <li><a href="#obra">ARQ-04 · Da planta à obra</a></li>
            <li><a href="#acervo">ARQ-05 · Acervo</a></li>
            <li><a href="#sistemas">ARQ-07 · Sistemas</a></li>
            <li><a href="#investimento">ARQ-09 · Investimento</a></li>
            <li><a href="#tecnico">ARQ-11 · Base técnica</a></li>
          </ul>
        </nav>

        <div class="rodape-mapa">
          <p class="rodape-t">Como chegar</p>
          <iframe
            title={`Mapa — ${EMPRESA.rua}`}
            src={`https://www.google.com/maps?q=${mapaQuery}&z=16&output=embed`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen></iframe>
          <a class="rodape-link" href={`https://www.google.com/maps/search/?api=1&query=${mapaQuery}`} rel="noopener">
            Abrir no Google Maps →
          </a>
        </div>
      </div>

      <p class="caixa rodape-fim">
        <span>© 2026 {EMPRESA.nome} · {EMPRESA.bairro}, {EMPRESA.cidade}/{EMPRESA.uf}</span>
        <a href={import.meta.env.BASE_URL}>← Voltar ao portfolio</a>
      </p>
    </footer>
  </div>
</Base>

<style>
  .pr {
    --papel: #fff;
    --osso: #f6f6f3;
    --linha: #e6e5e1;
    --tinta: #16181c;
    --c60: #5c6067;
    --c40: #9a9da4;
    --acento: #1b4fd6;
    --acento-esc: #143aa3;
    --planta: #0c2747;
    --planta-2: #123561;
    --ciano: #7fd3ff;

    --raio: 12px;
    --raio-g: 18px;
    --t: 0.4s;
    --e: cubic-bezier(0.22, 0.61, 0.36, 1);
    --malha: 34px;
    --topo-h: 4rem;

    position: relative;
    background: var(--papel);
    color: var(--tinta);
    font-family: 'Archivo', ui-sans-serif, system-ui, sans-serif;
    line-height: 1.6;
  }

  :global(body) { background: #fff; color: #16181c; }
  :global(::selection) { background: #1b4fd6; color: #fff; }
  /*
    O que o navegador desenha por conta também é parte do design: a barra de
    rolagem acompanha a página inteira, o cursor de texto pisca dentro de todo
    campo do formulário e o sublinhado padrão corta a perna das letras.
    Numeral tabular onde há medida, preço ou cota — sem ele o 1 é mais estreito
    que o 8 e a coluna de números dança de linha em linha.
  */
  :global(html) { scrollbar-color: #c2c4c9 #f6f6f3; }
  .pr :is(input, textarea, select) { caret-color: var(--acento); }
  .pr a { text-underline-offset: 0.18em; text-decoration-thickness: 1px; }
  .pr :is(input, textarea)::placeholder { color: var(--c40); }
  .pr :is(.faixa dt, .faixa dd, table, .cota, [class*='preco'], [class*='num'], [class*='medida'], time) {
    font-variant-numeric: tabular-nums;
  }


  /* papel milimetrado: fixo, atrás de tudo, dois níveis como prancha de verdade */
  .pr::before {
    content: '';
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    background-image:
      linear-gradient(rgba(27, 79, 214, 0.026) 1px, transparent 1px),
      linear-gradient(90deg, rgba(27, 79, 214, 0.026) 1px, transparent 1px),
      linear-gradient(rgba(27, 79, 214, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(27, 79, 214, 0.05) 1px, transparent 1px);
    background-size: var(--malha) var(--malha), var(--malha) var(--malha),
      calc(var(--malha) * 5) calc(var(--malha) * 5), calc(var(--malha) * 5) calc(var(--malha) * 5);
  }
  /*
    Sobe o conteúdo acima da malha do ::before — menos os três elementos que
    precisam continuar presos à janela: o topo, o fio de prumo e o carimbo de
    folha.

    O `:not` não é preciosismo. O Astro escopa este seletor como
    `.pr[cid] > [cid]`, especificidade (0,3,0), que ganha de `.topo[cid]`
    (0,2,0) — e o `position: relative` daqui sobrescrevia o `fixed` dos três
    por especificidade, não por ordem. O sintoma: o header rolava junto com a
    página e o carimbo de folha, que devia ser uma pílula no canto inferior
    direito, virava uma barra branca de largura inteira no alto da página.
  */
  .pr > *:not(.topo):not(.prumo):not(.folha-atual) { position: relative; z-index: 1; }

  .sr {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip-path: inset(50%); white-space: nowrap;
  }
  .pular {
    position: absolute; left: -9999px; top: 0; z-index: 100;
    background: var(--tinta); color: #fff; padding: 0.7rem 1.1rem;
    text-decoration: none; border-radius: 0 0 var(--raio) 0;
  }
  .pular:focus { left: 0; }

  /* ---------- tipografia ---------- */
  h1, h2, h3 {
    font-weight: 700; letter-spacing: -0.028em; line-height: 1.14;
    margin: 0; text-wrap: balance;
  }
  h1 { font-size: clamp(2.3rem, 5.4vw, 4.2rem); font-weight: 800; line-height: 1.04; letter-spacing: -0.038em; }
  h2 { font-size: clamp(1.6rem, 3.1vw, 2.5rem); }
  h3 { font-size: 1.12rem; letter-spacing: -0.018em; }
  p { margin: 0; text-wrap: pretty; }
  .lead { font-size: 1.03rem; color: var(--c60); max-width: 58ch; }
  .lead-claro { font-size: 1.03rem; color: rgba(234, 243, 255, 0.72); max-width: 62ch; }
  .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }
  .sub {
    font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--acento);
    margin-bottom: 1.1rem;
  }


  .caixa { max-width: 1220px; margin: 0 auto; padding-inline: clamp(1rem, 4vw, 2.6rem); }
  .secao { position: relative; padding-block: clamp(3.6rem, 7.5vw, 6.5rem); }
  .secao-osso { background: var(--osso); border-block: 1px solid var(--linha); }
  .cab { margin-bottom: clamp(2.2rem, 4vw, 3.2rem); max-width: 62ch; }
  .cab .lead { margin-top: 0.9rem; }
  .cab .btn { margin-top: 1.6rem; }
  .cab-larga {
    max-width: none; display: flex; flex-wrap: wrap; gap: 1.4rem 2.5rem;
    align-items: flex-end; justify-content: space-between;
  }
  .cab-larga > div { max-width: 62ch; }
  .cab-nota {
    font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;
    color: var(--c40); text-align: right;
  }
  .dupla { display: grid; gap: clamp(2rem, 4vw, 3.4rem); align-items: start; }
  .dupla-topo { margin-top: clamp(2.4rem, 4vw, 3.4rem); }
  .pr section[id] { scroll-margin-top: calc(var(--topo-h) + 0.6rem); }

  /* ---------- botões ---------- */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    padding: 0.75rem 1.4rem; border-radius: 999px;
    font-family: inherit; font-size: 0.92rem; font-weight: 600; text-decoration: none;
    border: 1px solid transparent; white-space: nowrap; cursor: pointer;
    transition: background var(--t) var(--e), color var(--t) var(--e),
      border-color var(--t) var(--e), box-shadow var(--t) var(--e);
  }
  .btn-g { padding: 0.92rem 1.7rem; font-size: 0.98rem; }
  .btn-min { padding: 0.52rem 1.05rem; font-size: 0.84rem; }
  .btn-cheio { width: 100%; }
  .btn-p { background: var(--acento); color: #fff; }
  .btn-p:hover { background: var(--acento-esc); box-shadow: 0 8px 24px -12px rgba(27, 79, 214, 0.7); }
  .btn-v { background: transparent; color: var(--tinta); border-color: var(--linha); }
  .btn-v:hover { border-color: var(--acento); color: var(--acento); }

  /* ---------- fio de prumo e carimbo de folha ---------- */
  .prumo {
    position: fixed; z-index: 55; top: var(--topo-h); bottom: 0;
    left: clamp(0.5rem, 1.6vw, 1.4rem); width: 1px;
    background: var(--linha); pointer-events: none;
  }
  .prumo span {
    display: block; width: 1px; height: 100%;
    background: linear-gradient(var(--acento), var(--acento-esc));
    transform: scaleY(0); transform-origin: 50% 0;
  }
  /* o peso do prumo: um losango que desce junto */
  .prumo::after {
    content: ''; position: absolute; left: -3px; top: 0; width: 7px; height: 7px;
    background: var(--acento); rotate: 45deg;
  }
  @media (max-width: 900px) { .prumo { display: none; } }

  .folha-atual {
    position: fixed; z-index: 55; right: clamp(0.7rem, 2vw, 1.6rem); bottom: 1rem;
    display: none; align-items: baseline; gap: 0.5rem;
    padding: 0.4rem 0.8rem; border-radius: 999px;
    background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);
    border: 1px solid var(--linha);
    font-family: 'JetBrains Mono', monospace; font-size: 0.7rem;
    color: var(--acento); letter-spacing: 0.1em;
  }
  .folha-atual em { font-style: normal; color: var(--c40); letter-spacing: 0.04em; }
  @media (min-width: 900px) { .folha-atual { display: flex; } }

  /* ---------- topo ---------- */
  .topo {
    position: fixed; inset: 0 0 auto; z-index: 60;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 0.7rem clamp(1rem, 4vw, 2.6rem);
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--linha);
  }
  .marca { display: flex; align-items: center; gap: 0.65rem; text-decoration: none; color: var(--tinta); }
  .marca-simbolo {
    width: 1.6rem; height: 1.6rem; flex: none; position: relative;
    border: 1.5px solid var(--acento);
  }
  /* o símbolo é um esquadro: a diagonal fecha o triângulo */
  .marca-simbolo::after {
    content: ''; position: absolute; inset: -1.5px;
    background: linear-gradient(45deg, transparent 49%, var(--acento) 49% 51%, transparent 51%);
  }
  .marca-txt { font-size: 1.02rem; font-weight: 800; letter-spacing: 0.02em; line-height: 1.1; }
  .marca-txt small {
    display: block; font-family: 'JetBrains Mono', monospace; font-weight: 400;
    font-size: 0.55rem; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--c40); margin-top: 0.28rem;
  }
  .topo-nav { display: none; gap: 1.4rem; }
  .topo-nav a {
    position: relative; font-size: 0.87rem; font-weight: 500;
    color: var(--c60); text-decoration: none;
    transition: color var(--t) var(--e);
  }
  .topo-nav a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -5px; height: 1px;
    background: var(--acento); transform: scaleX(0); transform-origin: 0 50%;
    transition: transform var(--t) var(--e);
  }
  .topo-nav a:hover { color: var(--tinta); }
  .topo-nav a:hover::after { transform: scaleX(1); }

  /* ---------- capa ---------- */
  .capa {
    position: relative;
    padding: calc(var(--topo-h) + clamp(2.5rem, 6vh, 4.5rem)) clamp(1rem, 4vw, 2.6rem) clamp(4rem, 9vh, 6rem);
    max-width: 1220px; margin: 0 auto;
  }
  .capa-grade { display: grid; gap: clamp(2.5rem, 5vw, 4rem); align-items: center; }
  h1 em { font-style: normal; color: var(--acento); }
  h1 .linha { display: block; }
  .capa .lead { margin-top: 1.5rem; font-size: 1.08rem; max-width: 46ch; }
  .capa-acoes { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 2.1rem; }
  .selos {
    list-style: none; margin: 2.4rem 0 0; padding: 1.4rem 0 0;
    border-top: 1px solid var(--linha);
    display: grid; gap: 0.55rem;
    font-family: 'JetBrains Mono', monospace; font-size: 0.76rem; color: var(--c60);
  }
  .selos li { display: flex; align-items: baseline; gap: 0.6rem; }
  .selos li::before { content: '+'; color: var(--acento); font-weight: 700; }

  .capa-lado { display: grid; gap: 1rem; }
  .capa-desenho {
    border: 1px solid var(--linha); border-radius: var(--raio);
    padding: clamp(0.8rem, 2vw, 1.6rem); background: var(--papel);
  }
  .carimbo {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 120px), 1fr));
    border: 1px solid var(--linha); border-radius: var(--raio); overflow: hidden;
  }
  .carimbo-l {
    padding: 0.6rem 0.75rem; border-right: 1px solid var(--linha);
    display: grid; gap: 0.2rem;
  }
  .carimbo-l:last-child { border-right: 0; }
  .carimbo-l span {
    font-family: 'JetBrains Mono', monospace; font-size: 0.58rem;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--c40);
  }
  .carimbo-l b { font-size: 0.8rem; font-weight: 600; }

  .rolar {
    display: flex; align-items: center; gap: 0.7rem; margin-top: clamp(2.5rem, 6vh, 4rem);
    font-family: 'JetBrains Mono', monospace; font-size: 0.66rem;
    letter-spacing: 0.2em; text-transform: uppercase; color: var(--c40);
  }
  .rolar span { width: 3rem; height: 1px; background: linear-gradient(90deg, var(--acento), transparent); }

  /* ---------- números ---------- */
  .faixa { border-block: 1px solid var(--linha); background: var(--osso); }
  .nums {
    max-width: 1220px; margin: 0 auto;
    padding: clamp(2.2rem, 4.5vw, 3.2rem) clamp(1rem, 4vw, 2.6rem);
    display: grid; gap: clamp(1.4rem, 3vw, 2.4rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 170px), 1fr));
  }
  .num dt {
    display: flex; align-items: baseline; gap: 0.25rem;
    font-size: clamp(2rem, 4vw, 2.9rem); font-weight: 800; letter-spacing: -0.04em;
    line-height: 1; font-variant-numeric: tabular-nums;
  }
  .num dt i {
    font-style: normal; font-family: 'JetBrains Mono', monospace;
    font-size: 0.3em; font-weight: 500; color: var(--acento); letter-spacing: 0.04em;
  }
  .num dd { margin: 0.6rem 0 0; font-size: 0.86rem; color: var(--c60); max-width: 24ch; }

  /* ---------- ficha e pilares ---------- */
  .ficha {
    margin: 0; border: 1px solid var(--linha); border-radius: var(--raio-g);
    padding: clamp(1.2rem, 2.4vw, 1.8rem); background: var(--osso);
  }
  .ficha-t {
    font-family: 'JetBrains Mono', monospace; font-size: 0.66rem; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--acento);
    margin-bottom: 1.1rem;
  }
  .ficha div {
    display: grid; gap: 0.15rem; padding: 0.7rem 0; border-top: 1px solid var(--linha);
  }
  .ficha dt {
    font-family: 'JetBrains Mono', monospace; font-size: 0.62rem;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--c40);
  }
  .ficha dd { margin: 0; font-size: 0.88rem; }

  .pilares {
    list-style: none; margin: clamp(2.4rem, 4vw, 3.4rem) 0 0; padding: 0;
    display: grid; gap: 0;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    border-top: 1px solid var(--linha);
  }
  .pilares li {
    display: grid; gap: 0.4rem; align-content: start;
    padding: 1.5rem clamp(0.9rem, 2vw, 1.5rem) 1.5rem 0;
    border-right: 1px solid var(--linha);
  }
  .pilares li:last-child { border-right: 0; }
  .pilar-n {
    font-family: 'JetBrains Mono', monospace; font-size: 0.68rem;
    letter-spacing: 0.14em; color: var(--acento);
  }
  .pilares b { font-size: 1rem; font-weight: 700; }
  .pilar-d { font-size: 0.86rem; color: var(--c60); }

  /* ---------- prancha escura ---------- */
  .prancha {
    position: relative;
    background: var(--planta); color: #eaf3ff;
    padding-block: clamp(3.6rem, 7.5vw, 6.5rem);
    border-block: 1px solid var(--planta-2);
  }
  .prancha h2 { color: #eaf3ff; }
  .prancha-cab { margin-bottom: clamp(2rem, 4vw, 3rem); max-width: 68ch; }
  .prancha-cab h2 { margin-top: 0.2rem; }
  .prancha-palco { position: relative; }

  .camadas {
    list-style: none; margin: 0 0 1.2rem; padding: 0;
    display: flex; flex-wrap: wrap; gap: 0.4rem;
    counter-reset: cam;
  }
  .camadas li {
    padding: 0.3rem 0.7rem; border-radius: 999px;
    border: 1px solid rgba(159, 198, 255, 0.24);
    font-family: 'JetBrains Mono', monospace; font-size: 0.64rem;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: rgba(234, 243, 255, 0.42);
    transition: color var(--t) var(--e), border-color var(--t) var(--e), background var(--t) var(--e);
  }
  .camadas li::before {
    counter-increment: cam; content: counter(cam) ' ';
    color: rgba(159, 198, 255, 0.5);
  }
  .camadas li.ativa {
    color: var(--planta); background: var(--ciano); border-color: var(--ciano);
  }

  .legenda {
    list-style: none; margin: clamp(1.6rem, 3vw, 2.4rem) 0 0; padding: 0;
    display: grid; gap: 0.6rem 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    font-size: 0.84rem; color: rgba(234, 243, 255, 0.66);
  }
  .legenda b { color: #eaf3ff; font-weight: 600; }

  /* ---------- acervo ---------- */
  .grade-obras {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: clamp(1rem, 2vw, 1.5rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr));
  }
  .obra {
    display: flex; flex-direction: column;
    border: 1px solid var(--linha); border-radius: var(--raio-g);
    padding: clamp(1.1rem, 2.2vw, 1.5rem); background: var(--papel);
    transition: border-color var(--t) var(--e), box-shadow var(--t) var(--e);
  }
  .obra:hover { border-color: var(--acento); box-shadow: 0 16px 40px -24px rgba(27, 79, 214, 0.4); }
  .obra-cab { display: flex; align-items: center; justify-content: space-between; gap: 0.8rem; }
  .obra-cod {
    font-family: 'JetBrains Mono', monospace; font-size: 0.68rem;
    letter-spacing: 0.12em; color: var(--acento);
  }
  .obra-status {
    padding: 0.2rem 0.6rem; border-radius: 999px;
    background: var(--osso); border: 1px solid var(--linha);
    font-family: 'JetBrains Mono', monospace; font-size: 0.6rem;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--c60);
  }
  .obra-status-a { background: rgba(27, 79, 214, 0.08); border-color: rgba(27, 79, 214, 0.3); color: var(--acento); }

  .obra-massa { display: block; width: 100%; height: auto; margin: 1rem 0 0.4rem; }
  .obra-massa rect { fill: rgba(27, 79, 214, 0.07); stroke: var(--acento); stroke-width: 1.2; }
  .obra-agua { fill: none; stroke: var(--acento); stroke-width: 2; stroke-linejoin: round; }
  .obra-solo { stroke: var(--tinta); stroke-width: 1.6; }
  .obra-hachura { stroke: rgba(22, 24, 28, 0.28); stroke-width: 1; }

  .obra h3 { margin-top: 0.7rem; }
  .obra-tipo {
    font-family: 'JetBrains Mono', monospace; font-size: 0.66rem;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--c40);
    margin-top: 0.3rem;
  }
  .obra-nota { margin-top: 0.8rem; font-size: 0.87rem; color: var(--c60); flex: 1; }
  .obra-dados {
    margin: 1.1rem 0 0; padding-top: 0.9rem; border-top: 1px solid var(--linha);
    display: grid; gap: 0.45rem 1rem; grid-template-columns: 1fr 1fr;
  }
  .obra-dados div { display: grid; gap: 0.1rem; }
  .obra-dados dt {
    font-family: 'JetBrains Mono', monospace; font-size: 0.58rem;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--c40);
  }
  .obra-dados dd { margin: 0; font-size: 0.82rem; font-weight: 500; }

  /* ---------- serviços ---------- */
  .grade-serv {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 0;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr));
    border-top: 1px solid var(--linha);
  }
  .serv {
    padding: clamp(1.4rem, 2.6vw, 2rem) clamp(1rem, 2vw, 1.8rem) clamp(1.4rem, 2.6vw, 2rem) 0;
    border-right: 1px solid var(--linha); border-bottom: 1px solid var(--linha);
  }
  .serv-cod {
    font-family: 'JetBrains Mono', monospace; font-size: 0.68rem;
    letter-spacing: 0.14em; color: var(--acento);
  }
  .serv h3 { margin: 0.7rem 0 0.6rem; }
  .serv > p { font-size: 0.9rem; color: var(--c60); }
  .serv-itens {
    list-style: none; margin: 1.1rem 0 0; padding: 0; display: grid; gap: 0.4rem;
    font-size: 0.82rem; color: var(--c60);
  }
  .serv-itens li { display: flex; align-items: baseline; gap: 0.55rem; }
  .serv-itens li::before { content: ''; flex: none; width: 5px; height: 5px; background: var(--acento); rotate: 45deg; }

  /* ---------- tabela de sistemas ---------- */
  .tabela-rolo { overflow-x: auto; }
  .tabela { width: 100%; min-width: 46rem; border-collapse: collapse; text-align: left; }
  .tabela :is(th, td) { padding: 0.95rem 1rem; border-bottom: 1px solid var(--linha); vertical-align: top; }
  .tabela thead th {
    font-family: 'JetBrains Mono', monospace; font-size: 0.63rem; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--c40);
    border-bottom-color: var(--tinta);
  }
  .tabela tbody th { font-size: 0.95rem; font-weight: 700; width: 15rem; }
  .tabela td { font-size: 0.87rem; color: var(--c60); }
  .tabela .mono { font-size: 0.8rem; white-space: nowrap; }
  .td-q { min-width: 20rem; }
  .tabela tbody tr { transition: background var(--t) var(--e); }
  .tabela tbody tr:hover { background: var(--osso); }
  .prazo {
    padding: 0.16rem 0.55rem; border-radius: 999px;
    font-family: 'JetBrains Mono', monospace; font-size: 0.64rem;
    letter-spacing: 0.08em; white-space: nowrap;
  }
  .prazo-curto { background: rgba(27, 79, 214, 0.1); color: var(--acento); }
  .prazo-médio { background: var(--osso); color: var(--c60); border: 1px solid var(--linha); }
  .prazo-longo { background: rgba(22, 24, 28, 0.07); color: var(--tinta); }

  /* ---------- fases ---------- */
  .fases { list-style: none; margin: 0; padding: 0; }
  .fase {
    display: grid; gap: 0.3rem 1.4rem; align-items: baseline;
    padding: clamp(1.1rem, 2.2vw, 1.6rem) 0;
    border-top: 1px solid var(--linha);
    grid-template-columns: auto 1fr;
  }
  .fase:last-child { border-bottom: 1px solid var(--linha); }
  .fase-n {
    font-family: 'JetBrains Mono', monospace; font-size: 0.9rem; font-weight: 700;
    color: var(--acento); letter-spacing: 0.06em;
  }
  .fase-txt h3 { margin-bottom: 0.4rem; }
  .fase-txt p { font-size: 0.89rem; color: var(--c60); max-width: 74ch; }
  .fase-p {
    grid-column: 2; font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem; color: var(--c40); margin-top: 0.5rem;
  }

  /* ---------- investimento ---------- */
  .trio {
    display: grid; gap: clamp(1rem, 2vw, 1.4rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
  }
  .padrao {
    border: 1px solid var(--linha); border-radius: var(--raio-g);
    padding: clamp(1.2rem, 2.4vw, 1.7rem);
  }
  .padrao-t {
    font-family: 'JetBrains Mono', monospace; font-size: 0.66rem; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--acento);
  }
  .padrao-v { margin-top: 0.9rem; font-size: 1.4rem; font-weight: 800; letter-spacing: -0.03em; }
  .padrao-v small {
    display: block; margin-top: 0.25rem; font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem; font-weight: 400; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--c40);
  }
  .padrao-d { margin-top: 0.9rem; font-size: 0.85rem; color: var(--c60); }

  .lista-preco { margin: 0; display: grid; }
  .lista-preco div {
    display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; justify-content: space-between;
    padding: 0.8rem 0; border-top: 1px solid var(--linha);
  }
  .lista-preco dt { font-size: 0.89rem; }
  .lista-preco dd { margin: 0; font-size: 0.83rem; color: var(--acento); white-space: nowrap; }

  .aviso {
    font-size: 0.88rem; color: var(--c60);
    padding-left: 1rem; border-left: 2px solid var(--acento);
  }
  .fora {
    list-style: none; margin: 1.3rem 0 0; padding: 0;
    display: grid; gap: 0.45rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    font-size: 0.84rem; color: var(--c60);
  }
  .fora li { display: flex; align-items: baseline; gap: 0.55rem; }
  .fora li::before { content: '×'; color: var(--acento); font-weight: 700; }

  /* ---------- equipe ---------- */
  .grade-equipe {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: clamp(0.9rem, 1.8vw, 1.3rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
  }
  .pessoa {
    display: grid; gap: 0.3rem; align-content: start;
    padding: clamp(1.1rem, 2.2vw, 1.5rem);
    border: 1px solid var(--linha); border-radius: var(--raio-g);
    background: var(--papel);
  }
  .pessoa-ini {
    width: 2.6rem; height: 2.6rem; display: grid; place-items: center;
    margin-bottom: 0.7rem; border: 1px solid var(--acento);
    font-family: 'JetBrains Mono', monospace; font-size: 0.82rem; font-weight: 700;
    color: var(--acento);
  }
  .pessoa b { font-size: 1rem; }
  .pessoa-c { font-size: 0.82rem; color: var(--c60); }
  .pessoa-r { font-size: 0.68rem; color: var(--acento); letter-spacing: 0.06em; }
  .pessoa-f { margin-top: 0.4rem; font-size: 0.8rem; color: var(--c40); }

  /* ---------- técnico ---------- */
  .normas { list-style: none; margin: 0; padding: 0; }
  .normas li {
    display: grid; gap: 0.25rem; padding: 0.95rem 0;
    border-top: 1px solid var(--linha);
    grid-template-columns: 6.5rem 1fr;
  }
  .norma-n { font-size: 0.75rem; color: var(--acento); letter-spacing: 0.04em; grid-row: span 2; }
  .normas b { font-size: 0.93rem; }
  .norma-d { grid-column: 2; font-size: 0.84rem; color: var(--c60); }

  .entrega-bloco {
    border: 1px solid var(--linha); border-radius: var(--raio-g);
    padding: clamp(1.2rem, 2.4vw, 1.8rem); background: var(--osso);
  }
  .entrega-i { font-size: 0.86rem; color: var(--c60); }
  .entregas {
    list-style: none; margin: 1.3rem 0 0; padding: 0; display: grid; gap: 0.5rem;
    font-size: 0.85rem;
  }
  .entregas li { display: flex; align-items: baseline; gap: 0.6rem; }
  .entregas li::before {
    content: ''; flex: none; width: 12px; height: 1px; background: var(--acento);
    transform: translateY(-0.35em);
  }

  /* ---------- depoimentos ---------- */
  .secao-escura { background: var(--tinta); color: #f2f3f5; border-block: 1px solid #2a2d33; }
  .secao-escura h2 { color: #f2f3f5; }
  .depoimentos {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: clamp(1rem, 2vw, 1.6rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }
  .depoimentos li {
    display: flex; flex-direction: column; gap: 1.2rem;
