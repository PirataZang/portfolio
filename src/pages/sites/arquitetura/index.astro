    position: absolute; right: clamp(1rem, 4vw, 3rem); top: clamp(5rem, 9vw, 7rem);
    max-width: 15rem; text-align: right;
    font-family: 'JetBrains Mono', monospace; font-size: 0.66rem; color: var(--c40);
