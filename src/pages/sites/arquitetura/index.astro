    border: 1px solid var(--linha); border-radius: var(--raio-g);
    padding: clamp(1.1rem, 2.4vw, 1.7rem); box-shadow: var(--sombra-alta);
  }
  .cena-hud h2 { font-size: clamp(1.3rem, 2.2vw, 1.7rem); margin-bottom: 0.5rem; }
  .cena-d { color: var(--c60); font-size: 0.93rem; }
  .cena-det {
    margin-top: 0.9rem; padding: 0.5rem 0.8rem;
    border: 1px solid color-mix(in srgb, var(--acento) 30%, transparent);
    background: rgba(27, 79, 214, 0.06); border-radius: 8px;
    font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; color: var(--acento-esc);
