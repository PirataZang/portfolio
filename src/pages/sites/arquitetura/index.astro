  .pr :focus-visible { outline: 2px solid var(--acento); outline-offset: 3px; border-radius: 6px; }
  .prancha :focus-visible, .secao-escura :focus-visible, .rodape :focus-visible { outline-color: var(--ciano); }

  /* o que o Motion revela nasce escondido — só com JS e com vontade de movimento */
  :global(.anima-on) .pr [data-anima],
  :global(.anima-on) .pr [data-linha] { opacity: 0; }

  /* ---------- peças preservadas: elevação, planta e cena 3D ----------
