  .pl-norte-c { fill: none; stroke: rgba(190, 216, 255, 0.5); }
  .pl-norte-s { fill: var(--ciano); }
  .pl-norte-t { fill: #9fc6ff; font-family: 'JetBrains Mono', monospace; font-size: 20px; text-anchor: middle; }
  .pl-esc { stroke: rgba(190, 216, 255, 0.6); stroke-width: 1.6; }
  .pl-esc-b { fill: rgba(190, 216, 255, 0.6); }
  .pl-esc-t { fill: #9fc6ff; font-family: 'JetBrains Mono', monospace; font-size: 19px; }
  .cena { position: relative; height: 460vh; scroll-margin-top: 0; }
  .cena-fixa {
