  .pl-arco { fill: none; stroke: rgba(127, 211, 255, 0.55); stroke-width: 2; }
  .pl-cota line { stroke: rgba(190, 216, 255, 0.55); stroke-width: 1.4; }
  .pl-cota .pl-ext { stroke: rgba(190, 216, 255, 0.3); }
