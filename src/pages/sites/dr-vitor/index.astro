---
import Base from '../../../layouts/Base.astro';

/*
  DR. VITOR — cirurgião-dentista, consultório de um profissional só.

  O argumento é a pessoa: quem agenda sabe que vai ser atendido pelo Dr. Vitor
  da avaliação ao retorno. Por isso ele aparece no início, grande, e volta nas
  fotos de atendimento e de prótese (o mesmo modelo em todas, fotos reais do
  Freepik com crédito no rodapé).

  Paleta do cliente: marinho #1F3B4D, azul-aço #376A8A, creme #F5EBDD, grafite
  #3C3C3C e dourado #C8AC62. O dourado é detalhe (fios, o arco do sorriso do
  símbolo, preços em fundo escuro); nunca texto sobre fundo claro.

  Mecânica própria: calculadora de orçamento para os procedimentos caros
  (lentes, clareamento, implante, protocolo). Mostra a faixa de valor e manda
  o pedido pronto para o WhatsApp.

  Movimento: fade por opacidade e só transform onde anima em loop (anéis do
  início). Nada de filtro animado, por desempenho.
*/

const DR = {
  nome: 'Dr. Vitor',
  titulo: 'Cirurgião-dentista',
  cro: 'CRO-SC 14.872',
  desde: 2012,
  rua: 'Rua XV de Novembro, 1200, sala 604',
  bairro: 'Centro',
  cidade: 'Joinville',
  uf: 'SC',
  cep: '89201-600',
  fone: '(99) 9999-9999',
  foneLink: '+559999999999',
  zap: '5599999999999',
  zapFmt: '(99) 99999-9999',
  email: 'contato@drvitor.odo.br',
  insta: 'drvitor.odonto',
  face: 'drvitorodonto',
  site: 'https://drvitor.odo.br',
};

const DIAS_ABERTOS = [1, 2, 3, 4, 5, 6];
const IMG = `${import.meta.env.BASE_URL}img/dr-vitor`;
const mapaQuery = encodeURIComponent(`${DR.rua}, ${DR.bairro}, ${DR.cidade} - ${DR.uf}`);
const brl = (n: number) => n.toLocaleString('pt-BR');

const NAV = [
  { id: 'inicio', t: 'Início' },
  { id: 'tratamentos', t: 'Tratamentos' },
  { id: 'cirurgias', t: 'Cirurgias e próteses' },
  { id: 'planos', t: 'Planos' },
  { id: 'orcamento', t: 'Orçamento' },
  { id: 'contato', t: 'Contato' },
];


const TRATAMENTOS = [
  { t: 'Clareamento dental', f: 't-clareamento', pos: '40% 50%', alt: 'Paciente de óculos de proteção recebendo clareamento com luz no consultório', d: 'No consultório, com gel de alta concentração e proteção da gengiva. Até 4 tons mais claro em duas sessões.', min: '2 sessões de 1h', preco: 900 },
  { t: 'Restaurações estéticas', f: 't-restauracao', pos: '45% 50%', alt: 'Luz de fotopolimerização endurecendo a resina de uma restauração', d: 'Resina da cor exata do seu dente, esculpida camada por camada. Sem metal e sem aquele contorno escuro.', min: '40 min por dente', preco: 220 },
  { t: 'Facetas de resina', f: 't-faceta', pos: '55% 50%', alt: 'Escala de cor encostada no sorriso da paciente para escolher o tom da faceta', d: 'Corrigem cor, formato e pequenos espaços em uma sessão, com desgaste mínimo do dente.', min: '1h por dente', preco: 650 },
  { t: 'Lentes de contato dental', f: 't-lente', pos: '50% 50%', alt: 'Sorriso de perto com dentes brancos, alinhados e com brilho natural', d: 'Lâminas de porcelana de 0,3 mm, feitas em laboratório. Resistentes a mancha e com brilho natural.', min: '3 consultas', preco: 1800 },
  { t: 'Limpeza e prevenção', f: 't-limpeza', pos: '50% 40%', alt: 'Paciente sorrindo durante a avaliação com espelho e sonda', d: 'Raspagem, polimento e aplicação de flúor, com avaliação completa e orientação de escovação.', min: '50 min', preco: 180 },
  { t: 'Tratamento de canal', f: 't-canal', pos: '50% 22%', alt: 'Dr. Vitor analisando a radiografia dos dentes contra a luz', d: 'Com localizador eletrônico e anestesia computadorizada. Na maioria dos casos, resolvido em uma sessão.', min: '1 a 2 sessões', preco: 850 },
];

const IMPLANTE = [
  { t: 'Avaliação com tomografia', d: 'Medimos a altura e a espessura do osso para planejar o implante no lugar certo.' },
  { t: 'Instalação do implante', d: 'Cirurgia com anestesia local, em torno de 1 hora. Você volta para casa no mesmo dia.' },
  { t: 'Cicatrização', d: 'De 3 a 6 meses para o osso se unir ao implante. Você usa um dente provisório nesse período.' },
  { t: 'Coroa definitiva', d: 'Coroa de porcelana feita sob medida, com cor e formato iguais aos dos dentes vizinhos.' },
];

const CIRURGIAS = [
  { t: 'Implante unitário', d: 'Repõe um dente perdido sem desgastar os vizinhos.', preco: 3200 },
  { t: 'Extração de siso', d: 'Com planejamento por tomografia e sedação, se você preferir.', preco: 450 },
  { t: 'Enxerto ósseo', d: 'Recupera o volume de osso para receber implante.', preco: 1500 },
  { t: 'Prótese total', d: 'Dentadura nova, confortável e com aparência natural.', preco: 2400 },
  { t: 'Protocolo fixo', d: 'Arcada inteira fixa sobre 4 a 6 implantes.', preco: 18000 },
];

const PLANOS = [
  {
    id: 'prevencao', nome: 'Prevenção', preco: 99, sub: 'Para manter o sorriso saudável',
    itens: ['1 limpeza completa por mês', 'Avaliação com o Dr. Vitor a cada visita', 'Aplicação de flúor'],
    bonus: ['10% de desconto em restaurações'],
  },
  {
    id: 'cuidado', nome: 'Cuidado Total', preco: 179, sub: 'O mais escolhido pelos pacientes', destaque: true,
    itens: ['1 limpeza completa por mês', 'Radiografia digital a cada 6 meses', 'Urgência sem custo no horário do consultório', '1 restauração simples por semestre'],
    bonus: ['15% de desconto em clareamento e facetas', 'Clareamento caseiro de brinde no 1º ano'],
  },
  {
    id: 'familia', nome: 'Família', preco: 349, sub: 'Até 4 pessoas no mesmo plano',
    itens: ['1 limpeza por mês para cada pessoa', 'Radiografias e urgências incluídas', 'Atendimento para crianças a partir de 4 anos'],
    bonus: ['20% de desconto em qualquer tratamento', 'Prioridade na agenda aos sábados'],
  },
];

/* faixas de referência do consultório; o valor final sai só depois da avaliação */
const ORCAMENTO = [
  { id: 'lentes', t: 'Lentes de contato dental', un: 'dente', min: 1800, max: 2500, qtd: true, qMin: 2, qMax: 20, qIni: 8, dica: 'O mais comum é de 6 a 10 dentes, os que aparecem no sorriso.' },
  { id: 'clareamento', t: 'Clareamento', opcoes: [
    { id: 'consultorio', t: 'No consultório', min: 900, max: 1100 },
    { id: 'caseiro', t: 'Caseiro com moldeira', min: 650, max: 800 },
    { id: 'combinado', t: 'Combinado: consultório e caseiro', min: 1300, max: 1600 },
  ] },
  { id: 'implante', t: 'Implante com coroa', un: 'implante', min: 3200, max: 4500, qtd: true, qMin: 1, qMax: 10, qIni: 1, dica: 'Inclui implante, componente e coroa de porcelana.' },
  { id: 'protocolo', t: 'Protocolo fixo', un: 'arcada', min: 18000, max: 28000, qtd: true, qMin: 1, qMax: 2, qIni: 1, dica: 'Arcada inteira fixa sobre implantes. Cada arcada é superior ou inferior.' },
];

const CANAIS = [
  { i: 'fa-brands fa-whatsapp', t: 'WhatsApp', v: DR.zapFmt, u: `https://wa.me/${DR.zap}` },
  { i: 'fa-solid fa-phone', t: 'Telefone', v: DR.fone, u: `tel:${DR.foneLink}` },
  { i: 'fa-brands fa-instagram', t: 'Instagram', v: `@${DR.insta}`, u: `https://instagram.com/${DR.insta}` },
  { i: 'fa-regular fa-envelope', t: 'E-mail', v: DR.email, u: `mailto:${DR.email}` },
];
const REDES = [
  { n: 'Instagram', i: 'fa-brands fa-instagram', u: `https://instagram.com/${DR.insta}` },
  { n: 'WhatsApp', i: 'fa-brands fa-whatsapp', u: `https://wa.me/${DR.zap}` },
  { n: 'Facebook', i: 'fa-brands fa-facebook-f', u: `https://facebook.com/${DR.face}` },
];

const titulo = `${DR.nome}, cirurgião-dentista em ${DR.cidade} | Implantes, lentes e clareamento`;
const descricao = `Consultório do ${DR.nome} em ${DR.cidade}: clareamento, lentes de contato dental, implantes e próteses, com atendimento feito por ele do início ao fim. Planos mensais a partir de R$ 99.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  name: `${DR.nome}, ${DR.titulo}`,
  description: descricao,
  url: DR.site,
  image: `${DR.site}/img/dr-vitor/vitor.jpg`,
  telephone: DR.foneLink,
  email: DR.email,
  priceRange: 'R$ 180 – R$ 28.000',
  address: { '@type': 'PostalAddress', streetAddress: DR.rua, addressLocality: DR.cidade, addressRegion: DR.uf, postalCode: DR.cep, addressCountry: 'BR' },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:00', closes: '19:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Saturday'], opens: '08:00', closes: '12:00' },
  ],
  sameAs: REDES.filter((r) => r.n !== 'WhatsApp').map((r) => r.u),
};
---

<Base title={titulo} description={descricao}>
  <Fragment slot="head">
    <meta name="theme-color" content="#1F3B4D" />
    <link rel="canonical" href={DR.site} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:image" content={`${DR.site}/img/dr-vitor/vitor.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=Public+Sans:wght@400;500;600;700&display=swap" />
    <link rel="preload" as="image" href={`${IMG}/vitor-recorte.webp`} type="image/webp" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="odo">
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>

    <!-- símbolo: o V do nome apoiado no arco de um sorriso -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <symbol id="simbolo" viewBox="0 0 40 40">
          <path d="M11 9l9 17 9-17" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M8 29c7 5 17 5 24 0" fill="none" stroke="#C8AC62" stroke-width="3" stroke-linecap="round" />
        </symbol>
        <symbol id="arco" viewBox="0 0 120 24">
          <path d="M4 4c30 22 82 22 112 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </symbol>
      </defs>
    </svg>

    <!-- ─────────────── cabeçalho ─────────────── -->
    <header class="topo">
      <div class="topo-in">
        <a class="marca" href="#inicio" aria-label={`${DR.nome}, voltar ao início`}>
          <svg class="marca-simbolo" aria-hidden="true"><use href="#simbolo" /></svg>
          <span class="marca-texto"><strong>{DR.nome}</strong><span>{DR.titulo}</span></span>
        </a>
        <nav class="nav" aria-label="Seções da página">
          <ul>{NAV.map((n) => <li><a href={`#${n.id}`} data-secao={n.id}>{n.t}</a></li>)}</ul>
        </nav>
        <button class="botao botao-marinho botao-topo" type="button" data-abrir-agenda>Agendar consulta</button>
        <button class="topo-menu" type="button" aria-expanded="false" aria-controls="menu-movel" aria-label="Abrir menu">
          <span></span><span></span>
        </button>
      </div>
      <nav id="menu-movel" class="menu-movel" aria-label="Seções da página" hidden>
        <ul>{NAV.map((n) => <li><a href={`#${n.id}`} data-secao={n.id}>{n.t}</a></li>)}</ul>
        <button class="botao botao-marinho" type="button" data-abrir-agenda>Agendar consulta</button>
      </nav>
    </header>

    <main id="conteudo">
      <!-- ─────────────── início: capa de revista ─────────────── -->
      <section id="inicio" class="heroi" aria-labelledby="titulo-inicio">
        <!-- painel marinho com o nome gigante em contorno e o Dr. Vitor recortado na frente -->
        <div class="painel" aria-hidden="true">
          <span class="painel-nome">VITOR</span>
          <svg class="painel-arco" viewBox="0 0 600 300"><path d="M40 40c120 260 400 260 520 0" /></svg>
          <span class="forma forma-anel"></span>
          <span class="forma forma-ponto"></span>
        </div>
        <picture class="retrato">
          <source srcset={`${IMG}/vitor-recorte.webp`} type="image/webp" />
          <img src={`${IMG}/vitor-recorte.png`} width="1100" height="1392" fetchpriority="high"
            alt="Dr. Vitor, cirurgião-dentista, de jaleco branco, sorrindo com os braços cruzados" />
        </picture>
        <p class="assinatura">
          <strong>{DR.nome}</strong>
          <span>{DR.titulo}<br />{DR.cro}</span>
        </p>

        <div class="heroi-in">
          <div class="heroi-texto">
            <p class="heroi-selo entra"><svg aria-hidden="true"><use href="#simbolo" /></svg>Consultório particular em {DR.cidade}</p>
            <h1 id="titulo-inicio" class="entra" style="--i: 1">Um dentista só seu, do primeiro exame ao sorriso pronto.</h1>
            <p class="heroi-lide entra" style="--i: 2">
              Sou o Dr. Vitor. Faço pessoalmente cada etapa do seu tratamento, do
              clareamento ao implante. Sem troca de profissional no meio do caminho.
            </p>
            <div class="heroi-acoes entra" style="--i: 3">
              <button class="botao botao-marinho botao-grande" type="button" data-abrir-agenda>Agendar avaliação</button>
              <a class="link-seta" href="#orcamento">Simular um orçamento</a>
            </div>
            <dl class="regua entra" style="--i: 4">
              <div><dt>Desde</dt><dd>{DR.desde}</dd></div>
              <div><dt>Sábados</dt><dd>8h às 12h</dd></div>
              <div><dt>Parcelamento</dt><dd>até 12x</dd></div>
              <div><dt>Esta semana</dt><dd><span class="ponto-vivo" aria-hidden="true"></span>com horários</dd></div>
            </dl>
          </div>
        </div>

        <ul class="faixa" aria-label="Tratamentos oferecidos">
          {['Clareamento', 'Lentes de contato', 'Implantes', 'Facetas', 'Próteses', 'Restaurações', 'Canal'].map((t) => (
            <li class="faixa-item"><svg aria-hidden="true"><use href="#arco" /></svg>{t}</li>
          ))}
        </ul>
      </section>

      <!-- ─────────────── tratamentos: vitrine de fotos + tabela de valores ─────────────── -->
      <section id="tratamentos" class="secao tem-formas" aria-labelledby="titulo-tratamentos">
        <span class="forma forma-disco" style="right: -140px; top: 60px" aria-hidden="true"></span>
        <svg class="forma forma-arco" style="left: -20px; top: 44%" viewBox="0 0 120 24" aria-hidden="true"><use href="#arco" /></svg>
        <div class="cab">
          <div>
            <svg class="cab-arco" aria-hidden="true"><use href="#arco" /></svg>
            <h2 id="titulo-tratamentos" data-fade>Tratamentos e valores</h2>
          </div>
          <p data-fade style="--i: 1">
            Valores de referência do consultório. O valor exato sai na avaliação,
            com radiografia digital, antes de começar qualquer tratamento.
          </p>
        </div>

        <div class="honorarios" data-fade style="--i: 2">
          <!-- fotos empilhadas: a do tratamento escolhido aparece por cima, com fade -->
          <div class="vitrine">
            {TRATAMENTOS.map((t, k) => (
              <picture class={k === 0 ? 'vitrine-foto ativa' : 'vitrine-foto'} data-foto={k}>
                <source srcset={`${IMG}/${t.f}.webp`} type="image/webp" />
                <img src={`${IMG}/${t.f}.jpg`} alt={t.alt} width={t.f === 't-canal' ? 1100 : 1400} height={t.f === 't-canal' ? 1650 : 933}
                  style={`object-position: ${t.pos}`} loading={k === 0 ? 'eager' : 'lazy'} decoding="async" />
              </picture>
            ))}
            <p class="vitrine-legenda"><span id="vit-nome">{TRATAMENTOS[0].t}</span><span id="vit-tempo">{TRATAMENTOS[0].min}</span></p>
          </div>

          <!-- tabela de valores: a linha escolhida abre com a descrição -->
          <div class="tabela">
            <p class="tabela-titulo">Tabela de valores <span>{DR.nome}</span></p>
            <ul class="tabela-lista">
              {TRATAMENTOS.map((t, k) => (
                <li class={k === 0 ? 'item aberto' : 'item'}>
                  <button class="linha" type="button" aria-expanded={k === 0 ? 'true' : 'false'} aria-controls={`trat-${k}`} data-trat-idx={k} data-tempo={t.min}>
                    <span class="linha-nome"><strong>{t.t}</strong><small>{t.min}</small></span>
                    <span class="linha-pontos" aria-hidden="true"></span>
                    <span class="linha-preco"><small>a partir de</small>R$ {brl(t.preco)}</span>
                  </button>
                  <div class="item-corpo" id={`trat-${k}`}>
                    <div class="item-dentro">
                      <p>{t.d}</p>
                      <button class="botao botao-marinho" type="button" data-abrir-agenda data-trat={t.t} tabindex={k === 0 ? 0 : -1}>Agendar {t.t.toLowerCase()}</button>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
            <p class="tabela-nota">Parcelamos em até 12x no cartão. Planos mensais têm desconto nestes valores.</p>
          </div>
        </div>
      </section>

      <!-- ─────────────── cirurgias e próteses ─────────────── -->
      <section id="cirurgias" class="cirurgias tem-formas" aria-labelledby="titulo-cirurgias">
        <span class="forma forma-grade" style="left: 3%; bottom: 8%" aria-hidden="true"></span>
        <span class="forma forma-ponto" style="left: 46%; top: 12%" aria-hidden="true"></span>
        <div class="cirurgias-in">
          <div class="cab cab-escuro">
            <div>
              <svg class="cab-arco" aria-hidden="true"><use href="#arco" /></svg>
              <h2 id="titulo-cirurgias" data-fade>Cirurgias e próteses</h2>
            </div>
            <p data-fade style="--i: 1">
              Implantes, extrações e próteses completas feitas no próprio consultório,
              com planejamento por tomografia e o mesmo dentista em todas as etapas.
            </p>
          </div>

          <div class="implante">
            <div class="implante-fotos" data-fade>
              <picture class="implante-foto-grande">
                <source srcset={`${IMG}/implante.webp`} type="image/webp" />
                <img src={`${IMG}/implante.jpg`} alt="Cirurgia de implante dentário em andamento, com o motor de implante sobre a bancada" width="1400" height="993" loading="lazy" decoding="async" />
              </picture>
              <div class="implante-selo">
                <strong>1 hora</strong>
                <span>é o tempo médio da cirurgia de um implante</span>
              </div>
            </div>
            <div class="implante-texto">
              <h3 data-fade>Como é feito um implante</h3>
              <ol class="etapas">
                {IMPLANTE.map((e, k) => (
                  <li data-fade style={`--i: ${k}`}>
                    <span class="etapa-num">{k + 1}</span>
                    <div><strong>{e.t}</strong><p>{e.d}</p></div>
                  </li>
                ))}
              </ol>
            </div>
          </div>

          <div class="proteses">
            <figure class="protese-foto" data-fade>
              <picture>
                <source srcset={`${IMG}/protese.webp`} type="image/webp" />
                <img src={`${IMG}/protese.jpg`} alt="Dr. Vitor segurando um modelo de prótese dentária completa" width="1400" height="933" loading="lazy" decoding="async" />
              </picture>
            </figure>
            <div class="protese-lista" data-fade style="--i: 1">
              <h3>Procedimentos</h3>
              <ul>
                {CIRURGIAS.map((c) => (
                  <li>
                    <div><strong>{c.t}</strong><span>{c.d}</span></div>
                    <span class="protese-preco"><small>a partir de</small>R$ {brl(c.preco)}</span>
                  </li>
                ))}
              </ul>
              <a class="botao botao-dourado" href="#orcamento">Simular orçamento de cirurgia</a>
            </div>
          </div>
        </div>
      </section>

      <!-- ─────────────── planos ─────────────── -->
      <section id="planos" class="secao tem-formas" aria-labelledby="titulo-planos">
        <span class="forma forma-disco forma-disco-p" style="left: -60px; top: 34%" aria-hidden="true"></span>
        <span class="forma forma-anel" style="right: 2%; top: 90px" aria-hidden="true"></span>
        <div class="cab cab-centro">
          <svg class="cab-arco" aria-hidden="true"><use href="#arco" /></svg>
          <h2 id="titulo-planos" data-fade>Planos mensais</h2>
          <p data-fade style="--i: 1">Limpeza todo mês com o Dr. Vitor e desconto nos tratamentos. Sem carência para limpeza e sem fidelidade depois de 12 meses.</p>
        </div>
        <ul class="planos">
          {PLANOS.map((p, k) => (
            <li class={p.destaque ? 'plano plano-destaque' : 'plano'} data-fade style={`--i: ${k}`}>
              {p.destaque && <span class="plano-fita">Mais escolhido</span>}
              <h3>{p.nome}</h3>
              <p class="plano-sub">{p.sub}</p>
              <p class="plano-preco"><span class="moeda">R$</span>{brl(p.preco)}<span class="por">por mês</span></p>
              <ul class="plano-lista">
                {p.itens.map((it) => <li><i class="fa-solid fa-check" aria-hidden="true"></i>{it}</li>)}
                {p.bonus.map((b) => <li class="plano-bonus"><i class="fa-solid fa-star" aria-hidden="true"></i><span><span class="sr">Vantagem: </span>{b}</span></li>)}
              </ul>
              <button class={p.destaque ? 'botao botao-dourado' : 'botao botao-marinho'} type="button" data-abrir-agenda data-obs={`Quero assinar o plano ${p.nome}.`}>Assinar o {p.nome}</button>
            </li>
          ))}
        </ul>
      </section>

      <!-- ─────────────── orçamento ─────────────── -->
      <section id="orcamento" class="orcamento tem-formas" aria-labelledby="titulo-orcamento">
        <span class="forma forma-anel forma-anel-g" style="right: 10px; top: -60px" aria-hidden="true"></span>
        <div class="orcamento-in">
          <div class="orcamento-texto">
            <svg class="cab-arco" aria-hidden="true"><use href="#arco" /></svg>
            <h2 id="titulo-orcamento" data-fade>Simule o seu orçamento</h2>
            <p data-fade style="--i: 1">
              Para lentes, clareamento e cirurgias, veja uma faixa de valor antes da
              consulta. O valor exato sai na avaliação, depois do exame.
            </p>
            <figure class="orcamento-foto" data-fade style="--i: 2">
              <picture>
                <source srcset={`${IMG}/sorriso.webp`} type="image/webp" />
                <img src={`${IMG}/sorriso.jpg`} alt="Paciente sorrindo e olhando o resultado do tratamento no espelho" width="1400" height="933" loading="lazy" decoding="async" />
              </picture>
            </figure>
          </div>

          <form class="calc" id="calc" data-fade style="--i: 1" data-zap={DR.zap}>
            <fieldset class="calc-proc">
              <legend>O que você quer fazer?</legend>
              <div class="calc-opcoes">
                {ORCAMENTO.map((o, k) => (
                  <label class="calc-op">
                    <input type="radio" name="proc" value={o.id} checked={k === 0} />
                    <span>{o.t}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            {ORCAMENTO.map((o, k) => (
              <div class="calc-detalhe" data-proc={o.id} hidden={k !== 0}
                data-min={o.min} data-max={o.max} data-un={o.un} data-nome={o.t}>
                {o.qtd && (
                  <div class="calc-qtd">
                    <label for={`q-${o.id}`}>Quantos {o.un === 'dente' ? 'dentes' : o.un === 'implante' ? 'implantes' : 'arcadas'}?</label>
                    <div class="contador">
                      <button type="button" data-passo="-1" aria-label="Diminuir"><i class="fa-solid fa-minus" aria-hidden="true"></i></button>
                      <input id={`q-${o.id}`} type="number" inputmode="numeric" min={o.qMin} max={o.qMax} value={o.qIni} />
                      <button type="button" data-passo="1" aria-label="Aumentar"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
                    </div>
                    <p class="calc-dica">{o.dica}</p>
                  </div>
                )}
                {o.opcoes && (
                  <fieldset class="calc-tipo">
                    <legend>Qual tipo?</legend>
                    {o.opcoes.map((op, j) => (
                      <label class="calc-op calc-op-linha">
                        <input type="radio" name={`tipo-${o.id}`} value={op.id} checked={j === 0} data-min={op.min} data-max={op.max} data-nome={op.t} />
                        <span>{op.t}</span>
                        <small>R$ {brl(op.min)} a {brl(op.max)}</small>
                      </label>
                    ))}
                  </fieldset>
                )}
              </div>
            ))}

            <div class="calc-resultado" aria-live="polite">
              <p class="calc-rotulo">Faixa estimada</p>
              <p class="calc-valor"><span id="calc-min">R$ 0</span> a <span id="calc-max">R$ 0</span></p>
              <p class="calc-parcela" id="calc-parcela"></p>
            </div>
            <button class="botao botao-dourado botao-grande" type="submit">
              <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Pedir orçamento pelo WhatsApp
            </button>
            <p class="calc-nota">Valores de referência do consultório. Não substituem a avaliação.</p>
          </form>
        </div>
      </section>

      <!-- ─────────────── contato ─────────────── -->
      <section id="contato" class="secao contato tem-formas" aria-labelledby="titulo-contato">
        <svg class="forma forma-arco forma-arco-g" style="right: 4%; top: 70px" viewBox="0 0 120 24" aria-hidden="true"><use href="#arco" /></svg>
        <span class="forma forma-ponto" style="left: 48%; bottom: 40px" aria-hidden="true"></span>
        <div class="contato-cartao">
          <figure class="contato-foto" data-fade>
            <picture>
              <source srcset={`${IMG}/espelho.webp`} type="image/webp" />
              <img src={`${IMG}/espelho.jpg`} alt="Dr. Vitor mostrando o resultado para uma paciente sorridente com um espelho" width="1400" height="933" loading="lazy" decoding="async" />
            </picture>
          </figure>
          <div class="contato-texto">
            <svg class="cab-arco" aria-hidden="true"><use href="#arco" /></svg>
            <h2 id="titulo-contato" data-fade>Agende sua consulta</h2>
            <p data-fade style="--i: 1">
              Escolha o tratamento e o dia. A mensagem sai pronta no WhatsApp e a
              secretária confirma o horário com você.
            </p>
            <button class="botao botao-marinho botao-grande" type="button" data-abrir-agenda data-fade style="--i: 2">
              <i class="fa-regular fa-calendar" aria-hidden="true"></i> Agendar consulta
            </button>
            <ul class="canais" data-fade style="--i: 3">
              {CANAIS.map((c) => (
                <li><a href={c.u} rel="noopener">
                  <span class="canal-icone"><i class={c.i} aria-hidden="true"></i></span>
                  <span class="canal-texto"><strong>{c.t}</strong><span>{c.v}</span></span>
                </a></li>
              ))}
            </ul>
            <dl class="horarios" data-fade style="--i: 4">
              <div><dt>Segunda a sexta</dt><dd>8h às 19h</dd></div>
              <div><dt>Sábado</dt><dd>8h às 12h</dd></div>
              <div><dt>Urgência</dt><dd>Pelo WhatsApp</dd></div>
            </dl>
          </div>
        </div>
      </section>
    </main>

    <!-- ─────────────── rodapé ─────────────── -->
    <footer class="rodape">
      <svg class="rodape-arco" aria-hidden="true"><use href="#arco" /></svg>
      <div class="rodape-in">
        <div class="rodape-grade">
          <div class="rodape-marca">
            <a class="marca marca-clara" href="#inicio">
              <svg class="marca-simbolo" aria-hidden="true"><use href="#simbolo" /></svg>
              <span class="marca-texto"><strong>{DR.nome}</strong><span>{DR.titulo}</span></span>
            </a>
            <p>Clareamento, lentes, implantes e próteses em {DR.cidade}, com um único dentista cuidando de todo o tratamento. {DR.cro}.</p>
            <ul class="redes">
              {REDES.map((r) => <li><a href={r.u} rel="noopener" aria-label={r.n}><i class={r.i} aria-hidden="true"></i></a></li>)}
            </ul>
          </div>
          <div class="rodape-col">
            <h2>Navegue</h2>
            <ul>{NAV.slice(1).map((n) => <li><a href={`#${n.id}`}>{n.t}</a></li>)}</ul>
          </div>
          <div class="rodape-col">
            <h2>Consultório</h2>
            <address>{DR.rua}<br />{DR.bairro}, {DR.cidade}, {DR.uf}<br />CEP {DR.cep}</address>
            <p><a href={`tel:${DR.foneLink}`}>{DR.fone}</a><br /><a href={`mailto:${DR.email}`}>{DR.email}</a></p>
          </div>
          <div class="rodape-mapa">
            <iframe title={`Mapa: ${DR.rua}, ${DR.cidade}`}
              src={`https://www.google.com/maps?q=${mapaQuery}&z=16&output=embed`}
              loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
            <a href={`https://www.google.com/maps/search/?api=1&query=${mapaQuery}`} rel="noopener">
              <i class="fa-solid fa-location-dot" aria-hidden="true"></i> Como chegar
            </a>
          </div>
        </div>
        <div class="rodape-fim">
          <span>© 2026 {DR.nome}, {DR.titulo}</span>
          <span>Demonstração de portfólio: profissional, registro, preços e contatos são fictícios. Fotos: <a href="https://www.freepik.com" rel="noopener">Freepik</a>.</span>
          <a href={import.meta.env.BASE_URL}>Voltar ao portfólio</a>
        </div>
      </div>
    </footer>

    <a class="zap-flutua" href={`https://wa.me/${DR.zap}`} rel="noopener" aria-label="Conversar com o Dr. Vitor no WhatsApp">
      <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
    </a>

    <!-- ─────────────── modal de agendamento ─────────────── -->
    <dialog id="agenda" class="modal" aria-labelledby="agenda-titulo">
      <form class="modal-in" id="form-agenda" novalidate data-zap={DR.zap} data-dias={DIAS_ABERTOS.join(',')}>
        <div class="modal-cab">
          <div>
            <h2 id="agenda-titulo">Agendar consulta</h2>
            <p>A mensagem abre pronta no WhatsApp. Você confere antes de enviar.</p>
          </div>
          <button class="modal-fechar" type="button" data-fechar-agenda aria-label="Fechar"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
        </div>
        <div class="modal-corpo">
          <div class="campos">
            <div class="campo campo-largo">
              <label for="f-nome">Nome</label>
              <input id="f-nome" name="nome" type="text" autocomplete="name" maxlength="60" placeholder="Seu nome" aria-describedby="e-nome" />
              <p class="erro" id="e-nome" aria-live="polite"></p>
            </div>
            <div class="campo campo-largo">
              <label for="f-trat">Tratamento</label>
              <div class="seletor">
                <select id="f-trat" name="trat" aria-describedby="e-trat">
                  <option value="">Escolha o tratamento</option>
                  <option>Avaliação inicial</option>
                  {TRATAMENTOS.map((t) => <option>{t.t}</option>)}
                  {CIRURGIAS.map((c) => <option>{c.t}</option>)}
                </select>
                <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
              </div>
              <p class="erro" id="e-trat" aria-live="polite"></p>
            </div>
            <div class="campo">
              <label for="f-dia">Dia</label>
              <div class="seletor">
                <select id="f-dia" name="dia" aria-describedby="e-dia"><option value="">Escolha o dia</option></select>
                <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
              </div>
              <p class="erro" id="e-dia" aria-live="polite"></p>
            </div>
            <fieldset class="campo periodo">
              <legend>Período</legend>
              <div class="periodo-op">
                <label><input type="radio" name="periodo" value="manhã" checked /><span>Manhã</span></label>
                <label><input type="radio" name="periodo" value="tarde" /><span>Tarde</span></label>
              </div>
            </fieldset>
            <div class="campo campo-largo">
              <label for="f-obs">Observação <span class="opcional">(opcional)</span></label>
              <textarea id="f-obs" name="obs" rows="3" maxlength="400" placeholder="Dor, sensibilidade, um dente que incomoda, se tem plano…"></textarea>
            </div>
          </div>
          <div class="previa">
            <p class="previa-titulo"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Prévia da mensagem</p>
            <p class="previa-texto" id="previa" aria-live="polite"></p>
          </div>
        </div>
        <div class="modal-pe">
          <button class="botao botao-marinho botao-grande" type="submit"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Enviar pelo WhatsApp</button>
        </div>
      </form>
    </dialog>
  </div>
</Base>

<script>
  const reduzido = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const raiz = document.documentElement;
  const pad = (n: number) => String(n).padStart(2, '0');
  const brl = (n: number) => `R$ ${Math.round(n).toLocaleString('pt-BR')}`;

  /* ── fade ao entrar na tela ── */
  const fades = document.querySelectorAll<HTMLElement>('.odo [data-fade]');
  if (reduzido || !('IntersectionObserver' in window)) fades.forEach((el) => el.classList.add('visto'));
  else {
    const obs = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) { e.target.classList.add('visto'); obs.unobserve(e.target); }
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.15 });
    fades.forEach((el) => obs.observe(el));
  }


  /* ── tratamentos: a linha escolhida abre e troca a foto da vitrine ── */
  const itens = [...document.querySelectorAll<HTMLLIElement>('.tabela-lista .item')];
  const fotos = [...document.querySelectorAll<HTMLElement>('.vitrine-foto')];
  function abrirItem(k: number) {
    itens.forEach((li, j) => {
      const on = j === k;
      li.classList.toggle('aberto', on);
      li.querySelector('.linha')!.setAttribute('aria-expanded', String(on));
      li.querySelector<HTMLElement>('.item-dentro .botao')!.tabIndex = on ? 0 : -1;
    });
    fotos.forEach((f, j) => f.classList.toggle('ativa', j === k));
    const linha = itens[k].querySelector<HTMLElement>('.linha')!;
    document.getElementById('vit-nome')!.textContent = linha.querySelector('strong')!.textContent;
    document.getElementById('vit-tempo')!.textContent = linha.dataset.tempo!;
  }
  itens.forEach((li, k) => li.querySelector('.linha')!.addEventListener('click', () => abrirItem(k)));

  /* ── link da seção atual ── */
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.odo a[data-secao]')];
  const secoes = [...new Set(links.map((l) => l.dataset.secao!))].map((id) => document.getElementById(id)!);
  const obsNav = new IntersectionObserver((es) => {
    for (const e of es) if (e.isIntersecting) links.forEach((l) => {
      if (l.dataset.secao === e.target.id) l.setAttribute('aria-current', 'location'); else l.removeAttribute('aria-current');
    });
  }, { rootMargin: '-45% 0px -50% 0px' });
  secoes.forEach((s) => obsNav.observe(s));

  /* ── menu do celular ── */
  const topo = document.querySelector<HTMLElement>('.topo')!;
  const botaoMenu = topo.querySelector<HTMLButtonElement>('.topo-menu')!;
  const menu = document.getElementById('menu-movel')!;
  function abrirMenu(abrir: boolean) {
    botaoMenu.setAttribute('aria-expanded', String(abrir));
    botaoMenu.setAttribute('aria-label', abrir ? 'Fechar menu' : 'Abrir menu');
    menu.hidden = !abrir; topo.classList.toggle('menu-aberto', abrir);
  }
  botaoMenu.addEventListener('click', () => abrirMenu(menu.hidden));
  menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a, button')) abrirMenu(false); });
  matchMedia('(min-width: 1180px)').addEventListener('change', () => abrirMenu(false));

  /* ── calculadora de orçamento ── */
  const calc = document.getElementById('calc') as HTMLFormElement;
  const detalhes = [...calc.querySelectorAll<HTMLElement>('.calc-detalhe')];
  const saidaMin = document.getElementById('calc-min')!;
  const saidaMax = document.getElementById('calc-max')!;
  const saidaParcela = document.getElementById('calc-parcela')!;

  function estado() {
    const proc = (calc.querySelector<HTMLInputElement>('input[name="proc"]:checked'))!.value;
    const d = detalhes.find((x) => x.dataset.proc === proc)!;
    const tipo = d.querySelector<HTMLInputElement>('input[type="radio"]:checked');
    const qtdEl = d.querySelector<HTMLInputElement>('input[type="number"]');
    let qtd = 1;
    if (qtdEl) {
      qtd = Math.min(Number(qtdEl.max), Math.max(Number(qtdEl.min), Math.round(Number(qtdEl.value) || Number(qtdEl.min))));
    }
    const min = Number(tipo?.dataset.min ?? d.dataset.min) * qtd;
    const max = Number(tipo?.dataset.max ?? d.dataset.max) * qtd;
    const un = d.dataset.un;
    const plural = un === 'dente' ? 'dentes' : un === 'implante' ? 'implantes' : 'arcadas';
    const desc = tipo ? `${d.dataset.nome} (${tipo.dataset.nome})` : `${d.dataset.nome}, ${qtd} ${qtd === 1 ? un : plural}`;
    return { proc, d, min, max, desc };
  }

  function atualizarCalc() {
    const s = estado();
    detalhes.forEach((x) => (x.hidden = x !== s.d));
    saidaMin.textContent = brl(s.min);
    saidaMax.textContent = brl(s.max);
    saidaParcela.textContent = `ou em até 12x a partir de ${brl(s.min / 12)} sem juros`;
  }

  calc.addEventListener('change', atualizarCalc);
  calc.addEventListener('input', atualizarCalc);
  calc.querySelectorAll<HTMLButtonElement>('[data-passo]').forEach((b) => b.addEventListener('click', () => {
    const input = b.parentElement!.querySelector<HTMLInputElement>('input')!;
    const v = Math.min(Number(input.max), Math.max(Number(input.min), (Number(input.value) || 0) + Number(b.dataset.passo)));
    input.value = String(v);
    atualizarCalc();
  }));
  calc.querySelectorAll<HTMLInputElement>('input[type="number"]').forEach((i) => i.addEventListener('blur', () => {
    i.value = String(Math.min(Number(i.max), Math.max(Number(i.min), Math.round(Number(i.value) || Number(i.min)))));
    atualizarCalc();
  }));
  calc.addEventListener('submit', (e) => {
    e.preventDefault();
    const s = estado();
    const msg = `Olá, Dr. Vitor! Fiz a simulação no site e gostaria de um orçamento para: ${s.desc}.\nFaixa estimada: ${brl(s.min)} a ${brl(s.max)}.\nPodemos agendar uma avaliação?`;
    window.open(`https://wa.me/${calc.dataset.zap}?text=${encodeURIComponent(msg)}`, '_blank', 'noopener');
  });
  atualizarCalc();

  /* ── modal de agendamento ── */
  const modal = document.getElementById('agenda') as HTMLDialogElement;
  const form = document.getElementById('form-agenda') as HTMLFormElement;
  const campo = <T extends HTMLElement = HTMLInputElement>(n: string) => form.elements.namedItem(n) as unknown as T;
  const previa = document.getElementById('previa')!;
  const DIAS = form.dataset.dias!.split(',').map(Number);
  let quemAbriu: HTMLElement | null = null;
  let ultimaSugestao = '';
  const iso = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;

  function montarDias() {
    const sel = campo<HTMLSelectElement>('dia');
    const antes = sel.value;
    const d = new Date(); const hoje = iso(d);
    const ops: HTMLOptionElement[] = [];
    for (let i = 0; ops.length < 12 && i < 30; i++, d.setDate(d.getDate() + 1)) {
      if (!DIAS.includes(d.getDay())) continue;
      if (iso(d) === hoje && new Date().getHours() >= 17) continue;
      const txt = `${iso(d) === hoje ? 'Hoje, ' : ''}${d.toLocaleDateString('pt-BR', { weekday: 'long' })}, ${pad(d.getDate())}/${pad(d.getMonth() + 1)}`;
      ops.push(new Option(txt.charAt(0).toUpperCase() + txt.slice(1), iso(d)));
    }
    sel.replaceChildren(new Option('Escolha o dia', ''), ...ops);
    sel.value = ops.some((o) => o.value === antes) ? antes : '';
  }

  function abrirAgenda(origem: HTMLElement) {
    quemAbriu = origem;
    montarDias();
    if (origem.dataset.trat) campo<HTMLSelectElement>('trat').value = origem.dataset.trat;
    const obs = campo<HTMLTextAreaElement>('obs');
    const sug = origem.dataset.obs;
    if (sug && (!obs.value.trim() || obs.value === ultimaSugestao)) { obs.value = sug; ultimaSugestao = sug; }
    desenharPrevia();
    modal.showModal();
    raiz.classList.add('modal-aberto');
    campo('nome').focus();
  }
  modal.addEventListener('close', () => { raiz.classList.remove('modal-aberto'); quemAbriu?.focus(); });
  document.querySelectorAll<HTMLElement>('[data-abrir-agenda]').forEach((b) => b.addEventListener('click', () => abrirAgenda(b)));
  modal.querySelector('[data-fechar-agenda]')!.addEventListener('click', () => modal.close());
  modal.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });

  function valores() {
    const dia = campo<HTMLSelectElement>('dia').value;
    return {
      nome: campo('nome').value.trim().replace(/\s+/g, ' '),
      trat: campo<HTMLSelectElement>('trat').value,
      dia,
      diaFmt: dia ? new Date(`${dia}T12:00`).toLocaleDateString('pt-BR', { weekday: 'long', day: '2-digit', month: '2-digit' }) : '',
      periodo: (form.querySelector<HTMLInputElement>('input[name="periodo"]:checked'))!.value,
      obs: campo<HTMLTextAreaElement>('obs').value.trim(),
    };
  }
  function mensagem(v: ReturnType<typeof valores>) {
    let t = `Olá, Dr. Vitor! Meu nome é ${v.nome} e gostaria de agendar: ${v.trat}.\nDia: ${v.diaFmt}, de ${v.periodo}.`;
    if (v.obs) t += `\n\nObservação:\n${v.obs}`;
    return t;
  }
  function trecho(valor: string, vazio: string) {
    const s = document.createElement('span');
    s.className = valor ? 'cheio' : 'vazio'; s.textContent = valor || vazio; return s;
  }
  function desenharPrevia() {
    const v = valores();
    previa.replaceChildren(
      'Olá, Dr. Vitor! Meu nome é ', trecho(v.nome, 'seu nome'),
      ' e gostaria de agendar: ', trecho(v.trat, 'tratamento'), '.\nDia: ', trecho(v.diaFmt, 'dia escolhido'), `, de ${v.periodo}.`,
      ...(v.obs ? ['\n\nObservação:\n', trecho(v.obs, '')] : []),
    );
  }
  const REGRAS: Record<string, (v: ReturnType<typeof valores>) => string> = {
    nome: (v) => (v.nome ? '' : 'Digite seu nome.'),
    trat: (v) => (v.trat ? '' : 'Escolha o tratamento, ou "Avaliação inicial" se ainda não sabe.'),
    dia: (v) => (v.dia ? '' : 'Escolha o dia da consulta.'),
  };
  function marcarErro(n: string, t: string) {
    document.getElementById(`e-${n}`)!.textContent = t;
    const el = campo(n); if (t) el.setAttribute('aria-invalid', 'true'); else el.removeAttribute('aria-invalid');
  }
  form.addEventListener('input', (e) => {
    const a = e.target as HTMLInputElement;
    desenharPrevia();
    if (a.getAttribute('aria-invalid') === 'true' && REGRAS[a.name]) marcarErro(a.name, REGRAS[a.name](valores()));
  });
  form.addEventListener('change', desenharPrevia);
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const v = valores();
    const erros = Object.entries(REGRAS).map(([n, r]) => [n, r(v)] as const);
    erros.forEach(([n, t]) => marcarErro(n, t));
    const p = erros.find(([, t]) => t);
    if (p) { campo(p[0]).focus(); return; }
    window.open(`https://wa.me/${form.dataset.zap}?text=${encodeURIComponent(mensagem(v))}`, '_blank', 'noopener');
    modal.close();
  });
  montarDias();
  desenharPrevia();
</script>

<style is:global>
