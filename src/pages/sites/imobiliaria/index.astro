  @media (min-width: 860px) { .chamada { grid-template-columns: 1.4fr 1fr; } }
  .chamada h2 { color: #fff; }
  .chamada p { margin-top: 0.8rem; color: #b9cbdd; font-size: 0.96rem; max-width: 46ch; }
  .chamada-txt { min-width: 0; }
  /* o caminho da visita em uma frase: era uma grade de quatro cartões */
  .chamada-passos {
    margin-top: 1.4rem !important; padding-top: 1.2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
