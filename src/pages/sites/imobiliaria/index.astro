  .vazio[hidden] { display: none; }
  .vazio i { color: var(--azul); }

  /* ---------- sobre ---------- */
  .sobre-grade { display: grid; gap: clamp(1.8rem, 4vw, 3rem); }
  @media (min-width: 900px) { .sobre-grade { grid-template-columns: 1fr 1fr; align-items: start; } }
  .sobre-p { margin-top: 1rem; color: var(--c60); font-size: 0.98rem; max-width: 54ch; }
  /*
    A ficha da imobiliária: lista de definição, não cartões. São dados que o
    visitante confere — quem atende, registro, endereço — e dado se confere
    lendo em linha, não dentro de três caixas com ícone dizendo "confiança".
  */
  .ficha-empresa {
    margin: 0; align-self: start;
    background: var(--branco); border: 1px solid var(--borda);
    border-radius: var(--raio-g); box-shadow: var(--s1); overflow: hidden;
  }
  .ficha-empresa > div {
    display: grid; gap: 0.15rem; padding: 0.95rem 1.3rem;
    border-bottom: 1px solid var(--borda);
  }
  .ficha-empresa > div:last-child { border-bottom: 0; }
  .ficha-empresa dt {
    font-size: 0.68rem; font-weight: 600; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--c40);
  }
  .ficha-empresa dd { margin: 0; font-size: 0.92rem; color: var(--marinho); }

  /* ---------- chamada ---------- */
  .chamada {
    display: grid; gap: 1.6rem; align-items: center;
    padding: clamp(1.8rem, 5vw, 3rem);
