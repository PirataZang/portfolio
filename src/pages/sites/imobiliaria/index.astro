---
import Base from '../../../layouts/Base.astro';
import { galeria } from '../../../scripts/imovel-arte';

/*
  MERIDIANO IMÓVEIS — carteira de imóveis com ficha em modal.

  Claro, azul e arredondado: azul-claro nas superfícies, marinho no texto e no
  vulto, branco no cartão. As formas soltas do fundo são um SVG fixo atrás de
  tudo — dão o ar de folder de imobiliária sem virar ruído, porque ficam em
  opacidade baixa e nunca cruzam texto.

  Nenhuma foto: cada imóvel tem quatro ilustrações geradas em `imovel-arte.ts`
  a partir do próprio código, no build. É o que casa com a direção flat pedida,
  e evita a alternativa ruim de foto de banco genérica repetida dez vezes.

  O modal é `<dialog>` nativo — foco preso, Esc fecha e fundo escuro de graça.
  Dentro dele o carrossel anda por botão, seta do teclado, ponto e arrasto.

  Mobile primeiro: uma coluna até 620px, duas até 1000, três acima. O modal
  ocupa a tela quase inteira no celular e vira cartão centrado no desktop.
*/

const LOJA = {
  nome: 'Meridiano',
  sub: 'Imóveis',
  creci: 'CRECI-J 99.999 · SC',
  corretor: 'Helena Braz',
  cidade: 'Porto Sereno',
  uf: 'SC',
  rua: 'Av. das Enseadas, 900',
  bairro: 'Centro',
  cep: '99999-000',
  fone: '(99) 9999-9999',
  foneLink: '+559999999999',
  zap: '5599999999999',
  zapFmt: '(99) 99999-9999',
  email: 'contato@meridianoimoveis.com.br',
  insta: 'meridianoimoveis',
};

/*
  Carteira fictícia. Cidade, bairros e empreendimentos são inventados — nada
  aqui corresponde a imóvel, endereço ou preço real.

  `cod` é a semente do desenho: mudar o código muda as quatro ilustrações do
  imóvel, e mantê-lo garante que ele desenhe igual em todo build.
*/
const IMOVEIS = [
  {
    cod: 'MR-1042', atualizado: '2026-08-30', exclusivo: true, financia: true, predio: 'Entregue em 2013 · 4 unidades por andar', nome: 'Residencial Alvorada', tipo: 'Apartamento', negocio: 'Venda',
    bairro: 'Vila Aurora', preco: 780000, area: 92, quartos: 3, suites: 1, banheiros: 2, vagas: 2,
    andar: '8º andar', condominio: 720, iptu: 190, destaque: true,
    resumo: 'Três dormitórios com suíte e varanda voltada para o parque.',
    descricao:
      'Apartamento de esquina no oitavo andar, com sol da manhã nos dormitórios e varanda integrada à sala. O prédio tem doze anos, fachada revitalizada em 2024 e apenas quatro unidades por andar — o que se nota no silêncio do corredor. Piso em porcelanato retificado, esquadrias de alumínio com vidro duplo na face da avenida e cozinha já com armários planejados.',
    itens: ['Varanda integrada', 'Armários planejados', 'Vidro duplo na sala', 'Duas vagas cobertas', 'Portaria 24h', 'Salão de festas'],
  },
  {
    cod: 'MR-1077', atualizado: '2026-08-27', exclusivo: false, financia: true, predio: 'Construída em 2016', nome: 'Casa Jardim Meridiano', tipo: 'Casa', negocio: 'Venda',
    bairro: 'Jardim Meridiano', preco: 1250000, area: 210, quartos: 4, suites: 2, banheiros: 4, vagas: 3,
    andar: 'Térrea', condominio: 0, iptu: 340,
    resumo: 'Casa térrea em terreno de 450 m², com piscina e churrasqueira.',
    descricao:
      'Casa térrea em terreno plano de 450 m², toda em um pavimento — sem escada em lugar nenhum, o que costuma decidir a compra para quem tem criança pequena ou pai idoso. Living em L com pé-direito de 3,10 m, quatro dormitórios sendo dois suítes e uma área gourmet coberta com churrasqueira e piscina de 6 × 3.',
    itens: ['Terreno de 450 m²', 'Piscina 6 × 3', 'Área gourmet coberta', 'Pé-direito 3,10 m', 'Aquecimento solar', 'Três vagas'],
  },
  {
    cod: 'MR-1103', atualizado: '2026-09-01', exclusivo: true, financia: false, predio: 'Entregue em 2022', nome: 'Studio Farol', tipo: 'Studio', negocio: 'Aluguel',
    bairro: 'Bairro Farol', preco: 2400, area: 38, quartos: 1, suites: 0, banheiros: 1, vagas: 1,
    andar: '14º andar', condominio: 480, iptu: 70,
    resumo: 'Studio mobiliado no 14º andar, a duas quadras da orla.',
    descricao:
      'Studio de 38 m² entregue mobiliado e pronto para morar: cama box, sofá, mesa de trabalho, cooktop, coifa e geladeira já instalados. Prédio novo, com lavanderia coletiva, coworking no térreo e bicicletário. A duas quadras da orla e uma do ponto de ônibus da linha do centro.',
    itens: ['Mobiliado', 'Coworking no prédio', 'Lavanderia coletiva', 'Bicicletário', 'Pet friendly', 'Uma vaga'],
  },
  {
    cod: 'MR-1118', atualizado: '2026-08-19', exclusivo: true, financia: true, predio: 'Entregue em 2019 · 2 unidades por andar', nome: 'Cobertura Enseada', tipo: 'Cobertura', negocio: 'Venda',
    bairro: 'Alto da Enseada', preco: 2480000, area: 268, quartos: 4, suites: 3, banheiros: 5, vagas: 4,
    andar: '19º e 20º', condominio: 1980, iptu: 640, destaque: true,
    resumo: 'Cobertura duplex com terraço de 90 m² e vista para a baía.',
    descricao:
      'Cobertura duplex nos dois últimos andares, com terraço privativo de 90 m² e vista desimpedida para a baía — não há e não haverá construção à frente, por restrição de gabarito da orla. Piso inferior com living de 60 m², lavabo e três suítes; piso superior com master, closet e o terraço com spa, churrasqueira e pergolado.',
    itens: ['Terraço de 90 m²', 'Vista permanente da baía', 'Spa no terraço', 'Master com closet', 'Elevador privativo', 'Quatro vagas'],
  },
  {
    cod: 'MR-1126', atualizado: '2026-08-25', exclusivo: false, financia: true, predio: 'Construído em 2018 · condomínio de 42 casas', nome: 'Sobrado Costa Nova', tipo: 'Sobrado', negocio: 'Venda',
    bairro: 'Costa Nova', preco: 890000, area: 168, quartos: 3, suites: 1, banheiros: 3, vagas: 2,
    andar: 'Dois pavimentos', condominio: 380, iptu: 220,
    resumo: 'Sobrado em condomínio fechado, com quintal e área gourmet.',
    descricao:
      'Sobrado em condomínio fechado de 42 casas, com portaria, quadra e playground. Térreo com sala em dois ambientes, lavabo, cozinha americana e área gourmet aberta para o quintal; superior com três dormitórios, sendo um suíte com sacada. Quintal gramado nos fundos, murado, com espaço para piscina.',
    itens: ['Condomínio fechado', 'Quintal murado', 'Área gourmet', 'Quadra e playground', 'Espaço para piscina', 'Duas vagas'],
  },
  {
    cod: 'MR-1149', atualizado: '2026-09-02', exclusivo: false, financia: false, predio: 'Entregue em 2015', nome: 'Edifício Dunas', tipo: 'Apartamento', negocio: 'Aluguel',
    bairro: 'Parque das Dunas', preco: 3200, area: 74, quartos: 2, suites: 1, banheiros: 2, vagas: 1,
    andar: '5º andar', condominio: 610, iptu: 130,
    resumo: 'Dois dormitórios com suíte, de frente para a praça.',
    descricao:
      'Apartamento de dois dormitórios com suíte, no quinto andar de frente para a praça do Parque das Dunas. Sala com varanda e churrasqueira, cozinha com armários, área de serviço separada. Condomínio com piscina, academia e salão de festas, e taxa que inclui água e gás.',
    itens: ['Varanda com churrasqueira', 'Suíte', 'Academia no prédio', 'Piscina', 'Água e gás inclusos', 'Uma vaga'],
  },
  {
    cod: 'MR-1155', atualizado: '2026-08-14', exclusivo: true, financia: true, predio: 'Galpão de 1948, retrofit em 2021', nome: 'Loft Vila Bandeira', tipo: 'Loft', negocio: 'Venda',
    bairro: 'Vila Bandeira', preco: 615000, area: 66, quartos: 1, suites: 1, banheiros: 2, vagas: 1,
    andar: '2º andar', condominio: 420, iptu: 110,
    resumo: 'Loft de pé-direito duplo em antiga fábrica restaurada.',
    descricao:
      'Loft em galpão fabril de 1948, restaurado e convertido em 18 unidades. Pé-direito duplo de 5,40 m, tijolo aparente original em duas paredes, estrutura metálica à vista e mezanino com o dormitório. Janela industrial de 3 m de largura, voltada para o pátio interno arborizado.',
    itens: ['Pé-direito de 5,40 m', 'Tijolo aparente original', 'Mezanino', 'Janela industrial', 'Prédio tombado', 'Uma vaga'],
  },
  {
    cod: 'MR-1168', atualizado: '2026-08-31', exclusivo: false, financia: true, predio: 'Entregue em 1998 · sem elevador', nome: 'Residencial Morro Azul', tipo: 'Apartamento', negocio: 'Venda',
    bairro: 'Morro Azul', preco: 445000, area: 58, quartos: 2, suites: 0, banheiros: 1, vagas: 1,
    andar: '3º andar', condominio: 390, iptu: 85,
    resumo: 'Dois dormitórios reformado, pronto para entrar.',
    descricao:
      'Apartamento de dois dormitórios com reforma concluída em 2025: elétrica refeita, hidráulica revisada, piso novo em todos os ambientes e banheiro completo. Prédio sem elevador, no terceiro andar. Boa opção de primeiro imóvel — aceita financiamento e o valor está dentro do teto do programa habitacional.',
    itens: ['Reformado em 2025', 'Elétrica refeita', 'Aceita financiamento', 'Sem taxa de condomínio alta', 'Perto do terminal', 'Uma vaga'],
  },
  {
    cod: 'MR-1174', atualizado: '2026-08-22', exclusivo: false, financia: false, predio: 'Construída em 2009', nome: 'Casa Riacho Doce', tipo: 'Casa', negocio: 'Aluguel',
    bairro: 'Riacho Doce', preco: 4800, area: 140, quartos: 3, suites: 1, banheiros: 2, vagas: 2,
    andar: 'Térrea', condominio: 0, iptu: 180,
    resumo: 'Casa térrea com jardim, em rua sem saída.',
    descricao:
      'Casa térrea de três dormitórios em rua sem saída, silenciosa e com pouco movimento de carro. Jardim na frente e quintal com varal coberto nos fundos. Cozinha com armários e fogão embutido, aquecimento solar para os chuveiros. Aceita animais de qualquer porte, sem restrição.',
    itens: ['Rua sem saída', 'Jardim e quintal', 'Aquecimento solar', 'Aceita pets sem restrição', 'Cozinha com armários', 'Duas vagas'],
  },
  {
    cod: 'MR-1190', atualizado: '2026-08-28', exclusivo: true, financia: true, predio: 'Entregue em 2021 · 2 unidades por andar', nome: 'Terraço Praia do Sol', tipo: 'Cobertura', negocio: 'Venda',
    bairro: 'Praia do Sol', preco: 1690000, area: 176, quartos: 3, suites: 2, banheiros: 4, vagas: 3,
    andar: '12º andar', condominio: 1240, iptu: 410,
    resumo: 'Cobertura sem duplex, toda em um piso, com terraço frontal.',
    descricao:
      'Cobertura horizontal: toda a metragem em um único pavimento, sem escada interna, com terraço frontal de 42 m² acompanhando a sala. Três dormitórios, dois suítes, lavabo e dependência completa. O prédio tem apenas duas unidades por andar e a garagem é privativa, fechada com portão próprio.',
    itens: ['Sem escada interna', 'Terraço frontal de 42 m²', 'Duas unidades por andar', 'Garagem privativa fechada', 'Dependência completa', 'Três vagas'],
  },
];

/* as quatro ilustrações de cada imóvel, geradas no build */
const COM_ARTE = IMOVEIS.map((i) => ({ ...i, fotos: galeria(i.cod, i.tipo, i.quartos) }));

const brl = (n: number) =>
  n.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 });

/* o preço se lê diferente conforme o negócio: mês no aluguel, total na venda */
const preco = (i: (typeof IMOVEIS)[number]) =>
  i.negocio === 'Aluguel' ? `${brl(i.preco)}/mês` : brl(i.preco);

const TIPOS = [...new Set(IMOVEIS.map((i) => i.tipo))];

/*
  Quando o anúncio foi mexido pela última vez. Relativo enquanto é recente,
  porque é assim que se lê ("há 3 dias" diz mais que "01/09"); vira data
  absoluta depois de dois meses, senão um build antigo passa a anunciar
  "atualizado há 400 dias" — que é pior do que não dizer nada.
*/
const HOJE = new Date('2026-09-04T12:00:00');
function desdeQuando(iso: string) {
  const d = new Date(`${iso}T12:00:00`);
  const dias = Math.round((HOJE.getTime() - d.getTime()) / 86400000);
  if (dias <= 0) return 'atualizado hoje';
  if (dias === 1) return 'atualizado ontem';
  if (dias <= 60) return `atualizado há ${dias} dias`;
  return `atualizado em ${d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short' })}`;
}

/* o destaque abre a página; o resto vai para a grade */
const VITRINE = COM_ARTE.find((i) => i.destaque) ?? COM_ARTE[0];
const ATUALIZADO = [...IMOVEIS].sort((a, b) => (a.atualizado < b.atualizado ? 1 : -1))[0];

const titulo = `${LOJA.nome} ${LOJA.sub} — imóveis à venda e para alugar em ${LOJA.cidade}`;
const descricao =
  'Imobiliária em Porto Sereno (SC) com carteira de dez imóveis: apartamentos, casas, coberturas, lofts e studios, à venda e para alugar. Cada ficha traz metragem medida, planta, condomínio e IPTU, e a visita se agenda pelo WhatsApp.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  name: `${LOJA.nome} ${LOJA.sub}`,
  description: descricao,
  telephone: LOJA.foneLink,
  email: LOJA.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: LOJA.rua, addressLocality: LOJA.cidade,
    addressRegion: LOJA.uf, postalCode: LOJA.cep, addressCountry: 'BR',
  },
};
---

<Base title={titulo} description={descricao}>
  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta name="theme-color" content="#eff6fe" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Work+Sans:wght@300;400;500;600&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {/*
      Só esconde o que vai ser revelado se houver movimento para revelar. Sem
      JS, ou com movimento reduzido, `anima-on` nunca entra e o conteúdo nasce
      visível — o imóvel é o produto, a entrada é enfeite.
    */}
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.documentElement.classList.add('anima-on');
    </script>
  </Fragment>

  <div class="mi">
    <a class="pular" href="#carteira">Pular para os imóveis</a>
    <span hidden data-zap={LOJA.zap}></span>
    {/*
      Os imóveis com as ilustrações já geradas vão para o cliente numa ilha
      JSON. É o que o modal lê ao abrir — sem uma segunda requisição e sem
      recalcular o SVG no navegador.
    */}
    <script type="application/json" data-dados set:html={JSON.stringify({ imoveis: COM_ARTE, cidade: LOJA.cidade })}></script>

    {/*
      As formas do fundo. Ficam num SVG fixo, atrás de tudo e sem receber
      toque: é o "shape" do brief resolvido em uma camada só, em vez de meia
      dúzia de divs decorativas espalhadas pelo HTML.
    */}
    <svg class="formas" viewBox="0 0 1200 1600" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
      <circle cx="120" cy="180" r="300" fill="#bcd9f6" opacity=".38" />
      <circle cx="1080" cy="520" r="360" fill="#dcebfb" opacity=".7" />
      <circle cx="240" cy="980" r="260" fill="#dcebfb" opacity=".55" />
      <circle cx="960" cy="1340" r="320" fill="#bcd9f6" opacity=".3" />
      <rect x="820" y="60" width="300" height="300" rx="90" fill="#2b7fd4" opacity=".08" />
      <rect x="60" y="620" width="220" height="220" rx="70" fill="#2b7fd4" opacity=".07" />
    </svg>

    {/* ═════════════════ CABEÇALHO ═════════════════ */}
    <header class="topo" data-topo>
      <div class="topo-caixa">
        <a class="marca" href="#inicio" aria-label={`${LOJA.nome} ${LOJA.sub} — início`}>
          <span class="marca-selo" aria-hidden="true">
            <svg viewBox="0 0 40 40" fill="none">
              <circle cx="20" cy="20" r="16" stroke="currentColor" stroke-width="2.4" />
              <path d="M20 8v24M8 20h24" stroke="currentColor" stroke-width="2" opacity=".45" />
              <path d="M20 11l4 9-4 9-4-9z" fill="currentColor" />
            </svg>
          </span>
          <span class="marca-txt">
            <b>{LOJA.nome}</b>
            <i>{LOJA.sub}</i>
          </span>
        </a>

        <nav class="topo-nav" aria-label="Seções">
          <a href="#carteira">Imóveis</a>
          <a href="#sobre">Sobre</a>
          <a href="#contato">Contato</a>
        </nav>

        <a class="btn btn-azul btn-min" href={`https://wa.me/${LOJA.zap}`} rel="noopener">
          <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
          <span class="so-larga">Falar com corretor</span>
          <span class="so-estreita">WhatsApp</span>
        </a>
      </div>
    </header>

    <main id="conteudo">
      {/*
        ═════════════════ ABERTURA ═════════════════

        A abertura mostra um imóvel, não um slogan. Quem entra num site de
        imobiliária quer ver imóvel — e o texto ao lado só precisa dizer que
        carteira é essa. Composição assimétrica de propósito: coluna estreita
        de texto contra o anúncio largo, para a página não abrir com o mesmo
        bloco centrado de sempre.
      */}
      <section class="abertura" id="inicio">
        <div class="caixa abertura-grade">
          <div class="abertura-txt">
            <p class="olho" data-capa>
              <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
              {LOJA.cidade} · {LOJA.uf}
            </p>
            <h1 data-capa>
              {IMOVEIS.length} imóveis por vez.<br />
              <span>Todos visitados por nós.</span>
            </h1>
            <p class="abertura-d" data-capa>
              Medimos a metragem com trena, lemos a matrícula e somamos
              condomínio e IPTU antes de publicar. Se o imóvel tem problema,
              está escrito na ficha.
            </p>
            <p class="abertura-acoes" data-capa>
              <a class="btn btn-azul" href="#carteira">Ver a carteira</a>
              <a class="elo" href={`https://wa.me/${LOJA.zap}`} rel="noopener">
                <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
                Falar com {LOJA.corretor.split(' ')[0]}
              </a>
            </p>
          </div>

          {/* o destaque da semana, com a mesma ficha do card da grade */}
          <article class="vitrine" data-capa>
            <button type="button" class="vitrine-btn" data-abrir={VITRINE.cod}
                    aria-label={`Ver ficha de ${VITRINE.nome}`}>
              <span class="vitrine-arte" set:html={VITRINE.fotos[0].svg} />
              <span class="vitrine-tarja">
                <span class="fita">{VITRINE.negocio}</span>
                <span class="vitrine-ref">{VITRINE.cod}</span>
              </span>
              <span class="vitrine-corpo">
                <span class="vitrine-topo">
                  <span>
                    <span class="vitrine-local">{VITRINE.bairro} · {LOJA.cidade}</span>
                    <span class="vitrine-nome">{VITRINE.nome}</span>
                  </span>
                  <span class="vitrine-preco">{preco(VITRINE)}</span>
                </span>
                <span class="vitrine-ficha">
                  <span>{VITRINE.area} m²</span>
                  <span>{VITRINE.quartos} dorm.</span>
                  <span>{VITRINE.vagas} vagas</span>
                  <span>{VITRINE.andar}</span>
                </span>
                <span class="vitrine-ver">Ver ficha completa <i class="fa-solid fa-arrow-right" aria-hidden="true" /></span>
              </span>
            </button>
          </article>
        </div>
      </section>

      {/* ═════════════════ CARTEIRA ═════════════════ */}
      <section class="secao carteira" id="carteira">
        <div class="caixa">
          {/*
            Barra de listagem, e não cabeçalho de seção: título, contagem e
            filtros na mesma faixa. É o que um portal de imóvel faz, e evita
            repetir pela terceira vez o par "olho + título + lead".
          */}
          <div class="carteira-topo" data-anima>
            <div>
              <h2>A carteira</h2>
              <p class="carteira-nota">
                <span data-conta aria-live="polite">{IMOVEIS.length} imóveis</span>
                <span class="ponto" aria-hidden="true">·</span>
                {desdeQuando(ATUALIZADO.atualizado)}
              </p>
            </div>

            <div class="filtros" role="group" aria-label="Filtrar imóveis">
              <div class="filtro-grupo" role="group" aria-label="Tipo de negócio">
                <button type="button" class="chip ativo" data-negocio="todos" aria-pressed="true">Todos</button>
                <button type="button" class="chip" data-negocio="Venda" aria-pressed="false">Venda</button>
                <button type="button" class="chip" data-negocio="Aluguel" aria-pressed="false">Aluguel</button>
              </div>
              <div class="filtro-grupo" role="group" aria-label="Tipo de imóvel">
                <button type="button" class="chip ativo" data-tipo="todos" aria-pressed="true">Qualquer tipo</button>
                {TIPOS.map((t) => (
                  <button type="button" class="chip" data-tipo={t} aria-pressed="false">{t}</button>
                ))}
              </div>
            </div>
          </div>

          <ul class="grade">
            {
              COM_ARTE.map((i) => (
                <li class="cartao" data-imovel={i.cod} data-negocio-v={i.negocio} data-tipo-v={i.tipo} data-anima>
                  <button type="button" class="cartao-btn" data-abrir={i.cod}
                          aria-label={`Ver ficha de ${i.nome}, ${i.tipo} em ${i.bairro}`}>
                    <span class="cartao-arte" set:html={i.fotos[0].svg} />
                    <span class="cartao-fitas">
                      <span class:list={['fita', i.negocio === 'Aluguel' && 'fita-alt']}>{i.negocio}</span>
                      {i.exclusivo && <span class="fita fita-dest">Exclusivo</span>}
                    </span>

                    <span class="cartao-corpo">
                      {/* ref e data: os dois dados que separam anúncio de enfeite */}
                      <span class="cartao-meta">
                        <b>{i.cod}</b>
                        <span class="ponto" aria-hidden="true">·</span>
                        {desdeQuando(i.atualizado)}
                      </span>
                      <span class="cartao-nome">{i.nome}</span>
                      <span class="cartao-local">
                        <i class="fa-solid fa-location-dot" aria-hidden="true" />
                        {i.bairro} · {LOJA.cidade}
                      </span>

                      <span class="cartao-ficha">
                        <span>{i.area} m²</span>
                        <span>{i.quartos} dorm.</span>
                        {i.suites > 0 && <span>{i.suites} suíte{i.suites > 1 ? 's' : ''}</span>}
                        <span>{i.vagas} vaga{i.vagas > 1 ? 's' : ''}</span>
                      </span>

                      <span class="cartao-pe">
                        <span class="cartao-valor">
                          <b>{preco(i)}</b>
                          <small>
                            {i.condominio > 0 ? `+ ${brl(i.condominio)} cond.` : 'sem condomínio'}
                            {i.financia && i.negocio === 'Venda' ? ' · aceita financiamento' : ''}
                          </small>
                        </span>
                        <span class="cartao-ver" aria-hidden="true"><i class="fa-solid fa-arrow-right" /></span>
                      </span>
                    </span>
                  </button>
                </li>
              ))
            }
          </ul>

          <p class="vazio" data-vazio hidden>
            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
            Nenhum imóvel com esse filtro. Tente outra combinação.
          </p>
        </div>
      </section>

      {/*
        ═════════════════ SOBRE ═════════════════

        Só texto e a ficha da imobiliária. Os três cartões de "promessa" que
        moravam aqui repetiam, em caixa, o que o parágrafo ao lado já dizia em
        prosa — e três caixas iguais é justamente o que faz a página parecer
        montada por gerador.
      */}
      <section class="secao sobre" id="sobre">
        <div class="caixa sobre-grade">
          <div data-anima>
            <p class="olho"><i class="fa-solid fa-handshake" aria-hidden="true"></i>Sobre</p>
            <h2>Carteira pequena, de propósito</h2>
            <p class="sobre-p">
              Trabalhamos com cerca de dez imóveis por vez. Não é modéstia: é o
              número que dá para visitar pessoalmente, medir com trena, conferir
              matrícula e conhecer o síndico antes de anunciar.
            </p>
            <p class="sobre-p">
              Por isso a ficha traz a metragem que medimos e não a da escritura,
              o custo mensal somado e o que precisa de reforma. Descobrir na
              visita custa o seu sábado.
            </p>
            <p class="sobre-p">
              Quem atende é sempre a mesma pessoa, do primeiro WhatsApp à
              entrega da chave. Não passamos o cliente de corretor em corretor.
            </p>
          </div>

          {/* ficha da empresa: dado verificável, não selo de confiança */}
          <dl class="ficha-empresa" data-anima>
            <div><dt>Responsável técnico</dt><dd>{LOJA.corretor}</dd></div>
            <div><dt>Registro</dt><dd>{LOJA.creci}</dd></div>
            <div><dt>Escritório</dt><dd>{LOJA.rua} · {LOJA.bairro}</dd></div>
            <div><dt>Atendimento</dt><dd>Seg a sex, 9h–18h · sáb, 9h–13h</dd></div>
            <div><dt>Visitas</dt><dd>Agendadas, inclusive sábado de manhã</dd></div>
          </dl>
        </div>
      </section>

      {/* ═════════════════ CONTATO ═════════════════ */}
      <section class="secao contato" id="contato">
        <div class="caixa">
          <div class="chamada" data-anima>
            <div class="chamada-txt">
              <h2>Achou um, ou não achou nenhum?</h2>
              <p>
                Nos dois casos, fale com a gente. Se o que você procura não está
                na carteira, procuramos — e avisamos quando entrar.
              </p>
              {/*
                O caminho da visita em uma linha. Era uma grade de quatro
                cartões numerados com ícone; virou uma frase, que é o tamanho
                que a informação merece.
              */}
              <p class="chamada-passos">
                Visita agendada por WhatsApp
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                proposta por escrito
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                documentação conferida antes do sinal
              </p>
            </div>
            <div class="chamada-acoes">
              <a class="btn btn-azul btn-g" href={`https://wa.me/${LOJA.zap}`} rel="noopener">
                <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
                Chamar no WhatsApp
              </a>
              <a class="btn btn-vaz btn-g" href={`tel:${LOJA.foneLink}`}>
                <i class="fa-solid fa-phone" aria-hidden="true"></i>
                {LOJA.fone}
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    {/* ═════════════════ RODAPÉ ═════════════════ */}
    <footer class="rodape">
      <div class="caixa">
        <div class="rodape-grade">
          <div>
            <p class="rodape-marca"><b>{LOJA.nome}</b> <i>{LOJA.sub}</i></p>
            <p class="rodape-d">
              {LOJA.creci} · {LOJA.rua}, {LOJA.bairro}<br />
              {LOJA.cidade}/{LOJA.uf} — CEP {LOJA.cep}
            </p>
            <ul class="redes">
              <li><a href={`https://wa.me/${LOJA.zap}`} rel="noopener" aria-label="WhatsApp"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i></a></li>
              <li><a href={`https://instagram.com/${LOJA.insta}`} rel="noopener" aria-label="Instagram"><i class="fa-brands fa-instagram" aria-hidden="true"></i></a></li>
              <li><a href={`tel:${LOJA.foneLink}`} aria-label="Telefone"><i class="fa-solid fa-phone" aria-hidden="true"></i></a></li>
              <li><a href={`mailto:${LOJA.email}`} aria-label="E-mail"><i class="fa-regular fa-envelope" aria-hidden="true"></i></a></li>
            </ul>
          </div>

          <div>
            <p class="rodape-t">Atendimento</p>
            <dl class="rodape-horas">
              <div><dt>Segunda a sexta</dt><dd>09h às 18h</dd></div>
              <div><dt>Sábado</dt><dd>09h às 13h</dd></div>
              <div><dt>Domingo</dt><dd>Plantão por agendamento</dd></div>
            </dl>
          </div>

          <div>
            <p class="rodape-t">Contato</p>
            <ul class="rodape-contato">
              <li><i class="fa-solid fa-phone" aria-hidden="true"></i><a href={`tel:${LOJA.foneLink}`}>{LOJA.fone}</a></li>
              <li><i class="fa-brands fa-whatsapp" aria-hidden="true"></i><a href={`https://wa.me/${LOJA.zap}`} rel="noopener">{LOJA.zapFmt}</a></li>
              <li><i class="fa-regular fa-envelope" aria-hidden="true"></i><a href={`mailto:${LOJA.email}`}>{LOJA.email}</a></li>
            </ul>
          </div>
        </div>

        <p class="rodape-legal">
          Demonstração de portfólio. {LOJA.nome} {LOJA.sub} não existe: cidade,
          bairros, imóveis, preços, CRECI e telefone são fictícios, as imagens
          são ilustrações geradas pelo próprio site e nenhuma visita é agendada
          de verdade.
        </p>
      </div>
    </footer>

    {/* ═════════════════ FICHA DO IMÓVEL (dialog nativo) ═════════════════ */}
    <dialog class="ficha" data-ficha aria-label="Ficha do imóvel">
      <button type="button" class="ficha-x" data-fechar aria-label="Fechar ficha">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>

      <div class="ficha-rolo">
        {/* carrossel */}
        <div class="carro" data-carro>
          <div class="carro-trilho" data-trilho></div>

          <button type="button" class="carro-seta carro-ant" data-passo="-1" aria-label="Foto anterior">
            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
          </button>
          <button type="button" class="carro-seta carro-prox" data-passo="1" aria-label="Próxima foto">
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
          </button>

          <p class="carro-rotulo" data-carro-rotulo>—</p>
          <div class="carro-pontos" data-pontos role="tablist" aria-label="Fotos do imóvel"></div>
        </div>

        <div class="ficha-corpo">
          <p class="ficha-local">
            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
            <span data-f-local>—</span>
            <span class="ficha-cod" data-f-cod>—</span>
          </p>
          <h2 data-f-nome>—</h2>

          <p class="ficha-preco">
            <b data-f-preco>—</b>
            <span data-f-negocio>—</span>
          </p>

          {/* custo mensal somado: é a conta que decide a compra */}
          <dl class="ficha-custos">
            <div><dt>Condomínio</dt><dd data-f-cond>—</dd></div>
            <div><dt>IPTU (mês)</dt><dd data-f-iptu>—</dd></div>
            <div class="custo-total"><dt>Custo mensal</dt><dd data-f-mensal>—</dd></div>
          </dl>

          <ul class="ficha-ficha" data-f-atributos></ul>

          {/* a linha do prédio: idade e porte, o que ninguém põe e todo mundo pergunta */}
          <p class="ficha-predio">
            <i class="fa-solid fa-building" aria-hidden="true"></i>
            <span data-f-predio>—</span>
          </p>

          <h3 class="ficha-t">Sobre o imóvel</h3>
          <p class="ficha-desc" data-f-desc>—</p>

          <h3 class="ficha-t">O que está incluso</h3>
          <ul class="ficha-itens" data-f-itens></ul>
        </div>
      </div>

      {/* a ação fica presa no rodapé do modal: some do alcance ao rolar, não */}
      <div class="ficha-acao">
        <div class="ficha-acao-preco">
          <span data-f-preco2>—</span>
          <small data-f-area>—</small>
        </div>
        <a class="btn btn-azul btn-g" data-f-zap href="#" rel="noopener">
          <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
          Agendar visita
        </a>
      </div>
    </dialog>
  </div>
</Base>

<style>
  /*
    Azul-claro, marinho e branco. O claro é o fundo e a superfície; o marinho é
    o texto e o vulto; o azul-marca só aparece em ação e em dado. Cantos
    generosos em tudo (`--raio-g` de 22px, chip em 999px) — o "arredondado" do
    brief é uma regra de forma, não um enfeite pontual.

    Contraste conferido: marinho #0B2A4A sobre branco dá 14,3:1; o azul de
    botão é o escuro #1E5FA8, que com texto branco dá 6,3:1. O #2B7FD4 fica
    para ícone e número grande, onde 4,1:1 basta.
  */
  .mi {
    --branco: #ffffff;
    --claro: #eff6fe;
    --claro-2: #dcebfb;
    --claro-3: #bcd9f6;

    --marinho: #0b2a4a;
    --marinho-2: #14395f;
    --azul: #2b7fd4;
    --azul-esc: #1e5fa8;
    --azul-mais: #174a85;

    --c60: #5a7183;
    --c40: #7d92a3;
    --borda: #dbe6f1;

    --raio: 12px;
    --raio-g: 22px;
    --raio-xg: 30px;
    --t: 0.4s;
    --e: cubic-bezier(0.22, 0.61, 0.36, 1);
    --topo-h: 4.4rem;

    --s1: 0 1px 2px rgba(11, 42, 74, 0.06), 0 4px 14px -6px rgba(11, 42, 74, 0.12);
    --s2: 0 6px 18px -8px rgba(11, 42, 74, 0.18), 0 18px 40px -22px rgba(11, 42, 74, 0.28);
    --s3: 0 12px 28px -12px rgba(11, 42, 74, 0.24), 0 40px 80px -40px rgba(11, 42, 74, 0.4);

    position: relative;
    background: var(--claro);
    color: var(--marinho);
    font-family: 'Work Sans', ui-sans-serif, system-ui, sans-serif;
    font-weight: 400;
    line-height: 1.7;
    overflow-x: clip;
  }
  :global(body) { background: #eff6fe; color: #0b2a4a; }
  :global(html) { scrollbar-color: #bcd9f6 #eff6fe; }
  :global(::selection) { background: #2b7fd4; color: #fff; }

  .pular {
    position: absolute; left: -9999px; top: 0; z-index: 100;
    background: var(--azul-esc); color: #fff; padding: 0.7rem 1.1rem;
    text-decoration: none; border-radius: 0 0 var(--raio) 0; font-weight: 600;
  }
  .pular:focus { left: 0; }

  /* as formas: fixas, atrás de tudo, sem receber toque */
  .formas {
    position: fixed; inset: 0; z-index: 0;
    width: 100%; height: 100%; pointer-events: none;
  }
  .topo, main, .rodape { position: relative; z-index: 2; }

  /* ---------- tipografia ---------- */
  h1, h2, h3 { margin: 0; text-wrap: balance; font-family: 'Outfit', sans-serif; font-weight: 600; }
  h1 { font-size: clamp(2.2rem, 7vw, 4rem); line-height: 1.05; letter-spacing: -0.03em; }
  h1 span { color: var(--azul-esc); }
  h2 { font-size: clamp(1.6rem, 4.4vw, 2.5rem); line-height: 1.12; letter-spacing: -0.02em; }
  h3 { font-size: 1.02rem; font-weight: 600; line-height: 1.35; }
  p { margin: 0; text-wrap: pretty; }
  .lead { font-size: 1rem; color: var(--c60); max-width: 56ch; }

  .olho {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.4rem 0.9rem; border-radius: 999px;
    background: var(--claro-2); color: var(--azul-esc);
    font-size: 0.74rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
    margin-bottom: 1.1rem;
  }

  .caixa { max-width: 1180px; margin: 0 auto; padding-inline: clamp(1.1rem, 4vw, 2.4rem); }
  .secao { position: relative; padding-block: clamp(3rem, 8vw, 5.5rem); }
  .cab { margin-bottom: clamp(1.8rem, 4vw, 2.8rem); max-width: 58ch; }
  .cab-centro { margin-inline: auto; text-align: center; }
  .cab .lead { margin-top: 0.9rem; }
  .mi section[id] { scroll-margin-top: calc(var(--topo-h) + 0.6rem); }

  /* ---------- botões ---------- */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem;
    min-height: 46px; padding: 0.75rem 1.5rem;
    border: 1px solid transparent; border-radius: 999px;
    font-family: 'Outfit', sans-serif; font-size: 0.92rem; font-weight: 600;
    text-decoration: none; white-space: nowrap; cursor: pointer;
    transition: background var(--t) var(--e), color var(--t) var(--e),
      border-color var(--t) var(--e), box-shadow var(--t) var(--e), translate var(--t) var(--e);
  }
  .btn-g { padding: 0.95rem 1.9rem; font-size: 1rem; min-height: 52px; }
  .btn-min { padding: 0.55rem 1.2rem; font-size: 0.85rem; min-height: 42px; }
  .btn-azul { background: var(--azul-esc); color: #fff; box-shadow: var(--s2); }
  .btn-azul:hover { background: var(--azul-mais); translate: 0 -2px; box-shadow: var(--s3); }
  .btn-vaz { background: var(--branco); color: var(--marinho); border-color: var(--borda); box-shadow: var(--s1); }
  .btn-vaz:hover { border-color: var(--azul); color: var(--azul-esc); translate: 0 -2px; box-shadow: var(--s2); }
  .mi :is(a, button):focus-visible { outline: 2px solid var(--azul-esc); outline-offset: 3px; }

  /* ---------- cabeçalho ---------- */
  .topo {
    position: sticky; top: 0; z-index: 60;
    background: rgba(239, 246, 254, 0.82);
    backdrop-filter: blur(16px) saturate(1.3);
    border-bottom: 1px solid transparent;
    transition: border-color var(--t) var(--e), box-shadow var(--t) var(--e);
  }
  .topo[data-topo='rolou'] { border-bottom-color: var(--borda); box-shadow: 0 8px 24px -18px rgba(11, 42, 74, 0.4); }
  .topo-caixa {
    max-width: 1180px; margin: 0 auto;
    padding: 0.5rem clamp(1.1rem, 4vw, 2.4rem); min-height: var(--topo-h);
    display: flex; align-items: center; gap: clamp(0.6rem, 2vw, 1.6rem);
  }
  .marca { display: inline-flex; align-items: center; gap: 0.65rem; text-decoration: none; color: var(--marinho); margin-right: auto; }
  .marca-selo { width: 2.3rem; height: 2.3rem; flex: none; color: var(--azul-esc); }
  .marca-selo svg { width: 100%; height: 100%; display: block; }
  .marca-txt { display: flex; align-items: baseline; gap: 0.35rem; font-family: 'Outfit', sans-serif; }
  .marca-txt b { font-size: 1.28rem; font-weight: 700; letter-spacing: -0.02em; }
  .marca-txt i { font-style: normal; font-size: 0.95rem; font-weight: 400; color: var(--c60); }
  .topo-nav { display: none; gap: clamp(1rem, 2.4vw, 2rem); }
  .topo-nav a {
    color: var(--c60); text-decoration: none; font-size: 0.9rem; font-weight: 500;
    transition: color var(--t) var(--e);
  }
  .topo-nav a:hover { color: var(--azul-esc); }
  .so-estreita { display: inline; }
  .so-larga { display: none; }
  @media (min-width: 900px) {
    .topo-nav { display: flex; }
    .so-estreita { display: none; }
    .so-larga { display: inline; }
  }

  /* ---------- abertura ---------- */
  /*
    Assimétrica: texto estreito contra o anúncio largo. No celular a ordem
    inverte pouco — texto primeiro, porque é ele que diz que carteira é essa,
    e o imóvel logo abaixo, ainda na primeira rolagem.
  */
  .abertura { position: relative; padding-block: clamp(2rem, 6vw, 4rem) clamp(2.4rem, 6vw, 4rem); }
  .abertura-grade { display: grid; gap: clamp(1.8rem, 4vw, 3rem); align-items: center; }
  @media (min-width: 940px) {
    .abertura-grade { grid-template-columns: 0.82fr 1.18fr; gap: clamp(2.4rem, 4vw, 4rem); }
  }
  .abertura-d { margin-top: 1.2rem; color: var(--c60); font-size: 1rem; max-width: 42ch; }
  .abertura-acoes { margin-top: 1.8rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem 1.4rem; }
  /* o segundo caminho é um elo de texto, não um segundo botão: dois botões
     lado a lado dividem a atenção e nenhum vira ação principal */
  .elo {
    display: inline-flex; align-items: center; gap: 0.5rem;
    color: var(--azul-esc); font-weight: 600; font-size: 0.92rem;
    text-decoration: none; border-bottom: 1px solid transparent; padding-bottom: 2px;
    transition: border-color var(--t) var(--e);
  }
  .elo:hover { border-bottom-color: var(--azul-esc); }

  /* ---------- vitrine (o destaque da abertura) ---------- */
  .vitrine { min-width: 0; }
  .vitrine-btn {
    display: block; width: 100%; padding: 0; overflow: hidden; cursor: pointer;
    text-align: left; font-family: inherit; color: inherit;
    background: var(--branco); border: 1px solid var(--borda);
    border-radius: var(--raio-xg); box-shadow: var(--s2);
    transition: border-color var(--t) var(--e), box-shadow var(--t) var(--e);
  }
  .vitrine-btn:hover { border-color: var(--claro-3); box-shadow: var(--s3); }
  .vitrine-arte { display: block; position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: var(--claro-2); }
  .vitrine-arte :global(svg) { display: block; width: 100%; height: 100%; }
  .vitrine-tarja {
    position: absolute; top: 1rem; left: 1rem; right: 1rem;
    display: flex; align-items: center; justify-content: space-between; gap: 0.6rem;
  }
  .vitrine-ref {
    padding: 0.3rem 0.7rem; border-radius: 999px;
    background: rgba(255, 255, 255, 0.92); color: var(--marinho);
    font-family: ui-monospace, monospace; font-size: 0.7rem; box-shadow: var(--s1);
  }
  .vitrine-corpo { display: grid; gap: 0.9rem; padding: 1.3rem clamp(1.2rem, 3vw, 1.8rem) 1.4rem; }
  .vitrine-topo { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.6rem 1.2rem; }
  .vitrine-local { display: block; font-size: 0.78rem; color: var(--c40); }
  .vitrine-nome { display: block; font-family: 'Outfit', sans-serif; font-size: clamp(1.25rem, 3vw, 1.6rem); font-weight: 600; letter-spacing: -0.01em; }
  .vitrine-preco { font-family: 'Outfit', sans-serif; font-size: clamp(1.2rem, 3vw, 1.5rem); font-weight: 700; color: var(--azul-esc); }
  .vitrine-ficha {
    display: flex; flex-wrap: wrap; gap: 0.4rem 0.8rem;
    padding-top: 0.9rem; border-top: 1px solid var(--borda);
    font-size: 0.84rem; color: var(--c60);
  }
  /* separador entre os itens da ficha, sem precisar de um <span> por vão */
  .vitrine-ficha > span + span::before { content: '·'; margin-right: 0.8rem; color: var(--c40); }
  .vitrine-ver {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: 0.85rem; font-weight: 600; color: var(--azul-esc);
  }
  .vitrine-ver i { font-size: 0.7rem; transition: translate var(--t) var(--e); }
  .vitrine-btn:hover .vitrine-ver i { translate: 4px 0; }

  /* ---------- barra da carteira ---------- */
  .carteira-topo {
    display: grid; gap: 1.2rem; margin-bottom: clamp(1.4rem, 3vw, 2rem);
    padding-bottom: 1.2rem; border-bottom: 1px solid var(--borda);
  }
  @media (min-width: 1000px) {
    .carteira-topo { grid-template-columns: auto 1fr; align-items: end; gap: 2rem; }
    .carteira-topo .filtros { justify-items: end; }
  }
  .carteira-nota {
    margin-top: 0.4rem; font-size: 0.85rem; color: var(--c40);
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem;
  }
  .ponto { color: var(--claro-3); }

  /* ---------- filtros ---------- */
  .filtros { display: grid; gap: 0.7rem; margin-bottom: 1.2rem; }
  .filtro-grupo { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip {
    min-height: 42px; padding: 0.5rem 1.1rem;
    border: 1px solid var(--borda); border-radius: 999px;
    background: var(--branco); color: var(--c60); cursor: pointer;
    font-family: 'Outfit', sans-serif; font-size: 0.86rem; font-weight: 500;
    transition: background var(--t) var(--e), color var(--t) var(--e),
      border-color var(--t) var(--e), box-shadow var(--t) var(--e);
  }
  .chip:hover { border-color: var(--azul); color: var(--azul-esc); }
  .chip.ativo { background: var(--marinho); border-color: var(--marinho); color: #fff; box-shadow: var(--s1); }
  .conta { font-size: 0.85rem; color: var(--c40); margin-bottom: 1.2rem; }

  /* ---------- grade de imóveis ---------- */
  .grade {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: clamp(1rem, 2.4vw, 1.5rem);
    grid-template-columns: 1fr;
  }
  @media (min-width: 620px) { .grade { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) {
    .grade { grid-template-columns: repeat(3, 1fr); }
    /*
      O primeiro anúncio ocupa duas colunas e deita a foto ao lado do texto.
      Dez caixas idênticas é o que mais denuncia página montada por gerador —
      basta um elemento fora da régua para a grade parar de parecer template.
    */
    .cartao:first-child { grid-column: span 2; }
    .cartao:first-child .cartao-btn { flex-direction: row; align-items: stretch; }
    .cartao:first-child .cartao-arte { flex: 0 0 46%; aspect-ratio: auto; }
    .cartao:first-child .cartao-corpo { flex: 1; justify-content: center; padding: 1.6rem 1.7rem; }
    .cartao:first-child .cartao-nome { font-size: 1.45rem; }
    /*
      No cartão em pé a ficha desce com `margin-top: auto` para alinhar o rodapé
      dos três da fileira. Deitado não há fileira para alinhar — e o auto abre
      um vão no meio do texto. Aqui o bloco volta a ser fluido.
    */
    .cartao:first-child .cartao-ficha { margin-top: 0.4rem; }
  }
  .cartao { min-width: 0; }
  .cartao[hidden] { display: none; }

  /*
    O cartão inteiro é um botão. Área de toque enorme no celular, e um só
    elemento focável por imóvel — em vez de um link no título e outro na foto,
    que faz o teclado passar duas vezes pela mesma coisa.
  */
  .cartao-btn {
    display: flex; flex-direction: column; width: 100%; height: 100%;
    padding: 0; text-align: left; cursor: pointer; overflow: hidden;
    background: var(--branco); border: 1px solid var(--borda);
    border-radius: var(--raio-xg); box-shadow: var(--s1);
    font-family: inherit; color: inherit;
