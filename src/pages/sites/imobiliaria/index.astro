  .rodape-horas { margin: 0; display: grid; gap: 0.45rem; font-size: 0.85rem; }
  .rodape-horas > div { display: flex; justify-content: space-between; gap: 0.8rem; }
  .rodape-horas dt { color: var(--c60); }
  .rodape-horas dd { margin: 0; text-align: right; }
  .rodape-contato { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; font-size: 0.85rem; }
  .rodape-contato li { display: grid; grid-template-columns: 1.1rem 1fr; gap: 0.6rem; align-items: center; }
  .rodape-contato i { color: var(--azul); }
  .rodape-contato a { color: var(--c60); text-decoration: none; transition: color var(--t) var(--e); }
  .rodape-contato a:hover { color: var(--azul-esc); }
  .rodape-legal {
    margin-top: 2.2rem; padding-top: 1.3rem; border-top: 1px solid var(--borda);
    font-size: 0.75rem; color: var(--c40); max-width: 72ch;
  }

  /* ══════════════ FICHA (modal) ══════════════ */
  .ficha {
