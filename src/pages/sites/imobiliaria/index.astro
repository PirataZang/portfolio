  }
  .carro :global(.ponto::before) {
    width: 7px; border-radius: 50%;
    background: rgba(255, 255, 255, 0.6);
  }
  .carro :global(.ponto::after) {
    width: 20px; border-radius: 999px; background: #fff;
    opacity: 0; transform: scaleX(0.35);
  }
  .carro :global(.ponto[aria-selected='true']::before) { opacity: 0; }
  .carro :global(.ponto[aria-selected='true']::after) { opacity: 1; transform: scaleX(1); }

  /* ---------- corpo da ficha ---------- */
  .ficha-corpo { padding: clamp(1.2rem, 3vw, 2rem); }
  .ficha-local {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem;
    font-size: 0.82rem; color: var(--c60);
  }
  .ficha-local > i { color: var(--azul); }
  .ficha-cod {
    margin-left: auto; padding: 0.2rem 0.6rem; border-radius: 999px;
    background: var(--claro-2); color: var(--azul-esc);
    font-family: ui-monospace, monospace; font-size: 0.72rem;
  }
  .ficha-corpo h2 { margin-top: 0.5rem; }
  .ficha-preco { display: flex; align-items: baseline; gap: 0.6rem; margin-top: 0.9rem; flex-wrap: wrap; }
  .ficha-preco b { font-family: 'Outfit', sans-serif; font-size: clamp(1.6rem, 5vw, 2.1rem); font-weight: 700; color: var(--azul-esc); }
  .ficha-preco span { font-size: 0.82rem; color: var(--c40); }

  .ficha-custos {
    margin: 1.2rem 0 0; padding: 1rem 1.2rem;
    background: var(--claro); border: 1px solid var(--borda); border-radius: var(--raio-g);
    display: grid; gap: 0.45rem; font-size: 0.88rem;
  }
  .ficha-custos > div { display: flex; justify-content: space-between; gap: 1rem; }
  .ficha-custos dt { color: var(--c60); }
  .ficha-custos dd { margin: 0; font-weight: 500; }
  /* a soma é o número que decide, então ganha peso e uma linha para separar */
  .custo-total { padding-top: 0.5rem; border-top: 1px dashed var(--borda); font-weight: 600; }
  .custo-total dd { color: var(--azul-esc); font-family: 'Outfit', sans-serif; font-size: 1.05rem; }

  .ficha-ficha {
    list-style: none; margin: 1.2rem 0 0; padding: 0;
    display: grid; gap: 0.6rem; grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
  }
  .ficha :global(.at) {
    padding: 0.8rem 0.9rem; border-radius: var(--raio);
    background: var(--branco); border: 1px solid var(--borda); text-align: center;
  }
  .ficha :global(.at i) { color: var(--azul); font-size: 0.9rem; }
  .ficha :global(.at b) { display: block; margin-top: 0.3rem; font-family: 'Outfit', sans-serif; font-size: 1.05rem; font-weight: 600; }
  .ficha :global(.at span) { display: block; font-size: 0.72rem; color: var(--c40); }

  .ficha-predio {
    margin-top: 1.2rem; padding: 0.8rem 1rem;
    display: flex; align-items: center; gap: 0.65rem;
    background: var(--claro); border-radius: var(--raio);
    font-size: 0.86rem; color: var(--c60);
  }
  .ficha-predio i { color: var(--azul); }
  .ficha-t { margin-top: 1.6rem; font-size: 0.76rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c40); }
  .ficha-desc { margin-top: 0.7rem; font-size: 0.94rem; color: var(--c60); }
  .ficha-itens { list-style: none; margin: 0.8rem 0 0; padding: 0; display: grid; gap: 0.5rem; }
  @media (min-width: 620px) { .ficha-itens { grid-template-columns: 1fr 1fr; } }
  .ficha :global(.item) { display: grid; grid-template-columns: 1.1rem 1fr; gap: 0.6rem; align-items: start; font-size: 0.88rem; color: var(--c60); }
  .ficha :global(.item i) { color: var(--azul); font-size: 0.8rem; margin-top: 0.32rem; }

  .ficha-acao {
    display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;
    padding: 0.9rem clamp(1.2rem, 3vw, 2rem) calc(0.9rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--borda); background: var(--branco);
    box-shadow: 0 -10px 30px -20px rgba(11, 42, 74, 0.5);
  }
  .ficha-acao-preco { display: grid; line-height: 1.2; margin-right: auto; }
  .ficha-acao-preco span { font-family: 'Outfit', sans-serif; font-size: 1.15rem; font-weight: 700; }
  .ficha-acao-preco small { font-size: 0.75rem; color: var(--c40); }
  .ficha-acao .btn { flex: 1 1 12rem; }
  @media (min-width: 560px) { .ficha-acao .btn { flex: 0 0 auto; } }

