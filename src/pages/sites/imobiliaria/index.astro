  */
  const reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const SAIDA = [0.22, 0.61, 0.36, 1] as const;

  const brl = (n: number) =>
    n.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 });

  /* ═════════════ 1. filtro da carteira ═════════════ */
  function filtrar() {
    const cartoes = [...document.querySelectorAll<HTMLElement>('[data-imovel]')];
    const conta = document.querySelector<HTMLElement>('[data-conta]');
    const vazio = document.querySelector<HTMLElement>('[data-vazio]');
    if (!cartoes.length) return;

    const estado = { negocio: 'todos', tipo: 'todos' };

    const aplicar = () => {
      let n = 0;
      for (const c of cartoes) {
        const ok =
          (estado.negocio === 'todos' || c.dataset.negocioV === estado.negocio) &&
          (estado.tipo === 'todos' || c.dataset.tipoV === estado.tipo);
        c.hidden = !ok;
        if (ok) n++;
      }
      if (conta) conta.textContent = n === 1 ? '1 imóvel' : `${n} imóveis`;
      if (vazio) vazio.hidden = n > 0;

      /* os que ficaram entram de novo: a grade remonta, então ela reanima */
      if (!reduz) {
        const vistos = cartoes.filter((c) => !c.hidden);
        animate(
          vistos,
          { opacity: [0, 1], transform: ['scale(0.96) translateY(10px)', 'scale(1) translateY(0px)'] },
          { duration: 0.4, delay: stagger(0.04), ease: SAIDA },
        );
      }
    };

    document.querySelectorAll<HTMLElement>('[data-negocio],[data-tipo]').forEach((b) => {
      b.addEventListener('click', () => {
        const chave = b.dataset.negocio ? 'negocio' : 'tipo';
        const valor = b.dataset.negocio ?? b.dataset.tipo!;
        estado[chave] = valor;
        // o grupo inteiro perde o estado antes de o clicado ganhar
        document
          .querySelectorAll<HTMLElement>(`[data-${chave}]`)
          .forEach((o) => {
            const ativo = o === b;
            o.classList.toggle('ativo', ativo);
            o.setAttribute('aria-pressed', String(ativo));
          });
        aplicar();
      });
    });
  }

  /* ═════════════ 2. ficha em modal, com carrossel ═════════════ */
  type Imovel = {
    cod: string; nome: string; tipo: string; negocio: string; bairro: string;
    preco: number; area: number; quartos: number; suites: number; banheiros: number;
    vagas: number; andar: string; condominio: number; iptu: number;
    descricao: string; itens: string[]; predio: string;
    fotos: { t: string; svg: string }[];
  };

  function ficha(dados: Imovel[], cidade: string) {
    const modal = document.querySelector<HTMLDialogElement>('[data-ficha]');
    if (!modal) return;

    const trilho = modal.querySelector<HTMLElement>('[data-trilho]')!;
    const pontos = modal.querySelector<HTMLElement>('[data-pontos]')!;
    const rotulo = modal.querySelector<HTMLElement>('[data-carro-rotulo]')!;
    const setas = [...modal.querySelectorAll<HTMLButtonElement>('[data-passo]')];
    const set = (sel: string, v: string) => {
      const el = modal.querySelector<HTMLElement>(sel);
      if (el) el.textContent = v;
    };

    let atual: Imovel | null = null;
    let slide = 0;

    const irPara = (n: number, liso = true) => {
      if (!atual) return;
      slide = Math.max(0, Math.min(atual.fotos.length - 1, n));
      trilho.scrollTo({ left: slide * trilho.clientWidth, behavior: liso && !reduz ? 'smooth' : 'auto' });
      pintarEstado();
    };

    /* o estado do carrossel sai da posição real do trilho, e não de um contador
       paralelo: assim arrastar com o dedo mexe nos pontos igual ao botão */
    const pintarEstado = () => {
      if (!atual) return;
      rotulo.textContent = atual.fotos[slide]?.t ?? '';
      [...pontos.children].forEach((p, i) =>
        p.setAttribute('aria-selected', String(i === slide)),
      );
      setas[0].disabled = slide === 0;
      setas[1].disabled = slide === atual.fotos.length - 1;
    };

    let quieto = 0;
    trilho.addEventListener('scroll', () => {
      clearTimeout(quieto);
      quieto = window.setTimeout(() => {
        const n = Math.round(trilho.scrollLeft / Math.max(1, trilho.clientWidth));
        if (n !== slide) { slide = n; pintarEstado(); }
      }, 90);
    }, { passive: true });

    setas.forEach((b) =>
      b.addEventListener('click', () => irPara(slide + Number(b.dataset.passo))),
    );
    pontos.addEventListener('click', (ev) => {
      const p = (ev.target as HTMLElement).closest<HTMLElement>('[data-ponto]');
      if (p) irPara(Number(p.dataset.ponto));
    });
    /* seta do teclado anda no carrossel, que é o que se espera de uma galeria */
    modal.addEventListener('keydown', (ev) => {
      if (ev.key === 'ArrowRight') { ev.preventDefault(); irPara(slide + 1); }
      if (ev.key === 'ArrowLeft') { ev.preventDefault(); irPara(slide - 1); }
    });

    function abrir(cod: string) {
      const i = dados.find((d) => d.cod === cod);
      if (!i) return;
      atual = i;
      slide = 0;

      trilho.innerHTML = i.fotos
        .map((f) => `<div class="carro-slide" role="group" aria-label="${f.t}">${f.svg}</div>`)
        .join('');
      pontos.innerHTML = i.fotos
        .map((f, n) => `<button type="button" class="ponto" data-ponto="${n}" role="tab" aria-selected="${n === 0}" aria-label="${f.t}"></button>`)
        .join('');
      trilho.scrollTo({ left: 0, behavior: 'auto' });

      const aluguel = i.negocio === 'Aluguel';
      const mensal = i.condominio + i.iptu + (aluguel ? i.preco : 0);

      set('[data-f-local]', `${i.bairro} · ${cidade}`);
      set('[data-f-cod]', i.cod);
      set('[data-f-predio]', i.predio);
      set('[data-f-nome]', i.nome);
      set('[data-f-preco]', aluguel ? `${brl(i.preco)}/mês` : brl(i.preco));
      set('[data-f-negocio]', aluguel ? 'aluguel + encargos' : `${i.tipo} à venda`);
      set('[data-f-cond]', i.condominio ? brl(i.condominio) : 'Não há');
      set('[data-f-iptu]', brl(i.iptu));
      set('[data-f-mensal]', `${brl(mensal)}/mês`);
      set('[data-f-desc]', i.descricao);
      set('[data-f-preco2]', aluguel ? `${brl(i.preco)}/mês` : brl(i.preco));
      set('[data-f-area]', `${i.area} m² · ${i.andar}`);

      const atributos = [
        { i: 'fa-solid fa-ruler-combined', v: `${i.area} m²`, r: 'Área útil' },
        { i: 'fa-solid fa-bed', v: String(i.quartos), r: i.quartos === 1 ? 'Dormitório' : 'Dormitórios' },
        { i: 'fa-solid fa-door-open', v: String(i.suites), r: i.suites === 1 ? 'Suíte' : 'Suítes' },
        { i: 'fa-solid fa-shower', v: String(i.banheiros), r: 'Banheiros' },
        { i: 'fa-solid fa-car', v: String(i.vagas), r: 'Vagas' },
      ];
      const elAtrib = modal.querySelector<HTMLElement>('[data-f-atributos]')!;
      elAtrib.innerHTML = atributos
        .map((a) => `<li class="at"><i class="${a.i}" aria-hidden="true"></i><b>${a.v}</b><span>${a.r}</span></li>`)
        .join('');

      const elItens = modal.querySelector<HTMLElement>('[data-f-itens]')!;
      elItens.innerHTML = i.itens
        .map((t) => `<li class="item"><i class="fa-solid fa-check" aria-hidden="true"></i>${t}</li>`)
        .join('');

      /* a mensagem já vai preenchida: o corretor recebe o código, não um "oi" */
      const zap = modal.querySelector<HTMLAnchorElement>('[data-f-zap]');
      if (zap) {
        const numero = document.querySelector<HTMLElement>('[data-zap]')?.dataset.zap ?? '';
        const msg =
          `Olá! Vi o imóvel ${i.cod} — ${i.nome}, ${i.tipo} em ${i.bairro}, ` +
          `${aluguel ? `${brl(i.preco)}/mês` : brl(i.preco)}. Gostaria de agendar uma visita.`;
        zap.href = `https://wa.me/${numero}?text=${encodeURIComponent(msg)}`;
      }

      modal.showModal();
      pintarEstado();

      if (!reduz) {
        animate(modal, { opacity: [0, 1], transform: ['scale(0.97)', 'scale(1)'] }, { duration: 0.32, ease: SAIDA });
        animate(
          modal.querySelectorAll('.ficha-corpo > *'),
          { opacity: [0, 1], transform: ['translateY(12px)', 'translateY(0px)'] },
          { duration: 0.45, delay: stagger(0.035, { startDelay: 0.1 }), ease: SAIDA },
        );
      }
    }

    document.querySelectorAll<HTMLElement>('[data-abrir]').forEach((b) => {
      b.addEventListener('click', () => abrir(b.dataset.abrir!));
    });
    modal.querySelector('[data-fechar]')?.addEventListener('click', () => modal.close());
    /* clique no fundo escuro fecha: o <dialog> recebe o clique fora do conteúdo */
    modal.addEventListener('click', (ev) => {
      if (ev.target === modal) modal.close();
    });
    /* o trilho precisa reposicionar quando a largura do modal muda */
    new ResizeObserver(() => irPara(slide, false)).observe(trilho);
  }

  /* ═════════════ 3. entradas por scroll ═════════════ */
  function ligarMovimento() {
    if (reduz) return;

    animate(
      '[data-capa]',
      { opacity: [0, 1], transform: ['translateY(22px)', 'translateY(0px)'] },
      { duration: 0.85, delay: stagger(0.1, { startDelay: 0.1 }), ease: SAIDA },
    );

    /* agrupado por pai: o stagger corre entre irmãos, e não entre elementos que
       só por acaso estão na mesma altura da página */
    const grupos = new Map<Element, HTMLElement[]>();
    document.querySelectorAll<HTMLElement>('[data-anima]').forEach((el) => {
      const pai = el.parentElement!;
      grupos.set(pai, [...(grupos.get(pai) ?? []), el]);
    });

    for (const [pai, filhos] of grupos) {
      inView(
        pai,
        () => {
          animate(
            filhos,
            { opacity: [0, 1], transform: ['translateY(20px)', 'translateY(0px)'] },
            { duration: 0.65, delay: stagger(0.06), ease: SAIDA },
          );
        },
        { amount: 0.12, margin: '0px 0px -8% 0px' },
      );
    }
  }

  const topo = document.querySelector<HTMLElement>('[data-topo]');
  if (topo) {
    const marcar = () => { topo.dataset.topo = scrollY > 12 ? 'rolou' : ''; };
    marcar();
    addEventListener('scroll', marcar, { passive: true });
  }

  filtrar();
  ligarMovimento();

  /* os dados do modal chegam do frontmatter pela ilha JSON */
  const ilha = document.querySelector<HTMLElement>('[data-dados]');
  if (ilha) {
    const { imoveis, cidade } = JSON.parse(ilha.textContent || '{}');
    ficha(imoveis, cidade);
  }
</script>
