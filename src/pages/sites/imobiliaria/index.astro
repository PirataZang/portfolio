  }
  .cartao-btn:hover { border-color: var(--claro-3); box-shadow: var(--s3); translate: 0 -5px; }
  .cartao-arte { display: block; position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--claro-2); }
  .cartao-arte :global(svg) { display: block; width: 100%; height: 100%; }
  .cartao-btn:hover .cartao-arte :global(svg) { scale: 1.04; }
  .cartao-arte :global(svg) { transition: scale 0.6s var(--e); }

  .cartao-fitas { position: absolute; top: 0.9rem; left: 0.9rem; display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .fita {
    padding: 0.3rem 0.75rem; border-radius: 999px;
    background: var(--marinho); color: #fff;
    font-size: 0.68rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
    box-shadow: var(--s1);
