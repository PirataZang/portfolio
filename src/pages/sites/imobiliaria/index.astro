  .ficha[open] { display: flex; flex-direction: column; }
  .ficha::backdrop { background: rgba(11, 42, 74, 0.55); backdrop-filter: blur(4px); }
  /* o corpo rola; a barra de ação fica presa embaixo */
  .ficha-rolo { overflow-y: auto; overscroll-behavior: contain; flex: 1; }

  .ficha-x {
    position: absolute; z-index: 5; top: 0.85rem; right: 0.85rem;
    width: 44px; height: 44px; display: grid; place-items: center;
    border: 0; border-radius: 50%; cursor: pointer;
    background: rgba(255, 255, 255, 0.92); color: var(--marinho);
    font-size: 1rem; box-shadow: var(--s2);
    transition: background var(--t) var(--e), scale var(--t) var(--e);
  }
  .ficha-x:hover { background: #fff; scale: 1.06; }

  /* ---------- carrossel ---------- */
  .carro { position: relative; background: var(--claro-2); }
  .carro-trilho {
    display: flex; overflow-x: auto; scroll-snap-type: x mandatory;
    scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  .carro-trilho::-webkit-scrollbar { display: none; }
  /* os slides nascem de JS: sem :global o escopo do Astro não os alcança */
  /*
    O teto de altura é o que impede o carrossel de comer o modal inteiro: em
    tela alta ele para em 42% da viewport e sobra espaço para preço, custo e
    descrição aparecerem sem rolar.
  */
  .carro :global(.carro-slide) {
    flex: 0 0 100%; scroll-snap-align: center;
    aspect-ratio: 4 / 3; max-height: min(42dvh, 22rem); min-width: 0;
  }
  .carro :global(.carro-slide svg) { display: block; width: 100%; height: 100%; }

  .carro-seta {
    position: absolute; top: 50%; translate: 0 -50%; z-index: 3;
    width: 44px; height: 44px; display: grid; place-items: center;
    border: 0; border-radius: 50%; cursor: pointer;
    background: rgba(255, 255, 255, 0.92); color: var(--marinho);
    font-size: 0.85rem; box-shadow: var(--s2);
    transition: background var(--t) var(--e), scale var(--t) var(--e), opacity var(--t) var(--e);
  }
  .carro-seta:hover { background: #fff; scale: 1.08; }
  .carro-seta:disabled { opacity: 0.35; cursor: not-allowed; scale: 1; }
  .carro-ant { left: 0.7rem; }
  .carro-prox { right: 0.7rem; }

  .carro-rotulo {
    position: absolute; z-index: 3; left: 0.9rem; bottom: 0.9rem;
    padding: 0.35rem 0.85rem; border-radius: 999px;
    background: rgba(11, 42, 74, 0.82); color: #fff;
    font-size: 0.74rem; font-weight: 500;
  }
  .carro-pontos {
    position: absolute; z-index: 3; right: 0.9rem; bottom: 0.9rem;
    display: flex; gap: 0.35rem;
  }
  .carro :global(.ponto) {
    width: 22px; height: 22px; padding: 0; display: grid; place-items: center;
    border: 0; background: transparent; cursor: pointer;
  }
