    font-size: 0.84rem; color: #cfdcea !important; max-width: none !important;
  }
  .chamada-passos i { font-size: 0.62rem; color: var(--claro-3); }
  .chamada-acoes { display: grid; gap: 0.7rem; align-content: center; }
  .chamada .btn-azul { background: #fff; color: var(--marinho); }
  .chamada .btn-azul:hover { background: var(--claro-2); }
  .chamada .btn-vaz { background: transparent; color: #fff; border-color: rgba(255, 255, 255, 0.3); box-shadow: none; }
  .chamada .btn-vaz:hover { border-color: #fff; color: #fff; background: rgba(255, 255, 255, 0.08); }

  /* ---------- rodapé ---------- */
  .rodape { background: var(--branco); border-top: 1px solid var(--borda); }
  .rodape .caixa { padding-block: clamp(2.4rem, 6vw, 3.6rem) 1.6rem; }
  .rodape-grade { display: grid; gap: 2rem; }
  @media (min-width: 760px) { .rodape-grade { grid-template-columns: 1.6fr 1fr 1.2fr; } }
  .rodape-marca { font-family: 'Outfit', sans-serif; font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; }
  .rodape-marca i { font-style: normal; font-weight: 400; color: var(--c60); }
  .rodape-d { margin-top: 0.7rem; font-size: 0.85rem; color: var(--c60); line-height: 1.8; }
  .redes { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.2rem 0 0; padding: 0; }
  .redes a {
    display: grid; place-items: center; width: 44px; height: 44px;
    border: 1px solid var(--borda); border-radius: 50%;
    color: var(--c60); text-decoration: none; font-size: 0.95rem;
    transition: color var(--t) var(--e), border-color var(--t) var(--e), translate var(--t) var(--e);
  }
  .redes a:hover { color: var(--azul-esc); border-color: var(--azul); translate: 0 -2px; }
  .rodape-t {
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--c40); margin-bottom: 0.9rem;
