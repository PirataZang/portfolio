  .cartao-corpo { display: flex; flex-direction: column; gap: 0.45rem; padding: 1.2rem 1.25rem 1.3rem; flex: 1; }
  /* a referência e a data: o par que separa anúncio de cartão decorativo */
  .cartao-meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem;
    font-size: 0.72rem; color: var(--c40);
  }
  .cartao-meta b { font-family: ui-monospace, monospace; font-weight: 500; color: var(--azul-esc); }
  .cartao-nome { font-family: 'Outfit', sans-serif; font-size: 1.2rem; font-weight: 600; letter-spacing: -0.01em; }
  .cartao-local {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-size: 0.8rem; color: var(--c60);
  }
  .cartao-local i { color: var(--azul); font-size: 0.75rem; }
  .cartao-ficha {
    display: flex; flex-wrap: wrap; gap: 0.35rem 0.7rem;
    padding: 0.75rem 0; margin-top: auto;
    border-block: 1px solid var(--borda);
    font-size: 0.82rem; color: var(--c60);
  }
  /* separador entre itens, sem gastar um elemento por vão */
  .cartao-ficha > span + span::before { content: '·'; margin-right: 0.7rem; color: var(--claro-3); }
  .cartao-pe { display: flex; align-items: flex-end; justify-content: space-between; gap: 0.8rem; margin-top: 0.65rem; }
  .cartao-valor { display: grid; gap: 0.1rem; min-width: 0; }
  .cartao-valor b { font-family: 'Outfit', sans-serif; font-size: 1.28rem; font-weight: 700; color: var(--marinho); }
  /* o custo que vem junto do preço: é a conta que o comprador faz de verdade */
  .cartao-valor small { font-size: 0.74rem; color: var(--c40); }
  .cartao-ver {
    flex: none; width: 2.1rem; height: 2.1rem; display: grid; place-items: center;
    border-radius: 50%; background: var(--claro-2);
    font-size: 0.72rem; color: var(--azul-esc);
    transition: background var(--t) var(--e), color var(--t) var(--e), translate var(--t) var(--e);
  }
  .cartao-btn:hover .cartao-ver { background: var(--azul-esc); color: #fff; translate: 3px 0; }

  .vazio {
    display: flex; align-items: center; justify-content: center; gap: 0.6rem;
    padding: 3rem 1rem; color: var(--c60); font-size: 0.92rem;
