            </li>
            <li>
              <a href={`https://facebook.com/${CLINICA.face}`} rel="noopener" aria-label="Facebook">
                <i class="fa-brands fa-facebook-f" aria-hidden="true"></i>
              </a>
            </li>
            <li>
              <a href={`https://wa.me/${CLINICA.zap}`} rel="noopener" aria-label="WhatsApp">
                <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
              </a>
            </li>
            <li>
              <a href={`mailto:${CLINICA.email}`} aria-label="E-mail">
                <i class="fa-solid fa-envelope" aria-hidden="true"></i>
              </a>
            </li>
          </ul>
        </div>

        <nav aria-label="Navegar">
          <p class="rodape-t">Navegar</p>
          <ul>
            <li><a href="#abordagens">As terapias</a></li>
            <li><a href="#caminho">O caminho até a alta</a></li>
