---
import Base from '../../../layouts/Base.astro';

/*
  VEREDA — psicologia clínica.

  Vereda é o caminho estreito que corta o cerrado até a água. É também o que a
  casa vende: terapia como percurso, não como conserto. O layout inteiro
  obedece a isso — nada tem canto vivo. Foto em folha, seção separada por
  onda, etapa ligada por curva, botão em cápsula.

  Paleta branco + verde, e o verde escuro só aparece em dois blocos, para
  respirar. O herói é desenhado em WebGL: ruído com domain warp em quatro
  verdes, lento, quase parado. É fundo, não espetáculo — se o contexto falhar,
  o gradiente CSS embaixo assume e ninguém percebe.

  Fotos do Pixabay (licença livre). Crédito no rodapé.

  Movimento pelo Motion One, curto e de baixa amplitude: quem chega a um site
  de psicologia não quer nada saltando na tela. Sem JS, e para quem pede menos
  movimento, tudo nasce visível.
*/

const CLINICA = {
  nome: 'Vereda',
  sub: 'Psicologia',
  lema: 'Um caminho por vez.',
  fone: '(99) 9999-9999',
  foneLink: '+559999999999',
  zap: '5599999999999',
  zapFmt: '(99) 99999-9999',
  email: 'contato@vereda.psi.br',
  rua: 'Rua Almirante Lamego, 780 — sala 904',
  bairro: 'Centro',
  cidade: 'Florianópolis',
  uf: 'SC',
  cep: '88015-600',
  site: 'https://vereda.psi.br',
  insta: 'veredapsicologia',
  linkedin: 'company/vereda-psicologia',
  face: 'veredapsicologia',
  desde: 2014,
  crp: 'CRP 12/09814',
};

const ANO = 2026;
const mapaQuery = encodeURIComponent(
  `${CLINICA.rua}, ${CLINICA.bairro}, ${CLINICA.cidade} - ${CLINICA.uf}`,
);

const numeros = [
  { v: ANO - CLINICA.desde, u: 'anos', l: 'de clínica no Centro de Florianópolis' },
  { v: 6, u: 'abordagens', l: 'com indicação clara para cada caso' },
  { v: 4, u: 'psicólogos', l: 'com supervisão clínica mensal' },
  { v: 50, u: 'min', l: 'de sessão, presencial ou por vídeo' },
];

/*
  As abordagens são o miolo da página: quem procura terapia quase sempre não
  sabe a diferença entre elas, e escolher errado é o que faz desistir na
  quarta sessão. Por isso cada carta diz o mesmo trio — como funciona a
  sessão, com que frequência, e por quanto tempo — em vez de adjetivo.
*/
const ABORDAGENS = [
  {
    sigla: 'TCC',
    nome: 'Terapia Cognitivo-Comportamental',
    icone: 'fa-solid fa-diagram-project',
    resumo:
      'Trabalha o presente: o que você pensa, o que sente e o que faz — e como esses três se puxam em círculo.',
    como: [
      'Sessão com pauta combinada no início',
      'Registro do pensamento automático entre um encontro e outro',
      'Aproximação gradual daquilo que se evita',
    ],
    freq: '1× por semana',
    dur: '12 a 20 sessões',
    para: 'Ansiedade, pânico, TOC, insônia, fobia',
  },
  {
    sigla: 'Psicanálise',
    nome: 'Psicanálise clínica',
    icone: 'fa-solid fa-infinity',
    resumo:
      'Escuta do que se repete. Fala livre, sem pauta, para chegar onde a explicação pronta não alcança.',
    como: [
      'Associação livre: você fala, eu escuto o que escapa',
      'Nada de tarefa entre sessões',
      'O tempo do processo é do processo, não da agenda',
    ],
    freq: '1 a 2× por semana',
    dur: 'Processo aberto',
    para: 'Angústia sem nome, luto, repetição amorosa, identidade',
  },
  {
    sigla: 'ACT',
    nome: 'Aceitação e Compromisso',
    icone: 'fa-solid fa-seedling',
    resumo:
      'Em vez de brigar com o pensamento difícil, abrir espaço para ele e voltar a agir pelo que importa.',
    como: [
      'Exercícios para desgrudar do pensamento sem ter de acreditar nele',
      'Um mapa do que você valoriza, escrito com suas palavras',
      'Compromisso com ações pequenas, verificáveis, semanais',
    ],
    freq: '1× por semana',
    dur: '10 a 16 sessões',
    para: 'Burnout, dor crônica, ansiedade generalizada, adoecimento',
  },
  {
    sigla: 'EMDR',
    nome: 'Dessensibilização e reprocessamento',
    icone: 'fa-solid fa-water',
    resumo:
      'Memória que ficou travada é reprocessada com estimulação bilateral, dentro de um protocolo de oito fases.',
    como: [
      'Fases 1 e 2 preparam: história, recursos, estabilização',
      'Só então a memória-alvo é acessada, nunca de improviso',
      'Fecha-se cada sessão em um ponto seguro, sempre',
    ],
    freq: '1× por semana',
    dur: '6 a 12 sessões',
    para: 'Trauma único, TEPT, memória intrusiva, acidente',
  },
  {
    sigla: 'Casal',
    nome: 'Terapia de casal',
    icone: 'fa-solid fa-link',
    resumo:
      'Os dois na sala e um terceiro elemento entre eles: o vínculo. O foco é o padrão da conversa, não quem tem razão.',
    como: [
      'Uma sessão individual com cada um, no começo',
      'Mapeamento do ciclo: gatilho, reação, retirada',
      'Treino de conversa difícil dentro da sessão',
    ],
    freq: 'Quinzenal',
    dur: '8 a 16 encontros',
    para: 'Comunicação travada, recomeço, separação cuidada',
  },
  {
    sigla: 'Infantil',
    nome: 'Ludoterapia',
    icone: 'fa-solid fa-shapes',
    resumo:
      'Criança não deita no divã: ela brinca. O brincar é onde o conflito aparece inteiro, sem precisar de vocabulário.',
    como: [
      'Sala própria, com caixa lúdica individual',
      'Devolutiva aos responsáveis uma vez por mês',
      'Contato com a escola quando faz diferença',
    ],
    freq: '1× por semana',
    dur: 'Revisto a cada 3 meses',
    para: 'De 4 a 12 anos: birra, sono, separação, escola',
  },
];

/* O percurso. Cinco paradas, e a quinta é a alta — dizer isso alto é parte da proposta. */
const CAMINHO = [
  {
    n: '01',
    t: 'Primeira conversa',
    d: 'Vinte minutos por vídeo ou telefone, sem custo e sem compromisso. Você conta o que está acontecendo e a gente diz, com honestidade, se é caso para terapia aqui — ou para onde encaminhar.',
    tag: '20 min · gratuito',
  },
  {
    n: '02',
    t: 'Encontro inicial',
    d: 'Cinquenta minutos para história, contexto e o que você quer que mude. Ninguém sai com diagnóstico no primeiro dia: rótulo apressado é o que mais atrapalha adiante.',
    tag: '50 min',
  },
  {
    n: '03',
    t: 'Combinado terapêutico',
    d: 'Abordagem escolhida, frequência, valor, política de falta e o que é razoável esperar em três meses. Tudo por escrito, para você reler quando a semana for ruim.',
    tag: 'por escrito',
  },
  {
    n: '04',
    t: 'O trabalho',
    d: 'Sessões de cinquenta minutos. A cada oito encontros paramos para revisar o que mudou — e se não mudou, a rota muda. Terapia que não é revisada vira hábito caro.',
    tag: 'revisão a cada 8',
  },
  {
    n: '05',
    t: 'Alta e retorno',
    d: 'Terapia tem fim. Espaçamos as sessões, combinamos os sinais de alerta que pedem retorno e a porta fica aberta — voltar não é recaída, é manutenção.',
    tag: 'a porta fica aberta',
  },
];

const EQUIPE = [
  {
    img: 'eq-elias',
    nome: 'Dr. Elias Ravelli',
    crp: 'CRP 12/09814',
    papel: 'Fundador · Psicólogo clínico',
    form: 'Doutor em Psicologia Clínica, com formação em EMDR e supervisão em TCC.',
    faz: ['TCC', 'EMDR'],
    alt: 'Retrato de Elias Ravelli, psicólogo, de camisa verde sobre fundo claro.',
  },
  {
    img: 'eq-marina',
    nome: 'Marina Quadros',
    crp: 'CRP 12/11204',
    papel: 'Psicóloga clínica',
    form: 'Especialista em transtornos de ansiedade, com dez anos de consultório e formação em ACT.',
    faz: ['TCC', 'ACT'],
    alt: 'Retrato de Marina Quadros, psicóloga, sentada em uma sala de atendimento com estantes ao fundo.',
  },
  {
    img: 'eq-helena',
    nome: 'Helena Sartori',
    crp: 'CRP 12/12877',
    papel: 'Psicóloga clínica',
    form: 'Psicanalista em formação permanente, atende adultos e casais desde 2016.',
    faz: ['Psicanálise', 'Casal'],
    alt: 'Retrato de Helena Sartori, psicóloga, com blusa verde-sálvia sobre fundo neutro.',
  },
  {
    img: 'eq-dandara',
    nome: 'Dandara Vilas-Boas',
    crp: 'CRP 12/13590',
    papel: 'Psicóloga infantil',
    form: 'Ludoterapeuta, especialista em desenvolvimento infantil e orientação de pais.',
    faz: ['Infantil', 'ACT'],
    alt: 'Retrato de Dandara Vilas-Boas, psicóloga infantil, sorrindo em ambiente externo.',
  },
];

const PLANOS = [
  {
    id: 'quinzenal',
    t: 'Quinzenal',
    sub: 'Para quem já tem uma rotina firme',
    preco: 380,
    unidade: 'por mês · 2 sessões',
    porSessao: 'R$ 190 a sessão',
    itens: [
      'Duas sessões de 50 min por mês',
      'Horário fixo reservado no mês inteiro',
      'Presencial ou por vídeo, você escolhe a cada sessão',
      'Recibo com CRP para reembolso do plano',
      'Revisão do combinado a cada 3 meses',
    ],
    destaque: false,
  },
  {
    id: 'semanal',
    t: 'Semanal',
    sub: 'O ritmo em que a maior parte do trabalho acontece',
    preco: 680,
    unidade: 'por mês · 4 sessões',
    porSessao: 'R$ 170 a sessão',
    itens: [
      'Quatro sessões de 50 min por mês',
      'Horário fixo e prioridade em remarcação',
      'Presencial ou por vídeo, você escolhe a cada sessão',
      'Recibo com CRP para reembolso do plano',
      'Revisão formal do plano a cada 8 encontros',
      'Contato por mensagem entre sessões em urgência',
    ],
    destaque: true,
  },
  {
    id: 'casal',
    t: 'Casal e família',
    sub: 'Encontros mais longos, com duas pessoas ou mais',
    preco: 290,
    unidade: 'por encontro de 80 min',
    porSessao: 'quinzenal, em média',
    itens: [
      'Encontro de 80 min com o casal ou o núcleo familiar',
      'Uma sessão individual com cada um, no início',
      'Devolutiva escrita ao fim do primeiro ciclo',
      'Recibo com CRP para reembolso do plano',
      'Sessão avulsa de manutenção depois da alta',
    ],
    destaque: false,
  },
];

const DUVIDAS = [
  {
    p: 'Como sei qual abordagem é a minha?',
    r: 'Você não precisa saber. Essa é a função da primeira conversa e do encontro inicial: a indicação sai de lá, com o motivo explicado. E se depois de algumas sessões a escolha não estiver funcionando, trocar de abordagem — ou de psicólogo, dentro da própria equipe — é parte do combinado, não um fracasso.',
  },
  {
    p: 'Terapia online funciona igual?',
    r: 'Para a maior parte dos casos, sim: a pesquisa dos últimos anos não mostra diferença relevante de resultado entre online e presencial em ansiedade, depressão e TCC em geral. Onde o presencial ainda leva vantagem é em ludoterapia, em quadros de risco e nas primeiras fases de EMDR — e nesses casos a gente diz isso na primeira conversa.',
  },
  {
    p: 'O plano de saúde cobre?',
    r: 'O atendimento é particular, e ao fim de cada mês você recebe um recibo com CRP, CPF e código do procedimento. Com ele, a maioria dos planos reembolsa uma parte, e o valor varia com o seu contrato. Também é dedutível no imposto de renda.',
  },
  {
    p: 'E se eu faltar ou precisar remarcar?',
    r: 'Remarcação avisada com 24 horas de antecedência não é cobrada e cabe na mesma semana, conforme a agenda. Abaixo disso a sessão é cobrada — o horário fica reservado só seu, e é isso que garante que ele exista quando você precisar.',
  },
  {
    p: 'Quanto tempo até eu sentir diferença?',
    r: 'Em quadros de ansiedade e pânico com TCC, costuma haver alívio percebido entre a quarta e a oitava sessão. Em processos de luto, trauma ou questões de longa data, o primeiro movimento aparece mais tarde e é mais sutil. Por isso existe a revisão a cada oito encontros: para medir isso junto, e não no chute.',
  },
  {
    p: 'O que eu falo fica entre nós?',
    r: 'Sim. O sigilo é obrigação do Código de Ética do psicólogo e só é quebrado nas exceções que a própria lei prevê — risco iminente de vida e determinação judicial —, e mesmo aí no mínimo necessário. Em atendimento infantil, os pais recebem devolutiva de processo, não transcrição do que a criança disse.',
  },
  {
    p: 'Vocês atendem em urgência?',
    r: 'Não somos serviço de emergência. Se houver risco imediato, procure o CAPS da sua região, a emergência do hospital mais próximo ou ligue 188 (CVV), que atende de graça, 24 horas. Fora disso, temos duas vagas de encaixe por semana para pacientes em acompanhamento.',
  },
];

const ESPACO = [
  {
    img: 'espaco',
    alt: 'Sala de atendimento da Vereda: sofá cinza, luminária de piso e uma janela ampla para o verde.',
    t: 'A sala verde',
    d: 'Janela inteira para as árvores dos fundos. Luz natural o dia todo e nenhuma lâmpada fria.',
  },
  {
    img: 'poltronas',
    alt: 'Duas poltronas frente a frente, com tapete claro e mesa de centro entre elas.',
    t: 'Duas poltronas',
    d: 'Sem mesa entre você e o psicólogo. A distância é a mesma de uma conversa, porque é o que é.',
  },
  {
    img: 'escuta',
    alt: 'Psicóloga e paciente conversando em um sofá, com caderno de anotações e plantas na sala.',
    t: 'Espera reservada',
    d: 'Ninguém cruza com ninguém: os horários têm dez minutos de folga entre si, de propósito.',
  },
];

const titulo = `${CLINICA.nome} ${CLINICA.sub} — terapia em ${CLINICA.cidade}, presencial e online`;
const descricao =
  'Consultório de psicologia clínica no Centro de Florianópolis. TCC, psicanálise, ACT, EMDR, terapia de casal e ludoterapia, presencial e online. Primeira conversa de 20 minutos sem custo.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['MedicalBusiness', 'Psychiatric'],
      '@id': `${CLINICA.site}/#clinica`,
      name: `${CLINICA.nome} ${CLINICA.sub}`,
      slogan: CLINICA.lema,
      description: descricao,
      url: CLINICA.site,
      telephone: CLINICA.foneLink,
      email: CLINICA.email,
      priceRange: 'R$ 170 – R$ 290',
      foundingDate: String(CLINICA.desde),
      address: {
        '@type': 'PostalAddress',
        streetAddress: CLINICA.rua,
        addressLocality: CLINICA.cidade,
        addressRegion: CLINICA.uf,
        postalCode: CLINICA.cep,
        addressCountry: 'BR',
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
          opens: '08:00',
          closes: '20:00',
        },
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: 'Saturday',
          opens: '09:00',
          closes: '13:00',
        },
      ],
      sameAs: [
        `https://instagram.com/${CLINICA.insta}`,
        `https://www.linkedin.com/${CLINICA.linkedin}`,
        `https://facebook.com/${CLINICA.face}`,
      ],
      employee: EQUIPE.map((e) => ({
        '@type': 'Person',
        name: e.nome,
        jobTitle: e.papel,
        identifier: e.crp,
      })),
      makesOffer: PLANOS.map((p) => ({
        '@type': 'Offer',
        name: `Terapia ${p.t}`,
        price: p.preco,
        priceCurrency: 'BRL',
      })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: DUVIDAS.map((d) => ({
        '@type': 'Question',
        name: d.p,
        acceptedAnswer: { '@type': 'Answer', text: d.r },
      })),
    },
  ],
};

/* Onda usada como junta entre seções. Uma só curva, virada no CSS quando precisa. */
const ONDA = 'M0,58 C220,110 430,10 720,34 C1010,58 1230,120 1440,74 L1440,140 L0,140 Z';
---

<Base title={titulo} description={descricao}>
  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={CLINICA.site} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f4f8f4" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    />
    <link rel="preload" as="image" href={`${import.meta.env.BASE_URL}img/psi/acolhida.webp`} type="image/webp" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.documentElement.classList.add('anima-on');
    </script>
  </Fragment>

  <div class="vd">
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>

    <header class="topo" data-topo>
      <div class="topo-barra" data-progresso aria-hidden="true"></div>
      <a class="marca" href={import.meta.env.BASE_URL}>
        <span class="marca-folha" aria-hidden="true">
          <svg viewBox="0 0 40 40" focusable="false">
            <path
              d="M34 6C34 6 8 4 6 22c-1.4 12.6 8 12 8 12s-3-10 4-16 16-12 16-12Z"
              fill="currentColor"
              opacity="0.9"></path>
            <path
              d="M12 34C14 22 22 14 32 8"
              fill="none"
              stroke="#fff"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
        </span>
        <span class="marca-txt">{CLINICA.nome}<small>{CLINICA.sub}</small></span>
      </a>
      <nav class="topo-nav" aria-label="Seções">
        <a href="#abordagens">Terapias</a>
        <a href="#caminho">O caminho</a>
        <a href="#espaco">O espaço</a>
        <a href="#equipe">Equipe</a>
        <a href="#planos">Planos</a>
        <a href="#duvidas">Dúvidas</a>
      </nav>
      <a class="btn btn-p btn-min" href="#agendar">Agendar conversa</a>
    </header>

    <main id="conteudo">
      {/* ═══════════════════ HERÓI ═══════════════════ */}
      <section class="heroi" id="inicio">
        {/*
          O canvas é fundo. Fica atrás de um véu branco que abre no topo e
          fecha embaixo, então o texto nunca disputa contraste com o ruído.
        */}
        <canvas class="tela" data-shader aria-hidden="true"></canvas>
        <div class="heroi-veu" aria-hidden="true"></div>

        <div class="caixa heroi-grade">
          <div class="heroi-txt">
            <p class="selo" data-anima>
              <span class="ponto" aria-hidden="true"></span>
              {CLINICA.crp} · presencial em {CLINICA.cidade} e online no Brasil inteiro
            </p>
            <h1>
              <span class="linha" data-linha>A cura não acontece</span>
              <span class="linha" data-linha>de um salto —</span>
              <span class="linha" data-linha>ela é <em>um caminho</em>.</span>
            </h1>
            <p class="lead" data-anima>
              A {CLINICA.nome} é um consultório de psicologia clínica no Centro de
              {' '}{CLINICA.cidade}. Seis abordagens, quatro psicólogos e um combinado
              por escrito desde a primeira sessão — para você saber onde está pisando
              antes de começar a andar.
            </p>
            <div class="heroi-acoes" data-anima>
              <a class="btn btn-p btn-g" href="#agendar">
                <i class="fa-solid fa-calendar-check" aria-hidden="true"></i>
                Agendar primeira conversa
              </a>
              <a class="btn btn-vaz btn-g" href="#abordagens">
                Como funcionam as terapias
              </a>
            </div>
            <ul class="heroi-fatos" data-anima>
              <li><i class="fa-solid fa-clock" aria-hidden="true"></i> Seg a sex, 8h às 20h</li>
              <li><i class="fa-solid fa-file-invoice" aria-hidden="true"></i> Recibo para reembolso</li>
              <li><i class="fa-solid fa-video" aria-hidden="true"></i> Sessão por vídeo</li>
            </ul>
          </div>

          <figure class="heroi-foto" data-anima>
            <div class="folha" data-parallax>
              <picture>
                <source srcset={`${import.meta.env.BASE_URL}img/psi/acolhida.webp`} type="image/webp" />
                <img
                  src={`${import.meta.env.BASE_URL}img/psi/acolhida.jpg`}
                  alt="Psicólogo ouvindo um paciente em sessão, com um vaso de planta entre eles."
                  width="1200"
                  height="800"
                  fetchpriority="high"
                  decoding="async"
                />
              </picture>
            </div>
            <figcaption class="flutua">
              <b>20 min</b>
              <span>Primeira conversa, sem custo e sem compromisso</span>
            </figcaption>
            <span class="bolha bolha-a" aria-hidden="true"></span>
            <span class="bolha bolha-b" aria-hidden="true"></span>
          </figure>
        </div>

        <svg class="onda onda-baixo" viewBox="0 0 1440 140" preserveAspectRatio="none" aria-hidden="true">
          <path d={ONDA}></path>
        </svg>
      </section>

      {/* ═══════════════════ NÚMEROS ═══════════════════ */}
      <section class="faixa">
        <dl class="caixa faixa-grade">
          {
            numeros.map((n) => (
              <div data-anima>
                <dt><span data-conta={n.v}>{n.v}</span> <small>{n.u}</small></dt>
                <dd>{n.l}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      {/* ═══════════════════ ABORDAGENS ═══════════════════ */}
      <section class="secao secao-nevoa" id="abordagens">
        <div class="caixa">
          <div class="cab">
            <p class="etiqueta" data-anima>As terapias</p>
            <h2 data-anima>Seis modos de trabalhar — e por que isso importa</h2>
            <p class="lead" data-anima>
              Escolher a abordagem errada é o que mais faz gente desistir na quarta
              sessão. Aqui elas estão lado a lado com a mesma régua: como é a sessão,
              de quanto em quanto tempo, e por quanto tempo. A indicação sai do
              encontro inicial, com o motivo dito em voz alta.
            </p>
          </div>

          <div class="cartas">
            {
              ABORDAGENS.map((a) => (
                <article class="carta" data-carta>
                  <span class="carta-arco" aria-hidden="true"></span>
                  <p class="carta-icone" aria-hidden="true"><i class={a.icone} /></p>
                  <p class="carta-sigla">{a.sigla}</p>
                  <h3>{a.nome}</h3>
                  <p class="carta-resumo">{a.resumo}</p>
                  <ul class="carta-como">
                    {a.como.map((c) => (
                      <li>{c}</li>
                    ))}
                  </ul>
                  <dl class="carta-dados">
                    <div><dt>Frequência</dt><dd>{a.freq}</dd></div>
                    <div><dt>Duração</dt><dd>{a.dur}</dd></div>
                  </dl>
                  <p class="carta-para"><b>Indicado para</b> {a.para}</p>
                </article>
              ))
            }
          </div>
        </div>
        <svg class="onda onda-baixo onda-branca" viewBox="0 0 1440 140" preserveAspectRatio="none" aria-hidden="true">
          <path d={ONDA}></path>
        </svg>
      </section>

      {/* ═══════════════════ O CAMINHO ═══════════════════ */}
      <section class="secao" id="caminho">
        <div class="caixa">
          <div class="cab cab-centro">
            <p class="etiqueta" data-anima>O caminho</p>
            <h2 data-anima>Da primeira conversa até a alta</h2>
            <p class="lead" data-anima>
              Terapia sem previsão vira assinatura. Este é o percurso inteiro,
              incluindo o fim dele — porque o fim também é combinado no começo.
            </p>
          </div>

          <ol class="trilha">
            {/* a curva é decorativa: liga as paradas sem carregar informação */}
            <svg class="trilha-fio" viewBox="0 0 60 1000" preserveAspectRatio="none" aria-hidden="true">
              <path
                d="M30 0 C6 120, 54 220, 30 340 C6 460, 54 560, 30 680 C6 800, 54 900, 30 1000"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-dasharray="1 1"
                pathLength="1"
                data-fio></path>
            </svg>

            {
              CAMINHO.map((e) => (
                <li class="parada" data-parada>
                  <span class="parada-n" aria-hidden="true">{e.n}</span>
                  <div class="parada-corpo">
                    <p class="parada-tag">{e.tag}</p>
                    <h3>{e.t}</h3>
                    <p>{e.d}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      {/* ═══════════════════ O ESPAÇO ═══════════════════ */}
      <section class="secao secao-musgo" id="espaco">
        <svg class="onda onda-cima onda-musgo" viewBox="0 0 1440 140" preserveAspectRatio="none" aria-hidden="true">
          <path d={ONDA}></path>
        </svg>
        <div class="caixa">
          <div class="cab cab-larga">
            <div>
              <p class="etiqueta" data-anima>O espaço</p>
              <h2 data-anima>Uma sala que não parece consultório</h2>
            </div>
            <p class="lead" data-anima>
              Sala no nono andar, acústica tratada, luz natural o dia inteiro e dez
              minutos de folga entre um horário e o outro — para que ninguém cruze com
              ninguém na saída. Prédio com elevador e acesso sem degrau.
            </p>
          </div>

          <div class="galeria">
            {
              ESPACO.map((f, i) => (
                <figure class={`peca peca-${i}`} data-anima>
                  <picture>
                    <source srcset={`${import.meta.env.BASE_URL}img/psi/${f.img}.webp`} type="image/webp" />
                    <img
                      src={`${import.meta.env.BASE_URL}img/psi/${f.img}.jpg`}
                      alt={f.alt}
                      width="1200"
                      height="800"
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                  <figcaption>
                    <b>{f.t}</b>
                    <span>{f.d}</span>
                  </figcaption>
                </figure>
              ))
            }
          </div>
        </div>
        <svg class="onda onda-baixo onda-musgo-b" viewBox="0 0 1440 140" preserveAspectRatio="none" aria-hidden="true">
          <path d={ONDA}></path>
        </svg>
      </section>

      {/* ═══════════════════ EQUIPE ═══════════════════ */}
      <section class="secao" id="equipe">
        <div class="caixa">
          <div class="cab cab-centro">
            <p class="etiqueta" data-anima>Quem atende</p>
            <h2 data-anima>Quatro psicólogos, uma supervisão só</h2>
            <p class="lead" data-anima>
              Todo mundo aqui leva os próprios casos para supervisão clínica uma vez
              por mês. É o que impede o consultório de virar quatro consultórios que
              dividem um corredor.
            </p>
          </div>

          <div class="equipe">
            {
              EQUIPE.map((p) => (
                <article class="pessoa" data-anima>
                  <div class="pessoa-foto">
                    <picture>
                      <source srcset={`${import.meta.env.BASE_URL}img/psi/${p.img}.webp`} type="image/webp" />
                      <img
                        src={`${import.meta.env.BASE_URL}img/psi/${p.img}.jpg`}
                        alt={p.alt}
                        width="800"
                        height="800"
                        loading="lazy"
                        decoding="async"
                      />
                    </picture>
                  </div>
                  <h3>{p.nome}</h3>
                  <p class="pessoa-papel">{p.papel} · <span class="mono">{p.crp}</span></p>
                  <p class="pessoa-form">{p.form}</p>
                  <ul class="pessoa-tags">
                    {p.faz.map((f) => (
                      <li>{f}</li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      {/* ═══════════════════ PLANOS ═══════════════════ */}
      <section class="secao secao-nevoa" id="planos">
        <svg class="onda onda-cima onda-nevoa" viewBox="0 0 1440 140" preserveAspectRatio="none" aria-hidden="true">
          <path d={ONDA}></path>
        </svg>
        <div class="caixa">
          <div class="cab cab-centro">
            <p class="etiqueta" data-anima>Planos</p>
            <h2 data-anima>Preço fechado, sem letra miúda</h2>
            <p class="lead" data-anima>
              O valor é o mesmo presencial ou online. Você paga por mês, o horário fica
              reservado só seu, e o combinado é revisto a cada três meses — para cima ou
              para baixo, conforme a fase.
            </p>
          </div>

          <div class="planos">
            {
              PLANOS.map((p) => (
                <article class:list={['plano', p.destaque && 'plano-destaque']} data-plano>
                  {p.destaque && <p class="plano-fita">Mais escolhido</p>}
                  <h3>{p.t}</h3>
                  <p class="plano-sub">{p.sub}</p>
                  <p class="plano-preco">
                    <small>R$</small>
                    <b data-conta={p.preco}>{p.preco.toLocaleString('pt-BR')}</b>
                  </p>
                  <p class="plano-unid">{p.unidade}</p>
                  <p class="plano-sessao">{p.porSessao}</p>
                  <ul class="plano-itens">
                    {p.itens.map((i) => (
                      <li>
                        <i class="fa-solid fa-check" aria-hidden="true" />
                        {i}
                      </li>
                    ))}
                  </ul>
                  <a
                    class:list={['btn', 'btn-cheio', p.destaque ? 'btn-p' : 'btn-vaz']}
                    href="#agendar"
                    data-plano-alvo={p.t}>
                    Começar pelo {p.t.toLowerCase()}
                  </a>
                </article>
              ))
            }
          </div>

          <p class="planos-nota" data-anima>
            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
            Sessão avulsa, sem plano: <b>R$ 220</b>. Recibo com CRP para reembolso e
            dedução no imposto de renda. Mantemos <b>cinco vagas sociais</b> com valor
            reduzido — pergunte na primeira conversa, sem constrangimento.
          </p>
        </div>
        <svg class="onda onda-baixo onda-branca" viewBox="0 0 1440 140" preserveAspectRatio="none" aria-hidden="true">
          <path d={ONDA}></path>
        </svg>
      </section>

      {/* ═══════════════════ DÚVIDAS ═══════════════════ */}
      <section class="secao" id="duvidas">
        <div class="caixa dupla-fq">
          <div class="cab">
            <p class="etiqueta" data-anima>Dúvidas</p>
            <h2 data-anima>O que costumam perguntar antes da primeira sessão</h2>
            <p class="lead" data-anima>
              Se a sua pergunta não estiver aqui, ela cabe na primeira conversa — que é
              de graça exatamente para isso.
            </p>
            <a class="btn btn-vaz" href="#agendar" data-anima>Perguntar direto</a>
          </div>

          <div class="fq" data-anima>
            {
              DUVIDAS.map((d) => (
                <details name="duvidas">
                  <summary>
                    {d.p}
                    <i class="fa-solid fa-plus" aria-hidden="true" />
                  </summary>
                  <p>{d.r}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      {/* ═══════════════════ AGENDAR ═══════════════════ */}
      <section class="secao secao-fundo" id="agendar">
        <svg class="onda onda-cima onda-fundo" viewBox="0 0 1440 140" preserveAspectRatio="none" aria-hidden="true">
          <path d={ONDA}></path>
        </svg>
        <div class="caixa agendar-grade">
          <div data-anima>
            <p class="etiqueta etiqueta-claro">Primeiro passo</p>
            <h2>Vinte minutos para descobrir se faz sentido</h2>
            <p class="lead-claro">
              Sem custo, sem compromisso e sem discurso de venda. Você conta o que está
              acontecendo, a gente diz qual abordagem indicaria e com quem — ou, se não
              for caso para nós, para onde encaminhar.
            </p>

            <dl class="contato-dados">
              <div>
                <dt>WhatsApp</dt>
                <dd><a href={`https://wa.me/${CLINICA.zap}`} rel="noopener">{CLINICA.zapFmt}</a></dd>
              </div>
              <div>
                <dt>Telefone</dt>
                <dd><a href={`tel:${CLINICA.foneLink}`}>{CLINICA.fone}</a></dd>
              </div>
              <div>
                <dt>E-mail</dt>
                <dd><a href={`mailto:${CLINICA.email}`}>{CLINICA.email}</a></dd>
              </div>
              <div>
                <dt>Consultório</dt>
                <dd>{CLINICA.rua}<br />{CLINICA.bairro} · {CLINICA.cidade}/{CLINICA.uf}</dd>
              </div>
              <div>
                <dt>Horários</dt>
                <dd>Seg a sex, 8h às 20h<br />Sáb, 9h às 13h</dd>
              </div>
              <div>
                <dt>Urgência</dt>
                <dd>CVV <a href="tel:188">188</a> · 24 h, gratuito</dd>
              </div>
            </dl>
          </div>

          <form class="form" data-form data-zap={CLINICA.zap} data-anima>
            <div class="form-2">
              <label>
                Nome
                <input name="nome" type="text" required autocomplete="name" placeholder="Como te chamamos" />
              </label>
              <label>
                WhatsApp
                <input name="fone" type="tel" required autocomplete="tel" placeholder="(48) 90000-0000" />
              </label>
            </div>
            <div class="form-2">
              <label>
                Para quem é
                <select name="quem">
                  <option>Para mim</option>
                  <option>Para o casal</option>
                  <option>Para meu filho ou filha</option>
                  <option>Para outra pessoa da família</option>
                </select>
              </label>
              <label>
                Plano de interesse
                <select name="plano" data-plano-campo>
                  <option>Ainda não sei</option>
                  {PLANOS.map((p) => <option>{p.t}</option>)}
                  <option>Sessão avulsa</option>
                  <option>Vaga social</option>
                </select>
              </label>
            </div>
            <div class="form-2">
              <label>
                Formato
                <select name="formato">
                  <option>Tanto faz</option>
                  <option>Presencial no Centro</option>
                  <option>Por vídeo</option>
                </select>
              </label>
              <label>
                Melhor horário
                <select name="horario">
                  <option>Manhã</option>
                  <option>Tarde</option>
                  <option>Fim de tarde, depois das 18h</option>
                  <option>Sábado de manhã</option>
                </select>
              </label>
            </div>
            <label>
              O que está acontecendo <small>opcional</small>
              <textarea
                name="msg"
                rows="3"
                placeholder="Uma linha já basta. Você não precisa se explicar por escrito."></textarea>
            </label>
            <button class="btn btn-p btn-cheio btn-g" type="submit">
              <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
              Abrir conversa no WhatsApp
            </button>
            <p class="form-nota">
              Abre o WhatsApp com tudo preenchido — você ainda revisa antes de enviar.
              Nada é gravado neste site.
            </p>
          </form>
        </div>
      </section>
    </main>

    {/* ═══════════════════ RODAPÉ ═══════════════════ */}
