  .rd-nap a:hover { border-bottom-color: var(--ambar-cl); color: var(--ambar-cl); }
  .rd-legal { margin-top: 1.4rem; font-size: 0.78rem; line-height: 1.65; color: rgb(159 195 172 / 0.8); max-width: 68ch; }
