  .onde { display: grid; gap: 1.6rem; }
  @media (min-width: 560px) { .onde { grid-template-columns: 1.15fr 1fr; gap: 2rem; } }
  .onde h3 {
    font-family: 'Figtree', sans-serif; font-size: 0.7rem; font-weight: 700;
