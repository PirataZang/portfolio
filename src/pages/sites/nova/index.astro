        </div>

        <div class="rodape-contato">
          <p class="rodape-t">Contato</p>
          <ul>
            <li>
              <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
              <span>
                {CLINICA.rua}<br />
                {CLINICA.bairro} · {CLINICA.cidade}/{CLINICA.uf}<br />
