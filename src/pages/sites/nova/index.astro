  @media (min-width: 860px) { .rd-topo { grid-template-columns: auto 1fr; align-items: center; gap: 2.5rem; } }
  .marca-gr { color: var(--salvia); }
  .marca-gr .marca-t b { font-size: 2rem; color: var(--creme); }
