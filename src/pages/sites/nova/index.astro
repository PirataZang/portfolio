---
import Base from '../../../layouts/Base.astro';

/*
  VEREDA — psicologia clínica.

  ─── Correção de rota ───

  A versão anterior era um documento de texto bem composto e frio. Eu tinha
  lido o design_models como lista de proibições — sem cartão, sem gradiente,
  sem efeito — e esqueci o §45, que vem antes de todas elas: a página precisa
  criar vontade. Contenção sem desejo não é sobriedade, é página morta.

  ─── A direção ───

  Uma clínica calorosa, não um consultório clínico. Verde profundo, creme,
  areia e um âmbar quente que humaniza tudo. A fotografia é grande e colorida:
  a sala, as poltronas, as pessoas. Quem procura terapia quer ver onde vai
  sentar e com quem vai falar.

  A página muda de fundo a cada seção — creme, areia, verde escuro — e essa
  troca é o ritmo (§09). Nada de bloco branco atrás de bloco branco.

  ─── A assinatura ───

  Cada terapia tem uma cor própria, e essa cor volta na ficha de quem atende:
  dá para ver de relance quem faz o quê. E cada seção abre com um número
  grande em serifa e um filete âmbar.

  ─── Movimento ───

  Título entra palavra por palavra, de baixo para cima, atrás de uma máscara.
  Foto abre de dentro de um corte e assenta de uma escala maior. Cartão sobe
  em série. Número conta. Tudo curto, tudo desligado em prefers-reduced-motion.
*/

const CLINICA = {
  nome: 'Vereda',
  sub: 'Psicologia',
  fone: '(99) 9999-9999',
  foneLink: '+559999999999',
  zap: '5599999999999',
  zapFmt: '(99) 99999-9999',
  email: 'contato@vereda.psi.br',
  rua: 'Rua Almirante Lamego, 780 — sala 904',
  bairro: 'Centro',
  cidade: 'Florianópolis',
  uf: 'SC',
  cep: '88015-600',
  site: 'https://vereda.psi.br',
  insta: 'veredapsicologia',
  desde: 2014,
  crp: 'CRP 12/09814',
};

const ANO = 2026;
const IMG = `${import.meta.env.BASE_URL}img/vereda`;
const mapaQuery = encodeURIComponent(
  `${CLINICA.rua}, ${CLINICA.bairro}, ${CLINICA.cidade} - ${CLINICA.uf}`,
);

const MENU = [
  { id: 'terapias', t: 'Terapias' },
  { id: 'percurso', t: 'Como funciona' },
  { id: 'espaco', t: 'O espaço' },
  { id: 'equipe', t: 'Equipe' },
  { id: 'planos', t: 'Planos' },
];

const PROVAS = [
  { n: 12, suf: '', t: 'anos', d: 'de clínica no Centro de Florianópolis' },
  { n: 6, suf: '', t: 'terapias', d: 'com indicação explicada em voz alta' },
  { n: 4, suf: '', t: 'psicólogos', d: 'na mesma supervisão clínica mensal' },
  { n: 20, suf: 'min', t: 'de graça', d: 'na conversa que decide se é aqui' },
];

/*
  Cada terapia tem cor própria. A cor não é enfeite: ela volta na ficha do
  psicólogo, então dá para ver de relance quem faz o quê.
*/
const TERAPIAS = [
  {
    id: 'tcc', cor: '#2E6B52',
    nome: 'Terapia cognitivo-comportamental', curto: 'TCC',
    para: 'Ansiedade, pânico, TOC, insônia, fobia',
    resumo: 'Trabalha o presente: o que você pensa, o que sente e o que faz — e como esses três se puxam em círculo.',
    freq: '1× por semana', dur: '12 a 20 sessões',
    icone: 'M4 17l5-5 4 4 7-8',
  },
  {
    id: 'psicanalise', cor: '#7A5C9E',
    nome: 'Psicanálise clínica', curto: 'Psicanálise',
    para: 'Angústia sem nome, luto, repetição amorosa',
    resumo: 'Escuta do que se repete. Fala livre, sem pauta, para chegar onde a explicação pronta não alcança.',
    freq: '1 a 2× por semana', dur: 'Processo aberto',
    icone: 'M7 12a3 3 0 106 0 3 3 0 10-6 0m6 0a3 3 0 106 0 3 3 0 10-6 0',
  },
  {
    id: 'act', cor: '#C97B4A',
    nome: 'Aceitação e compromisso', curto: 'ACT',
    para: 'Burnout, dor crônica, ansiedade generalizada',
    resumo: 'Em vez de brigar com o pensamento difícil, abrir espaço para ele e voltar a agir pelo que importa.',
    freq: '1× por semana', dur: '10 a 16 sessões',
    icone: 'M12 20V9m0 0c0-3 2-5 5-5 0 3-2 5-5 5m0 0C12 6 10 4 7 4c0 3 2 5 5 5',
  },
  {
    id: 'emdr', cor: '#2C6E86',
    nome: 'Dessensibilização e reprocessamento', curto: 'EMDR',
    para: 'Trauma único, TEPT, memória intrusiva',
    resumo: 'Memória travada é reprocessada com estimulação bilateral, dentro de um protocolo de oito fases.',
    freq: '1× por semana', dur: '6 a 12 sessões',
    icone: 'M3 14c3-4 6-4 9 0s6 4 9 0M3 8c3-4 6-4 9 0s6 4 9 0',
  },
  {
    id: 'casal', cor: '#B0526A',
    nome: 'Terapia de casal', curto: 'Casal',
    para: 'Comunicação travada, recomeço, separação cuidada',
    resumo: 'Os dois na sala e um terceiro elemento entre eles: o vínculo. O foco é o padrão da conversa, não quem tem razão.',
    freq: 'Quinzenal', dur: '8 a 16 encontros',
    icone: 'M9 7a3 3 0 106 0 3 3 0 10-6 0M4 20c0-3.5 3.6-5.5 8-5.5s8 2 8 5.5',
  },
  {
    id: 'infantil', cor: '#3F8E6E',
    nome: 'Ludoterapia', curto: 'Infantil',
    para: 'De 4 a 12 anos: birra, sono, separação, escola',
    resumo: 'Criança não deita no divã: ela brinca. O brincar é onde o conflito aparece inteiro, sem precisar de vocabulário.',
    freq: '1× por semana', dur: 'Revisto a cada 3 meses',
    icone: 'M5 5h6v6H5zM14 5h5v5h-5zM5 14h5v5H5zM16.5 14.5a2.5 2.5 0 100 5 2.5 2.5 0 100-5',
  },
];

const PERCURSO = [
  { t: 'Primeira conversa', tag: '20 min · de graça',
    d: 'Por vídeo ou telefone, sem compromisso. Você conta o que está acontecendo e a gente diz, com honestidade, se é caso para terapia aqui — ou para onde encaminhar.' },
  { t: 'Encontro inicial', tag: '50 min',
    d: 'História, contexto e o que você quer que mude. Ninguém sai com diagnóstico no primeiro dia: rótulo apressado é o que mais atrapalha adiante.' },
  { t: 'Combinado por escrito', tag: 'antes de pagar',
    d: 'Abordagem, frequência, valor, política de falta e o que é razoável esperar em três meses. Você lê tudo antes da primeira sessão paga.' },
  { t: 'O trabalho', tag: 'revisão a cada 8',
    d: 'Sessões de cinquenta minutos. A cada oito encontros paramos para revisar o que mudou — e se não mudou, a rota muda.' },
  { t: 'Alta e retorno', tag: 'a porta fica aberta',
    d: 'Terapia tem fim. Espaçamos as sessões, combinamos os sinais que pedem retorno e a porta continua aberta. Voltar não é recaída, é manutenção.' },
];

const ESPACO = [
  { img: 'sala', t: 'A sala verde', d: 'Janela inteira para as árvores dos fundos. Luz natural o dia todo, nenhuma lâmpada fria.',
    alt: 'Sala de atendimento da Vereda com janela do chão ao teto para as árvores, poltrona clara e sofá cinza.' },
  { img: 'poltronas', t: 'Duas poltronas', d: 'Sem mesa entre você e o psicólogo. A distância é a de uma conversa, porque é o que é.',
    alt: 'Duas poltronas estampadas frente a frente sobre tapete claro, com mesa de centro entre elas.' },
  { img: 'escuta', t: 'Espera reservada', d: 'Dez minutos de folga entre um horário e outro: ninguém cruza com ninguém na saída.',
    alt: 'Psicóloga e paciente conversando em um sofá claro, com caderno de anotações sobre a mesa.' },
];

const EQUIPE = [
  { img: 'eq-elias', nome: 'Elias Ravelli', crp: 'CRP 12/09814', papel: 'Fundador · Psicólogo clínico',
    form: 'Doutor em psicologia clínica, formação em EMDR e supervisão em TCC. Atende desde 2009.',
    faz: ['tcc', 'emdr'], alt: 'Retrato de Elias Ravelli, psicólogo, de camisa verde.' },
  { img: 'eq-marina', nome: 'Marina Quadros', crp: 'CRP 12/11204', papel: 'Psicóloga clínica',
    form: 'Especialista em transtornos de ansiedade, dez anos de consultório e formação em ACT.',
    faz: ['tcc', 'act'], alt: 'Retrato de Marina Quadros, psicóloga, em uma sala com estantes ao fundo.' },
  { img: 'eq-helena', nome: 'Helena Sartori', crp: 'CRP 12/12877', papel: 'Psicóloga clínica',
    form: 'Psicanalista em formação permanente. Atende adultos e casais desde 2016.',
    faz: ['psicanalise', 'casal'], alt: 'Retrato de Helena Sartori, psicóloga, sobre fundo claro.' },
  { img: 'eq-dandara', nome: 'Dandara Vilas-Boas', crp: 'CRP 12/13590', papel: 'Psicóloga infantil',
    form: 'Ludoterapeuta, especialista em desenvolvimento infantil e orientação de pais.',
    faz: ['infantil', 'act'], alt: 'Retrato de Dandara Vilas-Boas, psicóloga infantil, ao ar livre.' },
];

const PLANOS = [
  { id: 'quinzenal', t: 'Quinzenal', sub: 'Para quem já tem uma rotina firme',
    mes: 380, sessao: 190, ritmo: '2 sessões de 50 min por mês', destaque: false,
    itens: ['Horário fixo reservado no mês inteiro', 'Presencial ou por vídeo, você escolhe a cada sessão',
            'Recibo com CRP para reembolso', 'Revisão do combinado a cada 8 sessões'] },
  { id: 'semanal', t: 'Semanal', sub: 'O ritmo em que a maior parte do trabalho acontece',
    mes: 680, sessao: 170, ritmo: '4 sessões de 50 min por mês', destaque: true,
    itens: ['Horário fixo e prioridade em remarcação', 'Presencial ou por vídeo, você escolhe a cada sessão',
            'Recibo com CRP para reembolso', 'Revisão do combinado a cada 8 sessões',
            'Contato por mensagem entre sessões em urgência'] },
  { id: 'casal', t: 'Casal e família', sub: 'Encontros mais longos, com duas pessoas ou mais',
    mes: null, sessao: 290, ritmo: '1 encontro de 80 min, em média quinzenal', destaque: false,
    itens: ['Uma sessão individual com cada um no início', 'Devolutiva escrita ao fim do primeiro ciclo',
            'Recibo com CRP para reembolso', 'Sessão de manutenção avulsa depois da alta'] },
];

const DUVIDAS = [
  { p: 'Como sei qual terapia é a minha?',
    r: 'Você não precisa saber — é para isso que existem a primeira conversa e o encontro inicial. A indicação sai de lá, com o motivo explicado. E se depois de algumas sessões a escolha não estiver funcionando, trocar de abordagem, ou de psicólogo dentro da própria equipe, é parte do combinado e não um fracasso.' },
  { p: 'Terapia online funciona igual?',
    r: 'Para a maior parte dos casos, sim. Onde o presencial ainda leva vantagem é em ludoterapia, em quadros de risco e nas primeiras fases do EMDR — e nesses casos a gente diz isso logo na primeira conversa, antes de você pagar qualquer sessão.' },
  { p: 'O plano de saúde cobre?',
    r: 'O atendimento é particular. Ao fim de cada mês você recebe um recibo com CRP, CPF e código do procedimento; com ele a maioria dos planos reembolsa uma parte, e o valor varia conforme o seu contrato. O gasto também é dedutível no imposto de renda.' },
  { p: 'E se eu faltar ou precisar remarcar?',
    r: 'Remarcação avisada com 24 horas de antecedência não é cobrada e cabe na mesma semana, conforme a agenda. Abaixo disso a sessão é cobrada — o horário fica reservado só seu, e é isso que garante que ele exista quando você precisar dele.' },
  { p: 'Quanto tempo até eu sentir diferença?',
    r: 'Em ansiedade e pânico com TCC, costuma haver alívio percebido entre a quarta e a oitava sessão. Em luto, trauma ou questões de longa data, o primeiro movimento aparece mais tarde e é mais sutil. É por isso que existe a revisão a cada oito encontros: para medir isso junto, e não no chute.' },
  { p: 'O que eu falo fica entre nós?',
    r: 'Fica. O sigilo é obrigação do Código de Ética do psicólogo e só é quebrado nas exceções que a lei prevê — risco iminente de vida e determinação judicial —, e mesmo aí no mínimo necessário. Em atendimento infantil, os responsáveis recebem devolutiva de processo, não transcrição do que a criança disse.' },
];

const titulo = `${CLINICA.nome} ${CLINICA.sub} — terapia em ${CLINICA.cidade}, presencial e online`;
const descricao =
  'Consultório de psicologia clínica no Centro de Florianópolis. TCC, psicanálise, ACT, EMDR, terapia de casal e ludoterapia, presencial e online. Primeira conversa de 20 minutos sem custo.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['MedicalBusiness', 'Psychiatric'],
      '@id': `${CLINICA.site}/#clinica`,
      name: `${CLINICA.nome} ${CLINICA.sub}`,
      description: descricao,
      url: CLINICA.site,
      telephone: CLINICA.foneLink,
      email: CLINICA.email,
      priceRange: 'R$ 170 – R$ 290',
      foundingDate: String(CLINICA.desde),
      image: `${CLINICA.site}/img/vereda/sala.jpg`,
      address: {
        '@type': 'PostalAddress',
        streetAddress: CLINICA.rua,
        addressLocality: CLINICA.cidade,
        addressRegion: CLINICA.uf,
        postalCode: CLINICA.cep,
        addressCountry: 'BR',
      },
      openingHoursSpecification: [
        { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday'], opens: '08:00', closes: '20:00' },
        { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '09:00', closes: '13:00' },
      ],
      sameAs: [`https://instagram.com/${CLINICA.insta}`],
      employee: EQUIPE.map((e) => ({ '@type': 'Person', name: e.nome, jobTitle: e.papel, identifier: e.crp })),
      makesOffer: PLANOS.map((p) => ({ '@type': 'Offer', name: `Terapia ${p.t}`, price: p.mes ?? p.sessao, priceCurrency: 'BRL' })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: DUVIDAS.map((d) => ({ '@type': 'Question', name: d.p, acceptedAnswer: { '@type': 'Answer', text: d.r } })),
    },
  ],
};

const brl = (n: number) => `R$ ${n.toLocaleString('pt-BR')}`;
const dois = (n: number) => String(n).padStart(2, '0');
const corDe = (id: string) => TERAPIAS.find((t) => t.id === id)?.cor ?? '#2E6B52';
const nomeDe = (id: string) => TERAPIAS.find((t) => t.id === id)?.curto ?? id;

/* Quebra o título em palavras para cada uma entrar sozinha atrás da máscara. */
const palavras = (frase: string) => frase.split(' ');
---

<Base title={titulo} description={descricao}>
  <Fragment slot="head">
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={CLINICA.site} />
    <meta property="og:image" content={`${CLINICA.site}/img/vereda/sala.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#10312a" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Petrona:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Figtree:wght@400;500;600;700&display=swap"
    />
    <link rel="preload" as="image" href={`${IMG}/sala.webp`} type="image/webp" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.documentElement.classList.add('anda');
    </script>
  </Fragment>

  <div class="vd">
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>

    {/* ═══════════ BARRA ═══════════ */}
    <header class="topo" data-topo>
      <div class="caixa topo-in">
        <a class="marca" href="#inicio" aria-label={`${CLINICA.nome} ${CLINICA.sub}`}>
          <svg class="marca-s" viewBox="0 0 32 32" width="30" height="30" aria-hidden="true" fill="none">
            <path d="M16 29C16 18 10 12 4 9c8-1 12 3 12 8 0-7 4-10 12-9-6 3-12 9-12 21Z"
                  fill="currentColor" opacity=".92" />
            <path d="M16 29V17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" opacity=".55" />
          </svg>
          <span class="marca-t"><b>{CLINICA.nome}</b><i>{CLINICA.sub}</i></span>
        </a>

        <nav class="topo-nav" aria-label="Seções">
          {MENU.map((m) => <a href={`#${m.id}`}>{m.t}</a>)}
        </nav>

        <a class="bt bt-forte bt-peq" href="#contato">Agendar conversa</a>
      </div>
    </header>

    <main id="conteudo">
      {/* ═══════════ HERÓI ═══════════

        Texto grande à esquerda, fotografia sangrando pela direita e um cartão
        flutuante por cima da junção. A foto não é ilustração: é a resposta à
        primeira pergunta de quem procura terapia — "como é o lugar".
      */}
      <section class="heroi" id="inicio">
        <span class="heroi-luz" aria-hidden="true"></span>

        <div class="caixa heroi-in">
          <div class="heroi-txt">
            <p class="selo" data-rev style="--i:0">
              <span class="selo-p" aria-hidden="true"></span>
              {CLINICA.crp} · desde {CLINICA.desde} · {CLINICA.bairro}, {CLINICA.cidade}
            </p>

            <h1 class="titulao">
              {palavras('Terapia começa com uma conversa de vinte minutos —').map((p, i) => (
                <span class="pal"><span style={`--d:${i * 0.055}s`}>{p}</span></span>
              ))}
              <span class="pal"><span style="--d:0.5s"><em>de graça.</em></span></span>
            </h1>

            <p class="heroi-d" data-rev style="--i:1">
              Consultório de psicologia clínica no Centro de Florianópolis,
              presencial e online. Nessa primeira conversa a gente diz, com
              honestidade, <b>se é caso para terapia aqui — ou para onde
              encaminhar.</b>
            </p>

            <p class="acoes" data-rev style="--i:2">
              <a class="bt bt-forte" href="#contato">Agendar a primeira conversa</a>
              <a class="bt bt-fraco" href="#terapias">Ver as seis terapias</a>
            </p>

            <ul class="heroi-tiques" data-rev style="--i:3">
              <li>Sem cadastro</li>
              <li>Sem pagar nada antes</li>
              <li>Resposta no mesmo dia</li>
            </ul>
          </div>

          <div class="heroi-foto">
            <div class="heroi-corte" data-foto>
              <picture>
                <source srcset={`${IMG}/sala.webp`} type="image/webp" />
                <img
                  src={`${IMG}/sala.jpg`}
                  alt="Sala de atendimento da Vereda: janela do chão ao teto para as árvores, poltrona clara e sofá."
                  width="1000" height="987" fetchpriority="high" decoding="async"
                />
              </picture>
            </div>

            <div class="flutua" data-rev style="--i:4">
              <p class="flutua-n">20<span>min</span></p>
              <p class="flutua-t">Primeira conversa</p>
              <p class="flutua-d">Por vídeo ou telefone, sem custo e sem compromisso.</p>
            </div>
          </div>
        </div>
      </section>

      {/* ═══════════ PROVAS ═══════════ */}
      <section class="faixa" aria-label="A clínica em números">
        <div class="caixa faixa-in">
          {PROVAS.map((p, i) => (
            <div class="prova" data-rev style={`--i:${i}`}>
              <p class="prova-n">
                <b data-conta={p.n}>0</b>{p.suf && <span class="prova-suf">{p.suf}</span>}
                <span class="prova-t">{p.t}</span>
              </p>
              <p class="prova-d">{p.d}</p>
            </div>
          ))}
        </div>
      </section>

      {/* ═══════════ TERAPIAS ═══════════

        Cartões, sim — e aqui eles fazem sentido (§19): cada terapia é uma
        unidade que a pessoa compara. A faixa de cor no topo é o código da
        casa e volta na ficha de quem atende.
      */}
      <section class="secao secao-creme" id="terapias" aria-labelledby="t-terapias">
        <div class="caixa">
          <header class="cab">
            <p class="cab-n" data-rev>01</p>
            <div>
              <h2 id="t-terapias" class="titulo" data-rev>
                Seis terapias, medidas com a <em>mesma régua</em>
              </h2>
              <p class="cab-d" data-rev style="--i:1">
                Escolher a abordagem errada é o que mais faz gente desistir na
                quarta sessão. Aqui as seis respondem as mesmas perguntas: como
                é a sessão, com que frequência, e por quanto tempo.
              </p>
            </div>
          </header>

          <ul class="cartas">
            {TERAPIAS.map((t, i) => (
              <li class="carta" data-rev style={`--i:${i}; --cor:${t.cor}`}>
                <span class="carta-faixa" aria-hidden="true"></span>
                <span class="carta-ico" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor"
                       stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d={t.icone} />
                  </svg>
                </span>
                <p class="carta-tag">{t.curto}</p>
                <h3>{t.nome}</h3>
                <p class="carta-d">{t.resumo}</p>
                <dl class="carta-dados">
                  <div><dt>Frequência</dt><dd>{t.freq}</dd></div>
                  <div><dt>Duração</dt><dd>{t.dur}</dd></div>
                </dl>
                <p class="carta-para"><span>Indicado para</span>{t.para}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      {/* ═══════════ PERCURSO ═══════════

        Bloco escuro no meio da página. A linha à esquerda cresce conforme a
        seção entra: é o caminho, que é o nome da casa.
      */}
      <section class="secao secao-escura" id="percurso" aria-labelledby="t-percurso">
        <div class="caixa">
          <header class="cab">
            <p class="cab-n" data-rev>02</p>
            <div>
              <h2 id="t-percurso" class="titulo" data-rev>
                Da primeira conversa <em>até a alta</em>
              </h2>
              <p class="cab-d" data-rev style="--i:1">
                Cinco paradas, e a quinta é a alta. Terapia sem fim previsto é
                assinatura, não tratamento.
              </p>
            </div>
          </header>

          <div class="passos-caixa" data-passos>
            <span class="passos-linha" aria-hidden="true"><i></i></span>
            <ol class="passos">
            {PERCURSO.map((c, i) => (
              <li data-rev style={`--i:${i}`}>
                <span class="passo-bola" aria-hidden="true">{dois(i + 1)}</span>
                <div class="passo-txt">
                  <h3>{c.t}</h3>
                  <p>{c.d}</p>
                </div>
                <p class="passo-tag">{c.tag}</p>
              </li>
            ))}
            </ol>
          </div>
        </div>
      </section>

      {/* ═══════════ O ESPAÇO ═══════════

        Mosaico assimétrico: a primeira foto ocupa duas fileiras, as outras
        duas se empilham ao lado. Nada de três iguais em linha (§13).
      */}
      <section class="secao secao-areia" id="espaco" aria-labelledby="t-espaco">
        <div class="caixa">
          <header class="cab">
            <p class="cab-n" data-rev>03</p>
            <div>
              <h2 id="t-espaco" class="titulo" data-rev>
                Quarto andar, <em>janela para as árvores</em>
              </h2>
              <p class="cab-d" data-rev style="--i:1">
                Duas quadras da Praça XV. Prédio com elevador e acesso sem
                degrau. É este o lugar onde você vai sentar.
              </p>
            </div>
          </header>

          <div class="mosaico">
            {ESPACO.map((e, i) => (
              <figure class={`peca peca-${i}`} data-foto style={`--i:${i}`}>
                <picture>
                  <source srcset={`${IMG}/${e.img}.webp`} type="image/webp" />
                  <img src={`${IMG}/${e.img}.jpg`} alt={e.alt} width="1080" height="800"
                       loading="lazy" decoding="async" />
                </picture>
                <figcaption>
                  <b>{e.t}</b>
                  <span>{e.d}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      {/* ═══════════ EQUIPE ═══════════ */}
      <section class="secao secao-creme" id="equipe" aria-labelledby="t-equipe">
        <div class="caixa">
          <header class="cab">
            <p class="cab-n" data-rev>04</p>
            <div>
              <h2 id="t-equipe" class="titulo" data-rev>
                Quatro psicólogos, <em>uma supervisão só</em>
              </h2>
              <p class="cab-d" data-rev style="--i:1">
                Todo mundo leva os próprios casos à mesma supervisão clínica,
                uma vez por mês. Você escolhe com quem quer sentar.
              </p>
            </div>
          </header>

          <ul class="gente">
            {EQUIPE.map((p, i) => (
              <li data-rev style={`--i:${i}`}>
                <figure class="gente-foto" data-foto style={`--i:${i}`}>
                  <picture>
                    <source srcset={`${IMG}/${p.img}.webp`} type="image/webp" />
                    <img src={`${IMG}/${p.img}.jpg`} alt={p.alt} width="640" height="640"
                         loading="lazy" decoding="async" />
                  </picture>
                </figure>
                <div class="gente-txt">
                  <h3>{p.nome}</h3>
                  <p class="gente-papel">{p.papel}</p>
                  <p class="gente-crp">{p.crp}</p>
                  <p class="gente-form">{p.form}</p>
                  <p class="gente-faz">
                    {p.faz.map((f) => (
                      <span style={`--cor:${corDe(f)}`}>{nomeDe(f)}</span>
                    ))}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>

      {/* ═══════════ PLANOS ═══════════

        Cartões de preço num bloco escuro. O do meio sobe e ganha âmbar não
        por marketing, mas porque é o ritmo em que a maior parte do trabalho
        realmente acontece — e isso está escrito no cartão.
      */}
      <section class="secao secao-escura" id="planos" aria-labelledby="t-planos">
        <div class="caixa">
          <header class="cab">
            <p class="cab-n" data-rev>05</p>
            <div>
              <h2 id="t-planos" class="titulo" data-rev>
                Preço fechado, <em>sem letra miúda</em>
              </h2>
              <p class="cab-d" data-rev style="--i:1">
                A frequência é indicação clínica e sai do encontro inicial. Os
                valores estão aqui para você decidir antes de marcar, não
                depois.
              </p>
            </div>
          </header>

          <ul class="planos">
            {PLANOS.map((p, i) => (
              <li class={`plano${p.destaque ? ' plano-alto' : ''}`} data-rev style={`--i:${i}`}>
                {p.destaque && <p class="plano-fita">O mais escolhido</p>}
                <h3>{p.t}</h3>
                <p class="plano-sub">{p.sub}</p>

                <p class="plano-preco">
                  {p.mes ? (
                    <><b>{brl(p.mes)}</b><span>por mês</span></>
                  ) : (
                    <><b>{brl(p.sessao)}</b><span>por encontro</span></>
                  )}
                </p>
                <p class="plano-sessao">
                  {p.mes ? `${brl(p.sessao)} a sessão · ${p.ritmo}` : p.ritmo}
                </p>

                <ul class="plano-itens">
                  {p.itens.map((it) => (
                    <li>
                      <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true" fill="none"
                           stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m4 10.5 4 4 8-9" />
                      </svg>
                      {it}
                    </li>
                  ))}
                </ul>

                <a class={`bt ${p.destaque ? 'bt-ambar' : 'bt-vazado'}`} href="#contato">
                  Começar por aqui
                </a>
              </li>
            ))}
          </ul>

          <p class="planos-pe" data-rev style="--i:3">
            Recibo mensal com CRP em todos os planos, para reembolso do convênio
            e dedução no imposto de renda. Remarcação sem custo avisada com 24
            horas.
          </p>
        </div>
      </section>

      {/* ═══════════ DÚVIDAS ═══════════ */}
      <section class="secao secao-creme" id="duvidas" aria-labelledby="t-duvidas">
        <div class="caixa duvidas-grade">
          <header class="cab cab-solta">
            <p class="cab-n" data-rev>06</p>
            <div>
              <h2 id="t-duvidas" class="titulo" data-rev>
                O que perguntam <em>antes da primeira sessão</em>
              </h2>
              <p class="cab-d" data-rev style="--i:1">
                Se a sua pergunta não estiver aqui, mande no WhatsApp. Quem
                responde é um psicólogo da equipe, não um atendente.
              </p>
            </div>
          </header>

          <ul class="duvidas">
            {DUVIDAS.map((d, i) => (
              <li data-rev style={`--i:${i}`}>
                <details>
                  <summary>
                    <span>{d.p}</span>
                    <span class="sinal" aria-hidden="true"></span>
                  </summary>
                  <p>{d.r}</p>
                </details>
              </li>
            ))}
          </ul>
        </div>
      </section>

      {/* ═══════════ CONTATO ═══════════ */}
      <section class="secao secao-escura contato" id="contato" aria-labelledby="t-contato">
        <div class="caixa">
          <div class="contato-grade">
            <div>
              <p class="cab-n cab-n-solo" data-rev>07</p>
              <h2 id="t-contato" class="titulao titulao-peq" data-rev style="--i:1">
                Vinte minutos <em>para saber se é aqui.</em>
              </h2>
              <p class="contato-d" data-rev style="--i:2">
                Escreva no WhatsApp, ligue ou mande um e-mail. A gente marca a
                conversa em geral para o mesmo dia ou o seguinte.
              </p>

              <p class="acoes" data-rev style="--i:3">
                <a class="bt bt-ambar" href={`https://wa.me/${CLINICA.zap}`} rel="noopener">
                  WhatsApp {CLINICA.zapFmt}
                </a>
                <a class="bt bt-vazado" href={`tel:${CLINICA.foneLink}`}>{CLINICA.fone}</a>
              </p>

              <p class="contato-mail" data-rev style="--i:4">
                <a href={`mailto:${CLINICA.email}`}>{CLINICA.email}</a>
              </p>
            </div>

            <div class="contato-lado">
              <div class="urgencia" role="note" data-rev style="--i:2">
                <p class="urg-t">Se for urgência, não espere resposta aqui</p>
                <p>
                  A Vereda não é serviço de emergência. Havendo risco imediato,
                  ligue <a href="tel:188">188 (CVV)</a> — de graça, 24 horas —,
                  procure o CAPS da sua região ou a emergência do hospital mais
                  próximo.
                </p>
              </div>

              <div class="onde" data-rev style="--i:3">
                <div>
                  <h3>Endereço</h3>
                  <address>
                    {CLINICA.rua}<br />
                    {CLINICA.bairro} · {CLINICA.cidade}/{CLINICA.uf}<br />
                    CEP {CLINICA.cep}
                  </address>
                  <a class="link-fino" href={`https://www.google.com/maps/search/?api=1&query=${mapaQuery}`} rel="noopener">
                    Abrir no mapa
                  </a>
                </div>
                <div>
                  <h3>Horário</h3>
                  <dl class="horas">
                    <div><dt>Seg a sex</dt><dd><time>8h–20h</time></dd></div>
                    <div><dt>Sábado</dt><dd><time>9h–13h</time></dd></div>
                    <div class="off"><dt>Domingo</dt><dd>fechado</dd></div>
                  </dl>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="rodape">
      <div class="caixa">
        <div class="rd-topo">
          <a class="marca marca-gr" href="#inicio">
            <svg class="marca-s" viewBox="0 0 32 32" width="46" height="46" aria-hidden="true" fill="none">
              <path d="M16 29C16 18 10 12 4 9c8-1 12 3 12 8 0-7 4-10 12-9-6 3-12 9-12 21Z"
                    fill="currentColor" opacity=".92" />
              <path d="M16 29V17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" opacity=".55" />
            </svg>
            <span class="marca-t"><b>{CLINICA.nome}</b><i>{CLINICA.sub}</i></span>
          </a>
          <p class="rd-nap">
            {CLINICA.crp} · {CLINICA.rua}, {CLINICA.bairro},
            {' '}{CLINICA.cidade}/{CLINICA.uf} ·
            {' '}<a href={`tel:${CLINICA.foneLink}`}>{CLINICA.fone}</a> ·
            {' '}<a href={`https://instagram.com/${CLINICA.insta}`} rel="noopener">@{CLINICA.insta}</a>
          </p>
        </div>
        <p class="rd-legal">
          Demonstração de portfólio. A Vereda é um consultório fictício:
          endereço, telefone, equipe e valores são de exemplo, e nenhum
          agendamento é registrado de verdade. O telefone do CVV (188) é real e
          funciona.
        </p>
        <p class="rd-fim">
          <span>© {ANO} {CLINICA.nome}</span>
          <a href="#inicio">Voltar ao topo</a>
        </p>
      </div>
    </footer>
  </div>
</Base>

<style>
  /* ─────────── tokens ─────────── */
  .vd {
    --creme: #fbf6ec;
    --areia: #f0e7d7;
    --verde-esc: #10312a;
    --verde: #1c4a38;
    --verde-viva: #2e6b52;
    --salvia: #9fc3ac;
    --salvia-esc: #7fa98c;
    --ambar: #d08a4e;
    --ambar-cl: #e8b67f;
    --tinta: #16241d;
    --tinta-70: #495a50;
    --tinta-45: #55645b;
    --borda: #e2d8c5;
    --e: cubic-bezier(0.22, 0.68, 0.3, 1);

    background: var(--creme);
    color: var(--tinta);
    font-family: 'Figtree', ui-sans-serif, system-ui, sans-serif;
    font-size: 16px; line-height: 1.6;
    min-height: 100dvh;
    overflow-x: clip;
  }
  .vd :where(h1,h2,h3,p,ul,ol,dl,figure,address,figcaption) { margin: 0; }
  .vd :where(ul,ol) { list-style: none; padding: 0; }
  .vd address { font-style: normal; }
  .vd *:focus-visible { outline: 2px solid var(--ambar); outline-offset: 3px; }

  .caixa { width: min(100% - 2.4rem, 74rem); margin-inline: auto; }
  .pular { position: absolute; left: -9999px; top: 0; z-index: 60; background: var(--verde-esc); color: var(--creme); padding: 0.7rem 1.1rem; }
  .pular:focus { left: 0.6rem; top: 0.6rem; }

  /* ─────────── tipografia ─────────── */
  .titulao, .titulo, .vd h3, .prova-n b, .flutua-n, .plano-preco b, .cab-n {
    font-family: 'Petrona', Georgia, serif; font-weight: 400;
  }
  /* na escala pequena a variável afina demais: 500 devolve o corpo */
  .vd h3, .marca-t b, .peca figcaption b { font-weight: 500; }
  .titulao {
    font-size: clamp(2.4rem, 6vw, 4.4rem); line-height: 1.04;
    letter-spacing: -0.02em;
  }
  .titulo {
    font-size: clamp(1.9rem, 4.2vw, 3.1rem); line-height: 1.08;
    letter-spacing: -0.018em; text-wrap: balance;
  }
  .titulao em, .titulo em { font-style: italic; color: var(--verde-viva); }
  .secao-escura .titulo em, .secao-escura .titulao em { color: var(--ambar-cl); }
  .vd h3 { font-size: 1.3rem; line-height: 1.2; letter-spacing: -0.01em; }

  /* palavra a palavra, atrás de uma máscara */
  .pal { display: inline-block; overflow: hidden; vertical-align: bottom; padding-bottom: 0.08em; }
  .pal > span { display: inline-block; }
  .pal + .pal { margin-left: 0.22em; }
  :global(.anda) .pal > span { translate: 0 105%; animation: sobe 0.85s var(--e) forwards; animation-delay: var(--d, 0s); }
  @keyframes sobe { to { translate: 0 0; } }

  /* ─────────── botões ─────────── */
  .acoes { display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .bt {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 52px; padding: 0 1.6rem; border-radius: 999px;
    font-size: 0.98rem; font-weight: 600; text-decoration: none;
    border: 1.5px solid transparent; cursor: pointer;
    transition: background 0.25s var(--e), color 0.25s var(--e),
                border-color 0.25s var(--e), translate 0.25s var(--e), box-shadow 0.25s var(--e);
  }
  .bt-peq { min-height: 42px; padding: 0 1.15rem; font-size: 0.9rem; }
  .bt-forte { background: var(--verde-esc); color: var(--creme); }
  .bt-forte:hover { background: var(--verde-viva); translate: 0 -2px; box-shadow: 0 10px 22px -14px rgb(16 49 42 / 0.8); }
  .bt-fraco { border-color: var(--borda); color: var(--tinta); background: transparent; }
  .bt-fraco:hover { border-color: var(--verde-viva); color: var(--verde-viva); translate: 0 -2px; }
  .bt-ambar { background: var(--ambar); color: #24160a; }
  .bt-ambar:hover { background: var(--ambar-cl); translate: 0 -2px; box-shadow: 0 12px 26px -16px rgb(208 138 78 / 0.9); }
  .bt-vazado { border-color: rgb(251 246 236 / 0.32); color: var(--creme); }
  .bt-vazado:hover { border-color: var(--creme); translate: 0 -2px; }

  /* ─────────── barra ─────────── */
  .topo {
    position: sticky; top: 0; z-index: 40;
    background: rgb(251 246 236 / 0.84); backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--e);
  }
  .topo[data-rolou] { border-bottom-color: var(--borda); }
  .topo-in { display: flex; align-items: center; justify-content: space-between; gap: 1.2rem; padding-block: 0.7rem; }
  .marca { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; color: var(--verde); }
  .marca-s { flex: 0 0 auto; }
  .marca-t { display: grid; line-height: 1.05; }
  .marca-t b { font-family: 'Petrona', Georgia, serif; font-weight: 400; font-size: 1.5rem; color: var(--tinta); }
  .marca-t i {
    font-style: normal; font-size: 0.6rem; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--tinta-45);
  }
  .topo-nav { display: none; gap: 1.7rem; }
  @media (min-width: 960px) { .topo-nav { display: flex; } }
  .topo-nav a {
    font-size: 0.92rem; font-weight: 500; color: var(--tinta-70); text-decoration: none;
    position: relative; padding-block: 0.3rem;
  }
  .topo-nav a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px;
    background: var(--ambar); scale: 0 1; transform-origin: left;
    transition: scale 0.3s var(--e);
  }
  .topo-nav a:hover { color: var(--tinta); }
  .topo-nav a:hover::after { scale: 1 1; }

  /* ─────────── herói ─────────── */
  .heroi { position: relative; padding-block: clamp(2.5rem, 6vw, 4.5rem) 0; overflow: clip; }
  .heroi-luz {
    position: absolute; z-index: 0; pointer-events: none;
    right: -12%; top: -18%; width: 70vw; height: 70vw; max-width: 900px; max-height: 900px;
    background: radial-gradient(circle, rgb(208 138 78 / 0.22), rgb(208 138 78 / 0) 62%);
  }
  .heroi-in { position: relative; z-index: 1; display: grid; gap: clamp(2rem, 5vw, 3rem); }
  @media (min-width: 940px) {
    .heroi-in { grid-template-columns: 1.02fr 0.98fr; align-items: center; gap: 3.5rem; }
  }
  .heroi-txt { padding-bottom: clamp(1rem, 4vw, 3rem); }

  .selo {
    display: inline-flex; align-items: center; gap: 0.55rem;
    padding: 0.4rem 0.95rem 0.4rem 0.7rem; border-radius: 999px;
    background: rgb(46 107 82 / 0.09); border: 1px solid rgb(46 107 82 / 0.18);
    font-size: 0.78rem; font-weight: 500; color: var(--verde);
    margin-bottom: 1.6rem;
  }
  .selo-p { width: 7px; height: 7px; border-radius: 50%; background: var(--verde-viva); flex: 0 0 auto; }
  :global(.anda) .selo-p { animation: pulsa 2.6s ease-in-out infinite; }
  @keyframes pulsa { 0%,100% { box-shadow: 0 0 0 0 rgb(46 107 82 / 0.5); } 60% { box-shadow: 0 0 0 7px rgb(46 107 82 / 0); } }

  .heroi-d {
    margin-top: 1.7rem; font-size: clamp(1.02rem, 1.5vw, 1.15rem);
    line-height: 1.62; color: var(--tinta-70); max-width: 46ch;
  }
  /* o que importa fica gravado: risca âmbar por baixo da frase-chave */
  .heroi-d b {
    font-weight: 600; color: var(--tinta);
    background: linear-gradient(transparent 62%, rgb(208 138 78 / 0.38) 62%);
  }
  .heroi .acoes { margin-top: 2.1rem; }
  .heroi-tiques {
    display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; margin-top: 1.7rem;
    font-size: 0.86rem; color: var(--tinta-45);
  }
  .heroi-tiques li { display: flex; align-items: center; gap: 0.45rem; }
  .heroi-tiques li::before {
    content: ''; width: 14px; height: 14px; border-radius: 50%;
    background: rgb(46 107 82 / 0.16);
    box-shadow: inset 0 0 0 1px rgb(46 107 82 / 0.3);
  }

  .heroi-foto { position: relative; }
  .heroi-corte { overflow: hidden; border-radius: 1.4rem 1.4rem 0 0; }
  @media (min-width: 940px) {
    .heroi-foto { margin-right: calc((100vw - min(100vw - 2.4rem, 74rem)) / -2); }
    .heroi-corte { border-radius: 1.6rem 0 0 1.6rem; }
  }
  .heroi-corte img { display: block; width: 100%; height: auto; aspect-ratio: 1 / 0.92; object-fit: cover; }

  .flutua {
    position: relative; margin: -3.4rem 0 0 1rem; width: min(19rem, 84%);
    background: var(--creme); border-radius: 1.1rem; padding: 1.2rem 1.3rem;
    box-shadow: 0 24px 50px -30px rgb(16 49 42 / 0.6), 0 0 0 1px rgb(226 216 197 / 0.9);
  }
  @media (min-width: 940px) { .flutua { position: absolute; left: -2.4rem; bottom: 2.4rem; margin: 0; } }
  .flutua-n {
    font-size: 2.6rem; line-height: 1; color: var(--verde-viva);
    display: flex; align-items: baseline; gap: 0.25rem;
  }
  .flutua-n span { font-family: 'Figtree', sans-serif; font-size: 0.85rem; font-weight: 600; }
  .flutua-t { margin-top: 0.5rem; font-weight: 600; font-size: 0.98rem; }
  .flutua-d { margin-top: 0.2rem; font-size: 0.85rem; color: var(--tinta-45); line-height: 1.5; }

  /* ─────────── faixa de números ─────────── */
  .faixa { background: var(--verde-esc); color: var(--creme); padding-block: clamp(2.2rem, 5vw, 3.2rem); }
  .faixa-in { display: grid; gap: 1.6rem 2rem; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 860px) { .faixa-in { grid-template-columns: repeat(4, 1fr); } }
  .prova-n { display: flex; align-items: baseline; gap: 0.35rem; flex-wrap: wrap; }
  .prova-n b { font-size: clamp(2.2rem, 5vw, 3rem); line-height: 1; color: var(--ambar-cl); font-variant-numeric: tabular-nums; }
  .prova-suf { font-size: 0.9rem; font-weight: 600; color: var(--ambar-cl); }
