</Base>

<style>
  .vd {
    --branco: #ffffff;
    --nevoa: #f3f8f3;
    --musgo: #e6efe6;
    --salvia: #a9c4a6;
    --verde: #3f7d5b;
    --verde-2: #35694c;
    --verde-esc: #1f4a37;
    --noite: #12332a;
    --noite-2: #17402f;
    --tinta: #16261f;
    --c60: #56675d;
    --c40: #8b988f;
    --linha: #e2ebe3;
    --linha-forte: #cfdfd1;
    --claro-60: rgba(240, 248, 241, 0.72);
    --claro-40: rgba(240, 248, 241, 0.5);

    --raio: 16px;
    --raio-g: 28px;
    --raio-xg: 40px;
    --t: 0.5s;
    --t-icone: 0.3s;
    --e: cubic-bezier(0.22, 0.61, 0.36, 1);
    --topo-h: 4.2rem;
    --sombra: 0 1px 2px rgba(22, 38, 31, 0.04), 0 12px 30px -18px rgba(22, 38, 31, 0.2);
    --sombra-alta: 0 2px 8px rgba(22, 38, 31, 0.05), 0 30px 60px -28px rgba(22, 38, 31, 0.28);

    position: relative;
    background: var(--branco);
    color: var(--tinta);
    font-family: 'Plus Jakarta Sans', ui-sans-serif, system-ui, sans-serif;
    line-height: 1.68;
    overflow-x: clip;
  }
  :global(body) { background: #fff; color: #16261f; }
  :global(html) { scrollbar-color: #bed3c0 #f0f5f0; }
  :global(::selection) { background: #3f7d5b; color: #fff; }

  .vd a { text-underline-offset: 0.18em; text-decoration-thickness: 1px; }
  .vd :is(input, textarea, select) { caret-color: var(--verde); }
  .vd :is(input, textarea)::placeholder { color: var(--c40); }
  .vd :is(.faixa dt, .plano-preco, .parada-n, .mono) { font-variant-numeric: tabular-nums; }

  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .pular {
    position: absolute; left: -9999px; top: 0; z-index: 100;
    background: var(--noite); color: #fff; padding: 0.7rem 1.1rem;
    text-decoration: none; border-radius: 0 0 var(--raio) 0;
  }
  .pular:focus { left: 0; }
  .mono { font-family: ui-monospace, 'SFMono-Regular', monospace; font-size: 0.86em; }

  /* ---------- tipografia ---------- */
  h1, h2, h3 {
    font-family: 'Fraunces', 'Iowan Old Style', Georgia, serif;
    font-weight: 600; letter-spacing: -0.018em; line-height: 1.16;
    margin: 0; text-wrap: balance;
  }
  h1 {
    font-size: clamp(2.3rem, 5.4vw, 4.1rem);
    line-height: 1.08; letter-spacing: -0.025em;
    font-variation-settings: 'opsz' 100;
  }
  h1 em { font-style: italic; color: var(--verde); font-variation-settings: 'opsz' 144; }
  h2 { font-size: clamp(1.6rem, 3.1vw, 2.5rem); font-variation-settings: 'opsz' 60; }
  h3 { font-size: 1.18rem; letter-spacing: -0.012em; }
  p { margin: 0; text-wrap: pretty; }

  .lead { font-size: 1.03rem; color: var(--c60); max-width: 60ch; }
  .lead-claro { font-size: 1.03rem; color: var(--claro-60); max-width: 58ch; }

  .etiqueta {
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--verde);
    margin-bottom: 0.85rem;
    display: flex; align-items: center; gap: 0.6rem;
  }
  .etiqueta::after {
    content: ''; height: 1px; width: 2.6rem;
    background: linear-gradient(90deg, var(--salvia), transparent);
  }
  .etiqueta-claro { color: var(--salvia); }
  .etiqueta-claro::after { background: linear-gradient(90deg, rgba(169, 196, 166, 0.7), transparent); }
  .cab-centro .etiqueta { justify-content: center; }
  .cab-centro .etiqueta::after { display: none; }

  .caixa { max-width: 1200px; margin: 0 auto; padding-inline: clamp(1.1rem, 4vw, 2.6rem); }
  .secao { position: relative; padding-block: clamp(4rem, 8vw, 7rem); }
  .secao-nevoa { background: var(--nevoa); }
  .secao-musgo { background: var(--musgo); }
  .secao-fundo { background: var(--noite); color: #f0f8f1; }
  .secao-fundo h2 { color: #f6fbf6; }
  .cab { margin-bottom: clamp(2.4rem, 4.5vw, 3.6rem); max-width: 64ch; }
  .cab .lead { margin-top: 1rem; }
  .cab-centro { margin-inline: auto; text-align: center; }
  .cab-centro .lead { margin-inline: auto; }
  .cab-larga {
    max-width: none; display: grid; gap: 1.4rem;
    align-items: end;
  }
  .vd section[id] { scroll-margin-top: calc(var(--topo-h) + 0.8rem); }

  /* ---------- ondas entre seções ---------- */
  .onda {
    position: absolute; left: -1px; width: calc(100% + 2px);
    height: clamp(48px, 6vw, 90px); display: block; pointer-events: none;
  }
  .onda path { fill: var(--branco); }
  .onda-baixo { bottom: -1px; }
  /* acima da seção, pintando a cor dela para cima; espelhada para não repetir a curva */
  .onda-cima { bottom: 100%; scale: -1 1; }
  .onda-branca path { fill: var(--branco); }
  .onda-nevoa path { fill: var(--nevoa); }
  .onda-musgo path { fill: var(--musgo); }
  .onda-musgo-b path { fill: var(--branco); }
  .onda-fundo path { fill: var(--noite); }

  /* ---------- botões ---------- */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.55rem;
    padding: 0.78rem 1.5rem; border-radius: 999px;
    font-family: inherit; font-size: 0.93rem; font-weight: 600;
    text-decoration: none; border: 1px solid transparent;
    white-space: nowrap; cursor: pointer;
    transition: background var(--t) var(--e), color var(--t) var(--e),
      border-color var(--t) var(--e), box-shadow var(--t) var(--e),
      translate var(--t) var(--e);
  }
  .btn-g { padding: 0.98rem 1.8rem; font-size: 1rem; }
  .btn-min { padding: 0.54rem 1.1rem; font-size: 0.84rem; }
  .btn-cheio { width: 100%; }
  .btn-p {
    background: var(--verde); color: #fff;
    box-shadow: 0 10px 24px -14px rgba(31, 74, 55, 0.7);
  }
  .btn-p:hover { background: var(--verde-esc); translate: 0 -2px; box-shadow: 0 16px 32px -16px rgba(31, 74, 55, 0.6); }
  .btn-vaz { border-color: var(--linha-forte); color: var(--tinta); background: rgba(255, 255, 255, 0.6); }
  .btn-vaz:hover { border-color: var(--verde); color: var(--verde); translate: 0 -2px; }
  .secao-fundo .btn-vaz { border-color: rgba(169, 196, 166, 0.4); color: #eef7ef; background: transparent; }

  /* ---------- topo ---------- */
  .topo {
    position: sticky; top: 0; z-index: 60;
    height: var(--topo-h);
    display: flex; align-items: center; gap: clamp(0.7rem, 2vw, 1.6rem);
    padding-inline: clamp(1.1rem, 4vw, 2.6rem);
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(14px) saturate(1.3);
    border-bottom: 1px solid transparent;
    transition: border-color var(--t) var(--e), background var(--t) var(--e);
  }
  .topo[data-topo='rolou'] { border-bottom-color: var(--linha); background: rgba(255, 255, 255, 0.93); }
  .topo-barra {
    position: absolute; inset: auto 0 -1px 0; height: 2px; transform-origin: 0 50%;
    background: linear-gradient(90deg, var(--salvia), var(--verde));
    scale: 0 1;
  }
  .marca {
    display: inline-flex; align-items: center; gap: 0.6rem;
    text-decoration: none; color: var(--tinta); margin-right: auto;
  }
  .marca-folha { width: 2.1rem; height: 2.1rem; color: var(--verde); flex: none; }
  .marca-folha svg { width: 100%; height: 100%; display: block; }
  .marca-txt {
    font-family: 'Fraunces', Georgia, serif; font-weight: 600;
    font-size: 1.22rem; letter-spacing: -0.02em; line-height: 1.05;
    display: flex; flex-direction: column;
  }
  .marca-txt small {
    font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 500;
    font-size: 0.58rem; letter-spacing: 0.24em; text-transform: uppercase;
    color: var(--c40);
  }
  .topo-nav { display: none; gap: clamp(0.9rem, 1.8vw, 1.7rem); }
  .topo-nav a {
    color: var(--c60); text-decoration: none; font-size: 0.88rem; font-weight: 500;
    padding-block: 0.35rem; position: relative;
    transition: color var(--t) var(--e);
  }
  .topo-nav a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0;
    height: 1.5px; border-radius: 2px; background: var(--verde);
    scale: 0 1; transform-origin: 0 50%;
    transition: scale var(--t) var(--e);
  }
  .topo-nav a:hover { color: var(--verde); }
  .topo-nav a:hover::after { scale: 1 1; }

  /* ---------- herói ---------- */
  .heroi {
    position: relative; isolation: isolate;
    padding-block: clamp(2.6rem, 6vw, 5rem) clamp(6rem, 12vw, 10rem);
    /* fundo de reserva: é o que aparece se o WebGL não subir */
    background:
      radial-gradient(120% 90% at 78% 8%, rgba(169, 196, 166, 0.55), transparent 62%),
      radial-gradient(90% 70% at 8% 22%, rgba(63, 125, 91, 0.16), transparent 60%),
      linear-gradient(180deg, var(--nevoa), var(--branco) 72%);
  }
  .tela {
    position: absolute; inset: 0; width: 100%; height: 100%;
    z-index: -2; display: block;
  }
  .tela[hidden] { display: none; }
  .heroi-veu {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.42) 0%, rgba(255, 255, 255, 0.1) 34%, rgba(255, 255, 255, 0.86) 82%, #fff 100%),
      radial-gradient(60% 50% at 22% 42%, rgba(255, 255, 255, 0.78), transparent 70%);
  }
  .heroi-grade { display: grid; gap: clamp(2.4rem, 5vw, 4rem); align-items: center; }

  .selo {
    display: inline-flex; align-items: center; gap: 0.55rem;
    padding: 0.42rem 0.95rem 0.42rem 0.72rem; margin-bottom: 1.6rem;
    border-radius: 999px; border: 1px solid rgba(63, 125, 91, 0.22);
    background: rgba(255, 255, 255, 0.7);
    font-size: 0.74rem; font-weight: 500; color: var(--verde-esc);
    backdrop-filter: blur(6px);
  }
  .ponto {
    width: 7px; height: 7px; border-radius: 50%; flex: none;
    background: var(--verde); box-shadow: 0 0 0 4px rgba(63, 125, 91, 0.14);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ponto { animation: pulso 3.2s var(--e) infinite; }
  }
  @keyframes pulso {
    50% { box-shadow: 0 0 0 8px rgba(63, 125, 91, 0.05); }
  }

  h1 .linha { display: block; }
  .heroi .lead { margin-top: 1.7rem; }
  .heroi-acoes { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2.2rem; }
  .heroi-fatos {
    list-style: none; margin: 2.4rem 0 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 0.7rem 1.6rem;
    font-size: 0.84rem; color: var(--c60);
  }
  .heroi-fatos li { display: inline-flex; align-items: center; gap: 0.5rem; }
  .heroi-fatos i { color: var(--verde); font-size: 0.82em; }

  .heroi-foto { position: relative; margin: 0; }
  /*
    "Folha": dois cantos arredondados de verdade e dois quase retos. É a forma
    da marca, e reaparece na galeria e nas fotos da equipe.
  */
  .folha {
    border-radius: clamp(60px, 14vw, 160px) var(--raio-g) clamp(60px, 14vw, 160px) var(--raio-g);
    overflow: hidden; box-shadow: var(--sombra-alta);
    background: var(--musgo);
  }
  .folha img { display: block; width: 100%; height: auto; }
  .flutua {
    position: absolute; left: clamp(-0.4rem, 1vw, 1rem); bottom: clamp(-1.4rem, -2vw, -0.8rem);
    display: grid; gap: 0.15rem;
    padding: 0.9rem 1.25rem; max-width: 15rem;
    border-radius: var(--raio-g) var(--raio-g) var(--raio-g) 8px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    border: 1px solid var(--linha);
    box-shadow: var(--sombra);
  }
  .flutua b {
    font-family: 'Fraunces', Georgia, serif; font-size: 1.4rem;
    color: var(--verde); line-height: 1;
  }
  .flutua span { font-size: 0.76rem; color: var(--c60); line-height: 1.45; }
  .bolha { position: absolute; border-radius: 50%; filter: blur(0.5px); z-index: -1; }
  .bolha-a {
    width: 7rem; height: 7rem; right: -1.4rem; top: -1.8rem;
    background: radial-gradient(circle at 32% 30%, rgba(169, 196, 166, 0.85), rgba(169, 196, 166, 0.15));
  }
  .bolha-b {
    width: 3.4rem; height: 3.4rem; right: 12%; bottom: -1.6rem;
    background: radial-gradient(circle at 35% 32%, rgba(63, 125, 91, 0.4), rgba(63, 125, 91, 0.06));
  }

  /* ---------- faixa de números ---------- */
  .faixa { padding-block: clamp(2.2rem, 4vw, 3.4rem); background: var(--branco); }
  .faixa-grade {
    display: grid; gap: 1.8rem 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr));
  }
  .faixa dt {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(2rem, 3.6vw, 2.8rem); font-weight: 600;
    letter-spacing: -0.03em; line-height: 1; color: var(--verde-esc);
    display: flex; align-items: baseline; gap: 0.35rem;
  }
  .faixa dt small {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.78rem; font-weight: 600; letter-spacing: 0.06em;
    color: var(--verde);
  }
  .faixa dd { margin: 0.55rem 0 0; font-size: 0.83rem; color: var(--c60); max-width: 24ch; }

  /* ---------- cartas de abordagem ---------- */
  .cartas {
    display: grid; gap: clamp(1rem, 2vw, 1.5rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }
  .carta {
    position: relative; overflow: hidden;
    display: flex; flex-direction: column;
    padding: clamp(1.5rem, 2.6vw, 2rem);
    border-radius: var(--raio-xg) var(--raio) var(--raio-xg) var(--raio);
    background: var(--branco);
    border: 1px solid var(--linha);
    transition: translate var(--t) var(--e), box-shadow var(--t) var(--e), border-color var(--t) var(--e);
  }
  .carta:hover { translate: 0 -4px; box-shadow: var(--sombra-alta); border-color: var(--linha-forte); }
  /* arco que assina o canto sem pesar */
  .carta-arco {
    position: absolute; right: -4.5rem; top: -4.5rem;
    width: 11rem; height: 11rem; border-radius: 50%;
    background: radial-gradient(circle at 35% 65%, rgba(169, 196, 166, 0.26), transparent 68%);
    transition: scale var(--t) var(--e);
  }
  .carta:hover .carta-arco { scale: 1.18; }
  .carta-icone {
    width: 2.9rem; height: 2.9rem; display: grid; place-items: center;
    border-radius: 50% 50% 50% 12px;
    background: var(--musgo); color: var(--verde);
    font-size: 1.05rem; margin-bottom: 1.1rem;
  }
  .carta-sigla {
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--verde); margin-bottom: 0.4rem;
  }
  .carta h3 { margin-bottom: 0.7rem; }
  .carta-resumo { font-size: 0.92rem; color: var(--c60); }
  .carta-como {
    list-style: none; margin: 1.1rem 0 auto; padding: 0;
    display: grid; gap: 0.5rem; font-size: 0.85rem; color: var(--c60);
  }
  .carta-como li { display: grid; grid-template-columns: 1rem 1fr; gap: 0.55rem; }
  .carta-como li::before {
    content: ''; width: 7px; height: 7px; margin-top: 0.58rem;
    border-radius: 50% 50% 50% 2px; background: var(--salvia);
  }
  .carta-dados {
    display: flex; flex-wrap: wrap; gap: 0.4rem 1.6rem;
    margin: 1.3rem 0 0; padding-top: 1.1rem;
    border-top: 1px solid var(--linha);
  }
  .carta-dados dt {
    font-size: 0.64rem; font-weight: 600; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--c40);
  }
  .carta-dados dd { margin: 0.1rem 0 0; font-size: 0.86rem; font-weight: 600; color: var(--tinta); }
  .carta-para {
    padding-top: 1rem;
    font-size: 0.82rem; color: var(--c60);
  }
  .carta-para b {
    display: block; font-size: 0.64rem; font-weight: 600; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--c40); margin-bottom: 0.2rem;
  }

  /* ---------- trilha ---------- */
  .trilha { position: relative; list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(1.4rem, 3vw, 2.4rem); }
  /* o fio corre pelo centro da coluna das bolinhas — 2,9 rem, a largura delas */
  .trilha-fio {
    position: absolute; left: 0; top: 1.5rem; bottom: 1.5rem;
    width: 2.9rem; height: auto; color: var(--salvia);
    pointer-events: none;
  }
  .parada {
    position: relative; display: grid; gap: 1rem 1.4rem;
    grid-template-columns: auto 1fr; align-items: start;
  }
  .parada-n {
    display: grid; place-items: center;
    width: 2.9rem; height: 2.9rem; flex: none;
    border-radius: 50% 50% 50% 10px;
    background: var(--branco); border: 1.5px solid var(--linha-forte);
    font-family: 'Fraunces', Georgia, serif; font-size: 0.92rem; font-weight: 600;
    color: var(--verde); z-index: 1;
    transition: background var(--t) var(--e), color var(--t) var(--e),
      border-color var(--t) var(--e), scale var(--t) var(--e);
  }
  .parada[data-vista] .parada-n {
    background: var(--verde); border-color: var(--verde); color: #fff; scale: 1.06;
  }
  .parada-corpo {
    padding: clamp(1.2rem, 2.4vw, 1.7rem) clamp(1.3rem, 2.6vw, 1.9rem);
    border-radius: var(--raio-xg) var(--raio) var(--raio-xg) var(--raio);
    background: var(--nevoa); border: 1px solid var(--linha);
  }
  .parada-tag {
    font-size: 0.66rem; font-weight: 600; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--verde); margin-bottom: 0.45rem;
  }
  .parada-corpo h3 { margin-bottom: 0.5rem; }
  .parada-corpo p { font-size: 0.92rem; color: var(--c60); max-width: 62ch; }

  /* ---------- galeria do espaço ---------- */
  .galeria { display: grid; gap: clamp(1.1rem, 2.4vw, 1.8rem); }
  .peca { margin: 0; }
  .peca picture { display: block; overflow: hidden; background: var(--nevoa); }
  .peca img {
    display: block; width: 100%; height: 100%; object-fit: cover;
    transition: scale 0.9s var(--e);
  }
  .peca:hover img { scale: 1.04; }
  .peca-0 picture { border-radius: clamp(50px, 10vw, 120px) var(--raio-g) clamp(50px, 10vw, 120px) var(--raio-g); }
  .peca-1 picture { border-radius: var(--raio-g) clamp(50px, 10vw, 120px) var(--raio-g) clamp(50px, 10vw, 120px); }
  .peca-2 picture { border-radius: clamp(50px, 10vw, 120px); }
  .peca figcaption { margin-top: 1rem; display: grid; gap: 0.25rem; }
  .peca figcaption b { font-family: 'Fraunces', Georgia, serif; font-size: 1.05rem; font-weight: 600; }
  .peca figcaption span { font-size: 0.85rem; color: var(--c60); }

  /* ---------- equipe ---------- */
  .equipe {
    display: grid; gap: clamp(1.4rem, 3vw, 2.2rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
  }
  .pessoa { text-align: center; }
  .pessoa-foto {
    width: min(100%, 15rem); margin: 0 auto 1.2rem; aspect-ratio: 1;
    overflow: hidden; background: var(--musgo);
    border-radius: 52% 48% 45% 55% / 48% 52% 48% 52%;
    box-shadow: var(--sombra);
    transition: border-radius 1.1s var(--e), translate var(--t) var(--e);
  }
  .pessoa:hover .pessoa-foto {
    border-radius: 44% 56% 58% 42% / 56% 44% 56% 44%;
    translate: 0 -4px;
  }
  .pessoa-foto img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pessoa h3 { margin-bottom: 0.25rem; }
  .pessoa-papel { font-size: 0.8rem; color: var(--verde); font-weight: 600; }
  .pessoa-form { margin-top: 0.7rem; font-size: 0.85rem; color: var(--c60); }
  .pessoa-tags {
    list-style: none; margin: 1rem 0 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 0.4rem; justify-content: center;
  }
  .pessoa-tags li {
    padding: 0.24rem 0.7rem; border-radius: 999px;
    background: var(--musgo); color: var(--verde-esc);
    font-size: 0.72rem; font-weight: 600;
  }

  /* ---------- planos ---------- */
  .planos {
    display: grid; gap: clamp(1.1rem, 2.2vw, 1.6rem); align-items: start;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }
  .plano {
    position: relative; display: flex; flex-direction: column;
    padding: clamp(1.6rem, 2.8vw, 2.2rem);
    border-radius: var(--raio-xg) var(--raio) var(--raio-xg) var(--raio);
    background: var(--branco); border: 1px solid var(--linha);
    transition: translate var(--t) var(--e), box-shadow var(--t) var(--e);
  }
  .plano:hover { translate: 0 -4px; box-shadow: var(--sombra-alta); }
  .plano-destaque {
    border-color: var(--verde);
    box-shadow: 0 24px 60px -34px rgba(31, 74, 55, 0.55);
  }
  .plano-fita {
    position: absolute; top: -0.85rem; left: 50%; translate: -50% 0;
    padding: 0.3rem 0.9rem; border-radius: 999px;
    background: var(--verde); color: #fff;
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    white-space: nowrap;
  }
  .plano h3 { font-size: 1.34rem; }
  .plano-sub { margin-top: 0.35rem; font-size: 0.84rem; color: var(--c60); min-height: 2.6em; }
  .plano-preco {
    display: flex; align-items: baseline; gap: 0.25rem;
    margin-top: 1.2rem; color: var(--verde-esc);
  }
  .plano-preco small { font-size: 0.95rem; font-weight: 600; }
  .plano-preco b {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(2.1rem, 3.4vw, 2.7rem); font-weight: 600;
    letter-spacing: -0.03em; line-height: 1;
  }
  .plano-unid { font-size: 0.82rem; color: var(--c60); margin-top: 0.3rem; }
  .plano-sessao {
    align-self: start; margin-top: 0.7rem;
    padding: 0.22rem 0.7rem; border-radius: 999px;
    background: var(--musgo); color: var(--verde-esc);
    font-size: 0.74rem; font-weight: 600;
  }
  .plano-itens {
    list-style: none; margin: 1.5rem 0; padding: 1.4rem 0 0;
    border-top: 1px solid var(--linha);
    display: grid; gap: 0.65rem; font-size: 0.86rem; color: var(--c60);
  }
  .plano-itens li { display: grid; grid-template-columns: 1.1rem 1fr; gap: 0.6rem; align-items: start; }
  .plano-itens i { color: var(--verde); font-size: 0.72rem; margin-top: 0.42rem; }
  .plano .btn { margin-top: auto; }
  .planos-nota {
    margin-top: clamp(1.6rem, 3vw, 2.4rem);
    padding: 1.1rem 1.4rem; border-radius: var(--raio-g);
    background: rgba(255, 255, 255, 0.7); border: 1px dashed var(--linha-forte);
    font-size: 0.86rem; color: var(--c60); text-align: center;
  }
  .planos-nota i { color: var(--verde); margin-right: 0.4rem; }
  .planos-nota b { color: var(--tinta); }

  /* ---------- dúvidas ---------- */
  .dupla-fq { display: grid; gap: clamp(2rem, 4vw, 3.4rem); align-items: start; }
  .dupla-fq .cab { margin-bottom: 0; }
  .dupla-fq .btn { margin-top: 1.6rem; }
  .fq { display: grid; gap: 0.6rem; }
  .fq details {
    border: 1px solid var(--linha); border-radius: var(--raio-g);
    background: var(--branco); overflow: hidden;
    transition: border-color var(--t) var(--e), background var(--t) var(--e);
  }
  .fq details[open] { border-color: var(--linha-forte); background: var(--nevoa); }
  .fq summary {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 1.05rem 1.35rem; cursor: pointer; list-style: none;
    font-weight: 600; font-size: 0.95rem;
    transition: color var(--t) var(--e);
  }
  .fq summary::-webkit-details-marker { display: none; }
  .fq summary:hover { color: var(--verde); }
  .fq summary i {
    flex: none; width: 1.7rem; height: 1.7rem; display: grid; place-items: center;
    border-radius: 50%; background: var(--musgo); color: var(--verde);
