  /* ─────────── entrada ─────────── */
  :global(.anda) [data-rev] {
    opacity: 0; translate: 0 22px;
    transition: opacity 0.7s var(--e), translate 0.7s var(--e);
    transition-delay: calc(var(--i, 0) * 0.08s);
  }
  :global(.anda) [data-rev].vista { opacity: 1; translate: 0 0; }

  /*
    A foto é descoberta por uma cortina que sobe, e a imagem assenta de uma
    escala maior. A cortina é um elemento por cima — e não clip-path no
    próprio bloco: clip-path zera a área de interseção e o observador nunca
    dispara, então a foto ficava invisível para sempre.
  */
  [data-foto] { position: relative; }
  :global(.anda) [data-foto]::before {
    content: ''; position: absolute; inset: 0; z-index: 3; pointer-events: none;
    background: var(--cortina, var(--creme));
    transform-origin: bottom; scale: 1 1;
    transition: scale 0.9s var(--e); transition-delay: calc(var(--i, 0) * 0.12s);
  }
  :global(.anda) [data-foto].vista::before { scale: 1 0; }
  :global(.anda) [data-foto] img { scale: 1.12; }
  :global(.anda) [data-foto].vista img {
    scale: 1; transition: scale 1.6s var(--e); transition-delay: calc(var(--i, 0) * 0.12s);
  }
  .secao-areia [data-foto] { --cortina: var(--areia); }

  @media (prefers-reduced-motion: reduce) {
    .vd *, .vd *::before, .vd *::after {
      animation: none !important; transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  const raiz = document.querySelector('.vd');
  if (raiz) {
    const anda = document.documentElement.classList.contains('anda');

    /* entrada dos blocos e das fotos */
    const olho = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('vista');
          olho.unobserve(e.target);
        }),
      { threshold: 0.05 },
    );
    raiz.querySelectorAll('[data-rev], [data-foto]').forEach((el) => olho.observe(el));

    /*
      Rede de segurança: passados três segundos, o que ainda não entrou entra
      de qualquer jeito. Nenhum conteúdo pode depender de um observador para
      existir — foi assim que a versão anterior deste site nasceu invisível.
    */
    setTimeout(() => {
      raiz.querySelectorAll('[data-rev]:not(.vista), [data-foto]:not(.vista)')
        .forEach((el) => el.classList.add('vista'));
    }, 3000);

    /* os números contam quando a faixa aparece */
    const contar = (el: HTMLElement) => {
      const alvo = Number(el.dataset.conta ?? 0);
      if (!anda) { el.textContent = String(alvo); return; }
      const dur = 1100;
      const t0 = performance.now();
      const passo = (t: number) => {
        const p = Math.min((t - t0) / dur, 1);
        el.textContent = String(Math.round(alvo * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(passo);
      };
      requestAnimationFrame(passo);
    };
    const olhoN = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (!e.isIntersecting) return;
          contar(e.target as HTMLElement);
          olhoN.unobserve(e.target);
        }),
      { threshold: 0.5 },
    );
    raiz.querySelectorAll<HTMLElement>('[data-conta]').forEach((el) => olhoN.observe(el));

    /* a linha do percurso cresce quando a lista entra */
    const passos = raiz.querySelector('[data-passos]');
    if (passos) {
      const olhoL = new IntersectionObserver(
        (es) =>
          es.forEach((e) => {
            if (!e.isIntersecting) return;
            passos.setAttribute('data-desenha', '');
            olhoL.disconnect();
          }),
        { threshold: 0.15 },
      );
      olhoL.observe(passos);
    }

    /* a barra ganha régua ao sair do topo */
    const topo = raiz.querySelector<HTMLElement>('[data-topo]');
    if (topo) {
      const marcar = () => topo.toggleAttribute('data-rolou', window.scrollY > 8);
      marcar();
      window.addEventListener('scroll', marcar, { passive: true });
    }
  }
</script>
