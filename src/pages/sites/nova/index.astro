    text-transform: uppercase; color: var(--salvia);
  }
  .form label small {
    font-size: 0.92em; font-weight: 500; letter-spacing: 0.06em;
    text-transform: none; color: var(--claro-40);
  }
  .form :is(input, select, textarea) {
    width: 100%; padding: 0.78rem 0.95rem;
    border-radius: 14px; border: 1px solid rgba(169, 196, 166, 0.26);
    background-color: rgba(11, 32, 25, 0.5); color: #f2f9f3;
    font-family: inherit; font-size: 0.92rem; font-weight: 400;
