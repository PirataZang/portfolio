  /* ─────────── contato ─────────── */
  .titulao-peq { font-size: clamp(2.1rem, 4.6vw, 3.4rem); }
  .cab-n-solo { padding-top: 0; margin-bottom: 1.1rem; }
  .contato-grade { display: grid; gap: 2.6rem; }
  @media (min-width: 1000px) { .contato-grade { grid-template-columns: 1.05fr 0.95fr; gap: 4rem; } }
  .contato-d { margin-top: 1.8rem; font-size: 1.05rem; line-height: 1.62; color: var(--salvia); max-width: 42ch; }
  .contato .acoes { margin-top: 2rem; }
