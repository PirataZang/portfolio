  /* ---------- do tablet para cima ---------- */
  @media (min-width: 700px) {
    .form-2 { grid-template-columns: 1fr 1fr; }
    .rodape-grade { grid-template-columns: 1.3fr 1fr 1fr; }
  }
  @media (min-width: 980px) {
    .vt { --topo-h: 4.4rem; }
    /*
      auto-fit resolve pela largura e não pela contagem: com 6 cards ele dava
      4+2 e com 5 dava 4+1, que deixa a última fileira órfã. Três colunas fixas
      fecham 3+3 e 3+2, que é o que o olho espera.
    */
    .grade-bordas, .grade-serv, .passos-n { grid-template-columns: repeat(3, 1fr); }
    .topo-nav { display: flex; }
    .hero-grade { grid-template-columns: 1.05fr 0.95fr; }
    .dupla { grid-template-columns: 1fr 1.05fr; }
  }

  /* ---------- movimento reduzido ---------- */
  @media (prefers-reduced-motion: reduce) {
    .vt * { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
    .cena { height: 120vh; }
    .pedra:hover .pedra-foto img { scale: 1; }
  }
</style>

<script>
  /*
    Movimento pelo Motion One. A cena 3D e o carrossel de acabamentos continuam
    com a mecânica original — só o entorno mudou.
  */
  const reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const SAIDA = [0.22, 0.61, 0.36, 1] as const;
  const raiz = document.documentElement;

  type Etapa = { t: string; d: string; det: string };
  const ilha = document.querySelector<HTMLElement>('[data-cenas]');
  const CENAS: Record<string, { tag: string; etapas: Etapa[] }> =
    ilha ? JSON.parse(ilha.textContent || '{}') : {};

  /* A animação termina antes do fim da seção; o resto segura o resultado. */
  const FIM = 0.72;

  async function ligarCenas() {
    const canvases = [...document.querySelectorAll<HTMLCanvasElement>('[data-cena]')];
    if (!canvases.length) return;

    const mod = await import('../../../scripts/marmoraria-3d');
    const { scroll } = await import('motion');

    const fabricas: Record<string, (c: HTMLCanvasElement) => any> = {
      bancada: mod.criarBancada,
    };

    for (const canvas of canvases) {
      const nome = canvas.dataset.cena!;
      const secao = canvas.closest<HTMLElement>('[data-cena-sec]');
      const fabrica = fabricas[nome];
      if (!secao || !fabrica) continue;

      const textos = CENAS[nome]?.etapas ?? [];
      const tEl = document.querySelector<HTMLElement>(`[data-etapa-t="${nome}"]`);
      const dEl = document.querySelector<HTMLElement>(`[data-etapa-d="${nome}"]`);
      const detEl = document.querySelector<HTMLElement>(`[data-etapa-det="${nome}"]`);
      const passos = [...document.querySelectorAll<HTMLElement>(`[data-passo="${nome}"]`)];

      let etapa = -1;
      const mostrar = (i: number) => {
        if (i === etapa || !tEl || !dEl || !textos[i]) return;
        etapa = i;
        tEl.textContent = textos[i].t;
        dEl.textContent = textos[i].d;
        if (detEl) detEl.textContent = textos[i].det;
        passos.forEach((p, n) => p.classList.toggle('ativo', n <= i));
      };

      let cena: any = null;
      let alvo = 0;
      let atual = 0;
      let visivel = false;
      let rodando = false;
      let montando = false;

      const laco = () => {
        if (!visivel) { rodando = false; return; }
        const d = alvo - atual;
        if (cena && Math.abs(d) > 0.0004) {
          atual += d * 0.075;
          const local = Math.min(1, atual / FIM);
          cena.atualizar(local);
          cena.render();
          mostrar(Math.min(textos.length - 1, Math.floor(local * textos.length * 0.999)));
        }
        requestAnimationFrame(laco);
      };

      const montar = () => {
        if (cena || montando) return;
        montando = true;
        const fazer = () => {
          cena = fabrica(canvas);
          montando = false;
          if (!cena) return;
          canvas.classList.add('pronto');
          addEventListener('resize', () => cena.redimensionar());
          if (reduz) {
            cena.atualizar(1);
            cena.render();
            mostrar(textos.length - 1);
          } else if (!rodando) {
            rodando = true;
            requestAnimationFrame(laco);
          }
        };
        // criar contexto WebGL trava o quadro: nunca no meio de uma rolagem
        if ('requestIdleCallback' in window) requestIdleCallback(fazer, { timeout: 600 });
        else setTimeout(fazer, 0);
      };

      new IntersectionObserver(
        ([e]) => {
          visivel = e.isIntersecting;
          if (!visivel) return;
          montar();
          if (cena && !reduz && !rodando) { rodando = true; requestAnimationFrame(laco); }
        },
        { rootMargin: '250px' },
      ).observe(secao);

      if (!reduz) scroll((p: number) => { alvo = p; }, { target: secao, offset: ['start start', 'end end'] });
    }
  }

  async function ligarCarrossel() {
    const sec = document.querySelector<HTMLElement>('[data-carrossel]');
    const itens = sec ? [...sec.querySelectorAll<HTMLElement>('.acab-item')] : [];
    if (!sec || itens.length < 2) return;

    // sem JS a seção continua sendo a grade estática; a classe é o upgrade
    sec.classList.add('carrossel');
    itens[0].classList.add('ativo');

    const { scroll } = await import('motion');
    let atual = 0;
    scroll(
      (p: number) => {
        const i = Math.min(itens.length - 1, Math.floor(p * itens.length * 0.999));
        if (i === atual) return;
        itens[atual].classList.remove('ativo');
        itens[i].classList.add('ativo');
        atual = i;
      },
      { target: sec, offset: ['start start', 'end end'] },
    );
  }

  ligarCarrossel();

  if ('requestIdleCallback' in window) requestIdleCallback(() => ligarCenas());
  else setTimeout(ligarCenas, 200);

  /* ---------------- formulário ---------------- */

  const form = document.querySelector<HTMLFormElement>('[data-form]');
  form?.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const d = new FormData(form);
    const v = (k: string) => String(d.get(k) ?? '').trim();
    const linhas = [
      `Olá! Sou ${v('nome')} e quero um orçamento.`,
      '',
      `Peça: ${v('peca')}`,
      `Material: ${v('material')}`,
      v('medidas') && `Medidas: ${v('medidas')}`,
      `Marcenaria: ${v('marcenaria')}`,
      v('msg') && `Detalhes: ${v('msg')}`,
      '',
      `Meu WhatsApp: ${v('fone')}`,
    ].filter(Boolean);
    window.open(
      `https://wa.me/${form.dataset.zap}?text=${encodeURIComponent(linhas.join('\n'))}`,
      '_blank',
      'noopener',
    );
  });

  /* ---------------- filtro do acervo ---------------- */

  const cards = [...document.querySelectorAll<HTMLElement>('.pedra')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.filtro .chip')];

  /* versão sem animação: vale até o Motion chegar, e para sempre em movimento reduzido */
  let filtrar = (fam: string) => {
    cards.forEach((c) => (c.hidden = fam !== 'tudo' && c.dataset.fam !== fam));
  };
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      filtrar(chip.dataset.fam!);
    });
  });

  /* ---------------- movimento ---------------- */

  async function ligarMovimento() {
    if (reduz) return;
    const { animate, inView, scroll, stagger } = await import('motion');

    const umaVez = (
      el: Element,
      efeito: () => void,
      opcoes?: Parameters<typeof inView>[2],
    ) => {
      let parar = () => {};
      parar = inView(el, () => { efeito(); parar(); }, opcoes);
    };

    /* 1. barra de progresso do topo */
    const barra = document.querySelector<HTMLElement>('[data-progresso]');
    if (barra) scroll(animate(barra, { scaleX: [0, 1] }, { ease: 'linear' }));

    /* 2. herói */
    animate(
      document.querySelectorAll('[data-linha]'),
      { opacity: [0, 1], y: [24, 0] },
      { duration: 0.8, delay: stagger(0.09), ease: SAIDA },
    );
    animate(
      document.querySelectorAll('.hero [data-anima]'),
      { opacity: [0, 1], y: [16, 0] },
      { duration: 0.7, delay: stagger(0.09, { startDelay: 0.28 }), ease: SAIDA },
    );

    /* 3. revelação em cascata, agrupada por pai */
    const grupos = new Map<Element, HTMLElement[]>();
    for (const el of document.querySelectorAll<HTMLElement>('[data-anima]')) {
      if (el.closest('.hero')) continue;
      const pai = el.parentElement!;
      grupos.set(pai, [...(grupos.get(pai) ?? []), el]);
    }
    for (const irmaos of grupos.values()) {
      umaVez(
        irmaos[0],
        () => animate(irmaos, { opacity: [0, 1], y: [20, 0] }, { duration: 0.65, delay: stagger(0.07), ease: SAIDA }),
        { amount: 0.1, margin: '0px 0px -8% 0px' },
      );
    }

    /* 4. contadores */
    document.querySelectorAll<HTMLElement>('[data-conta-ate]').forEach((el) => {
      const fim = Number(el.dataset.contaAte);
      umaVez(
        el,
        () =>
          animate(0, fim, {
            duration: 1.2,
            ease: SAIDA,
            onUpdate: (n) => (el.textContent = Math.round(n).toLocaleString('pt-BR')),
          }),
        { amount: 0.8 },
      );
    });

    /* 5. as seções escuras se abrem de cima para baixo */
    document.querySelectorAll<HTMLElement>('[data-escura]').forEach((s) => {
      umaVez(
        s,
        () => animate(s, { clipPath: ['inset(0 0 100% 0)', 'inset(0 0 0% 0)'] }, { duration: 0.8, ease: SAIDA }),
        { amount: 0.04, margin: '0px 0px -12% 0px' },
      );
    });

    /*
      6. Os perfis de borda se desenham — que é o único jeito de ler uma seção.

      O quadro inicial vai DENTRO do animate, como `[1, 0]`, e não num
      `style.strokeDashoffset = '1'` antes. Escondendo por fora, qualquer falha
      no meio do caminho deixava o desenho preso invisível — foi o que
      aconteceu. Assim o estado visível é o padrão e a animação é o enfeite.
    */
    const perfis = [...document.querySelectorAll<SVGGeometryElement>('[data-perfil]')];
    const bordas = document.querySelector('.grade-bordas');
    if (bordas && perfis.length) {
      umaVez(
        bordas,
        () => {
          animate(
            perfis,
            { strokeDashoffset: [1, 0], fillOpacity: [0, 1] },
            { duration: 0.9, delay: stagger(0.08), ease: SAIDA },
          );
        },
        { amount: 0.2 },
      );
    }

    /* 7. parallax discreto na foto do herói */
    const par = document.querySelector<HTMLElement>('[data-parallax]');
    if (par) {
      scroll(animate(par, { y: [0, -40] }, { ease: 'linear' }), {
        target: par.closest('.hero')!,
        offset: ['start start', 'end start'],
      });
    }

    /* 8. filtro: a grade sai junta e volta em cascata */
    filtrar = async (fam) => {
      const visiveis = cards.filter((c) => !c.hidden);
      if (visiveis.length) {
        await animate(visiveis, { opacity: 0, y: -8 }, { duration: 0.16, ease: 'easeIn' }).finished;
      }
      const ficam = cards.filter((c) => fam === 'tudo' || c.dataset.fam === fam);
      cards.forEach((c) => (c.hidden = !ficam.includes(c)));
      animate(ficam, { opacity: [0, 1], y: [14, 0] }, { duration: 0.45, delay: stagger(0.04), ease: SAIDA });
    };
  }

  const revelarTudo = () => raiz.classList.remove('anima-on');
  const socorro = setTimeout(revelarTudo, 3000);
  ligarMovimento()
    .catch(revelarTudo)
    .finally(() => clearTimeout(socorro));
  if (reduz) revelarTudo();
</script>
