      { t: 'Recorte da cuba', d: 'O furo sai no centro CNC com o raio de canto exato que a cuba pede. A fresa entra pelo avesso para não lascar a face vista, e a borda já sai boleada no mesmo ciclo.', det: 'Tolerância de 1 mm · sem retrabalho na obra' },
      { t: 'Encaixe da cuba', d: 'Cuba de embutir fixada por baixo do tampo, com massa epóxi tingida na cor da pedra. Nada de silicone aparente: a junta some ao toque e não acumula sujeira na quina.', det: 'Fixação por baixo · epóxi na cor da pedra' },
      { t: 'Rodabanca', d: 'Cortada da mesma chapa e na mesma altura de veio, para o desenho continuar da bancada para a parede sem quebra.', det: 'Altura padrão 10 cm · veio contínuo' },
    ],
  },
};

/*
  Os três acabamentos, em foto da mesma chapa de Marquina preto. Não é a
  mesma imagem tratada: são três fotos do mesmo material, porque a diferença
  entre polido e escovado está no relevo real da superfície, e isso filtro
  de CSS não inventa.
*/
const ACABAMENTOS = [
  {
    img: 'polido', t: 'Polido',
    alt: 'Marquina preto com acabamento polido: superfície espelhada, refletindo o ambiente, com o veio branco em alto contraste.',
    d: 'Lixado em granas crescentes até virar espelho. Fecha o poro, escurece o fundo e faz o veio branco saltar. Reflete o ambiente inteiro — e é o que mais mostra poeira, digital e risco.',
    det: 'Brilho 85–95 GU · cozinha, banheiro e área interna coberta',
  },
  {
    img: 'semi-polido', t: 'Semi-polido',
    alt: 'Marquina preto com acabamento semi-polido: brilho difuso, sem reflexo nítido, o preto um tom mais aberto.',
    d: 'Também chamado de levigado. O polimento para antes do espelho: o brilho vira difuso, o preto abre um tom e marca de água, digital e risco fino somem no dia a dia.',
    det: 'Brilho 30–45 GU · piso interno, hall e uso pesado',
  },
  {
    img: 'escovado', t: 'Escovado',
    alt: 'Marquina preto com acabamento escovado: sem reflexo, poro aberto e relevo visível, o preto puxando para grafite.',
    d: 'Escovas de aço abrem o poro em vez de fechá-lo. O reflexo acaba e entra relevo: a mão sente o veio, o pé não escorrega molhado e o preto puxa para grafite.',
    det: 'Brilho abaixo de 10 GU · piscina, escada externa e churrasqueira',
  },
];

const titulo = 'Marmoraria em São Paulo | Bancada de Mármore, Granito e Quartzito — VETTA';
const descricao =
  'Marmoraria na Vila Leopoldina, São Paulo. Bancada de mármore, granito e quartzito com medição a laser, corte CNC de 1 mm e instalação própria. Acervo, perfis de borda e guia de cuidados. Orçamento em 24 h.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LocalBusiness', 'HomeAndConstructionBusiness'],
      '@id': `${NEGOCIO.site}/#negocio`,
      name: `${NEGOCIO.nome} ${NEGOCIO.sub}`,
      description: descricao,
      url: NEGOCIO.site,
      telephone: NEGOCIO.fone,
      email: NEGOCIO.email,
      priceRange: 'R$$',
      foundingDate: String(NEGOCIO.desde),
      address: {
        '@type': 'PostalAddress',
        streetAddress: NEGOCIO.rua,
        addressLocality: NEGOCIO.cidade,
        addressRegion: NEGOCIO.uf,
        postalCode: NEGOCIO.cep,
        addressCountry: 'BR',
      },
      geo: { '@type': 'GeoCoordinates', latitude: NEGOCIO.lat, longitude: NEGOCIO.lon },
      areaServed: regioes.map((r) => ({ '@type': 'Place', name: r })),
      openingHoursSpecification: [
        { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:00', closes: '18:00' },
        { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '09:00', closes: '13:00' },
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Serviços',
        itemListElement: servicos.map((s) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: s.t, description: s.d },
        })),
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${NEGOCIO.site}/#faq`,
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.p,
        acceptedAnswer: { '@type': 'Answer', text: f.r },
      })),
    },
  ],
};
---

<Base title={titulo} description={descricao}>
  <Fragment slot="head">
    <link rel="canonical" href={NEGOCIO.site} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="geo.region" content="BR-SP" />
    <meta name="geo.placename" content="São Paulo" />
    <meta name="geo.position" content={`${NEGOCIO.lat};${NEGOCIO.lon}`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={NEGOCIO.nome} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={NEGOCIO.site} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0f1113" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link rel="preload" as="image" href={`${import.meta.env.BASE_URL}img/chapas/estoque.webp`} type="image/webp" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.documentElement.classList.add('anima-on');
    </script>
  </Fragment>

  <div class="vt">
    <script type="application/json" data-cenas set:html={JSON.stringify(CENAS)}></script>

    <a class="pular" href="#conteudo">Pular para o conteúdo</a>

    <header class="topo">
      <div class="topo-barra" data-progresso aria-hidden="true"></div>
      <a class="marca" href={import.meta.env.BASE_URL}>{NEGOCIO.nome}<span>{NEGOCIO.sub}</span></a>
      <nav class="topo-nav" aria-label="Seções">
        <a href="#acervo">Acervo</a>
        <a href="#bancada">A bancada</a>
        <a href="#bordas">Bordas</a>
        <a href="#cuidados">Cuidados</a>
        <a href="#duvidas">Dúvidas</a>
      </nav>
      <a class="btn btn-primario btn-min" href="#orcamento">Pedir orçamento</a>
    </header>

    <main id="conteudo">
      {/* ═════════ HERÓI ═════════ */}
      <section class="hero">
        <div class="hero-grade">
          <div class="hero-txt">
            <h1>
              <span class="linha" data-linha>A pedra certa</span>
              <span class="linha" data-linha>começa por <em>entender</em></span>
              <span class="linha" data-linha>a pedra.</span>
            </h1>
            <p class="lead" data-anima>
              Mármore risca, granito não tem veio e quartzito custa o dobro por um
              motivo. Antes de te vender metro quadrado, a gente mostra por que.
              Medição a laser, corte CNC de 1 mm e instalação por equipe própria.
            </p>
            <div class="hero-acoes" data-anima>
              <a class="btn btn-primario btn-g" href="#orcamento">Orçamento em 24 h</a>
              <a class="btn btn-vazado btn-g" href="#acervo">Ver o acervo</a>
            </div>
            <ul class="hero-fatos" data-anima>
              <li><b>{PEDRAS.length}</b> materiais no acervo</li>
              <li><b>{BORDAS.length}</b> perfis de borda</li>
              <li><b>3</b> acabamentos de superfície</li>
            </ul>
          </div>

          {/*
            Painel de materiais, e não uma foto de depósito. A frase do título é
            "entender a pedra": o herói tem que mostrar pedra, de perto, não um
            galpão. São três dos macros de acervo, os que estão limpos de
            enquadramento, montados como amostra de showroom.
          */}
          <figure class="hero-foto" data-anima>
            <div class="painel" data-parallax>
              {[
                { arq: 'verde-guatemala', nome: 'Verde Guatemala', fam: 'Mármore' },
                { arq: 'delicatus', nome: 'Delicatus', fam: 'Quartzito' },
                { arq: 'midnight-sun', nome: 'Midnight Sun', fam: 'Quartzito' },
              ].map((c, i) => (
                <div class="lasca" style={`--i:${i}`}>
                  <picture>
                    <source srcset={`${import.meta.env.BASE_URL}img/chapas/${c.arq}.webp`} type="image/webp" />
                    <img
                      src={`${import.meta.env.BASE_URL}img/chapas/${c.arq}.jpg`}
                      alt={`Superfície de ${c.nome} vista de perto: ${c.fam.toLowerCase()}.`}
                      width="900" height="600"
                      fetchpriority={i === 0 ? 'high' : undefined}
                      decoding="async"
                    />
                  </picture>
                  <span class="lasca-nome"><b>{c.nome}</b>{c.fam}</span>
                </div>
              ))}
            </div>
            <figcaption>Três dos {PEDRAS.length} materiais do acervo, fotografados de perto</figcaption>
          </figure>
        </div>
      </section>

      {/* ═════════ NÚMEROS ═════════ */}
      <section class="faixa" aria-label="Números da empresa">
        <dl class="nums">
          {numeros.map((n) => (
            <div class="num" data-anima>
              <dt><span data-conta-ate={n.v}>{n.v.toLocaleString('pt-BR')}</span><i>{n.u}</i></dt>
              <dd>{n.l}</dd>
            </div>
          ))}
        </dl>
      </section>

      {/* ═════════ ACERVO ═════════ */}
      <section class="secao" id="acervo">
        <div class="caixa">
          <header class="cab cab-larga" data-anima>
            <div>
              <h2>Doze rochas fotografadas de perto, e o que cada uma aguenta</h2>
              <p class="lead">
                Cada material com dureza, porosidade e o que ele aguenta de verdade.
                É essa diferença que decide se a peça vai para a cozinha ou para o lavabo.
              </p>
            </div>
            <div class="filtro" role="group" aria-label="Filtrar por família">
              <button class="chip" type="button" data-fam="tudo" aria-pressed="true">Tudo</button>
              {FAMILIAS.map((f) => (
                <button class="chip" type="button" data-fam={f} aria-pressed="false">{f}</button>
              ))}
            </div>
          </header>

          {/*
            Descritivo do que a foto é. Fica aqui, à vista, e não só no crédito
            do rodapé: quem olha uma marmoraria espera chapa de showroom, e
            estas são amostras de rocha em macro. Dizer isso na cara evita que
            o visitante ache que a chapa dele vai ser deste tamanho.
          */}
          <p class="nota-foto" data-anima>
            <b>Sobre estas fotos</b>
            São chapas e bancadas instaladas de verdade, de fotógrafos que
            publicaram sob licença Creative Commons — crédito e link em cada
            card. Servem para você reconhecer o material pelo nome. A chapa que
            vai na sua casa é marcada por você no showroom, e a gente fotografa
            a peça inteira antes de cortar: bloco nenhum repete desenho.
          </p>

          <ul class="grade-pedras" data-grade>
            {PEDRAS.map((p) => (
              <li class="pedra" data-fam={p.familia}>
                <div class="pedra-foto">
                  <picture>
                    <source srcset={`${import.meta.env.BASE_URL}img/chapas/${p.arq}.webp`} type="image/webp" />
                    <img src={`${import.meta.env.BASE_URL}img/chapas/${p.arq}.jpg`} alt={p.alt}
                         width="900" height="600" loading="lazy" decoding="async" />
                  </picture>
                  <span class="pedra-fam">{p.familia}</span>
                </div>
                <h3>{p.nome}</h3>
                <p class="pedra-cor">{p.cor}</p>
                <p class="pedra-obs">{p.obs}</p>
                <dl class="pedra-dados">
                  <div><dt>Dureza</dt><dd>{p.mohs}</dd></div>
                  <div><dt>Porosidade</dt><dd>{p.poro}</dd></div>
                </dl>
                <p class="pedra-uso"><b>Indicado para</b> {p.uso}</p>
                <p class="pedra-ficha">
                  Foto: <a href={p.pag} rel="noopener">{p.autor}</a> · {p.lic}
                </p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      {/* ═════════ A BANCADA — cena 3D preservada, agora no escuro ═════════ */}
      <section class="cena cena-escura" id="bancada" data-cena-sec data-escura>
        <div class="cena-fixa">
          <canvas class="cena-canvas" data-cena="bancada"></canvas>
          <div class="cena-card">
            <p class="cena-tag">{CENAS.bancada.tag}</p>
            <h2 data-etapa-t="bancada">{CENAS.bancada.etapas[0].t}</h2>
            <p class="cena-d" data-etapa-d="bancada">{CENAS.bancada.etapas[0].d}</p>
            <p class="cena-det" data-etapa-det="bancada">{CENAS.bancada.etapas[0].det}</p>
            <div class="passos">{CENAS.bancada.etapas.map(() => <span data-passo="bancada"></span>)}</div>
          </div>
        </div>
      </section>

      {/* ═════════ ACABAMENTOS — carrossel preservado ═════════ */}
      <section class="acab" id="acabamentos" data-carrossel>
        <div class="acab-palco">
          <header class="cab acab-cab">
            <h2>A mesma pedra, três acabamentos</h2>
            <p class="lead">
              Marquina preto, a mesma chapa nas três fotos. Muda só quanto
              de luz a superfície devolve — e é isso que decide onde ela pode ir.
            </p>
          </header>

          <div class="acab-pilha">
            {ACABAMENTOS.map((a, i) => (
              <article class="acab-item">
                <figure class="acab-pedra">
                  <picture>
                    <source srcset={`${import.meta.env.BASE_URL}img/acabamentos/${a.img}.webp`} type="image/webp" />
                    <img src={`${import.meta.env.BASE_URL}img/acabamentos/${a.img}.jpg`} alt={a.alt} width="1536" height="1024" loading="lazy" decoding="async" />
                  </picture>
                </figure>
                <div class="cena-card cena-card-escuro">
                  <h3>{a.t}</h3>
                  <p class="cena-d">{a.d}</p>
                  <p class="cena-det">{a.det}</p>
                  <div class="passos">
                    {ACABAMENTOS.map((_, n) => <span class={n <= i ? 'ativo' : ''}></span>)}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      {/* ═════════ COMPARATIVO ═════════ */}
      <section class="secao" id="materiais">
        <div class="caixa">
          <header class="cab" data-anima>
            <h2>Três famílias, e a escolha quase sempre é de uso, não de gosto</h2>
            <p class="lead">
              A pergunta certa não é qual é a mais bonita. É quanto ácido, quanto
              peso e quanto sol aquela superfície vai receber por dia.
            </p>
          </header>
          <div class="trio">
            {comparativo.map((m) => (
              <article class="mat" data-anima>
                <h3>{m.t}</h3>
                <p class="mat-sub">{m.sub}</p>
                <dl class="mat-dados">
                  <div><dt>Dureza</dt><dd>{m.dureza}</dd></div>
                  <div><dt>Porosidade</dt><dd>{m.poro}</dd></div>
                  <div><dt>Faixa de preço</dt><dd>{m.preco}</dd></div>
                </dl>
                <p class="mat-l"><b>Use em</b> {m.uso}</p>
                <p class="mat-l mat-evitar"><b>Evite</b> {m.evitar}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      {/* ═════════ BORDAS E ESPESSURA — seção escura ═════════ */}
      <section class="secao secao-escura" id="bordas" data-escura>
        <div class="caixa">
          <header class="cab" data-anima>
            <h2>Seis cortes de borda, em seção transversal</h2>
            <p class="lead-claro">
              Cada desenho é a chapa de 3 cm vista de lado, com a borda trabalhada à
              direita. “Meia-cana” não diz nada sem a curva — por isso está desenhada.
            </p>
          </header>

          <ul class="grade-bordas">
            {BORDAS.map((b) => (
              <li class="borda" data-anima>
                <svg class="borda-svg" viewBox="-14 -6 92 46" aria-hidden="true">
                  <path class="borda-p" d={b.d} data-perfil pathLength="1" />
                  <line class="borda-cota" x1="-2" y1="0" x2="-2" y2="34" />
                  <text class="borda-t" x="-6" y="20" transform="rotate(-90 -6 20)">3 cm</text>
                </svg>
                <h3>{b.t}</h3>
                <p>{b.q}</p>
              </li>
            ))}
          </ul>

          <div class="espessuras">
            {ESPESSURAS.map((e) => (
              <article class="esp" data-anima>
                <p class="esp-n">{e.e}</p>
                <p class="esp-l"><b>Use em</b> {e.uso}</p>
                <p class="esp-l esp-nao"><b>Não use em</b> {e.naoUse}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      {/* ═════════ CUIDADOS ═════════ */}
      <section class="secao" id="cuidados">
        <div class="caixa">
          <header class="cab" data-anima>
            <h2>Como cuidar de cada família, sem achismo de internet</h2>
            <p class="lead">
              A maior parte do estrago em pedra natural vem de produto errado, não de
              uso pesado. Esta tabela é o que entregamos impresso junto com a nota.
            </p>
          </header>

          <div class="tabela-rolo no-bar">
            <table class="tabela" data-anima>
              <caption class="sr">Cuidados por família de pedra</caption>
              <thead>
                <tr>
                  <th scope="col">Material</th>
                  <th scope="col">No dia a dia</th>
                  <th scope="col">Nunca</th>
                  <th scope="col">Selante</th>
                  <th scope="col">Sobre mancha</th>
                </tr>
              </thead>
              <tbody>
                {CUIDADOS.map((c) => (
                  <tr>
                    <th scope="row">{c.m}</th>
                    <td>{c.dia}</td>
                    <td class="td-nao">{c.nunca}</td>
                    <td class="mono">{c.selante}</td>
                    <td>{c.mancha}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      {/* ═════════ SERVIÇOS ═════════ */}
      <section class="secao secao-osso" id="servicos">
        <div class="caixa">
          <header class="cab" data-anima>
            <h2>O que sai da fábrica</h2>
          </header>
          <ul class="grade-serv">
            {servicos.map((s) => (
              <li class="serv" data-anima>
                <h3>{s.t}</h3>
                <p>{s.d}</p>
                <p class="serv-n">{s.n}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      {/* ═════════ PROCESSO ═════════ */}
      <section class="secao" id="processo">
        <div class="caixa">
          <header class="cab" data-anima>
            <h2>Do WhatsApp à bancada instalada, em cinco passos</h2>
          </header>
          <ol class="passos-n">
            {processo.map((p) => (
              <li data-anima>
                <span class="passo-n">{p.n}</span>
                <h3>{p.t}</h3>
                <p>{p.d}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      {/* ═════════ GLOSSÁRIO ═════════ */}
      <section class="secao secao-osso" id="glossario">
        <div class="caixa">
          <header class="cab" data-anima>
            <h2>As oito palavras que você vai ouvir no balcão</h2>
            <p class="lead">
              Ninguém deveria assinar um orçamento com um termo que não entendeu.
            </p>
          </header>
          <dl class="glossario">
            {GLOSSARIO.map((g) => (
              <div data-anima><dt>{g.t}</dt><dd>{g.d}</dd></div>
            ))}
          </dl>
        </div>
      </section>

      {/* ═════════ REGIÕES ═════════ */}
      <section class="secao" id="regioes">
        <div class="caixa">
          <header class="cab" data-anima>
            <h2>São Paulo capital e Grande São Paulo</h2>
            <p class="lead">Medição sem custo em toda a área abaixo, depois da aprovação do orçamento.</p>
          </header>
          <ul class="regioes" data-anima>
            {regioes.map((r) => <li>{r}</li>)}
          </ul>
        </div>
      </section>

      {/* ═════════ DÚVIDAS ═════════ */}
      <section class="secao secao-osso" id="duvidas">
        <div class="caixa">
          <header class="cab" data-anima>
            <h2>As dez perguntas que chegam toda semana</h2>
          </header>
          <div class="faq">
            {faq.map((f) => (
              <details data-anima>
                <summary>{f.p}</summary>
                <p>{f.r}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      {/* ═════════ ORÇAMENTO — seção escura ═════════ */}
      <section class="secao secao-escura secao-cta" id="orcamento" data-escura>
        <div class="caixa">
          <div class="dupla">
            <div data-anima>
              <h2>Manda a medida que a gente devolve o preço em 24 h</h2>
              <p class="lead-claro">
                Planta, croqui no guardanapo ou só as medidas no WhatsApp: qualquer
                um dos três serve para o primeiro número. A medição a laser vem
                depois, e é ela que fecha o valor.
              </p>
              <dl class="contato-dados">
                <div><dt>WhatsApp</dt><dd><a href={`https://wa.me/${NEGOCIO.zap}`} rel="noopener">{NEGOCIO.zapFmt}</a></dd></div>
                <div><dt>Telefone</dt><dd><a href={`tel:${NEGOCIO.foneLink}`}>{NEGOCIO.fone}</a></dd></div>
                <div><dt>E-mail</dt><dd><a href={`mailto:${NEGOCIO.email}`}>{NEGOCIO.email}</a></dd></div>
                <div><dt>Showroom</dt><dd>{NEGOCIO.rua}<br />{NEGOCIO.bairro} · {NEGOCIO.cidade}/{NEGOCIO.uf}</dd></div>
                <div><dt>Horário</dt><dd>Seg a sex, 8h às 18h · Sáb, 9h às 13h</dd></div>
              </dl>
            </div>

            <form class="form" data-form data-zap={NEGOCIO.zap} data-anima>
              <div class="form-2">
                <label>
                  Nome
                  <input name="nome" type="text" required autocomplete="name" placeholder="Como te chamamos" />
                </label>
                <label>
                  WhatsApp
                  <input name="fone" type="tel" required autocomplete="tel" placeholder="(11) 90000-0000" />
                </label>
              </div>
              <div class="form-2">
                <label>
                  Peça
                  <select name="peca">
                    {servicos.map((s) => <option>{s.t}</option>)}
                    <option>Outra coisa</option>
                  </select>
                </label>
                <label>
                  Material pretendido
                  <select name="material">
                    <option>Ainda não sei</option>
                    {FAMILIAS.map((f) => <option>{f}</option>)}
                  </select>
                </label>
              </div>
              <div class="form-2">
                <label>
                  Medidas aproximadas
                  <input name="medidas" type="text" placeholder="2,40 × 0,60 m, por exemplo" />
                </label>
                <label>
                  Marcenaria instalada?
                  <select name="marcenaria">
                    <option>Ainda não</option>
                    <option>Sim, pronta para medir</option>
                    <option>É reforma, já tem bancada</option>
                  </select>
                </label>
              </div>
              <label>
                Detalhes
                <textarea name="msg" rows="3" placeholder="Cuba de embutir, cooktop, rodabanca de 10 cm…"></textarea>
              </label>
              <button class="btn btn-primario btn-cheio btn-g" type="submit">Enviar pelo WhatsApp</button>
              <p class="form-nota">Abre a conversa com tudo preenchido. Nada fica gravado neste site.</p>
            </form>
          </div>
        </div>
      </section>
    </main>

    <footer class="rodape">
      <div class="caixa rodape-grade">
        <div>
          <p class="rodape-marca">{NEGOCIO.nome}<small>{NEGOCIO.sub} · {NEGOCIO.bairro}</small></p>
          <p class="rodape-d">
            Marmoraria em {NEGOCIO.cidade} desde {NEGOCIO.desde}. Mármore, granito e
            quartzito com medição a laser, corte CNC e instalação por equipe própria.
          </p>
        </div>
        <nav aria-label="Rodapé">
          <p class="rodape-t">Navegar</p>
          <ul>
            <li><a href="#acervo">O acervo</a></li>
            <li><a href="#bancada">Como a bancada é feita</a></li>
            <li><a href="#bordas">Perfis de borda</a></li>
            <li><a href="#cuidados">Cuidados</a></li>
            <li><a href="#glossario">Vocabulário</a></li>
          </ul>
        </nav>
        <div class="rodape-mapa">
          <p class="rodape-t">Showroom</p>
          <iframe
            title={`Mapa — ${NEGOCIO.rua}`}
            src={`https://www.google.com/maps?q=${mapaQuery}&z=16&output=embed`}
            loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
          <a class="rodape-link" href={`https://www.google.com/maps/search/?api=1&query=${mapaQuery}`} rel="noopener">
            Abrir no Google Maps →
          </a>
        </div>
      </div>

      <p class="caixa rodape-fim">
        <span>© 2026 {NEGOCIO.nome} {NEGOCIO.sub} · {NEGOCIO.cidade}/{NEGOCIO.uf}</span>
        <a href={import.meta.env.BASE_URL}>← Voltar ao portfolio</a>
      </p>
    </footer>
  </div>
</Base>

<style>
  .vt {
    --branco: #fff;
    --osso: #f5f4f1;
    --linha: #e3e1dc;
    --tinta: #16181a;
    --c60: #5b5f66;
    --c40: #94989f;

    --escuro: #0f1113;
    --escuro-2: #17191c;
    --borda-esc: #2a2d31;
    --claro: #f2f1ee;
    --claro-60: #a8aab0;
    --claro-40: #74777d;

    --acento: #b4823c;
    --acento-2: #d3a45c;
    --acento-esc: #8d6329;

    --raio: 12px;
    --raio-g: 20px;
    --t: 0.4s;
    --e: cubic-bezier(0.22, 0.61, 0.36, 1);
    --topo-h: 4rem;
    --sombra: 0 1px 2px rgba(22, 24, 26, 0.04), 0 10px 26px -14px rgba(22, 24, 26, 0.16);
    --sombra-alta: 0 2px 6px rgba(22, 24, 26, 0.06), 0 24px 50px -22px rgba(22, 24, 26, 0.26);

    position: relative;
    background: var(--branco);
    color: var(--tinta);
    font-family: 'Plus Jakarta Sans', ui-sans-serif, system-ui, sans-serif;
    line-height: 1.62;
  }
  :global(body) { background: #fff; color: #16181a; }
  :global(::selection) { background: #b4823c; color: #fff; }
  /*
    O que o navegador desenha por conta também é parte do design: a barra de
    rolagem acompanha a página inteira, o cursor de texto pisca dentro de todo
    campo do formulário e o sublinhado padrão corta a perna das letras.
    Numeral tabular onde há medida, preço ou cota — sem ele o 1 é mais estreito
    que o 8 e a coluna de números dança de linha em linha.
  */
  :global(html) { scrollbar-color: #c8c5be #f5f4f1; }
  .vt :is(input, textarea, select) { caret-color: var(--acento); }
  .vt a { text-underline-offset: 0.18em; text-decoration-thickness: 1px; }
  .vt :is(input, textarea)::placeholder { color: var(--c40); }
  .vt :is(.faixa dt, .faixa dd, table, .cota, [class*='preco'], [class*='num'], [class*='medida'], time) {
    font-variant-numeric: tabular-nums;
  }


  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .pular {
    position: absolute; left: -9999px; top: 0; z-index: 100;
    background: var(--tinta); color: #fff; padding: 0.7rem 1.1rem;
    text-decoration: none; border-radius: 0 0 var(--raio) 0;
  }
  .pular:focus { left: 0; }
  .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }

  /* ---------- tipografia ---------- */
  h1, h2, h3 { font-weight: 700; letter-spacing: -0.03em; line-height: 1.14; margin: 0; text-wrap: balance; }
  h1 { font-size: clamp(2.4rem, 5.6vw, 4.4rem); font-weight: 800; line-height: 1.03; letter-spacing: -0.04em; }
  h2 { font-size: clamp(1.65rem, 3.2vw, 2.6rem); }
  h3 { font-size: 1.14rem; }
  p { margin: 0; text-wrap: pretty; }
  .lead { font-size: 1.02rem; color: var(--c60); max-width: 58ch; }
  .lead-claro { font-size: 1.02rem; color: var(--claro-60); max-width: 60ch; }

  /*
    Anotação da cena 3D. Não é rótulo de seção: nomeia o estado em que a peça
    está na cena, e muda conforme o scroll avança pelas etapas.
  */
  .cena-tag {
    margin: 0 0 0.7rem;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--acento);
  }

  .caixa { max-width: 1240px; margin: 0 auto; padding-inline: clamp(1rem, 4vw, 2.6rem); }
  .secao { position: relative; padding-block: clamp(3.6rem, 7.5vw, 6.5rem); }
  .secao-osso { background: var(--osso); border-block: 1px solid var(--linha); }
  .secao-escura { background: var(--escuro); color: var(--claro); }
  .secao-escura h2, .secao-escura h3 { color: var(--claro); }
  .cab { margin-bottom: clamp(2.2rem, 4vw, 3.2rem); max-width: 62ch; }
  .cab .lead, .cab .lead-claro { margin-top: 0.9rem; }
  .cab-larga { max-width: none; display: flex; flex-wrap: wrap; gap: 1.6rem 2.5rem; align-items: flex-end; justify-content: space-between; }
  .cab-larga > div { max-width: 60ch; }
  .dupla { display: grid; gap: clamp(2rem, 4vw, 3.4rem); align-items: start; }
  .vt section[id] { scroll-margin-top: calc(var(--topo-h) + 0.6rem); }

  /* ---------- botões ---------- */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    padding: 0.76rem 1.4rem; border-radius: 999px;
    font-family: inherit; font-size: 0.92rem; font-weight: 600; text-decoration: none;
    border: 1px solid transparent; white-space: nowrap; cursor: pointer;
    transition: background var(--t) var(--e), color var(--t) var(--e),
      border-color var(--t) var(--e), box-shadow var(--t) var(--e);
  }
  .btn-g { padding: 0.94rem 1.7rem; font-size: 0.98rem; }
  .btn-min { padding: 0.52rem 1.05rem; font-size: 0.84rem; }
  .btn-cheio { width: 100%; }
  .btn-primario { background: var(--tinta); color: #fff; }
  .btn-primario:hover { background: var(--acento-esc); box-shadow: 0 10px 26px -14px rgba(141, 99, 41, 0.9); }
  .secao-escura .btn-primario { background: var(--acento); }
  .secao-escura .btn-primario:hover { background: var(--acento-2); color: var(--escuro); }
  .btn-vazado { background: transparent; color: var(--tinta); border-color: var(--linha); }
  .btn-vazado:hover { border-color: var(--acento); color: var(--acento); }

  /* ---------- topo ---------- */
  .topo {
    position: fixed; inset: 0 0 auto; z-index: 60;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 0.7rem clamp(1rem, 4vw, 2.6rem);
    background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--linha);
  }
  .topo-barra {
    position: absolute; inset: auto 0 -1px; height: 2px;
    background: linear-gradient(90deg, var(--acento), var(--acento-2));
    transform: scaleX(0); transform-origin: 0 50%;
  }
  .marca { font-size: 1.15rem; font-weight: 800; letter-spacing: 0.06em; color: var(--tinta); text-decoration: none; line-height: 1.1; }
  .marca span {
    display: block; font-family: 'JetBrains Mono', monospace; font-weight: 400;
    font-size: 0.55rem; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--c40); margin-top: 0.3rem;
  }
  .topo-nav { display: none; gap: 1.5rem; }
  .topo-nav a { position: relative; font-size: 0.88rem; font-weight: 500; color: var(--c60); text-decoration: none; transition: color var(--t) var(--e); }
  .topo-nav a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -5px; height: 1px;
    background: var(--acento); transform: scaleX(0); transform-origin: 0 50%;
    transition: transform var(--t) var(--e);
  }
  .topo-nav a:hover { color: var(--tinta); }
  .topo-nav a:hover::after { transform: scaleX(1); }

  /* ---------- herói ---------- */
  .hero {
    max-width: 1240px; margin: 0 auto;
    padding: calc(var(--topo-h) + clamp(2.5rem, 6vh, 4.5rem)) clamp(1rem, 4vw, 2.6rem) clamp(3.5rem, 8vh, 5.5rem);
  }
  .hero-grade { display: grid; gap: clamp(2.5rem, 5vw, 4rem); align-items: center; }
  h1 em { font-style: normal; color: var(--acento); }
  h1 .linha { display: block; }
  .hero .lead { margin-top: 1.5rem; font-size: 1.06rem; max-width: 48ch; }
  .hero-acoes { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 2.1rem; }
  .hero-fatos {
    list-style: none; margin: 2.4rem 0 0; padding: 1.4rem 0 0;
    border-top: 1px solid var(--linha);
    display: flex; flex-wrap: wrap; gap: 0.7rem 2.2rem;
    font-size: 0.86rem; color: var(--c60);
  }
  .hero-fatos b { font-size: 1.15rem; font-weight: 800; color: var(--tinta); margin-right: 0.3rem; }

  .hero-foto { margin: 0; }
  .moldura {
    overflow: hidden; border-radius: var(--raio-g);
    box-shadow: var(--sombra-alta); aspect-ratio: 3 / 2;
  }
  .moldura img { display: block; width: 100%; height: 100%; object-fit: cover; }

  /*
    O painel de materiais do herói. Três lascas altas, cada uma escalonada um
    degrau abaixo da anterior — é como chapa fica apoiada em rack, e dá uma
    diagonal que uma fileira reta não daria. O nome mora no pé de cada lasca,
    sobre um véu escuro, porque nome de pedra é informação de compra.
  */
  .painel {
    --degrau: clamp(0.9rem, 1.6vw, 1.5rem);
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.4rem, 0.9vw, 0.7rem);
    aspect-ratio: 3 / 2.35;
    /* a última lasca desce dois degraus e sairia da caixa; o vão devolve o
       espaço para a legenda não passar por baixo dela */
    margin-bottom: calc(var(--degrau) * 2);
  }
  .lasca {
    position: relative; overflow: hidden;
    border-radius: calc(var(--raio-g) * 0.7);
    box-shadow: var(--sombra-alta);
    translate: 0 calc(var(--i) * var(--degrau));
  }
  .lasca img {
    display: block; width: 100%; height: 100%; object-fit: cover;
    /* o macro de pedra é plano por natureza; um fio de contraste devolve o grão */
    filter: contrast(1.06) saturate(0.96);
  }
  .lasca-nome {
    position: absolute; inset: auto 0 0; display: grid; gap: 0.1rem;
    padding: 1.6rem 0.7rem 0.6rem;
    background: linear-gradient(transparent, rgba(15, 17, 19, 0.82));
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.58rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--claro-60);
  }
  .lasca-nome b {
    font-family: inherit; font-size: 0.66rem; letter-spacing: 0.06em; color: #fff;
  }
  @media (max-width: 560px) {
    .painel { aspect-ratio: 3 / 2.6; }
    .lasca-nome { font-size: 0.52rem; padding-inline: 0.45rem; }
    .lasca-nome b { font-size: 0.58rem; }
  }
  .hero-foto figcaption {
    margin-top: 0.9rem; font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem; color: var(--c40); letter-spacing: 0.06em; text-align: center;
  }

  /* ---------- números ---------- */
  .faixa { background: var(--osso); border-block: 1px solid var(--linha); }
  .nums {
    max-width: 1240px; margin: 0 auto;
    padding: clamp(2.2rem, 4.5vw, 3.2rem) clamp(1rem, 4vw, 2.6rem);
    display: grid; gap: clamp(1.4rem, 3vw, 2.4rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 170px), 1fr));
  }
  .num dt {
    display: flex; align-items: baseline; gap: 0.25rem;
    font-size: clamp(2rem, 4vw, 2.9rem); font-weight: 800; letter-spacing: -0.04em;
    line-height: 1; font-variant-numeric: tabular-nums;
  }
  .num dt i { font-style: normal; font-family: 'JetBrains Mono', monospace; font-size: 0.3em; color: var(--acento); }
  .num dd { margin: 0.6rem 0 0; font-size: 0.86rem; color: var(--c60); max-width: 24ch; }

  /* ---------- acervo ---------- */
  .filtro { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chip {
    font: inherit; font-size: 0.83rem; font-weight: 600; cursor: pointer;
    padding: 0.45rem 0.95rem; border-radius: 999px;
    background: transparent; color: var(--c60); border: 1px solid var(--linha);
    transition: background var(--t) var(--e), color var(--t) var(--e), border-color var(--t) var(--e);
  }
  .chip:hover { border-color: var(--acento); color: var(--acento); }
  .chip[aria-pressed='true'] { background: var(--tinta); border-color: var(--tinta); color: #fff; }

  .grade-pedras {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: clamp(1rem, 2vw, 1.6rem);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 275px), 1fr));
  }
  .grade-pedras [hidden] { display: none; }
  .pedra {
    display: flex; flex-direction: column;
    border: 1px solid var(--linha); border-radius: var(--raio-g);
    overflow: hidden; background: var(--branco);
    transition: border-color var(--t) var(--e), box-shadow var(--t) var(--e);
  }
  .pedra:hover { border-color: var(--acento); box-shadow: var(--sombra-alta); }
  .pedra-foto { position: relative; aspect-ratio: 3 / 2; overflow: hidden; }
  .pedra-foto img { display: block; width: 100%; height: 100%; object-fit: cover; transition: scale 0.6s var(--e); }
  .pedra:hover .pedra-foto img { scale: 1.05; }
  .pedra-fam {
    position: absolute; left: 0.7rem; top: 0.7rem; z-index: 2;
    padding: 0.2rem 0.6rem; border-radius: 999px;
    background: rgba(15, 17, 19, 0.78); backdrop-filter: blur(6px); color: #fff;
    font-family: 'JetBrains Mono', monospace; font-size: 0.6rem;
    letter-spacing: 0.1em; text-transform: uppercase;
  }
  .pedra h3 { margin: 1.1rem clamp(0.9rem, 2vw, 1.2rem) 0; }
  .pedra-cor {
    margin: 0.25rem clamp(0.9rem, 2vw, 1.2rem) 0;
    font-family: 'JetBrains Mono', monospace; font-size: 0.68rem;
    color: var(--c40); letter-spacing: 0.04em;
  }
  .pedra-obs { margin: 0.8rem clamp(0.9rem, 2vw, 1.2rem) 0; font-size: 0.85rem; color: var(--c60); flex: 1; }
  .pedra-dados {
    margin: 1rem clamp(0.9rem, 2vw, 1.2rem) 0; padding-top: 0.85rem;
    border-top: 1px solid var(--linha);
    display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;
  }
  .pedra-dados div { display: grid; gap: 0.1rem; }
  .pedra-dados dt {
    font-family: 'JetBrains Mono', monospace; font-size: 0.57rem;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--c40);
  }
  .pedra-dados dd { margin: 0; font-size: 0.82rem; font-weight: 600; }
  .pedra-uso {
    margin: 0.9rem 0 0; padding: 0.8rem clamp(0.9rem, 2vw, 1.2rem);
    background: var(--osso); border-top: 1px solid var(--linha);
    font-size: 0.8rem; color: var(--c60);
  }
  .pedra-uso b { color: var(--tinta); }

  .nota-foto {
    margin-bottom: clamp(1.6rem, 3vw, 2.2rem);
    padding: 1rem 1.2rem;
    border: 1px solid color-mix(in srgb, var(--acento) 28%, transparent);
    background: var(--osso);
    border-radius: var(--raio);
    font-size: 0.87rem; color: var(--c60); max-width: 78ch; line-height: 1.65;
  }
  .nota-foto b { color: var(--tinta); }
  .nota-foto > b:first-child {
    display: block; margin-bottom: 0.3rem;
    font-family: 'JetBrains Mono', monospace; font-size: 0.66rem;
    font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--acento);
  }
  .nota-foto a { color: var(--acento); }

  .pedra-ficha {
    margin: 0; padding: 0.6rem clamp(0.9rem, 2vw, 1.2rem) 0.8rem;
    background: var(--osso);
    font-family: 'JetBrains Mono', monospace; font-size: 0.6rem;
    letter-spacing: 0.04em; color: var(--c40);
  }
  .pedra-ficha a { color: var(--c40); }
  .pedra-ficha a:hover { color: var(--acento); }
  /* a faixa de uso perde o arredondamento de baixo: a ficha fecha o card */
  .pedra-uso { border-radius: 0; }

  /* ---------- comparativo ---------- */
  .trio { display: grid; gap: clamp(1rem, 2vw, 1.5rem); grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); }
  .mat { border: 1px solid var(--linha); border-radius: var(--raio-g); padding: clamp(1.3rem, 2.5vw, 1.9rem); }
  .mat-sub { margin-top: 0.3rem; font-size: 0.85rem; color: var(--acento); }
  .mat-dados { margin: 1.2rem 0; display: grid; }
  .mat-dados div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.55rem 0; border-top: 1px solid var(--linha); }
  .mat-dados dt { font-size: 0.8rem; color: var(--c40); }
  .mat-dados dd { margin: 0; font-size: 0.84rem; font-weight: 600; }
  .mat-l { font-size: 0.85rem; color: var(--c60); margin-top: 0.7rem; }
  .mat-l b { color: var(--tinta); }
  .mat-evitar b { color: var(--acento-esc); }

  /* ---------- bordas ---------- */
  .grade-bordas {
    list-style: none; margin: 0 0 clamp(2.4rem, 4vw, 3.4rem); padding: 0;
    display: grid; gap: clamp(1rem, 2vw, 1.6rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
  }
  .borda { padding: clamp(1.2rem, 2.4vw, 1.7rem); border: 1px solid var(--borda-esc); border-radius: var(--raio-g); }
  .borda-svg { display: block; width: 100%; max-width: 13rem; height: auto; margin-bottom: 1.1rem; }
  .borda-p { fill: rgba(180, 130, 60, 0.14); stroke: var(--acento-2); stroke-width: 1.6; stroke-linejoin: round; }
  /* pathLength="1" no markup: o traço vale 1 independente do comprimento real,
     então o mesmo tracejado serve para a borda reta e para a meia-cana */
  :global(.anima-on) .vt [data-perfil] { stroke-dasharray: 1; }
