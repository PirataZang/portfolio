    top: clamp(4.5rem, 11vh, 6.5rem); left: clamp(1rem, 4vw, 2.6rem);
    /* 62ch deixa o h2 numa linha só no desktop; no celular manda a tela */
    max-width: min(62ch, calc(100% - 2rem));
