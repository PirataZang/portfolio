    grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr));
  }
  .acab-item { display: grid; grid-template-rows: auto 1fr; gap: 1rem; }
  .acab-item .cena-card { position: static; width: auto; backdrop-filter: none; }
  .acab-pedra {
    position: relative; margin: 0; overflow: hidden;
    border-radius: var(--raio-g); aspect-ratio: 4 / 3; background: #101014;
    box-shadow:
