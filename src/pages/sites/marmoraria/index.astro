      :is(.grade, .passos-lista, .faq) > .revela:nth-child(3n + 2) { animation-range: entry 8% cover 32%; }
      :is(.grade, .passos-lista, .faq) > .revela:nth-child(3n) { animation-range: entry 12% cover 38%; }
  .vt section[id]:not(.cena):not(.acab) { scroll-margin-top: 4.8rem; }
