---
/*
  MARCA — o símbolo da Daniel's.

  A assinatura visual desta casa já é a moldura de fio de latão que segura os
  retratos dos barbeiros. O símbolo repete essa moldura em escala de ícone e
  põe dentro dela a navalha aberta — o mesmo gesto que a seção do ofício
  descreve. Nada de poste de barbeiro: o poste é genérico e nenhum outro
  elemento da página é vermelho e azul.

  Desenhado em traço, sem texto, para continuar legível a 28px e para não
  depender de fonte carregada. O nome vem ao lado, em Newsreader, no HTML.
*/
interface Props {
  tamanho?: number;
  class?: string;
}
const { tamanho = 38, class: klass = '' } = Astro.props;
---

<svg
  class={`marca-sim ${klass}`}
  width={tamanho}
  height={tamanho}
  viewBox="0 0 40 40"
  fill="none"
  role="img"
  aria-label="Símbolo da Daniel's: navalha aberta dentro de uma moldura"
>
  <rect x="0.6" y="0.6" width="38.8" height="38.8" rx="2.6" class="m-quadro" />
  <g class="m-cantos">
    <path d="M4.4 8.2V4.4h3.8M35.6 8.2V4.4h-3.8M4.4 31.8v3.8h3.8M35.6 31.8v3.8h-3.8" />
  </g>
  <g class="m-navalha">
    {/* o cabo entra primeiro: a lâmina passa por cima e cobre a articulação */}
    <path d="M12.7 26.6 4.8 31.4l1.4 2.2 7.9-4.8z" class="m-cabo" />
    <path d="M12.4 26.4 29.8 12.9l1.2 1.6-16.5 14.6z" class="m-lamina" />
    <path d="M14.3 28.4 30.5 14.3" class="m-fio" />
    <circle cx="13.4" cy="27.7" r="0.85" class="m-rebite" />
  </g>
</svg>

<style>
  .marca-sim { display: block; flex: 0 0 auto; }
  .m-quadro { stroke: var(--latao, #c9a15e); stroke-width: 1; opacity: 0.55; }
  .m-cantos { stroke: var(--latao, #c9a15e); stroke-width: 1.1; stroke-linecap: square; }
  .m-lamina { fill: var(--creme, #f5efe6); stroke: var(--creme, #f5efe6); stroke-width: 0.5; stroke-linejoin: round; }
  .m-fio { stroke: rgb(18 16 14 / 0.35); stroke-width: 0.7; }
  .m-cabo { fill: var(--latao, #c9a15e); stroke: var(--latao, #c9a15e); stroke-width: 0.8; stroke-linejoin: round; }
  .m-rebite { fill: var(--breu, #12100e); opacity: 0.75; }
</style>
